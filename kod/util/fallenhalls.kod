////////////////////////////////////////////////////////////////////////////////
FallenHalls is UtilityFunctions

// Ours (guild revamp, ADR 0022 decision 16): the guild halls the Order of
// Necromancers holds (room/ghall/fallenhall.kod). One object,
// SYS@GetFallenHalls, made on demand. Each hall adds itself as it is made, and
// each Meridian day (System.NewGameDay) every hall is told to reset.
//
// Maintenance port: send object <this> NewGameDay resets them all now.

constants:

   include blakston.khd

resources:

classvars:

properties:

   plHalls = $

messages:

   AddHall(hall = $)
   {
      if hall <> $
         AND FindListElem(plHalls,hall) = 0
      {
         plHalls = Cons(hall,plHalls);
      }

      return;
   }

   RemoveHall(hall = $)
   {
      if FindListElem(plHalls,hall) > 0
      {
         plHalls = DelListElem(plHalls,hall);
      }

      return;
   }

   GetHalls()
   {
      return plHalls;
   }

   NewGameDay()
   {
      local i;

      foreach i in plHalls
      {
         Send(i,@NewGameDay);
      }

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
