// Ours (Meridian Shards, the faction revamp's phase 2; docs/adr/0021): the lieges' battles
// over the flagpoles. One object, SYS@GetFactionWar, made on demand (System.NewGameHour
// asks for it every game hour, which keeps the schedule going on any world).
//
// Every piBattleMinutes a battle is called at a front (PickFront): a flag room whose pole's
// liege differs from a neighbouring pole's (an assault), or a pole no liege holds next to a
// liege's land (open ground: a rival liege marches on it too). A liege's own city and its
// capture points are never attacked, nor a town's own pole.
//
//   STATE_MUSTER   announced to everyone; piMusterMinutes to come.
//   STATE_FIGHT    up to piFightMinutes. The armies take the field only once a player is in
//                  the room (SpawnArmies): piArmySize a side, with a captain, archers and mages
//                  of the liege's two schools, each twice a flag troop's strength
//                  (FactionTroop.SetBattle), plus a troop for each point of war effort. They
//                  fight each other and the other side's soldiers, nobody else. A side loses
//                  when its captain falls or its army is gone.
//
// Unwatched, or out of time, the battle is rolled: 50/50 shifted EFFORT_PERCENT for each
// point of war effort either side brought (AddWarEffort: Roq's contracts, the ground
// dailies), or, if it was fought, by the health each army has left. The winner takes the
// pole (Flagpole.SetFaction, which recounts the territory and the lieges' power), and the
// soldiers who stood there are paid (Resolve). Both sides' war effort is spent.
//
// Maintenance port: StartBattle (rid int, attacker int), EndBattle (winner int),
// AddWarEffort (faction int, amount int), and the settings below.
//
// Our client (phase 5): "war" (UC_SHARDS -> WarCommand) asks for UC_FACTION_WAR kind 1, all
// of it for the war window (SendWar); kind 2, the battle alone, goes to everyone when a battle
// is called, opens or ends, and every few seconds of a fight, for the War button by the map,
// which glows while one is on (BroadcastBattle). docs/research/protocol.md has the layout.
// Battles aren't announced in chat to everyone (2026-10-25): the button and the window say it;
// only those who take part are told things (the siege's caller, rallies, reinforcements, pay).
//
// Ours (2026-10-30, ADR 0021 decision 18): the assault on a liege's seat. The moment a rival
// liege takes a liege's own capital (TownChanged), everyone is told, and after
// ASSAULT_MUSTER_MINUTES the armies meet at the liege's seat (SeatOf: the Courtyard of
// Blackstone Keep, the Bourgeois Castle, the Temple of Kraanan), the seat held by its liege's
// guard, a quarter as many again. There's no pole: won, the attackers are paid ASSAULT_WIN_RENOWN
// and ASSAULT_WIN_SHILLINGS, their capital celebrates and the beaten liege mourns for
// ASSAULT_MOURN_MINUTES; held, the defenders are paid so and celebrate. The guard who stood are
// paid as winners even when the seat falls, and an assault nobody fought is held. Either way
// the capital goes back to its liege (ReturnCapital), and an assault called while a battle is
// on waits for it (plAssaultsWaiting).
////////////////////////////////////////////////////////////////////////////////
FactionWar is UtilityFunctions

constants:

   include blakston.khd
   include protocol.khd

   // UC_FACTION_WAR's kinds of packet, and how often a fight's banner is brought up to date
   WAR_PKT_ALL = 1
   WAR_PKT_BATTLE = 2
   BANNER_SECONDS = 5

   STATE_NONE = 0
   STATE_MUSTER = 1
   STATE_FIGHT = 2

   // War effort: each point moves an unwatched battle this much (percent), and brings a
   // troop more to a fought one; at most this many points count
   EFFORT_PERCENT = 5
   EFFORT_MAX = 4

   WIN_RENOWN = 5
   FOUGHT_RENOWN = 2
   WIN_SHILLINGS = 1000
   FOUGHT_SHILLINGS = 250

   HOW_FIELD = 1
   HOW_TIME = 2
   HOW_UNWATCHED = 3

   HISTORY_MAX = 10

   // A soldier who reaches a fought battle: this long before the enemy will turn on them,
   //  while their own army forms up round them (NoteParticipants)
   GRACE_SECONDS = 8
   // A soldier who comes once the armies are out brings this many of their liege's soldiers
   //  (Reinforce): only the first comer has the whole army formed round them
   REINFORCEMENTS = 3

   // The attackers form up at the room's spawning place nearest this many squares from the
   //  pole, on dry ground with no water between (SpawnArmies); at least FRONT_MIN off
   FRONT_SQUARES = 12
   FRONT_MIN = 6

   // Ours (2026-10-30): a battle's horn (the troops' cry as they take a target, FactionTroop.
   //  PlayAwareSound) sounds as the armies take the field, then at most this often (seconds)
   BATTLE_HORN_SECONDS = 45

   // Ours (2026-10-30): a troop is placed only on a floor within a step of its anchor's, so
   //  none lands up on a ledge it can't come down from (blakserv MAXSTEPHEIGHT, in Kod units)
   PLACE_STEP_HEIGHT = 24

   // A story siege (StartSiege) gathers this many minutes after it's called
   SIEGE_MUSTER_MINUTES = 2

   // Ours (2026-10-30): the assault on a liege's seat (StartAssault): its muster in minutes,
   //  the seat's guard as a percent of an army, the pay for the side that wins it, and how
   //  long the liege whose seat falls mourns
   ASSAULT_MUSTER_MINUTES = 10
   ASSAULT_GUARD_PERCENT = 125
   ASSAULT_WIN_RENOWN = 15
   ASSAULT_WIN_SHILLINGS = 3000
   ASSAULT_MOURN_MINUTES = 240

resources:

   fw_paid_win = "~IYour liege pays %i shillings to those who won the day at %s."
   fw_paid_lose = \
      "~IThe day is lost, but your liege remembers who stood at %s.  %i shillings for your "
      "trouble."
   fw_effort = "~IYour work strengthens %s's next battle."

   fw_siege_called = "~IYour liege's army will be waiting for you at %s.  Lead it there."
   fw_siege_busy = \
      "~IThe armies are already in the field.  Your liege will march when this battle is done."
   fw_blank = ""
   fw_rally = \
      "~IYour liege's soldiers close ranks round you.  You have a moment to find your place in "
      "the line."
   fw_reinforce = "~IA squad of your liege's soldiers comes up with you."
   fw_siege_no_target = "~IThere are no walls of that enemy left to besiege."

   fw_assault_called = \
      "~B~k[War]~n ~B%s has taken %s and storms %s's seat!  The armies meet at %s in ten "
      "minutes."
   fw_assault_won = \
      "~B~k[War]~n ~B%s's army has stormed %s and carried off %s's banner!  %s returns to its "
      "liege."
   fw_assault_held = \
      "~B~k[War]~n ~B%s's guard has held %s against %s's army!  %s returns to its liege."
   fw_paid_held = \
      "~IThe seat has fallen, but your liege pays %i shillings to every guard who stood at %s."

classvars:

properties:

   piState = STATE_NONE

   // Settings
   piBattleMinutes = 120
   piMusterMinutes = 10
   piFightMinutes = 20
   piArmySize = 10

   ptNext = $
   ptStage = $
   // Ours: when the last regular battle was called (GetTime()), so the next is called
   // piBattleMinutes after it, not after it ends (Resolve); 0 before the first
   piCalledAt = 0
   ptTick = $

   poRoom = $
   poFlag = $
   piAttacker = FACTION_NEUTRAL
   piDefender = FACTION_NEUTRAL
   pbOpenGround = FALSE
   // When the fight's banner was last sent (Tick)
   piBannerSent = 0
   // A story siege (StartSiege): the player who called it
   pbSiege = FALSE
   poSiegeLeader = $
   // Ours (2026-10-30): the battle is an assault on piDefender's seat (StartAssault), and the
   //  assaults waiting for the battle under way: [ attacker, defender ]
   pbAssault = FALSE
   plAssaultsWaiting = $
   // Ours: GetTime() the battle's horn last sounded (MayHorn); 0 before the armies are out
   piHornAt = 0
   piDeadline = 0
   pbSpawned = FALSE
   // Where each army gathers: [ row, col ] (SpawnArmies), or $ (the defenders: the pole)
   plAttackAnchor = $
   plDefendAnchor = $

   // The armies' troops, and their captains (FALSE once fallen)
   plAttackArmy = $
   plDefendArmy = $
   poAttackCaptain = $
   poDefendCaptain = $
   // How many each army raised, and whether its captain is still guarded
   piAttackRaised = 0
   piDefendRaised = 0
   pbAttackGuarded = TRUE
   pbDefendGuarded = TRUE

   // The soldiers who stood in the battle: [ player, faction, grace until ]
   plParticipants = $

   // War effort: [ Duke, Princess, Rebels ]
   plWarEffort = $

   // The last battles: [ GetTime(), rid, attacker, defender, winner, how ]
   plHistory = $

   // How the world answers the war (util/factionworld.kod), made on demand
   poWorld = $

messages:

   Constructor()
   {
      plWarEffort = [ 0, 0, 0 ];
      Send(self,@ScheduleNext);

      return;
   }

   Delete()
   {
      Send(self,@ClearTimers);
      Send(self,@ClearArmies);
      if ptNext <> $
      {
         DeleteTimer(ptNext);
         ptNext = $;
      }

      return;
   }

   NewGameHour()
   "From System.NewGameHour: keeps the schedule going if it was ever lost, and the world in "
   "step (FactionWorld.NewGameHour)."
   {
      if piState = STATE_NONE
         AND ptNext = $
      {
         Send(self,@ScheduleNext);
      }

      Send(Send(self,@GetWorld),@NewGameHour);

      return;
   }

   GetWorld()
   "The world's answers to the war: celebrations, mourning, occupation, the ledger "
   "(util/factionworld.kod)."
   {
      if poWorld = $
      {
         poWorld = Create(&FactionWorld);
      }

      return poWorld;
   }

   TownChanged(town = $,from = FACTION_NEUTRAL,to = FACTION_NEUTRAL)
   "From TerritoryGame.RecalcTownFlags: passed on to the world. Ours: a liege's own capital "
   "taken by a rival liege calls the assault on its seat (CapitalTaken)."
   {
      Send(Send(self,@GetWorld),@TownChanged,#town=town,#from=from,#to=to);
      Post(self,@CapitalTaken,#town=town,#to=to);

      return;
   }

   CapitalTaken(town = $,to = FACTION_NEUTRAL)
   "Ours (2026-10-30): town is now to's: if it's another liege's capital, to storms that liege's "
   "seat (StartAssault)."
   {
      local i, oWorld;

      if town = $
         OR to <= FACTION_NEUTRAL
         OR to > FACTION_NORMAL_MAX
      {
         return;
      }

      oWorld = Send(self,@GetWorld);
      i = FACTION_DUKE;
      while i <= FACTION_NORMAL_MAX
      {
         if i <> to
            AND Send(oWorld,@Capital,#faction=i) = town
         {
            Send(self,@StartAssault,#attacker=to,#defender=i);

            return;
         }

         i = i + 1;
      }

      return;
   }

   SeatOf(faction = $)
   "Ours (2026-10-30): where faction's seat is stormed: [ room, the defenders' row and col, the "
   "attackers' row and col ] (squares checked against the rooms' maps, on one floor)."
   {
      if faction = FACTION_DUKE
      {
         return [ RID_DUKE1, 55, 33, 75, 33 ];
      }

      if faction = FACTION_PRINCESS
      {
         return [ RID_CASTLE2B, 29, 51, 28, 9 ];
      }

      if faction = FACTION_REBEL
      {
         return [ RID_TEMPLE_KRAANAN, 34, 20, 42, 32 ];
      }

      return $;
   }

   ScheduleNext(minutes = $)
   {
      if minutes = $
      {
         minutes = piBattleMinutes;
      }

      if ptNext <> $
      {
         DeleteTimer(ptNext);
      }

      ptNext = CreateTimer(self,@NextBattleTimer,Bound(minutes,1,1440) * 60000);

      return;
   }

   NextBattleTimer()
   {
      ptNext = $;
      if NOT Send(self,@StartBattle)
      {
         Send(self,@ScheduleNext);
      }

      return;
   }

   //// Who's fighting

   GetState()
   {
      return piState;
   }

   GetStatus()
   "[ state, rid, attacker, defender, armies on the field, attackers, defenders, seconds left, "
   "war effort ]: for the admin."
   {
      local iRID;

      iRID = 0;
      if poRoom <> $
      {
         iRID = Send(poRoom,@GetRoomNum);
      }

      return [ piState, iRID, piAttacker, piDefender, pbSpawned, Length(plAttackArmy),
               Length(plDefendArmy), Bound(piDeadline - GetTime(),0,$), plWarEffort ];
   }

   IsBattleSide(faction = $)
   {
      return piState <> STATE_NONE
             AND faction <> FACTION_NEUTRAL
             AND (faction = piAttacker OR faction = piDefender);
   }

   IsBattleAt(flag = $)
   {
      return piState <> STATE_NONE AND flag <> $ AND flag = poFlag;
   }

   LiegeName(faction = $)
   {
      return Send(Send(SYS,@GetParliament),@GetFactionLiegeName,#faction=faction);
   }

   //// War effort

   AddWarEffort(faction = $,amount = 1,who = $)
   "Work done for faction's next battle (Roq's contracts, quests): who is told."
   {
      local iIndex;

      if faction = $
         OR faction <= FACTION_NEUTRAL
         OR faction > FACTION_NORMAL_MAX
      {
         return;
      }

      if plWarEffort = $
      {
         plWarEffort = [ 0, 0, 0 ];
      }

      iIndex = faction;
      SetNth(plWarEffort,iIndex,Bound(Nth(plWarEffort,iIndex) + amount,0,EFFORT_MAX));

      if who <> $
      {
         Send(who,@MsgSendUser,#message_rsc=fw_effort,
              #parm1=Send(self,@LiegeName,#faction=faction));
      }

      return;
   }

   GetWarEffort(faction = $)
   {
      if plWarEffort = $
         OR faction = $
         OR faction <= FACTION_NEUTRAL
         OR faction > FACTION_NORMAL_MAX
      {
         return 0;
      }

      return Nth(plWarEffort,faction);
   }

   //// Calling a battle

   PickFront()
   "[ room, flag, attacker, defender, open ground ] for the next battle, or $ if there's no "
   "front anywhere."
   {
      local oTG, iRID, oRoom, oFlag, iOwner, iNear, oNearRoom, oNearFlag, iNearFaction,
            lFronts, lFront, iRival, lRivals, i;

      oTG = Send(SYS,@GetTerritoryGame);
      if oTG = $
      {
         return $;
      }

      lFronts = $;
      foreach iRID in Send(oTG,@GetFlagRIDs)
      {
         oRoom = Send(SYS,@FindRoomByNum,#num=iRID);
         if oRoom = $
         {
            continue;
         }

         oFlag = Send(oRoom,@FindHoldingActive,#class=&Flagpole);
         if NOT Send(self,@CanBeAttacked,#rid=iRID,#flag=oFlag)
         {
            continue;
         }

         iOwner = Send(oFlag,@GetFaction);

         foreach iNear in Send(oRoom,@GetYellZone)
         {
            if iNear = iRID
            {
               continue;
            }

            oNearRoom = Send(SYS,@FindRoomByNum,#num=iNear);
            if oNearRoom = $
            {
               continue;
            }

            oNearFlag = Send(oNearRoom,@FindHoldingActive,#class=&Flagpole);
            if NOT Send(self,@MarchesFrom,#flag=oFlag,#near=oNearFlag)
            {
               continue;
            }

            iNearFaction = Send(oNearFlag,@GetFaction);

            if iOwner <> FACTION_NEUTRAL
            {
               // An assault counts twice: the war is between the lieges
               lFront = [ oRoom, oFlag, iNearFaction, iOwner, FALSE ];
               lFronts = Cons(lFront,Cons(lFront,lFronts));
            }
            else
            {
               lRivals = $;
               i = FACTION_DUKE;
               while i <= FACTION_NORMAL_MAX
               {
                  if i <> iNearFaction
                  {
                     lRivals = Cons(i,lRivals);
                  }

                  i = i + 1;
               }

               iRival = Nth(lRivals,Random(1,Length(lRivals)));
               lFronts = Cons([ oRoom, oFlag, iNearFaction, iRival, TRUE ],lFronts);
            }
         }
      }

      if lFronts = $
      {
         return $;
      }

      return Nth(lFronts,Random(1,Length(lFronts)));
   }

   CanBeAttacked(rid = $,flag = $)
   "Whether a battle could be called for this pole (PickFront): not a town's own pole, no claim "
   "on it, and not its liege's own city or capture points."
   {
      local iOwner, oTG;

      if flag = $
         OR NOT Send(flag,@IsClaimable)
         OR Send(flag,@IsClaimAttemptInProgress)
      {
         return FALSE;
      }

      iOwner = Send(flag,@GetFaction);
      oTG = Send(SYS,@GetTerritoryGame);
      if iOwner <> FACTION_NEUTRAL
         AND oTG <> $
         AND Send(oTG,@IsHometownFlag,#RID=rid,#faction=iOwner)
      {
         return FALSE;
      }

      return TRUE;
   }

   MarchesFrom(flag = $,near = $)
   "Whether the liege holding the pole near could march on flag (PickFront): a liege holds it, "
   "and not flag's."
   {
      local iNear;

      if flag = $
         OR near = $
      {
         return FALSE;
      }

      iNear = Send(near,@GetFaction);

      return iNear <> FACTION_NEUTRAL AND iNear <> Send(flag,@GetFaction);
   }

   StartBattle(rid = $,attacker = $)
   "Call a battle: at the room rid (for the admin; attacker, or a rival of its holder, attacks) "
   "or at a front (PickFront). Returns whether one was called."
   {
      local lFront, oRoom, oFlag, iDefender, lRivals, i;

      if piState <> STATE_NONE
      {
         return FALSE;
      }

      if rid <> $
      {
         oRoom = Send(SYS,@FindRoomByNum,#num=rid);
         if oRoom = $
         {
            return FALSE;
         }

         // Ours: not at a town's own pole, which follows its capture points (as PickFront)
         oFlag = Send(oRoom,@FindHoldingActive,#class=&Flagpole);
         if oFlag = $
            OR NOT Send(oFlag,@IsClaimable)
         {
            return FALSE;
         }

         iDefender = Send(oFlag,@GetFaction);
         lRivals = $;
         i = FACTION_DUKE;
         while i <= FACTION_NORMAL_MAX
         {
            if i <> iDefender
            {
               lRivals = Cons(i,lRivals);
            }

            i = i + 1;
         }

         if attacker = $
            OR attacker = iDefender
            OR attacker <= FACTION_NEUTRAL
            OR attacker > FACTION_NORMAL_MAX
         {
            attacker = Nth(lRivals,Random(1,Length(lRivals)));
         }

         if iDefender = FACTION_NEUTRAL
         {
            lRivals = DelListElem(lRivals,attacker);
            lFront = [ oRoom, oFlag, attacker, Nth(lRivals,Random(1,Length(lRivals))), TRUE ];
         }
         else
         {
            lFront = [ oRoom, oFlag, attacker, iDefender, FALSE ];
         }
      }
      else
      {
         lFront = Send(self,@PickFront);
      }

      if lFront = $
      {
         return FALSE;
      }

      if ptNext <> $
      {
         DeleteTimer(ptNext);
         ptNext = $;
      }

      poRoom = First(lFront);
      poFlag = Nth(lFront,2);
      piAttacker = Nth(lFront,3);
      piDefender = Nth(lFront,4);
      pbOpenGround = Nth(lFront,5);
      pbSpawned = FALSE;
      plParticipants = $;
      plAttackArmy = $;
      plDefendArmy = $;
      poAttackCaptain = $;
      poDefendCaptain = $;
      piState = STATE_MUSTER;
      piCalledAt = GetTime();

      ptStage = CreateTimer(self,@OpenBattle,Bound(piMusterMinutes,0,60) * 60000 + 1);
      Send(self,@BroadcastBattle);

      return TRUE;
   }

   StartAssault(attacker = $,defender = $)
   "Ours (2026-10-30): attacker holds defender's capital: everyone hears it, and after "
   "ASSAULT_MUSTER_MINUTES the armies meet at defender's seat (SeatOf). Called while a battle "
   "is on, it waits for it (Resolve). The regular schedule stays as it was. Returns whether "
   "it was called (or will be)."
   {
      local lSeat, oRoom, oWorld, iCapital;

      if attacker = $
         OR defender = $
         OR attacker = defender
         OR attacker <= FACTION_NEUTRAL OR attacker > FACTION_NORMAL_MAX
         OR defender <= FACTION_NEUTRAL OR defender > FACTION_NORMAL_MAX
      {
         return FALSE;
      }

      oWorld = Send(self,@GetWorld);
      iCapital = Send(oWorld,@Capital,#faction=defender);
      lSeat = Send(self,@SeatOf,#faction=defender);
      if lSeat = $
         OR iCapital = $
      {
         return FALSE;
      }

      // Still theirs to storm from (one waiting may have been won back meanwhile)
      if Send(oWorld,@TownOwner,#rid=iCapital) <> attacker
      {
         return FALSE;
      }

      oRoom = Send(SYS,@FindRoomByNum,#num=First(lSeat));
      if oRoom = $
      {
         return FALSE;
      }

      if piState <> STATE_NONE
      {
         plAssaultsWaiting = AppendListElem([ attacker, defender ],plAssaultsWaiting);

         return TRUE;
      }

      poRoom = oRoom;
      poFlag = $;
      piAttacker = attacker;
      piDefender = defender;
      pbOpenGround = FALSE;
      pbSpawned = FALSE;
      plParticipants = $;
      plAttackArmy = $;
      plDefendArmy = $;
      poAttackCaptain = $;
      poDefendCaptain = $;
      pbSiege = FALSE;
      poSiegeLeader = $;
      pbAssault = TRUE;
      piState = STATE_MUSTER;

      Send(oWorld,@Announce,#rsc=fw_assault_called,
           #parm1=Send(self,@LiegeName,#faction=attacker),
           #parm2=Send(oWorld,@RoomName,#rid=iCapital),
           #parm3=Send(self,@LiegeName,#faction=defender),
           #parm4=Send(oRoom,@GetName));
      ptStage = CreateTimer(self,@OpenBattle,ASSAULT_MUSTER_MINUTES * 60000);
      Send(self,@BroadcastBattle);

      return TRUE;
   }

   AssaultDone(winner = $)
   "Ours (2026-10-30): the assault on piDefender's seat is over: everyone hears it, the winner's "
   "capital celebrates, a seat that fell mourns, and the capital goes back to its liege."
   {
      local oWorld, iCapital;

      oWorld = Send(self,@GetWorld);
      iCapital = Send(oWorld,@Capital,#faction=piDefender);
      if winner = piAttacker
      {
         Send(oWorld,@Announce,#rsc=fw_assault_won,
              #parm1=Send(self,@LiegeName,#faction=piAttacker),#parm2=Send(poRoom,@GetName),
              #parm3=Send(self,@LiegeName,#faction=piDefender),
              #parm4=Send(oWorld,@RoomName,#rid=iCapital));
         Send(oWorld,@Celebrate,#faction=piAttacker,
              #places=[ Send(oWorld,@Capital,#faction=piAttacker) ]);
         Send(oWorld,@Mourn,#faction=piDefender,#town=iCapital,#victor=piAttacker,
              #minutes=ASSAULT_MOURN_MINUTES,#bAnnounce=FALSE);
      }
      else
      {
         Send(oWorld,@Announce,#rsc=fw_assault_held,
              #parm1=Send(self,@LiegeName,#faction=piDefender),#parm2=Send(poRoom,@GetName),
              #parm3=Send(self,@LiegeName,#faction=piAttacker),
              #parm4=Send(oWorld,@RoomName,#rid=iCapital));
         Send(oWorld,@Celebrate,#faction=piDefender,#places=[ iCapital ]);
      }

      Send(self,@ReturnCapital,#faction=piDefender);

      return;
   }

   ReturnCapital(faction = $)
   "Ours (2026-10-30): after an assault, faction's capital and its capture points are its own "
   "again. The city's pole goes first, quietly, so the recount as the capture points come back "
   "finds it already faction's and nobody celebrates or mourns the city twice."
   {
      local oWorld, oTG, iCapital, oPole, i;

      oWorld = Send(self,@GetWorld);
      oTG = Send(SYS,@GetTerritoryGame);
      iCapital = Send(oWorld,@Capital,#faction=faction);
      if oTG = $
         OR iCapital = $
      {
         return;
      }

      oPole = Send(oWorld,@TownPole,#rid=iCapital);
      if oPole <> $
      {
         Send(oPole,@SystemSetFaction,#faction=faction);
      }

      foreach i in Send(oTG,@GetFlagRIDs)
      {
         if i <> iCapital
            AND Send(oTG,@IsHometownFlag,#RID=i,#faction=faction)
         {
            oPole = Send(oWorld,@TownPole,#rid=i);
            if oPole <> $
               AND Send(oPole,@GetFaction) <> faction
            {
               Send(oPole,@SetFaction,#faction=faction);
            }
         }
      }

      // The counts and the saved states, whatever came back (TerritoryGame.FlagClaimed)
      Send(oTG,@FlagClaimed);
      Send(oWorld,@SyncSentries);

      return;
   }

   StartSiege(who = $,against = $)
   "Ours (the faction revamp's campaigns): who, on their campaign's siege step, said 'march' "
   "to their liege (Factions.SomeoneSaid): their liege's army besieges a capture point of "
   "against's capital after SIEGE_MUSTER_MINUTES. It takes no pole (Resolve); won, it counts "
   "for the step (QuestBook.SiegeDone) and the capital celebrates. Nobody leading it, it "
   "fails. The regular schedule stays as it was."
   {
      local iFaction, oTG, iRID, lTargets, oRoom, oFlag;

      iFaction = Send(who,@GetFaction);
      if piState <> STATE_NONE
      {
         Send(who,@MsgSendUser,#message_rsc=fw_siege_busy);

         return FALSE;
      }

      if against = $
         OR against = iFaction
         OR against <= FACTION_NEUTRAL
         OR against > FACTION_NORMAL_MAX
         OR iFaction = FACTION_NEUTRAL
      {
         return FALSE;
      }

      oTG = Send(SYS,@GetTerritoryGame);
      lTargets = $;
      if oTG <> $
      {
         foreach iRID in Send(oTG,@GetFlagRIDs)
         {
            if Send(oTG,@IsHometownFlag,#RID=iRID,#faction=against)
            {
               oRoom = Send(SYS,@FindRoomByNum,#num=iRID);
               if oRoom <> $
               {
                  oFlag = Send(oRoom,@FindHoldingActive,#class=&Flagpole);
                  if oFlag <> $
                     AND Send(oFlag,@IsClaimable)
                  {
                     lTargets = Cons(iRID,lTargets);
                  }
               }
            }
         }
      }

      if lTargets = $
      {
         Send(who,@MsgSendUser,#message_rsc=fw_siege_no_target);

         return FALSE;
      }

      iRID = Nth(lTargets,Random(1,Length(lTargets)));
      poRoom = Send(SYS,@FindRoomByNum,#num=iRID);
      poFlag = Send(poRoom,@FindHoldingActive,#class=&Flagpole);
      piAttacker = iFaction;
      piDefender = against;
      pbOpenGround = FALSE;
      pbSpawned = FALSE;
      plParticipants = $;
      plAttackArmy = $;
      plDefendArmy = $;
      poAttackCaptain = $;
      poDefendCaptain = $;
      pbSiege = TRUE;
      poSiegeLeader = who;
      piState = STATE_MUSTER;

      Send(who,@MsgSendUser,#message_rsc=fw_siege_called,#parm1=Send(poRoom,@GetName));

      ptStage = CreateTimer(self,@OpenBattle,SIEGE_MUSTER_MINUTES * 60000);
      Send(self,@BroadcastBattle);

      return TRUE;
   }

   OpenBattle()
   {
      ptStage = $;
      if piState <> STATE_MUSTER
      {
         return;
      }

      piState = STATE_FIGHT;
      piDeadline = GetTime() + Bound(piFightMinutes,1,120) * 60;

      piBannerSent = GetTime();
      Send(self,@BroadcastBattle);
      Send(self,@Tick);

      return;
   }

   //// The fight

   Tick()
   {
      ptTick = $;

      if piState <> STATE_FIGHT
      {
         return;
      }

      if NOT pbSpawned
         AND Send(poRoom,@IsUserInRoom)
      {
         Send(self,@SpawnArmies);
      }

      if pbSpawned
      {
         Send(self,@NoteParticipants);

         if poAttackCaptain = FALSE
            OR plAttackArmy = $
         {
            Send(self,@Resolve,#winner=piDefender,#how=HOW_FIELD);

            return;
         }

         if poDefendCaptain = FALSE
            OR plDefendArmy = $
         {
            Send(self,@Resolve,#winner=piAttacker,#how=HOW_FIELD);

            return;
         }

         Send(self,@CheckGuards);
         Send(self,@KeepTargets);

         if GetTime() >= piBannerSent + BANNER_SECONDS
         {
            piBannerSent = GetTime();
            Send(self,@BroadcastBattle);
         }
      }

      if GetTime() >= piDeadline
      {
         Send(self,@ResolveByRoll);

         return;
      }

      ptTick = CreateTimer(self,@Tick,1000);

      return;
   }

   MageSchool(faction = $,which = 1)
   "The liege's two schools: the Princess Faren and Shal'ille, the Duke Qor and Riija, Jonas "
   "Kraanan and Jala. An army of 10 has one mage, of the first."
   {
      // Ours (27 October): the Princess's mage is Faren's first, a battle mage of fire and
      //  lightning; Shal'ille's second
      if faction = FACTION_PRINCESS
      {
         return Nth([ SS_FAREN, SS_SHALILLE ],which);
      }

      if faction = FACTION_DUKE
      {
         return Nth([ SS_QOR, SS_RIIJA ],which);
      }

      return Nth([ SS_KRAANAN, SS_JALA ],which);
   }

   TroopClass(faction = $,mage = FALSE)
   {
      if faction = FACTION_DUKE
      {
         if mage
         {
            return &DukeMage;
         }

         return &DukeTroop;
      }

      if faction = FACTION_PRINCESS
      {
         if mage
         {
            return &PrincessMage;
         }

         return &PrincessTroop;
      }

      if mage
      {
         return &RebelMage;
      }

      return &RebelTroop;
   }

   SpawnArmies()
   "Both armies take the field: the defenders round the pole, the attackers round the room's "
   "spawning place about FRONT_SQUARES from it, dry and with no river to wade between (else "
   "the farthest); but the army of the soldier who came gathers round them, so nobody walks "
   "in alone against the other side."
   {
      local i, iBest, iDist, iFlagRow, iFlagCol, oFirst, iScore, iBestScore, lSeat;

      pbSpawned = TRUE;
      piHornAt = 0;

      plAttackAnchor = $;
      plDefendAnchor = $;
      // Ours: an assault forms up on its seat's squares (SeatOf)
      if pbAssault
      {
         lSeat = Send(self,@SeatOf,#faction=piDefender);
         if lSeat <> $
         {
            plDefendAnchor = [ Nth(lSeat,2), Nth(lSeat,3) ];
            plAttackAnchor = [ Nth(lSeat,4), Nth(lSeat,5) ];
         }
      }
      if poFlag <> $
         AND IsClass(poRoom,&MonsterRoom)
      {
         iFlagRow = Send(poFlag,@GetRow);
         iFlagCol = Send(poFlag,@GetCol);
         iBest = $;
         iBestScore = $;
         foreach i in Send(poRoom,@GetGenerators)
         {
            iDist = (First(i) - iFlagRow) * (First(i) - iFlagRow)
                    + (Nth(i,2) - iFlagCol) * (Nth(i,2) - iFlagCol);

            // Ours: a dry place near the front, with no water between it and the pole
            if iDist >= FRONT_MIN * FRONT_MIN
               AND NOT Send(poRoom,@IsWaterAt,#row=First(i),#col=Nth(i,2))
               AND Send(poRoom,@IsDryLine,#line_row1=First(i),#line_col1=Nth(i,2),
                        #line_row2=iFlagRow,#line_col2=iFlagCol)
            {
               iScore = Abs(Sqrt(iDist) - FRONT_SQUARES);
               if iBestScore = $ OR iScore < iBestScore
               {
                  iBestScore = iScore;
                  plAttackAnchor = [ First(i), Nth(i,2) ];
               }

               continue;
            }

            // Else the farthest, as before
            if iBestScore = $
               AND (iBest = $ OR iDist > iBest)
            {
               iBest = iDist;
               plAttackAnchor = [ First(i), Nth(i,2) ];
            }
         }
      }

      // Whoever came (in grace now) has their own army round them
      Send(self,@NoteParticipants,#bReinforce=FALSE);
      oFirst = $;
      foreach i in plParticipants
      {
         oFirst = i;
      }

      if oFirst <> $
      {
         if Nth(oFirst,2) = piAttacker
         {
            plAttackAnchor = [ Send(First(oFirst),@GetRow), Send(First(oFirst),@GetCol) ];
         }
         else
         {
            plDefendAnchor = [ Send(First(oFirst),@GetRow), Send(First(oFirst),@GetCol) ];
         }
      }

      Send(self,@RaiseArmy,#faction=piAttacker,#bHome=FALSE);
      Send(self,@RaiseArmy,#faction=piDefender,#bHome=TRUE);

      if poAttackCaptain = $
      {
         poAttackCaptain = FALSE;
      }

      if poDefendCaptain = $
      {
         poDefendCaptain = FALSE;
      }

      piAttackRaised = Length(plAttackArmy);
      piDefendRaised = Length(plDefendArmy);
      pbAttackGuarded = TRUE;
      pbDefendGuarded = TRUE;

      // Now they're known as captains, they hold their ground (FactionTroop.TweakBehavior)
      if poAttackCaptain <> FALSE
      {
         Send(poAttackCaptain,@ResetBehaviorFlags);
      }

      if poDefendCaptain <> FALSE
      {
         Send(poDefendCaptain,@ResetBehaviorFlags);
      }

      Send(self,@KeepTargets,#all=TRUE);

      return;
   }

   IsGuardedCaptain(troop = $)
   "A captain is guarded, and holds their ground, while more than half their army stands."
   {
      if troop = $
      {
         return FALSE;
      }

      if troop = poAttackCaptain
      {
         return pbAttackGuarded;
      }

      if troop = poDefendCaptain
      {
         return pbDefendGuarded;
      }

      return FALSE;
   }

   CheckGuards()
   "When half an army has fallen, its captain takes the field and becomes fair game."
   {
      if pbAttackGuarded
         AND Length(plAttackArmy) * 2 <= piAttackRaised
      {
         pbAttackGuarded = FALSE;
         if poAttackCaptain <> FALSE AND poAttackCaptain <> $
         {
            Send(poAttackCaptain,@ResetBehaviorFlags);
         }
      }

      if pbDefendGuarded
         AND Length(plDefendArmy) * 2 <= piDefendRaised
      {
         pbDefendGuarded = FALSE;
         if poDefendCaptain <> FALSE AND poDefendCaptain <> $
         {
            Send(poDefendCaptain,@ResetBehaviorFlags);
         }
      }

      return;
   }

   RaiseArmy(faction = $,bHome = FALSE)
   {
      local iSize, iArchers, iMages, i, iRole, oTroop, iMage;

      iSize = Bound(piArmySize,2,30)
              + Bound(Send(self,@GetWarEffort,#faction=faction),0,EFFORT_MAX);
      // Ours: a seat is held by its liege's guard, a quarter as many again
      if pbAssault AND bHome
      {
         iSize = iSize * ASSAULT_GUARD_PERCENT / 100;
      }
      iArchers = Bound(iSize / 10,1,$);
      iMages = Bound(iSize / 10,1,$);
      iMage = 0;

      i = 0;
      while i < iSize
      {
         i = i + 1;
         if i = 1
         {
            iRole = BATTLE_ROLE_CAPTAIN;
            oTroop = Create(Send(self,@TroopClass,#faction=faction));
            Send(oTroop,@SetBattle,#battle=self,#role=iRole);
         }
         else if i <= 1 + iMages
         {
            iRole = BATTLE_ROLE_MAGE;
            iMage = iMage + 1;
            oTroop = Create(Send(self,@TroopClass,#faction=faction,#mage=TRUE));
            Send(oTroop,@SetBattle,#battle=self,#role=iRole,
                 #school=Send(self,@MageSchool,#faction=faction,#which=((iMage - 1) % 2) + 1));
         }
         else if i <= 1 + iMages + iArchers
         {
            iRole = BATTLE_ROLE_ARCHER;
            oTroop = Create(Send(self,@TroopClass,#faction=faction));
            Send(oTroop,@SetBattle,#battle=self,#role=iRole);
         }
         else
         {
            iRole = BATTLE_ROLE_SOLDIER;
            oTroop = Create(Send(self,@TroopClass,#faction=faction));
            Send(oTroop,@SetBattle,#battle=self,#role=iRole);
         }

         if NOT Send(self,@PlaceTroop,#troop=oTroop,#bHome=bHome)
         {
            // GenerateMonster deleted it (TroopGone found it in no army)
            continue;
         }

         if bHome
         {
            plDefendArmy = Cons(oTroop,plDefendArmy);
            if iRole = BATTLE_ROLE_CAPTAIN
            {
               poDefendCaptain = oTroop;
            }
         }
         else
         {
            plAttackArmy = Cons(oTroop,plAttackArmy);
            if iRole = BATTLE_ROLE_CAPTAIN
            {
               poAttackCaptain = oTroop;
            }
         }
      }

      return;
   }

   PlaceTroop(troop = $,bHome = FALSE,anchor = $)
   "Defenders near the pole, attackers near their anchor (SpawnArmies), or near anchor "
   "([ row, col ]) if it's given; anywhere in the room if there's no room there. Returns "
   "whether it was placed (if not, the troop is gone)."
   {
      local iTry, iRow, iCol, iAnchorRow, iAnchorCol, iAnchorHeight, iHeight;

      iAnchorRow = $;
      if anchor <> $
      {
         iAnchorRow = First(anchor);
         iAnchorCol = Nth(anchor,2);
      }
      else if bHome
      {
         if plDefendAnchor <> $
         {
            iAnchorRow = First(plDefendAnchor);
            iAnchorCol = Nth(plDefendAnchor,2);
         }
         else if poFlag <> $
         {
            iAnchorRow = Send(poFlag,@GetRow);
            iAnchorCol = Send(poFlag,@GetCol);
         }
      }
      else if plAttackAnchor <> $
      {
         iAnchorRow = First(plAttackAnchor);
         iAnchorCol = Nth(plAttackAnchor,2);
      }

      if iAnchorRow <> $
      {
         // Ours: on the anchor's floor, within a step (PLACE_STEP_HEIGHT): not up on a ledge
         iAnchorHeight = Send(poRoom,@FloorHeightAt,#row=iAnchorRow,#col=iAnchorCol);
         iTry = 0;
         while iTry < 20
         {
            iTry = iTry + 1;
            iRow = iAnchorRow + Random(-3,3);
            iCol = iAnchorCol + Random(-3,3);
            iHeight = $;
            if iRow > 0 AND iCol > 0
            {
               iHeight = Send(poRoom,@FloorHeightAt,#row=iRow,#col=iCol);
            }

            // Ours: not in water (the last tries take what they find), and not up or down a ledge
            if iRow > 0 AND iCol > 0
               AND (iTry > 15 OR NOT Send(poRoom,@IsWaterAt,#row=iRow,#col=iCol))
               AND (iAnchorHeight = $ OR iHeight = $
                    OR Abs(iHeight - iAnchorHeight) <= PLACE_STEP_HEIGHT)
               AND Send(poRoom,@ReqNewHold,#what=troop,#new_row=iRow,#new_col=iCol)
               AND Send(poRoom,@ReqSomethingMoved,#what=troop,#new_row=iRow,#new_col=iCol)
            {
               Send(poRoom,@NewHold,#what=troop,#new_row=iRow,#new_col=iCol);

               return TRUE;
            }
         }

         // Ours: the anchor's own square, before anywhere in the room
         if Send(poRoom,@ReqNewHold,#what=troop,#new_row=iAnchorRow,#new_col=iAnchorCol)
         {
            Send(poRoom,@NewHold,#what=troop,#new_row=iAnchorRow,#new_col=iAnchorCol);

            return TRUE;
         }
      }

      return Send(poRoom,@GenerateMonster,#oMonster=troop,#bRandom=TRUE);
   }

   IsFoeOf(troop = $,what = $)
   {
      return Send(troop,@IsBattleFoe,#what=what);
   }

   MayHorn()
   "Ours (2026-10-30): whether a troop's cry may sound now: the first as the armies take the "
   "field, then once every BATTLE_HORN_SECONDS."
   {
      if piHornAt > 0
         AND GetTime() - piHornAt < BATTLE_HORN_SECONDS
      {
         return FALSE;
      }

      piHornAt = GetTime();

      return TRUE;
   }

   KeepTargets(all = FALSE)
   "Each troop without a foe in its sights goes for the nearest; one others are already on "
   "counts as further off, so the armies spread out (as ArenaBouts.PickTarget)."
   {
      local i, oTarget;

      foreach i in Send(self,@AllTroops)
      {
         oTarget = Send(i,@GetTarget);
         // Ours: all, but a mage keeps a foe it has (FactionTroop.TargetSwitch)
         if oTarget = $
            OR NOT IsObject(oTarget)
            OR NOT Send(i,@IsBattleFoe,#what=oTarget)
            OR Send(oTarget,@GetOwner) <> poRoom
            OR (all AND Send(i,@GetBattleRole) <> BATTLE_ROLE_MAGE)
         {
            Send(self,@PickTarget,#troop=i);
         }
      }

      return;
   }

   AllTroops()
   {
      local i, lAll;

      lAll = $;
      foreach i in plAttackArmy
      {
         lAll = Cons(i,lAll);
      }

      foreach i in plDefendArmy
      {
         lAll = Cons(i,lAll);
      }

      return lAll;
   }

   PickTarget(troop = $)
   {
      local lFoes, lTroops, i, j, iScore, iBest, oBest, oThing;

      lTroops = Send(self,@AllTroops);
      lFoes = $;
      foreach i in lTroops
      {
         if Send(troop,@IsBattleFoe,#what=i)
         {
            lFoes = Cons(i,lFoes);
         }
      }

      foreach i in Send(poRoom,@GetHolderActive)
      {
         oThing = First(i);
         if IsClass(oThing,&User)
            AND Send(troop,@IsBattleFoe,#what=oThing)
         {
            lFoes = Cons(oThing,lFoes);
         }
      }

      oBest = $;
      iBest = $;
      foreach i in lFoes
      {
         iScore = Send(troop,@SquaredFineDistanceTo,#what=i);
         if iScore = $
         {
            continue;
         }

         iScore = iScore / (FINENESS * FINENESS);
         foreach j in lTroops
         {
            if j <> troop AND Send(j,@GetTarget) = i
            {
               iScore = iScore + 16;
            }
         }

         if iBest = $ OR iScore < iBest
         {
            iBest = iScore;
            oBest = i;
         }
      }

      if oBest <> $
      {
         Send(troop,@TargetSwitch,#what=oBest,#iHatred=100,#force=TRUE);
         Send(troop,@EnterStateChase,#target=oBest,#actnow=TRUE);
      }

      return;
   }

   Reinforce(who = $,faction = $)
   "who came to a battle whose armies are already out: REINFORCEMENTS of their liege's soldiers "
   "come up with them."
   {
      local i, oTroop, bHome, lAt;

      bHome = (faction = piDefender);
      lAt = [ Send(who,@GetRow), Send(who,@GetCol) ];
      i = 0;
      while i < REINFORCEMENTS
      {
         i = i + 1;
         oTroop = Create(Send(self,@TroopClass,#faction=faction));
         Send(oTroop,@SetBattle,#battle=self,#role=BATTLE_ROLE_SOLDIER);
         if NOT Send(self,@PlaceTroop,#troop=oTroop,#bHome=bHome,#anchor=lAt)
         {
            continue;
         }

         if bHome
         {
            plDefendArmy = Cons(oTroop,plDefendArmy);
            piDefendRaised = piDefendRaised + 1;
         }
         else
         {
            plAttackArmy = Cons(oTroop,plAttackArmy);
            piAttackRaised = piAttackRaised + 1;
         }
      }

      Send(who,@MsgSendUser,#message_rsc=fw_reinforce);
      Send(self,@KeepTargets,#all=TRUE);

      return;
   }

   NoteParticipants(bReinforce = TRUE)
   "Soldiers of either liege in the room, shields worn, fight in it (and stop regrouping). One "
   "who comes once the armies are out brings reinforcements (unless bReinforce is FALSE: the "
   "armies are being raised round them)."
   {
      local i, j, oThing, oShield, iFaction, bKnown;

      foreach i in Send(poRoom,@GetHolderActive)
      {
         oThing = First(i);
         if NOT IsClass(oThing,&User)
            OR IsClass(oThing,&DM)
         {
            continue;
         }

         oShield = Send(oThing,@FindUsing,#class=&SoldierShield);
         if oShield = $
         {
            continue;
         }

         iFaction = Send(oShield,@GetFaction);
         if NOT Send(self,@IsBattleSide,#faction=iFaction)
         {
            continue;
         }

         bKnown = FALSE;
         foreach j in plParticipants
         {
            if First(j) = oThing
            {
               bKnown = TRUE;

               break;
            }
         }

         if NOT bKnown
         {
            plParticipants = Cons([ oThing, iFaction, GetTime() + GRACE_SECONDS ],
                                  plParticipants);
            Send(oThing,@EndRegrouping,#report=FALSE);
            Send(oThing,@MsgSendUser,#message_rsc=fw_rally);
            if bReinforce AND pbSpawned
            {
               Send(self,@Reinforce,#who=oThing,#faction=iFaction);
            }
         }
      }

      return;
   }

   InGrace(who = $)
   "A soldier just come to the field, whom the enemy leaves alone for a moment."
   {
      local i;

      foreach i in plParticipants
      {
         if First(i) = who
         {
            return GetTime() < Nth(i,3);
         }
      }

      return FALSE;
   }

   EndGrace(who = $)
   "They struck first (FactionTroop.CanMonsterFight): no more grace."
   {
      local i;

      foreach i in plParticipants
      {
         if First(i) = who
         {
            SetNth(i,3,0);
         }
      }

      return;
   }

   TroopGone(troop = $)
   "One of the armies' troops fell or was cleared away (FactionTroop.Delete)."
   {
      if troop = $
      {
         return;
      }

      // DelListElem empties a list it can't find the element in: look first
      if FindListElem(plAttackArmy,troop)
      {
         plAttackArmy = DelListElem(plAttackArmy,troop);
      }

      if FindListElem(plDefendArmy,troop)
      {
         plDefendArmy = DelListElem(plDefendArmy,troop);
      }

      if troop = poAttackCaptain
      {
         poAttackCaptain = FALSE;
      }

      if troop = poDefendCaptain
      {
         poDefendCaptain = FALSE;
      }

      return;
   }

   //// The end

   ArmyHealth(army = $)
   {
      local i, iTotal;

      iTotal = 0;
      foreach i in army
      {
         iTotal = iTotal + Send(i,@GetHealth);
      }

      return iTotal;
   }

   ResolveByRoll()
   "Out of time, or never fought: a fought battle goes by the health each army has left, an "
   "unwatched one by the dice and the war effort."
   {
      local iChance, iA, iD;

      // A siege nobody led fails; ours: an assault nobody fought is held
      if (pbSiege OR pbAssault)
         AND NOT pbSpawned
      {
         Send(self,@Resolve,#winner=piDefender,#how=HOW_UNWATCHED);

         return;
      }

      if pbSpawned
      {
         iA = Send(self,@ArmyHealth,#army=plAttackArmy);
         iD = Send(self,@ArmyHealth,#army=plDefendArmy);
         iChance = 50;
         if iA + iD > 0
         {
            iChance = iA * 100 / (iA + iD);
         }

         if Random(1,100) <= iChance
         {
            Send(self,@Resolve,#winner=piAttacker,#how=HOW_TIME);
         }
         else
         {
            Send(self,@Resolve,#winner=piDefender,#how=HOW_TIME);
         }

         return;
      }

      iChance = 50 + EFFORT_PERCENT * (Send(self,@GetWarEffort,#faction=piAttacker)
                                       - Send(self,@GetWarEffort,#faction=piDefender));
      iChance = Bound(iChance,50 - EFFORT_PERCENT * EFFORT_MAX,50 + EFFORT_PERCENT * EFFORT_MAX);

      if Random(1,100) <= iChance
      {
         Send(self,@Resolve,#winner=piAttacker,#how=HOW_UNWATCHED);
      }
      else
      {
         Send(self,@Resolve,#winner=piDefender,#how=HOW_UNWATCHED);
      }

      return;
   }

   EndBattle(winner = $)
   "For the admin: end the battle now, winner taking the day (or the dice deciding)."
   {
      if piState = STATE_NONE
      {
         return FALSE;
      }

      if winner = piAttacker OR winner = piDefender
      {
         Send(self,@Resolve,#winner=winner,#how=HOW_FIELD);
      }
      else
      {
         Send(self,@ResolveByRoll);
      }

      return TRUE;
   }

   Resolve(winner = $,how = HOW_FIELD)
   {
      local i, oWho, iFaction, iLoser, oRoom, iRenown, iPay, lNext;

      if piState = STATE_NONE
      {
         return;
      }

      piState = STATE_NONE;
      Send(self,@ClearTimers);

      Debug("FactionWar: battle at",Send(poRoom,@GetRoomNum),"attacker",piAttacker,
            "defender",piDefender,"won by",winner,"how",how,"armies left",
            Length(plAttackArmy),Length(plDefendArmy),"soldiers",Length(plParticipants));

      oRoom = poRoom;
      iLoser = piDefender;
      if winner = piDefender
      {
         iLoser = piAttacker;
      }

      // The winner takes the pole: SetFaction recounts the land and the lieges' power. A
      //  story siege (StartSiege) breaks the walls but takes no pole.
      if NOT pbSiege
         AND poFlag <> $
         AND Send(poFlag,@GetFaction) <> winner
      {
         Send(poFlag,@SetFaction,#faction=winner);
      }

      foreach i in plParticipants
      {
         oWho = First(i);
         iFaction = Nth(i,2);
         if NOT IsObject(oWho)
            OR Send(oWho,@GetFaction) <> iFaction
         {
            continue;
         }

         // The campaigns' battle and siege steps (util/questbook.kod)
         Send(Send(SYS,@GetQuestBook),@BattleDone,#who=oWho,#won=(iFaction = winner));
         if pbSiege
         {
            Send(Send(SYS,@GetQuestBook),@SiegeDone,#who=oWho,#won=(iFaction = winner),
                 #against=piDefender);
         }

         if iFaction = winner
         {
            Send(oWho,@NoteBattle,#won=TRUE);
            // Ours: an assault won pays more
            iRenown = WIN_RENOWN;
            iPay = WIN_SHILLINGS;
            if pbAssault
            {
               iRenown = ASSAULT_WIN_RENOWN;
               iPay = ASSAULT_WIN_SHILLINGS;
            }

            Send(oWho,@AddFactionRenown,#amount=iRenown);
            Send(oWho,@NewHold,#what=Create(&Shillings,#number=iPay));
            Send(oWho,@MsgSendUser,#message_rsc=fw_paid_win,#parm1=iPay,
                 #parm2=Send(oRoom,@GetName));
         }
         else if pbAssault
            AND iFaction = piDefender
         {
            // Ours: the seat's guard who stood are paid as a battle's winners
            Send(oWho,@NoteBattle,#won=FALSE);
            Send(oWho,@AddFactionRenown,#amount=WIN_RENOWN);
            Send(oWho,@NewHold,#what=Create(&Shillings,#number=WIN_SHILLINGS));
            Send(oWho,@MsgSendUser,#message_rsc=fw_paid_held,#parm1=WIN_SHILLINGS,
                 #parm2=Send(oRoom,@GetName));
         }
         else
         {
            Send(oWho,@NoteBattle,#won=FALSE);
            Send(oWho,@AddFactionRenown,#amount=FOUGHT_RENOWN);
            Send(oWho,@NewHold,#what=Create(&Shillings,#number=FOUGHT_SHILLINGS));
            Send(oWho,@MsgSendUser,#message_rsc=fw_paid_lose,#parm1=Send(oRoom,@GetName),
                 #parm2=FOUGHT_SHILLINGS);
         }
      }

      // A run of wins is celebrated (FactionWorld.BattleWon), and so is a siege won
      Send(Send(self,@GetWorld),@BattleWon,#winner=winner,#loser=iLoser);
      if pbSiege
         AND winner = piAttacker
      {
         Send(Send(self,@GetWorld),@Celebrate,#faction=winner,
              #places=[ Send(Send(self,@GetWorld),@Capital,#faction=winner) ]);
      }

      // Ours: an assault's stakes, and the capital back to its liege
      if pbAssault
      {
         Send(self,@AssaultDone,#winner=winner);
      }

      // Both sides' war effort is spent.
      if plWarEffort <> $
      {
         if winner > FACTION_NEUTRAL AND winner <= FACTION_NORMAL_MAX
         {
            SetNth(plWarEffort,winner,0);
         }

         if iLoser > FACTION_NEUTRAL AND iLoser <= FACTION_NORMAL_MAX
         {
            SetNth(plWarEffort,iLoser,0);
         }
      }

      plHistory = Cons([ GetTime(), Send(oRoom,@GetRoomNum), piAttacker, piDefender, winner,
                         how ],plHistory);
      if Length(plHistory) > HISTORY_MAX
      {
         plHistory = DelListElem(plHistory,Last(plHistory));
      }

      Send(self,@ClearArmies);

      poRoom = $;
      poFlag = $;
      plParticipants = $;
      pbSpawned = FALSE;
      piAttacker = FACTION_NEUTRAL;
      piDefender = FACTION_NEUTRAL;

      // A siege leaves the regular schedule as it was. Ours: a regular battle's next one is
      // called piBattleMinutes after it was, so the muster and the fight don't push it back.
      if NOT pbSiege
         AND NOT pbAssault
      {
         if piCalledAt > 0
         {
            Send(self,@ScheduleNext,
                 #minutes=piBattleMinutes - (GetTime() - piCalledAt) / 60);
         }
         else
         {
            Send(self,@ScheduleNext);
         }
      }
      else if ptNext = $
      {
         Send(self,@ScheduleNext);
      }

      pbSiege = FALSE;
      poSiegeLeader = $;
      pbAssault = FALSE;
      Send(self,@BroadcastBattle);

      // Ours: an assault that waited for this battle is called now
      if plAssaultsWaiting <> $
      {
         lNext = First(plAssaultsWaiting);
         plAssaultsWaiting = Rest(plAssaultsWaiting);
         Post(self,@StartAssault,#attacker=First(lNext),#defender=Nth(lNext,2));
      }

      return;
   }

   GetHistory()
   {
      return plHistory;
   }

   //// Our client: the war window and the battle banner (UC_FACTION_WAR)

   WarCommand(who = $,words = $)
   "The client's 'war': the war window's all of it."
   {
      Send(self,@SendWar,#who=who);

      return;
   }

   BroadcastBattle()
   "The battle, to everyone logged on (their banners)."
   {
      local i;

      foreach i in Send(SYS,@GetUsersLoggedOn)
      {
         Send(self,@SendBattle,#who=i);
      }

      return;
   }

   SendBattle(who = $)
   "UC_FACTION_WAR kind 2: the battle alone."
   {
      local oSession;

      if who = $ OR NOT IsClass(who,&User)
      {
         return;
      }

      oSession = Send(who,@GetShardsSession);
      if oSession = $
      {
         return;
      }

      AddPacket(1,BP_USERCOMMAND,1,UC_FACTION_WAR,1,WAR_PKT_BATTLE);
      Send(self,@AddBattlePacket);
      SendPacket(oSession);

      return;
   }

   AddBattlePacket()
   "The battle: state, attacker, defender, flags (1 a siege, 2 the armies are out, 4 open "
   "ground, 8 an assault on the defender's seat), its room, the seconds to the clash or left of the fight, each army's troops left "
   "and raised, and the seconds to the next battle called (0: not known)."
   {
      local iFlags, iRID, rName, iSeconds, iNext;

      iFlags = 0;
      iRID = 0;
      rName = fw_blank;
      iSeconds = 0;
      if piState <> STATE_NONE AND poRoom <> $
      {
         if pbSiege
         {
            iFlags = iFlags | 1;
         }

         if pbSpawned
         {
            iFlags = iFlags | 2;
         }

         if pbOpenGround
         {
            iFlags = iFlags | 4;
         }

         // Ours (2026-10-30): an assault on a liege's seat
         if pbAssault
         {
            iFlags = iFlags | 8;
         }

         iRID = Send(poRoom,@GetRoomNum);
         rName = Send(poRoom,@GetName);
         if piState = STATE_MUSTER
         {
            if ptStage <> $
            {
               iSeconds = GetTimeRemaining(ptStage) / 1000;
            }
         }
         else
         {
            iSeconds = Bound(piDeadline - GetTime(),0,$);
         }
      }

      iNext = 0;
      if ptNext <> $
      {
         iNext = GetTimeRemaining(ptNext) / 1000;
      }

      AddPacket(1,piState,1,piAttacker,1,piDefender,1,iFlags,4,iRID,STRING_RESOURCE,rName,
                2,Bound(iSeconds,0,65535),
                1,Bound(Length(plAttackArmy),0,255),1,Bound(Length(plDefendArmy),0,255),
                1,Bound(piAttackRaised,0,255),1,Bound(piDefendRaised,0,255),4,iNext);

      return;
   }

   SendWar(who = $)
   "UC_FACTION_WAR kind 1: all of it, for the war window. Ours: faction, renown, rank, record "
   "[ kills, deaths, fought, won ], flags (1 shield worn, 2 regrouping); the battle; the war "
   "effort; every flag room [ rid, name, liege, flags: 1 a town's own pole, 2 at half-staff, "
   "4 the battle's ]; the towns [ rid, name, liege, liege celebrating there ]; the last "
   "battles [ rid, name, attacker, defender, winner, how, seconds ago ]; our liege's ledger "
   "[ name, rank, kills, battles won, fought ]; and the flag rooms that are neighbours (each's "
   "yell zone) [ rid, rid, flags: 1 a front, where PickFront could call a battle ]."
   {
      local oSession, oWorld, oTG, i, j, iFlags, oPole, iFaction, lRecord, lList, iCeleb, oRoom,
            lPoles, lRIDs, lKeys, lPairs, iNear, oNearPole, iKey;

      if who = $ OR NOT IsClass(who,&User)
      {
         return;
      }

      oSession = Send(who,@GetShardsSession);
      if oSession = $
      {
         return;
      }

      oWorld = Send(self,@GetWorld);
      oTG = Send(SYS,@GetTerritoryGame);
      iFaction = Send(who,@GetFaction);
      lRecord = Send(who,@GetWarRecord);
      iFlags = 0;
      if Send(who,@FindUsing,#class=&SoldierShield) <> $
      {
         iFlags = iFlags | 1;
      }

      if Send(who,@IsRegrouping)
      {
         iFlags = iFlags | 2;
      }

      AddPacket(1,BP_USERCOMMAND,1,UC_FACTION_WAR,1,WAR_PKT_ALL,
                1,iFaction,1,Send(who,@GetFactionRenown),
                STRING_RESOURCE,Send(who,@GetRenownRankName),
                2,First(lRecord),2,Nth(lRecord,2),2,Nth(lRecord,3),2,Nth(lRecord,4),1,iFlags);
      Send(self,@AddBattlePacket);

      foreach i in [ FACTION_DUKE, FACTION_PRINCESS, FACTION_REBEL ]
      {
         AddPacket(1,Bound(Send(self,@GetWarEffort,#faction=i),0,255));
      }

      // The flag rooms (towns' own poles among them)
      lList = $;
      if oTG <> $
      {
         foreach i in Send(oTG,@GetFlagRIDs)
         {
            oRoom = Send(SYS,@FindRoomByNum,#num=i);
            if oRoom <> $
            {
               oPole = Send(oRoom,@FindHoldingActive,#class=&Flagpole);
               if oPole <> $
               {
                  lList = Cons([ i, oRoom, oPole ],lList);
               }
            }
         }
      }

      lPoles = lList;
      AddPacket(1,Length(lList));
      foreach i in lList
      {
         iFlags = 0;
         foreach j in Send(oWorld,@TownList)
         {
            if First(j) = First(i)
            {
               iFlags = iFlags | 1;
            }
         }

         if Send(Nth(i,3),@IsHalfStaff)
         {
            iFlags = iFlags | 2;
         }

         if piState <> STATE_NONE AND poRoom = Nth(i,2)
         {
            iFlags = iFlags | 4;
         }

         AddPacket(4,First(i),STRING_RESOURCE,Send(Nth(i,2),@GetName),
                   1,Send(Nth(i,3),@GetFaction),1,iFlags);
      }

      // The towns
      AddPacket(1,Length(Send(oWorld,@TownList)));
      foreach i in Send(oWorld,@TownList)
      {
         iCeleb = FACTION_NEUTRAL;
         foreach j in [ FACTION_DUKE, FACTION_PRINCESS, FACTION_REBEL ]
         {
            if Send(oWorld,@IsCelebrating,#faction=j,#town=First(i))
            {
               iCeleb = j;
            }
         }

         AddPacket(4,First(i),STRING_RESOURCE,Send(oWorld,@RoomName,#rid=First(i)),
                   1,Send(oWorld,@TownOwner,#rid=First(i)),1,iCeleb);
      }

      // The last battles
      AddPacket(1,Length(plHistory));
      foreach i in plHistory
      {
         oRoom = Send(SYS,@FindRoomByNum,#num=Nth(i,2));
         if oRoom <> $
         {
            AddPacket(4,Nth(i,2),STRING_RESOURCE,Send(oRoom,@GetName));
         }
         else
         {
            AddPacket(4,Nth(i,2),STRING_RESOURCE,fw_blank);
         }

         AddPacket(1,Nth(i,3),1,Nth(i,4),1,Nth(i,5),1,Nth(i,6),
                   4,Bound(GetTime() - First(i),0,$));
      }

      // Our liege's ledger
      lList = $;
      if iFaction > FACTION_NEUTRAL AND iFaction <= FACTION_NORMAL_MAX
      {
         lList = Send(oWorld,@LedgerOf,#faction=iFaction);
      }

      AddPacket(1,Length(lList));
      foreach i in lList
      {
         j = Nth(i,2);
         lRecord = Send(j,@GetWarRecord);
         AddPacket(STRING_RESOURCE,Send(j,@GetTrueName),
                   STRING_RESOURCE,Send(j,@GetRenownRankName),
                   2,First(lRecord),2,Nth(lRecord,4),2,Nth(lRecord,3));
      }

      // Ours (2026-10-29): neighbouring flag rooms, for the map's lines, each pair once
      lRIDs = $;
      foreach i in lPoles
      {
         lRIDs = Cons(First(i),lRIDs);
      }

      lKeys = $;
      lPairs = $;
      foreach i in lPoles
      {
         foreach iNear in Send(Nth(i,2),@GetYellZone)
         {
            if iNear = First(i)
               OR FindListElem(lRIDs,iNear) = 0
            {
               continue;
            }

            iKey = Bound(First(i),0,iNear) * 100000 + Bound(First(i),iNear,$);
            if FindListElem(lKeys,iKey) <> 0
            {
               continue;
            }

            lKeys = Cons(iKey,lKeys);
            foreach j in lPoles
            {
               if First(j) = iNear
               {
                  oNearPole = Nth(j,3);
               }
            }

            iFlags = 0;
            if (Send(self,@CanBeAttacked,#rid=First(i),#flag=Nth(i,3))
                AND Send(self,@MarchesFrom,#flag=Nth(i,3),#near=oNearPole))
               OR (Send(self,@CanBeAttacked,#rid=iNear,#flag=oNearPole)
                   AND Send(self,@MarchesFrom,#flag=oNearPole,#near=Nth(i,3)))
            {
               iFlags = 1;
            }

            lPairs = Cons([ First(i), iNear, iFlags ],lPairs);
         }
      }

      AddPacket(2,Length(lPairs));
      foreach i in lPairs
      {
         AddPacket(4,First(i),4,Nth(i,2),1,Nth(i,3));
      }

      SendPacket(oSession);

      return;
   }

   ClearTimers()
   {
      if ptStage <> $
      {
         DeleteTimer(ptStage);
         ptStage = $;
      }

      if ptTick <> $
      {
         DeleteTimer(ptTick);
         ptTick = $;
      }

      return;
   }

   ClearArmies()
   "The troops still standing march away."
   {
      local i, lAll;

      lAll = Send(self,@AllTroops);
      plAttackArmy = $;
      plDefendArmy = $;
      poAttackCaptain = $;
      poDefendCaptain = $;

      foreach i in lAll
      {
         if IsObject(i)
         {
            Send(i,@Delete);
         }
      }

      return;
   }

   //// Settings, for the admin

   SetBattleMinutes(minutes = 120)
   {
      piBattleMinutes = Bound(minutes,1,1440);
      if piState = STATE_NONE
      {
         Send(self,@ScheduleNext);
      }

      return;
   }

   SetMusterMinutes(minutes = 10)
   {
      piMusterMinutes = Bound(minutes,0,60);

      return;
   }

   SetFightMinutes(minutes = 20)
   {
      piFightMinutes = Bound(minutes,1,120);

      return;
   }

   SetArmySize(size = 10)
   {
      piArmySize = Bound(size,2,30);

      return;
   }

end
