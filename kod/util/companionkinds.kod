// Ours (Meridian Shards, docs/adr/0010-followers.md): the kinds of companion, one per faction
// leader who gives them, and the numbers they grow by. CompanionBook (util/companionbook.kod)
// inherits these tables, as QuestBook inherits QuestDefs.
//
// Since the 2026-10-19 revamp each fights with a weapon and a school's spells, and supports its
// owner with another's (GetSupport, Companion.SupportTimer); both come as its owner grows
// (COMPANION_SPELL2_HEALTH, COMPANION_SPELL3_HEALTH). The Duke's: an axe, Qor's acids, Riija's
// shadows and reflections and Qor's unholy weapon. The Princess's: a hammer, Faren's fire or ice,
// Shal'ille's heal, holy weapon and umbrella. The rebels': a scimitar, Kraanan's blessings and
// Jala's songs. Its bond tier betters its kit. The schools' own companions (kinds 4-7) are gone.

////////////////////////////////////////////////////////////////////////////////
CompanionKinds is UtilityFunctions

constants:

   include blakston.khd

   // The kinds and their numbers are in blakston.khd (COMPANION_*), for every file

resources:

   companion_kind_duke = "battle-mage of the Duke"
   companion_kind_princess = "spellsword of the Princess"
   companion_kind_rebel = "war-priest of the rebellion"

   comp_name_d_m1 = "Aldric"
   comp_name_d_m2 = "Bertram"
   comp_name_d_m3 = "Corvin"
   comp_name_d_m4 = "Gareth"
   comp_name_d_m5 = "Osric"
   comp_name_d_m6 = "Roderic"
   comp_name_d_f1 = "Brienna"
   comp_name_d_f2 = "Cassia"
   comp_name_d_f3 = "Edda"
   comp_name_d_f4 = "Helena"
   comp_name_d_f5 = "Morwen"
   comp_name_d_f6 = "Ysolde"

   comp_name_p_m1 = "Alaric"
   comp_name_p_m2 = "Cedric"
   comp_name_p_m3 = "Florian"
   comp_name_p_m4 = "Leopold"
   comp_name_p_m5 = "Percival"
   comp_name_p_m6 = "Tristan"
   comp_name_p_f1 = "Adela"
   comp_name_p_f2 = "Elowen"
   comp_name_p_f3 = "Isolde"
   comp_name_p_f4 = "Lianne"
   comp_name_p_f5 = "Rosamund"
   comp_name_p_f6 = "Seraphine"

   comp_name_r_m1 = "Bram"
   comp_name_r_m2 = "Dax"
   comp_name_r_m3 = "Fenn"
   comp_name_r_m4 = "Jory"
   comp_name_r_m5 = "Kestrel"
   comp_name_r_m6 = "Wick"
   comp_name_r_f1 = "Ash"
   comp_name_r_f2 = "Briar"
   comp_name_r_f3 = "Ketta"
   comp_name_r_f4 = "Nell"
   comp_name_r_f5 = "Sable"
   comp_name_r_f6 = "Tamsin"

classvars:

properties:

messages:

   KindForLeader(npc = $)
   "The kind of companion this NPC gives, or 0."
   {
      if npc = $
      {
         return 0;
      }

      if IsClass(npc,&DukeLiege)
      {
         return COMPANION_DUKE;
      }

      if IsClass(npc,&PrincessLiege)
      {
         return COMPANION_PRINCESS;
      }

      if IsClass(npc,&RebelLiege)
      {
         return COMPANION_REBEL;
      }

      return 0;
   }

   GetKindFaction(kind = 0)
   "The faction a leader gives its companions to the members of."
   {
      if kind = COMPANION_DUKE
      {
         return FACTION_DUKE;
      }

      if kind = COMPANION_PRINCESS
      {
         return FACTION_PRINCESS;
      }

      if kind = COMPANION_REBEL
      {
         return FACTION_REBEL;
      }

      return $;
   }

   GetKindName(kind = 0)
   {
      if kind = COMPANION_PRINCESS
      {
         return companion_kind_princess;
      }

      if kind = COMPANION_REBEL
      {
         return companion_kind_rebel;
      }

      return companion_kind_duke;
   }

   GetSchool(kind = 0)
   "The school (SS_*) its robe and spells are of."
   {
      if kind = COMPANION_PRINCESS
      {
         return SS_FAREN;
      }

      if kind = COMPANION_REBEL
      {
         return SS_KRAANAN;
      }

      return SS_QOR;
   }

   SpellsKnown(health = 50)
   "How many of its kind's three spells it has, by its owner's base health."
   {
      if health >= COMPANION_SPELL3_HEALTH
      {
         return 3;
      }

      if health >= COMPANION_SPELL2_HEALTH
      {
         return 2;
      }

      return 1;
   }

   GetSpellBook(kind = 0,health = 50)
   "Its attack spells for its owner's base health, as Monster.plSpellBook has them: [ spell, "
   "mana, cumulative chance ]. Fireball turns to Ice Shard against a target that resists cold "
   "less (GetColdTwin)."
   {
      if kind = COMPANION_DUKE
      {
         if Send(self,@SpellsKnown,#health=health) = 1
         {
            return [ [SID_SPLASH_OF_ACID,6,100] ];
         }

         return [ [SID_SPLASH_OF_ACID,6,75], [SID_BLIND,6,100] ];
      }

      if kind = COMPANION_PRINCESS
      {
         if Send(self,@SpellsKnown,#health=health) = 1
         {
            return [ [SID_FIREBALL,6,100] ];
         }

         return [ [SID_FIREBALL,6,60], [SID_LIGHTNING_BOLT,8,100] ];
      }

      return $;
   }

   GetSupport(kind = 0,health = 50)
   "How it supports its owner, for its owner's base health: [ spell, mana, COMP_SUP_* ] each "
   "(Companion.SupportTimer)."
   {
      local iKnown;

      iKnown = Send(self,@SpellsKnown,#health=health);
      if kind = COMPANION_DUKE
      {
         if iKnown = 1
         {
            return [ [SID_SHADOW_FORM,5,COMP_SUP_ENCHANT] ];
         }

         if iKnown = 2
         {
            return [ [SID_SHADOW_FORM,5,COMP_SUP_ENCHANT],
                     [SID_UNHOLY_WEAPON,10,COMP_SUP_WEAPON] ];
         }

         return [ [SID_SHADOW_FORM,5,COMP_SUP_ENCHANT], [SID_UNHOLY_WEAPON,10,COMP_SUP_WEAPON],
                  [SID_REFLECTION,10,COMP_SUP_REFLECT] ];
      }

      if kind = COMPANION_PRINCESS
      {
         if iKnown = 1
         {
            return [ [SID_MINOR_HEAL,4,COMP_SUP_HEAL] ];
         }

         if iKnown = 2
         {
            return [ [SID_MINOR_HEAL,4,COMP_SUP_HEAL], [SID_HOLY_WEAPON,10,COMP_SUP_WEAPON] ];
         }

         return [ [SID_MINOR_HEAL,4,COMP_SUP_HEAL], [SID_HOLY_WEAPON,10,COMP_SUP_WEAPON],
                  [SID_UMBRELLA,15,COMP_SUP_AURA] ];
      }

      if iKnown = 1
      {
         return [ [SID_BLESS,6,COMP_SUP_ENCHANT], [SID_INVIGORATE,5,COMP_SUP_SONG] ];
      }

      if iKnown = 2
      {
         return [ [SID_BLESS,6,COMP_SUP_ENCHANT], [SID_MAGIC_SHIELD,9,COMP_SUP_ENCHANT],
                  [SID_INVIGORATE,5,COMP_SUP_SONG], [SID_RESTORATE,5,COMP_SUP_SONG] ];
      }

      return [ [SID_BLESS,6,COMP_SUP_ENCHANT], [SID_MAGIC_SHIELD,9,COMP_SUP_ENCHANT],
               [SID_ARMOR_OF_GORT,10,COMP_SUP_ENCHANT], [SID_INVIGORATE,5,COMP_SUP_SONG],
               [SID_RESTORATE,5,COMP_SUP_SONG], [SID_REJUVENATE,5,COMP_SUP_SONG] ];
   }

   GetColdTwin(sid = 0)
   "The cold spell a fire spell turns into, or $."
   {
      if sid = SID_FIREBALL
      {
         return SID_ICESHARD;
      }

      return $;
   }

   GetCasterNumbers(kind = 0,tier = 1,health = 50)
   "[ chance to cast in a fight (percent), spell power, maximum mana ]."
   {
      return [ 30 + 2 * tier, Bound(health * 2 / 3 + 3 * tier,10,99), 60 + health * 2 / 3 ];
   }

   GetNames(kind = 0,gender = GENDER_MALE)
   {
      if kind = COMPANION_PRINCESS
      {
         if gender = GENDER_MALE
         {
            return [comp_name_p_m1, comp_name_p_m2, comp_name_p_m3, comp_name_p_m4,
                    comp_name_p_m5, comp_name_p_m6];
         }

         return [comp_name_p_f1, comp_name_p_f2, comp_name_p_f3, comp_name_p_f4,
                 comp_name_p_f5, comp_name_p_f6];
      }

      if kind = COMPANION_REBEL
      {
         if gender = GENDER_MALE
         {
            return [comp_name_r_m1, comp_name_r_m2, comp_name_r_m3, comp_name_r_m4,
                    comp_name_r_m5, comp_name_r_m6];
         }

         return [comp_name_r_f1, comp_name_r_f2, comp_name_r_f3, comp_name_r_f4,
                 comp_name_r_f5, comp_name_r_f6];
      }

      if gender = GENDER_MALE
      {
         return [comp_name_d_m1, comp_name_d_m2, comp_name_d_m3, comp_name_d_m4,
                 comp_name_d_m5, comp_name_d_m6];
      }

      return [comp_name_d_f1, comp_name_d_f2, comp_name_d_f3, comp_name_d_f4,
              comp_name_d_f5, comp_name_d_f6];
   }

   GetDamage(kind = 0)
   "[ least, most ] damage, in thousandths of the owner's base health."
   {
      // A monster of the owner's level hits for about 8 per 100 levels (Monster.GetDamage)
      if kind = COMPANION_REBEL
      {
         // It only buffs: its blade does the work
         return [ 50, 110 ];
      }

      // Its spells add to it
      return [ 45, 100 ];
   }

   GetGear(kind = 0,tier = 1)
   "Its weapon and headgear at a bond tier (1-5), made and worn in turn. Its school's robe and "
   "its faction's herald shield come with every tier (Companion.SetTier)."
   {
      if kind = COMPANION_DUKE
      {
         if tier <= 1
         {
            return [ &Axe ];
         }

         if tier = 2
         {
            return [ &BerserkerAxe ];
         }

         if tier = 3
         {
            return [ &BerserkerAxe, &ThornCirclet ];
         }

         if tier = 4
         {
            return [ &NeruditeAxe, &ThornCirclet ];
         }

         return [ &NeruditeAxe, &QormasHelm ];
      }

      if kind = COMPANION_PRINCESS
      {
         if tier <= 1
         {
            return [ &Hammer ];
         }

         if tier = 2
         {
            return [ &Hammer, &Circlet ];
         }

         if tier = 3
         {
            return [ &Maul, &Circlet ];
         }

         if tier = 4
         {
            return [ &Maul, &Circlet, &Gauntlet ];
         }

         return [ &Maul, &Wizardhat, &Gauntlet ];
      }

      if tier <= 1
      {
         return [ &Scimitar ];
      }

      if tier = 2
      {
         return [ &Scimitar, &SimpleHelm ];
      }

      if tier = 3
      {
         return [ &Scimitar, &Helm ];
      }

      if tier = 4
      {
         return [ &Scimitar, &Helm, &Gauntlet ];
      }

      return [ &Scimitar, &DaemonHelm, &Gauntlet ];
   }

   GetHeraldColours(kind = 0)
   "[ colour 1, colour 2 ] of its faction's herald shield (GuildShield)."
   {
      if kind = COMPANION_PRINCESS
      {
         return [ XLAT_TO_BLUE, XLAT_TO_SKY ];
      }

      if kind = COMPANION_REBEL
      {
         return [ XLAT_TO_RED, XLAT_TO_GRAY ];
      }

      return [ XLAT_TO_PURPLE, XLAT_TO_GRAY ];
   }

   GetInsignia(kind = 0)
   "Its faction's insignia on its herald shield."
   {
      if kind = COMPANION_PRINCESS
      {
         return INSIG_PRINCESS;
      }

      if kind = COMPANION_REBEL
      {
         return INSIG_REBEL;
      }

      return INSIG_DUKE;
   }

   GetPalette(kind = 0)
   "The colours its clothes may be given (XLAT_TO_*); the first two are its own at first."
   {
      if kind = COMPANION_PRINCESS
      {
         return [ XLAT_TO_BLUE, XLAT_TO_SKY, XLAT_TO_YELLOW, XLAT_TO_GRAY, XLAT_TO_PURPLE ];
      }

      if kind = COMPANION_REBEL
      {
         return [ XLAT_TO_RED, XLAT_TO_BLACK, XLAT_TO_DGREEN, XLAT_TO_ORANGE, XLAT_TO_GRAY ];
      }

      return [ XLAT_TO_PURPLE, XLAT_TO_BLUE, XLAT_TO_BLACK, XLAT_TO_GRAY, XLAT_TO_SKY ];
   }

   TierFloor(tier = 1)
   "Bond points a tier starts at."
   {
      if tier <= 1
      {
         return 0;
      }

      if tier = 2
      {
         return 300;
      }

      if tier = 3
      {
         return 1000;
      }

      if tier = 4
      {
         return 2500;
      }

      return 5000;
   }

   TierOf(points = 0)
   {
      local i;

      i = 5;
      while i > 1
      {
         if points >= Send(self,@TierFloor,#tier=i)
         {
            return i;
         }

         --i;
      }

      return 1;
   }

   BondBonus(tier = 1)
   "Percent more health and damage a bond tier gives."
   {
      if tier <= 1
      {
         return 0;
      }

      if tier = 2
      {
         return 3;
      }

      if tier = 3
      {
         return 7;
      }

      if tier = 4
      {
         return 11;
      }

      return 15;
   }

end
////////////////////////////////////////////////////////////////////////////////
