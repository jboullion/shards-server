classvars:

properties:

messages:

   KindForLeader(npc = $)
   "The kind of companion this NPC gives, or 0."
   {
      if npc = $
      {
         return 0;
      }

      if IsClass(npc,&DukeLiege)
      {
         return COMPANION_DUKE;
      }

      if IsClass(npc,&PrincessLiege)
      {
         return COMPANION_PRINCESS;
      }

      if IsClass(npc,&RebelLiege)
      {
         return COMPANION_REBEL;
      }

      if IsClass(npc,&KraananPriestess)
      {
         return COMPANION_KRAANAN;
      }

      if IsClass(npc,&ShalillePriestess)
      {
         return COMPANION_SHALILLE;
      }

      if IsClass(npc,&QorPriestess)
      {
         return COMPANION_QOR;
      }

      if IsClass(npc,&FarenPriestess)
      {
         return COMPANION_FAREN;
      }

      return 0;
   }

   GetLeaderClass(kind = 0)
   {
      if kind = COMPANION_DUKE
      {
         return &DukeLiege;
      }

      if kind = COMPANION_PRINCESS
      {
         return &PrincessLiege;
      }

      if kind = COMPANION_REBEL
      {
         return &RebelLiege;
      }

      if kind = COMPANION_KRAANAN
      {
         return &KraananPriestess;
      }

      if kind = COMPANION_SHALILLE
      {
         return &ShalillePriestess;
      }

      if kind = COMPANION_QOR
      {
         return &QorPriestess;
      }

      if kind = COMPANION_FAREN
      {
         return &FarenPriestess;
      }

      return $;
   }

   GetHallRoom(kind = 0)
   "Where its leader is: the room it waits and recovers in."
   {
      if kind = COMPANION_DUKE
      {
         return RID_DUKE3;
      }

      if kind = COMPANION_PRINCESS
      {
         return RID_CASTLE2C;
      }

      if kind = COMPANION_REBEL
      {
         return RID_JAS_BAR;
      }

      if kind = COMPANION_KRAANAN
      {
         return RID_TEMPLE_KRAANAN;
      }

      if kind = COMPANION_SHALILLE
      {
         return RID_TEMPLE_SHALILLE;
      }

      if kind = COMPANION_QOR
      {
         return RID_TEMPLE_QOR;
      }

      if kind = COMPANION_FAREN
      {
         // Faren's priestess stands in the badlands (badland1.kod)
         return RID_BADLAND1;
      }

      return $;
   }

   GetKindFaction(kind = 0)
   "The faction a leader gives its companions to the members of, or $ for a school's."
   {
      if kind = COMPANION_DUKE
      {
         return FACTION_DUKE;
      }

      if kind = COMPANION_PRINCESS
      {
         return FACTION_PRINCESS;
      }

      if kind = COMPANION_REBEL
      {
         return FACTION_REBEL;
      }

      return $;
   }

   GetKindName(kind = 0)
   {
      if kind = COMPANION_DUKE
      {
         return companion_kind_duke;
      }

      if kind = COMPANION_PRINCESS
      {
         return companion_kind_princess;
      }

      if kind = COMPANION_REBEL
      {
         return companion_kind_rebel;
      }

      if kind = COMPANION_SHALILLE
      {
         return companion_kind_shalille;
      }

      if kind = COMPANION_QOR
      {
         return companion_kind_qor;
      }

      if kind = COMPANION_FAREN
      {
         return companion_kind_faren;
      }

      return companion_kind_kraanan;
   }

   GetSchool(kind = 0)
   "A school head's companions' school (SS_*), or 0 for a faction's."
   {
      if kind = COMPANION_KRAANAN
      {
         return SS_KRAANAN;
      }

      if kind = COMPANION_SHALILLE
      {
         return SS_SHALILLE;
      }

      if kind = COMPANION_QOR
      {
         return SS_QOR;
      }

      if kind = COMPANION_FAREN
      {
         return SS_FAREN;
      }

      return 0;
   }

   IsCaster(kind = 0)
   "Whether it fights with spells (and wears robes, not armour)."
   {
      return kind = COMPANION_SHALILLE OR kind = COMPANION_QOR OR kind = COMPANION_FAREN;
   }

   GetDiscipleQuest(kind = 0)
   "The school's disciple quest (QuestBook ids), which its head asks for; 0 for a faction's."
   {
      if kind = COMPANION_KRAANAN
      {
         return COMPANION_KRAANAN_QUEST;
      }

      if kind = COMPANION_SHALILLE
      {
         return COMPANION_SHALILLE_QUEST;
      }

      if kind = COMPANION_QOR
      {
         return COMPANION_QOR_QUEST;
      }

      if kind = COMPANION_FAREN
      {
         return COMPANION_FAREN_QUEST;
      }

      return 0;
   }

   GetOldDisciple(kind = 0)
   "The old QuestEngine's disciple quest (QST_ID_*), which counts too (HasDoneReplacing)."
   {
      if kind = COMPANION_KRAANAN
      {
         return QST_ID_KRAANAN_DISCIPLE;
      }

      if kind = COMPANION_SHALILLE
      {
         return QST_ID_SHALILLE_DISCIPLE;
      }

      if kind = COMPANION_QOR
      {
         return QST_ID_QOR_DISCIPLE;
      }

      if kind = COMPANION_FAREN
      {
         return QST_ID_FAREN_DISCIPLE;
      }

      return $;
   }

   GetSpellBook(kind = 0,tier = 1)
   "A caster's attack spells at a bond tier, as Monster.plSpellBook has them: [ spell, mana, "
   "cumulative chance ]. Damage only: no holds, blinds or spells that hit a whole area."
   {
      if kind = COMPANION_QOR
      {
         if tier <= 1
         {
            return [ [SID_POISON,4,100] ];
         }

         if tier = 2
         {
            return [ [SID_POISON,4,40], [SID_VAMPIRIC_DRAIN,6,100] ];
         }

         if tier = 3
         {
            return [ [SID_VAMPIRIC_DRAIN,6,60], [SID_SPLASH_OF_ACID,8,100] ];
         }

         if tier = 4
         {
            return [ [SID_VAMPIRIC_DRAIN,6,45], [SID_SPLASH_OF_ACID,8,100] ];
         }

         return [ [SID_VAMPIRIC_DRAIN,6,30], [SID_SPLASH_OF_ACID,8,100] ];
      }

      if kind = COMPANION_FAREN
      {
         if tier <= 1
         {
            return [ [SID_SHOCKING_FURY,4,100] ];
         }

         if tier = 2
         {
            return [ [SID_SHOCKING_FURY,4,50], [SID_FIREBALL,6,100] ];
         }

         if tier = 3
         {
            return [ [SID_SHOCKING_FURY,4,30], [SID_FIREBALL,6,65], [SID_ICESHARD,6,100] ];
         }

         if tier = 4
         {
            return [ [SID_FIREBALL,6,35], [SID_ICESHARD,6,70], [SID_LIGHTNING_BOLT,8,100] ];
         }

         return [ [SID_FIREBALL,6,25], [SID_ICESHARD,6,50], [SID_LIGHTNING_BOLT,8,80],
                  [SID_BLAST_OF_FIRE,8,100] ];
      }

      if kind = COMPANION_SHALILLE AND tier >= 3
      {
         // Only when nobody needs healing (Companion.SupportTimer comes first)
         return [ [SID_HOLY_BLAZE,8,100] ];
      }

      return $;
   }

   GetHeals(kind = 0,tier = 1)
   "A healer's heals at a bond tier: [ small heal, big heal or $ ], each [ spell, mana ]."
   {
      if kind <> COMPANION_SHALILLE
      {
         return $;
      }

      if tier <= 2
      {
         return [ [SID_MINOR_HEAL,4], $ ];
      }

      return [ [SID_MINOR_HEAL,4], [SID_MAJOR_HEAL,10] ];
   }

   GetCasterNumbers(kind = 0,tier = 1,health = 50)
   "[ chance to cast in a fight (percent), spell power, maximum mana ] for a caster."
   {
      local iChance;

      iChance = 45;
      if kind = COMPANION_SHALILLE
      {
         // It saves its mana for healing
         iChance = 25;
      }

      return [ iChance + 5 * tier, Bound(40 + 12 * tier,1,99), 40 + health / 2 ];
   }

   GetNames(kind = 0,gender = GENDER_MALE)
   {
      if kind = COMPANION_DUKE
      {
         if gender = GENDER_MALE
         {
            return [comp_name_d_m1, comp_name_d_m2, comp_name_d_m3, comp_name_d_m4,
                    comp_name_d_m5, comp_name_d_m6];
         }

         return [comp_name_d_f1, comp_name_d_f2, comp_name_d_f3, comp_name_d_f4,
                 comp_name_d_f5, comp_name_d_f6];
      }

      if kind = COMPANION_PRINCESS
      {
         if gender = GENDER_MALE
         {
            return [comp_name_p_m1, comp_name_p_m2, comp_name_p_m3, comp_name_p_m4,
                    comp_name_p_m5, comp_name_p_m6];
         }

         return [comp_name_p_f1, comp_name_p_f2, comp_name_p_f3, comp_name_p_f4,
                 comp_name_p_f5, comp_name_p_f6];
      }

      if kind = COMPANION_REBEL
      {
         if gender = GENDER_MALE
         {
            return [comp_name_r_m1, comp_name_r_m2, comp_name_r_m3, comp_name_r_m4,
                    comp_name_r_m5, comp_name_r_m6];
         }

         return [comp_name_r_f1, comp_name_r_f2, comp_name_r_f3, comp_name_r_f4,
                 comp_name_r_f5, comp_name_r_f6];
      }

      if kind = COMPANION_SHALILLE
      {
         if gender = GENDER_MALE
         {
            return [comp_name_s_m1, comp_name_s_m2, comp_name_s_m3, comp_name_s_m4,
                    comp_name_s_m5, comp_name_s_m6];
         }

         return [comp_name_s_f1, comp_name_s_f2, comp_name_s_f3, comp_name_s_f4,
                 comp_name_s_f5, comp_name_s_f6];
      }

      if kind = COMPANION_QOR
      {
         if gender = GENDER_MALE
         {
            return [comp_name_q_m1, comp_name_q_m2, comp_name_q_m3, comp_name_q_m4,
                    comp_name_q_m5, comp_name_q_m6];
         }

         return [comp_name_q_f1, comp_name_q_f2, comp_name_q_f3, comp_name_q_f4,
                 comp_name_q_f5, comp_name_q_f6];
      }

      if kind = COMPANION_FAREN
      {
         if gender = GENDER_MALE
         {
            return [comp_name_f_m1, comp_name_f_m2, comp_name_f_m3, comp_name_f_m4,
                    comp_name_f_m5, comp_name_f_m6];
         }

         return [comp_name_f_f1, comp_name_f_f2, comp_name_f_f3, comp_name_f_f4,
                 comp_name_f_f5, comp_name_f_f6];
      }

      if gender = GENDER_MALE
      {
         return [comp_name_k_m1, comp_name_k_m2, comp_name_k_m3, comp_name_k_m4,
                 comp_name_k_m5, comp_name_k_m6];
      }

      return [comp_name_k_f1, comp_name_k_f2, comp_name_k_f3, comp_name_k_f4,
              comp_name_k_f5, comp_name_k_f6];
   }

   GetDamage(kind = 0)
   "[ least, most ] damage, in thousandths of the owner's base health."
   {
      // A monster of the owner's level hits for about 8 per 100 levels (Monster.GetDamage)
      if kind = COMPANION_REBEL
      {
         // Quick and light
         return [ 45, 95 ];
      }

      if kind = COMPANION_KRAANAN
      {
         // Heavy blows
         return [ 55, 125 ];
      }

      if Send(self,@IsCaster,#kind=kind)
      {
         // A wand's knock: its spells do the work
         return [ 25, 55 ];
      }

      return [ 50, 110 ];
   }

   GetGear(kind = 0,tier = 1)
   "The gear it wears at a bond tier (1-5): item classes, made and worn in turn. A caster's "
   "robe and wands are made for its school (Companion.SetTier passes #school and #color)."
   {
      if Send(self,@IsCaster,#kind=kind)
      {
         if tier <= 1
         {
            return [ &ApprenticeWand, &Robe ];
         }

         if tier = 2
         {
            return [ &ApprenticeWand, &DiscipleRobe ];
         }

         if tier = 3
         {
            return [ &ApprenticeWand, &DiscipleRobe, &Circlet ];
         }

         if tier = 4
         {
            return [ &MasterWand, &DiscipleRobe, &Circlet ];
         }

         if kind = COMPANION_QOR
         {
            return [ &MasterWand, &DiscipleRobe, &QormasHelm ];
         }

         // (The Ivy Circlet asks its wearer for Shal'ille spells, which a monster hasn't)
         return [ &MasterWand, &DiscipleRobe, &Circlet ];
      }

      if kind = COMPANION_DUKE OR kind = COMPANION_PRINCESS
      {
         if tier <= 1
         {
            return [ &ShortSword, &LeatherArmor ];
         }

         if tier = 2
         {
            return [ &LongSword, &ChainArmor ];
         }

         if tier = 3
         {
            return [ &LongSword, &ScaleArmor, &SimpleHelm ];
         }

         if tier = 4
         {
            return [ &MysticSword, &PlateArmor, &Helm, &Gauntlet ];
         }

         return [ &NeruditeSword, &PlateArmor, &KnightsHelm, &Gauntlet ];
      }

      if kind = COMPANION_REBEL
      {
         if tier <= 1
         {
            return [ &ShortSword, &LeatherArmor ];
         }

         if tier = 2
         {
            return [ &Scimitar, &LeatherArmor ];
         }

         if tier = 3
         {
            return [ &Scimitar, &ChainArmor, &SimpleHelm ];
         }

         if tier = 4
         {
            return [ &MysticSword, &ScaleArmor, &Helm, &Gauntlet ];
         }

         return [ &NeruditeSword, &ScaleArmor, &KnightsHelm, &Gauntlet ];
      }

      // Kraanan: maces and hammers
      if tier <= 1
      {
         return [ &Mace, &LeatherArmor, &MetalShield ];
      }

      if tier = 2
      {
         return [ &Hammer, &ChainArmor, &MetalShield ];
      }

      if tier = 3
      {
         return [ &Hammer, &ScaleArmor, &SimpleHelm, &MetalShield ];
      }

      if tier = 4
      {
         return [ &Hammer, &PlateArmor, &Helm, &Gauntlet, &Knightshield ];
      }

      return [ &Hammer, &PlateArmor, &DaemonHelm, &Gauntlet, &Knightshield ];
   }

   GetShield(kind = 0)
   "The soldier's shield of a faction's companions (worn at every tier), or $."
   {
      if kind = COMPANION_DUKE
      {
         return &DukeShield;
      }

      if kind = COMPANION_PRINCESS
      {
         return &PrincessShield;
      }

      return $;
   }

   GetPalette(kind = 0)
   "The colours its clothes may be given (XLAT_TO_*); the first two are its own at first."
   {
      if kind = COMPANION_DUKE
      {
         return [ XLAT_TO_PURPLE, XLAT_TO_BLUE, XLAT_TO_BLACK, XLAT_TO_GRAY, XLAT_TO_SKY ];
      }

      if kind = COMPANION_PRINCESS
      {
         return [ XLAT_TO_BLUE, XLAT_TO_SKY, XLAT_TO_YELLOW, XLAT_TO_GRAY, XLAT_TO_PURPLE ];
      }

      if kind = COMPANION_REBEL
      {
         return [ XLAT_TO_RED, XLAT_TO_BLACK, XLAT_TO_DGREEN, XLAT_TO_ORANGE, XLAT_TO_GRAY ];
      }

      if kind = COMPANION_SHALILLE
      {
         return [ XLAT_TO_SKY, XLAT_TO_GRAY, XLAT_TO_YELLOW, XLAT_TO_BLUE, XLAT_TO_GREEN ];
      }

      if kind = COMPANION_QOR
      {
         return [ XLAT_TO_BLACK, XLAT_TO_PURPLE, XLAT_TO_RED, XLAT_TO_DGREEN, XLAT_TO_GRAY ];
      }

      if kind = COMPANION_FAREN
      {
         return [ XLAT_TO_RED, XLAT_TO_ORANGE, XLAT_TO_BLUE, XLAT_TO_YELLOW, XLAT_TO_DGREEN ];
      }

      return [ XLAT_TO_ORANGE, XLAT_TO_BLACK, XLAT_TO_RED, XLAT_TO_YELLOW, XLAT_TO_GRAY ];
   }

   TierFloor(tier = 1)
   "Bond points a tier starts at."
   {
      if tier <= 1
      {
         return 0;
      }

      if tier = 2
      {
         return 300;
      }

      if tier = 3
      {
         return 1000;
      }

      if tier = 4
      {
         return 2500;
      }

      return 5000;
   }

   TierOf(points = 0)
   {
      local i;

      i = 5;
      while i > 1
      {
         if points >= Send(self,@TierFloor,#tier=i)
         {
            return i;
         }

         --i;
      }

      return 1;
   }

   BondBonus(tier = 1)
   "Percent more health and damage a bond tier gives."
   {
      if tier <= 1
      {
         return 0;
      }

      if tier = 2
      {
         return 3;
      }

      if tier = 3
      {
         return 7;
      }

      if tier = 4
      {
         return 11;
      }

      return 15;
   }

end
////////////////////////////////////////////////////////////////////////////////
