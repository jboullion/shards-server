// Ours (Meridian Shards, docs/adr/0010-followers.md): the kinds of companion, one per leader who
// gives them, and the numbers they grow by. CompanionBook (util/companionbook.kod) inherits
// these tables, as QuestBook inherits QuestDefs.
//
// Kinds 1-4 fight; 5-7 cast (Shal'ille's healer, Qor's dark caster, Faren's mage: spell books
// of damage spells, and the healer's heals, Companion.SupportTimer). 8-9 are kept for Riija and
// Jala, later.

////////////////////////////////////////////////////////////////////////////////
CompanionKinds is UtilityFunctions

constants:

   include blakston.khd

   // The kinds and their numbers are in blakston.khd (COMPANION_*), for every file

resources:

   companion_kind_duke = "Duke soldier"
   companion_kind_princess = "Princess knight"
   companion_kind_rebel = "rebel fencer"
   companion_kind_kraanan = "warrior-priest of Kraanan"
   companion_kind_shalille = "healer of Shal'ille"
