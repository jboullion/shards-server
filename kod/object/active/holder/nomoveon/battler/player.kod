   GetPartDyeCode(part = DYE_PART_BODY)
   "Ours (docs/adr/0012-cosmetics.md): ANIMATE_DYE's WORD for a body part, with our skin, "
   "or 0 when what draws it isn't dyed."
   {
      local iDye;

      iDye = piDyeBody;
      if part = DYE_PART_ARMS
      {
         iDye = piDyeArms;
      }
      else if part = DYE_PART_LEGS
      {
         iDye = piDyeLegs;
      }

      if iDye = 0
      {
         return 0;
      }

      return Send(SYS,@EncodeDye,#main=iDye & DYE_FIELD_MASK,
                  #trim=(iDye / DYE_TRIM_MUL) & DYE_FIELD_MASK,
                  #skin=Send(self,@ConvertSkinColorToXLAT,#skin_color=Send(self,@GetSkinColor)));
   }

   AddPartColour(part = DYE_PART_BODY)
   "Ours: a body part's colour before its animation: the dye of what draws it (ANIMATE_DYE), "
   "else its translation byte as before."
   {
      local iCode, iXlat;

      iCode = Send(self,@GetPartDyeCode,#part=part);
      if iCode <> 0
      {
         AddPacket(1,ANIMATE_DYE, 2,iCode);

         return;
      }

      iXlat = Send(self,@GetBodyTranslation);
      if part = DYE_PART_ARMS
      {
         iXlat = Send(self,@GetArmsTranslation);
      }
      else if part = DYE_PART_LEGS
      {
         iXlat = Send(self,@GetLegsTranslation);
      }

      if iXlat <> 0
      {
         AddPacket(1,ANIMATE_TRANSLATION, 1,iXlat);
      }

      return;
   }

   GetLegsTranslation()
   {
      // This returns the whole translation, including skin color.
      return (piBody_translations & PLAYER_TRANSLATION_LEGS_MASK)
