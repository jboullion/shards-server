   // hours of online time.
   ptReward_timer = $

   // Flags for various character attributes.
   piFlags = 0
   piFlags2 = 0
   piFlags3 = 0

   // Set of flags with player preferences.
   piPreferences = CF_DEFAULT_PREF

   // player starts unguilded--doesn't do much yet
