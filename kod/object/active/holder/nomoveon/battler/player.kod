            #where=Send(SYS,@FindRoomByNum,#num=piBound_room),
            #new_row=piBound_row,#new_col=piBound_col,
            #fine_row=piBound_fine_row,#fine_col=piBound_fine_col,
            #new_angle=piBound_angle, #max_distance=3);

      return;
   }

