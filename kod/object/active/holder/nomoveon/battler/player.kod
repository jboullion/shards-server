   CanChooseStart()
   "Ours: whether this character may still skip the tutorial for a starting city: made within the "
   "hour (CHOOSE_START_SECONDS), not chosen yet, and still at its first health."
   {
      return piCreatedAt > 0 AND NOT pbStartChosen
         AND GetTime() - piCreatedAt < CHOOSE_START_SECONDS
         AND piBase_max_health <= 20;
   }

   SetStartChosen()
   {
      pbStartChosen = TRUE;

      return;
   }

   GetMaxHealth()
   {
      return piMax_health;
   }

   GetBaseMaxHealth()
   {
      local iStamina;

      iStamina = Send(self,@GetStamina);

      // Bound twice - once for max HP this player can get, once for
      // max HP allowable by the game.
      return Bound(Bound(piBase_max_health,MIN_HP,100 + iStamina),MIN_HP,MAX_HP);
   }

   GetUncappedBaseMaxHealth()
   {
      return piBase_max_health;
   }

   GetLevel()
   {
      return Send(self,@GetBaseMaxHealth);
   }

   GetKillTarget()
   {
      return poKill_target;
