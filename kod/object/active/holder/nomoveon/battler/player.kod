   StopDancing()
   {
	  if Send(self,@IsAffectedByRadiusEnchantment,#byClass=&Jig)
	  {
		  return;
	  }
	  
      Send(self,@MsgSendUser,#message_rsc=player_stop_dance);
      Send(self,@SetPlayerFlag,#flag=PFLAG2_DANCING,#value=FALSE,#flagset=2);
