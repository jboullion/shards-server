////////////////////////////////////////////////////////////////////////////////
BarloqueClerk is BarloqueTown

constants:

   include blakston.khd
   include protocol.khd

resources:

   include bqclerk.lkod

   bq_clerk_name_rsc = "Caramo"
   bq_clerk_icon_rsc = bqclerk.bgf
   bq_clerk_desc_rsc = \
      "Not your typical Royal bureaucrat.  She's attractive, charming, and "
      "by all accounts, honorable.  Caramo has spent years counting the "
      "Duke's money, filing the former Queen's taxation scrolls, and more "
      "recently, serving as clerk for the Office of the Justicar."

   // Ours (docs/adr/0026-the-office-of-the-justicar.md): the Office of the Justicar once
   // pardoned murderers and outlaws. With random PvP gone (2026-10-21), Caramo:
   //   - changes names, through our client's window (UC_ITEM_SERVICE kind 3 and the `rename`
   //     command: util/itemservicebook.kod), with no deed-poll scroll any more;
   //   - records each change in the Book of Jala;
   //   - posts the court's bounties (quests 339-346);
   //   - is clerk of the Barloque Assizes (util/courtassizes.kod).

   bq_clerk_same_name = "That is already your name."
   bq_clerk_bad_name = \
      "I can't record that name.  It may be taken, or too long or short, or simply not fit for "
      "the Book of Jala."
   bq_clerk_not_enough = \
      "The fee is %i shillings, from your purse or from your bank account, and you don't "
      "have it."
   bq_clerk_name_changed = \
      "~kCaramo dips her quill and writes in the Book of Jala.~n  It is done.  From this day "
      "you are %s."

   bq_clerk_name_post_1 = "'s name has been changed"
   bq_clerk_name_post_2 = "Let it be known that "
   bq_clerk_name_post_3 = " has changed their name before the Office of the Justicar, to "
   bq_clerk_name_post_4 = \
      ". So it has been spoken, so shall it be done. \n\n-- Caramo"

classvars:

   vrName = bq_clerk_name_rsc
   vrIcon = bq_clerk_icon_rsc
   vrDesc = bq_clerk_desc_rsc

   // FULL_TALK: the gallery hears her as clerk of the Assizes
   viAttributes = MOB_NOFIGHT | MOB_NOMOVE | MOB_LAWFUL | MOB_FULL_TALK
   viGender = GENDER_FEMALE

properties:

   piAnimation = ANIM_NONE

messages:

   Recreate()
   {
      return;
   }

   Constructor()
   {
      Send(SYS,@SetCaramo,#oCaramo=self);

      propagate;
   }

   GetShardsService()
   "Ours: our client's name-change window opens when she's talked to "
   "(ItemServiceBook.ServiceActivated, SendRenameMenu). With bounties for them too, the "
   "quest window comes first, with a button for it."
   {
      return SERVICE_NAMECHANGE;
   }

#region Name Change

   ChangeName(who = $,sName = $)
   "The window's Confirm (`rename <name>`). The name is checked first, so a refused one costs "
   "nothing. Then the fee, from the purse or else the player's bank account (every banker "
   "in the world uses the one bank, BID_TOS, so it's the same account wherever they bank). "
   "Then the Book of Jala, and "
   "System renames them; blakserv sends every client the new name (BP_CHANGE_RESOURCE)."
   {
      local iFee, oMoney, oBank, sOld;

      if who = $ OR sName = $
      {
         return;
      }

      if StringEqual(sName,Send(who,@GetTrueName))
      {
         Send(self,@SayToOne,#target=who,#message_rsc=bq_clerk_same_name);

         return;
      }

      if NOT Send(SYS,@ValidateUserName,#oUser=who,#sName=sName)
      {
         Send(self,@SayToOne,#target=who,#message_rsc=bq_clerk_bad_name);

         return;
      }

      iFee = Send(SETTINGS_OBJECT,@GetNameChangeCost);
      oMoney = Send(who,@GetMoneyObject,#type=&Shillings);
      oBank = Send(SYS,@FindBankByNum,#num=BID_TOS);
      if oMoney <> $ AND Send(oMoney,@GetNumber) >= iFee
      {
         Send(oMoney,@SubtractNumber,#number=iFee);
      }
      else if oBank <> $ AND Send(oBank,@GetAccount,#what=who) >= iFee
      {
         Send(oBank,@WithdrawAccount,#what=who,#amount=iFee);
      }
      else
      {
         Send(self,@SayToOne,#target=who,#message_rsc=bq_clerk_not_enough,#parm1=iFee);

         return;
      }

      sOld = SetString($,Send(who,@GetTrueName));
      Send(self,@RecordNameChangeBook,#parm1=sOld,#parm2=sName);
      Send(SYS,@ChangeUserName,#oUser=who,#sName=sName);
      Send(self,@SayToOne,#target=who,#message_rsc=bq_clerk_name_changed,
           #parm1=Send(who,@GetTrueName));

      return;
   }

   RecordNameChangeBook(parm1=$, parm2=$)
   "parm1=oldname,parm2=newname"
   {
      local sString, sString2, oBook;

      ClearTempString();
      AppendTempString(parm1);
      AppendTempString(bq_clerk_name_post_1);
      sString = SetString($,GetTempString());

      ClearTempString();
      AppendTempString(bq_clerk_name_post_2);
      AppendTempString(parm1);
      AppendTempString(bq_clerk_name_post_3);
      AppendTempString(parm2);
      AppendTempString(bq_clerk_name_post_4);
      sString2 = SetString($,GetTempString());

      if poOwner = $
      {
         return;
      }

      oBook = Send(poOwner,@GetBook);
      if oBook <> $
      {
         Send(oBook,@PostNews,#what=self,#title=sString,#body=sString2);
      }

      return;
   }

#endregion Name Change

   ResetBrain()
   {
      poBrain = Send(SYS,@FindBrainByNum,#num=viBrain_type);

      return;
   }

   Delete()
   {
      Send(SYS,@DeleteCaramo);

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
