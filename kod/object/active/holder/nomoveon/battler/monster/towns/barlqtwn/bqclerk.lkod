// Name Change

bq_clerk_trigger_change = de "ändern"
bq_clerk_trigger_name = de "Name"
bq_clerk_change_name = de \
   "Ja, ich kann Deinen Namen mittels Urkunde ändern. Schreibe einfach Deinen "
   "Namen auf diese Schriftrolle, und gebe Sie mir zurück.  Wenn der Name "
   "verfügbar ist und nicht obszön, wird er Deiner sein.\nIch muss Dich "
   "allerdings warnen, denn es kostet Dich eine Gebühr von %i Schillingen "
   "um diesen Service zu beanspruchen.\n\n "
   "Dieser Betrag wird von Deinem Bankkonto abgezogen."
bq_clerk_cant_hold = de \
   "Ich kann Deinen Namen mit einer Urkunde ändern, aber Du hast keinen Platz "
   "mehr in Deinem Inventar um diese Urkunde aufzunehmen."
bq_clerk_warning_cost = de \
   "~BIch warne Dich noch einmal bevor ich den Prozess beende, dass "
   "Dir %i Schillinge "
   "für diesen Service berechnet werden. Wenn Du sicher bist, nehme ich die "
   "Urkunde an mich "
   "und fahre fort."
bq_clerk_not_enough = de \
   "Du hast nicht genug Geld auf deinem Bankkonto um diesen Service "
   "zu benutzen."
bq_clerk_bad_name = de "Sorry, der Name ist nicht gültig."
bq_clerk_name_changed = de "Dein Name wurde geändert."
bq_clerk_name_post_1 = de "s Name wurde geändert"
bq_clerk_name_post_2 = de "So sei bekannt zu machen, dass "
bq_clerk_name_post_3 = de "'s Name per Urkunde geändert wurde, und heißt nun "
bq_clerk_name_post_4 = de \
   ". So wie es gesprochen wurde, wurde es getan. \n\n-- Caramo"

bq_clerk_name_rsc = pt "Caramo"
bq_clerk_desc_rsc = pt "Não é a sua típica burocrata real. Ela é atraente, charmosa e, segundo todos os relatos, honrada. Caramo passou anos contando o dinheiro do Duque, arquivando os rolos de tributação da ex-rainha e, mais recentemente, atuando como escrevente do Escritório do Justicar."
bq_clerk_trigger_change = pt "mudar"
bq_clerk_trigger_name = pt "nome"
bq_clerk_change_name = pt "Sim, posso mudar o teu nome legal por escritura pública. Simplesmente preenche o teu novo nome neste pergaminho e devolve-o. Se estiver disponível e não for obsceno, será teu. Devo avisar que há uma taxa de %i xelins por este serviço, que será deduzida da tua conta bancária."
bq_clerk_cant_hold = pt "Posso mudar o teu nome legal por escritura pública, mas não tens espaço no teu inventário para segurar o pergaminho que precisarias de preencher."
bq_clerk_warning_cost = pt "~BDevo avisar-te novamente antes de completar este processo, que te será cobrado %i xelins por este serviço. Se estiveres positivo que queres pagar a taxa, aceitarei o teu pergaminho."
bq_clerk_not_enough = pt "Não tens dinheiro suficiente na tua conta bancária para este serviço."
bq_clerk_bad_name = pt "Desculpa, esse nome de usuário não é válido."
bq_clerk_name_changed = pt "O teu nome foi mudado."
bq_clerk_name_post_1 = pt " teve seu nome mudado"
bq_clerk_name_post_2 = pt "Que seja conhecido que "
bq_clerk_name_post_3 = pt " teve seu nome mudado por escritura pública para "
bq_clerk_name_post_4 = pt ". Assim foi dito, assim será feito. \n\n-- Caramo"
