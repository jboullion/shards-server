bq_clerk_name_rsc = de "Caramo"
bq_clerk_desc_rsc = de \
   "Nicht gerade das, was Du Dir unter einer typischen königlichen Bürokratin "
   "vorstellst. Sie ist attraktiv, charmant und nach allem, was man hört, "
   "ehrenhaft. Caramo hat Jahre damit verbracht, das Geld des Herzogs zu "
   "zählen, die Steuerunterlagen der früheren Königin zu ordnen und seit "
   "kurzem als Schreiberin im Büro des Justiziars zu dienen."

bq_clerk_name_rsc = pt "Caramo"
bq_clerk_desc_rsc = pt "Não é a sua típica burocrata real. Ela é atraente, charmosa e, segundo todos os relatos, honrada. Caramo passou anos contando o dinheiro do Duque, arquivando os rolos de tributação da ex-rainha e, mais recentemente, atuando como escrevente do Escritório do Justicar."
