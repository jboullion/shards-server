////////////////////////////////////////////////////////////////////////////////
JalaPriestess is Temples

constants:

   include blakston.khd

resources:

   include jalaprst.lkod

   jalapriestess_name_rsc = "Priestess Themala"
   jalapriestess_icon_rsc = jalaprst.bgf
   jalapriestess_desc_rsc = \
      "With long, wavy blonde hair framing her gentle face, the priestess of "
      "song greets you with a thoughtful gaze and a warm smile.  Clad in robes "
      "of fine silk dyed in the vibrant colors of her order, Themala’s elegant "
      "appearance belies the dedication and effort behind her role.  "
      "Born to noble parents and trained in music, art, and courtly ways from "
      "childhood, Themala chose to earn her place through courage and "
      "perseverance.  She joined the city guard at fifteen, aspiring to become "
      "a royal bard in King Aaron's court.  Her gift for inspiring allies "
      "with stirring songs soon reached the king, who recognized her talent "
      "and appointed her priestess, that she might teach others the secrets "
      "of the lute."

   jalapriestess_already_have_spell = "You already know the %s spell."

   jalapriestess_teach_quest_needed = \
      "Ah, fellow seeker of melody and story!  Every bard's journey is "
      "unique.  When your spirit is ready to learn, my guidance will "
      "await you.  Until then, may inspiration guide your steps!"

   jalapriestess_not_a_bard = \
      "Invigorate is a song for those who already know the bard's craft.  "
      "Learn another of our songs first."

   jalapriestess_forget_potion_sale = \
      "I offer %s%s, a potent draught. Drink it, and all rogue skills "
      "will fade from memory."

classvars:

   vrName = jalapriestess_name_rsc
   vrIcon = jalapriestess_icon_rsc
   vrDesc = jalapriestess_desc_rsc
   viKarma = 0
   viAttributes = \
      MOB_NOFIGHT | MOB_LISTEN | MOB_RANDOM | \
      MOB_RECEIVE | MOB_TEACHER | MOB_COND_SELLER
   viOccupation = MOB_ROLE_PRIESTESS

   // Ours: Truth, Mirth and Melancholy wait on the Pupil of Truth quest, as
   //  they do at the Minstrel.
   viQuestID = QST_ID_TRUTH_SPELL

messages:

   IsExpansionNPC()
   {
      return TRUE;
   }

   SetForSale()
   "Ours: she teaches every Jala song (she taught nothing)."
   {
      plFor_Sale = [
         $,$,
         [
            SID_INVIGORATE,
            SID_MIRTH,
            SID_MELANCHOLY,
            SID_WARP_TIME,
            SID_CIVILITY,
            SID_CONCILIATION,
            SID_DISTILL,
            SID_RESTORATE,
            SID_SACRED_RESONANCE,
            SID_PROFANE_RESONANCE,
            SID_TRUTH,
            SID_JIG,
            SID_DISHARMONY,
            SID_MANA_CONVERGENCE,
            SID_REJUVENATE,
            SID_CRYSTALIZE_MANA,
            SID_SPELLBANE
         ],
      $];

      return;
   }

   CanDoTeach(who=$,sid=0,bSkill=FALSE)
   {
      if NOT bSkill
         AND NOT Send(self,@CanAddSpell,#who=who,#num=sid,#report=TRUE)
      {
         return FALSE;
      }

      propagate;
   }

   CanAddSpell(who=$,num=0,report=FALSE)
   "The same gates as the other Jala teachers: the Pupil of Truth quest for "
   "Truth, Mirth and Melancholy (the Minstrel), and another Jala song first "
   "for Invigorate (D'Franco)."
   {
      local i, oSpell, bFound;

      if (num = SID_TRUTH
            OR num = SID_MIRTH
            OR num = SID_MELANCHOLY)
         AND NOT Send(self,@HasDoneLearnQuest,#who=who)
      {
         if report
         {
            Post(self,@SayToOne,#target=who,
                 #message_rsc=jalapriestess_teach_quest_needed);
         }

         return FALSE;
      }

      if num = SID_INVIGORATE
      {
         bFound = FALSE;
         foreach i in Send(who,@GetSpellList)
         {
            oSpell = Send(SYS,@FindSpellByNum,
                          #num=Send(who,@DecodeSpellNum,#compound=i));
            if oSpell <> $
               AND Send(oSpell,@GetSchool) = SS_JALA
            {
               bFound = TRUE;

               break;
            }
         }

         if NOT bFound
         {
            if report
            {
               Post(self,@SayToOne,#target=who,
                    #message_rsc=jalapriestess_not_a_bard);
            }

            return FALSE;
         }
      }

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
