GuildMaster is Human

// Ours (guild revamp, ADR 0022 decision 28): a faction's Guild Master, the
// project's first new NPCs. One stands beside each liege (the subclasses: the
// Duke's in his chambers, the Princess's in the Assembly Chamber, the rebels'
// in the Jasper tavern), and each serves any guild member, whatever their
// faction. They give the guild story (quests/guild-story-*.json, "giver":
// {"class": "GuildMaster"}), one quest for each Fallen Hall up the ladder.
//
// A Guild Master is built from player body parts, like a faction troop, so it
// needs no art of its own. Each subclass fixes its looks with the vi/vrLooks_
// classvars below, where Human picks at random (SetGender, SetHair, SetFace,
// the skin and clothes in SetClothes). It carries nothing and never fights.

constants:

   include blakston.khd

   // The guild story's first quest asks this much base health (quests/guild-story-a-guilds-calling.json)
   STORY_HEALTH = 80

resources:

   // Only the subclasses stand anywhere: this is how the quests name them all
   GuildMaster_name_rsc = "any Guild Master"
   GuildMaster_desc_rsc = \
      "A Guild Master keeps the rolls of the guilds that serve the realm, "
      "and knows where the Order of Necromancers has taken their halls."

   // For those the guild story isn't open to yet (SayNoQuests)
   GuildMaster_no_guild = \
      "I keep the rolls of the realm's guilds, and your name is on none of "
      "them.  Eight of the old guild halls have fallen to the Order of "
      "Necromancers, and it will take guilds to win them back.  Found one "
      "with Frular, the guild creator in Barloque, or join one, and come "
      "back to me."
   GuildMaster_too_weak = \
      "Your guild has need of you, but not yet.  Come back when you have "
      "80 health, and I'll tell you what became of the old guild halls."

classvars:

   vrName = GuildMaster_name_rsc
   vrDesc = GuildMaster_desc_rsc

   viDefault_behavior = AI_NPC | AI_NOMOVE | AI_NOFIGHT
   viAttributes = MOB_NOFIGHT | MOB_LISTEN | MOB_RECEIVE | MOB_NOMOVE | MOB_NOQUEST
   viObject_flags = OF_ATTACKABLE | OF_DISPLAY_NAME | OF_NPC
   viSpeed = SPEED_NONE
   viTreasure_type = TID_NONE
   viCashMin = 0
   viCashMax = 0

   // The looks: GENDER_*, the hair, eyes, nose, mouth and beard pictures ($ keeps
   // Human's default; no beard), the hair's colour (PT_GRAY_TO_*), the skin (1 to 4),
   // and the shirt's and the trousers' colours (XLAT_TO_*)
   viLooks_gender = GENDER_MALE
   vrLooks_hair = $
   vrLooks_eyes = $
   vrLooks_nose = $
   vrLooks_mouth = $
   vrLooks_beard = $
   viLooks_hair_colour = 0
   viLooks_skin = 1
   viLooks_shirt = XLAT_TO_GRAY
   viLooks_pants = XLAT_TO_BLACK

properties:

messages:

   SetGender()
   {
      viGender = viLooks_gender;
      if viGender = GENDER_FEMALE
      {
         vrIcon = human_female_icon_rsc;
         prHead = human_head_female_icon;
         prEyes = human_eyes_kx_icon;
         prMouth = human_mouth_kx_icon;
         prNose = human_nose_kx_icon;
         prToupee = human_hair_ca_icon;
         prLegs = human_legs_b_rsc;
         prRight_arm = human_rightarm_b_rsc;
         prLeft_arm = human_leftarm_b_rsc;
         vrDead_Icon = human_dead_female_icona_rsc;
         vrDead_Legs = human_dead_female_iconb_rsc;
         vrSound_death = human_female_sound_death;
      }

      return;
   }

   SetHair()
   {
      if vrLooks_hair <> $
      {
         prToupee = vrLooks_hair;
      }

      prBeard = vrLooks_beard;
      Send(self,@SetHairTranslation,#translation=viLooks_hair_colour);

      return;
   }

   SetFace()
   {
      if vrLooks_eyes <> $
      {
         prEyes = vrLooks_eyes;
      }

      if vrLooks_nose <> $
      {
         prNose = vrLooks_nose;
      }

      if vrLooks_mouth <> $
      {
         prMouth = vrLooks_mouth;
      }

      return;
   }

   SayNoQuests(who = $)
   "Monster.SayNoQuests: with no guild, or too little health for the guild story, a "
   "player hears why, and where the story begins."
   {
      if who = $
         OR NOT IsClass(who,&Player)
      {
         return FALSE;
      }

      if Send(who,@GetGuild) = $
      {
         Send(self,@SayToOne,#target=who,#message_rsc=GuildMaster_no_guild);

         return TRUE;
      }

      if Send(who,@GetBaseMaxHealth) < STORY_HEALTH
      {
         Send(self,@SayToOne,#target=who,#message_rsc=GuildMaster_too_weak);

         return TRUE;
      }

      return FALSE;
   }

   SetClothes()
   "After Human's random skin (Constructor), so the clothes take ours."
   {
      Send(self,@SetSkinColor,#color=viLooks_skin);
      Send(self,@SetDefaultClothes,#shirt_color=viLooks_shirt,
            #pants_color=viLooks_pants);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
