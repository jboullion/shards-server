////////////////////////////////////////////////////////////////////////////////
FactionTroop is Human

constants:

   include blakston.khd

   EQUIPMENT_DROP_PERCENT = 100

   // Ours (the faction revamp's battles, util/factionwar.kod): a battle troop is twice a flag
   // troop's level, up to this; a captain is more
   BATTLE_LEVEL_MAX = 240
   BATTLE_CAPTAIN_LEVEL = 300
   // How far off archers and mages keep (fine units, as ArenaFighter's)
   BATTLE_ARCHER_RANGE = 320
   BATTLE_MAGE_RANGE = 192
   // A battle troop changes foe only for one this much nearer, squared: 4 = half as far
   BATTLE_SWITCH_NEARER_SQ_DIV = 4

   // Ours (the faction revamp's phase 3, util/factionworld.kod): a troop on duty in a town,
   // not fighting (SetDuty); factionworld.kod has the same
   DUTY_NONE = 0
   DUTY_REVELLER = 1
   DUTY_SENTRY = 2

resources:

   include troop.lkod

   FactionTroop_name_rsc = "faction troop"
   FactionTroop_desc_rsc = \
   "This is a member of the local militia."
   FactionTroop_dead_name_rsc = "dead faction troop"

   FactionTroop_captain_duke = "captain of the Duke's army"
   FactionTroop_captain_princess = "captain of the Princess' army"
   FactionTroop_captain_rebel = "captain of Jonas's rebels"
   FactionTroop_not_your_battle = \
      "%s%s has no quarrel with you.  This battle is for the soldiers of two lieges."

classvars:

   vrName = FactionTroop_name_rsc
   vrDesc = FactionTroop_desc_rsc
   vrDead_name = FactionTroop_dead_name_rsc

   viTreasure_type = TID_EMPTY

   viSpeed = SPEED_FASTER
   viAttack_type = ATCK_WEAP_SLASH
   viAttributes = 0
   viDefault_behavior = AI_FIGHT_NEWBIESAFE | AI_MOVE_REGROUP

   viColorTranslate1 = XLAT_TO_RED     // Shirt
   viColorTranslate2 = XLAT_TO_BLACK   // Pants

   vcShieldClass = &GuildShield
   viShieldColor1 = XLAT_TO_RED
   viShieldColor2 = XLAT_TO_RED
   viShieldShape = SHIELDSHAPE_SLASH
   viInsignia = $

   viVisionDistance = 12

   viCashMin = 200
   viCashMax = 600

properties:

   piBaseLevel = 80
   piBaseDifficulty = 6

   //Here so they can be set
   vrIcon = human_male_icon_rsc
   vrDead_Icon = human_dead_male_icona_rsc
   vrDead_Legs = human_dead_male_iconb_rsc
   viLevel = 80         // piBaseLevel
   viDifficulty = 4     // piBaseDifficulty
   piGender = GENDER_MALE
   viKarma = 0

   // Ours: the battle we fight in (util/factionwar.kod), and what we are in it
   poBattle = $
   piBattleRole = BATTLE_ROLE_NONE
   // Ours: a town duty (SetDuty): a celebration's reveller, or a sentry at the town's pole
   piDuty = DUTY_NONE

   // Ours (guild revamp): the Order of Necromancers' garrisons hunt every
   // player, shield or none (OrderSoldier, OrderMage).
   pbHuntsAll = FALSE

messages:

   SetClothes()
   {
      Send(self,@SetDefaultClothes,#shirt_color=viColorTranslate1);
      Send(self,@SetTroopLegs,#translation=viColorTranslate2);

      return;
   }

   SetEquipment()
   {
      local oEquipmentItem, iRandomNumber, iBonusModifier;

      iRandomNumber = Random(1,100);
      if iRandomNumber <= 35
      {
         oEquipmentItem = Create(&Longsword);
         iBonusModifier = 3;
      }
      else if iRandomNumber <= 55
      {
         oEquipmentItem = Create(&Axe);
         iBonusModifier = 2;
      }
      else if iRandomNumber <= 65
      {
         oEquipmentItem = Create(&Hammer);
         iBonusModifier = 2;
      }
      else if iRandomNumber <= 75
      {
         oEquipmentItem = Create(&Mace);
         iBonusModifier = 1;
      }
      else if iRandomNumber <= 80
      {
         oEquipmentItem = Create(&ShortSword);
         iBonusModifier = 1;
      }
      else if iRandomNumber <= 85
      {
         oEquipmentItem = Create(&Scimitar);
         iBonusModifier = 4;
      }
      else if iRandomNumber <= 90
      {
        oEquipmentItem = Create(&BattleBow);
        poArrow = Create(&NeruditeArrow);
        iBonusModifier = 5;
      }
      else
      {
         oEquipmentItem = Create(&LongBow);
         poArrow = Create(&NeruditeArrow);
         iBonusModifier = 4;
      }

      viDifficulty = piBaseDifficulty + iBonusModifier;
      Send(self,@AddEquipmentObject,#what=oEquipmentItem);

      iRandomNumber = Random(1,100);
      if iRandomNumber <= 35
      {
         oEquipmentItem = Create(&LeatherArmor);
         iBonusModifier = 20;
      }
      else if iRandomNumber <= 70
      {
         oEquipmentItem = Create(&ChainArmor);
         iBonusModifier = 50;
      }
      else if iRandomNumber <= 85
      {
         oEquipmentItem = Create(&ScaleArmor);
         iBonusModifier = 75;
      }
      else
      {
         oEquipmentItem = Create(&PlateArmor);
         iBonusModifier = 100;
      }

      viLevel = piBaseLevel + iBonusModifier;
      Send(self,@AddEquipmentObject,#what=oEquipmentItem);

      // Gauntlets?
      iRandomNumber = Random(1,100);
      if iRandomNumber < 20
      {
         oEquipmentItem = Create(&Gauntlet);
         viDifficulty = viDifficulty + 1;
         viLevel = viLevel + 20;
         Send(self,@AddEquipmentObject,#what=oEquipmentItem);
      }

      // Helmet?
      if Random(1,100) < 30
      {
         oEquipmentItem = Create(&SimpleHelm);
         Send(self,@AddEquipmentObject,#what=oEquipmentItem);
      }

      return;
   }

   SetShield()
   {
      local oEquipmentItem;

      oEquipmentItem = Create(vcShieldClass,#color1=viShieldColor1,#color2=viShieldColor2,
                              #shape=viShieldShape);
      if viInsignia <> $
      {
         Send(oEquipmentItem,@ChangeGuildInsignia,#insignia=viInsignia);
      }

      Send(self,@AddEquipmentObject,#what=oEquipmentItem);

      return;
   }

   // Override from monster superclass
   // We drop some of our carried items when we die.
   CreateTreasure(who = $, corpse = $)
   {
      local oUsedItem, oItemAtt, iPercentDrop;

      // Ours: a battle's troops leave nothing behind; the battle pays its fighters
      //  (util/factionwar.kod), so a field of twenty fallen isn't a looting ground.
      if poBattle <> $
      {
         foreach oUsedItem in plUsing
         {
            Send(oUsedItem,@Delete);
         }

         plUsing = $;

         return;
      }

	  iPercentDrop = EQUIPMENT_DROP_PERCENT;
	  
      oItemAtt = Send(SYS,@FindItemAttByNum,#num=IA_CORPSEPOINTER);

      foreach oUsedItem in plUsing
      {
         // Weapon Wands should only have a 1% chance to drop.
		 if IsClass(oUsedItem, &ApprenticeWand)
		 {
		    iPercentDrop = 1;
		 }
		 else
		 {
		    iPercentDrop = EQUIPMENT_DROP_PERCENT;
		 }
		 
         // Only a percentage chance to drop each item.  Too much stuff otherwise.
         // Don't drop the shield!  It's a quest/special item!
		 if (Random(1,100) <= iPercentDrop)
            AND (NOT IsClass(oUsedItem,vcShieldClass))
            AND NOT pbIllusion
         {
            if (oItemAtt <> $) AND Send(oItemAtt,@ReqAddToItem,#oItem=oUsedItem)
            {
               Send(oItemAtt,@AddToItem,#oItem=oUsedItem,#state1=corpse);
            }

            Send(poOwner,@NewHold,#what=oUsedItem,
                  #new_row=piRow,#new_col=piCol,
                  #fine_row=piFine_row,#fine_col=piFine_col);
         }
         else
         {
            Send(oUsedItem,@Delete);
         }
      }

      plUsing = $;

      propagate;
   }

   IsAlly(target = $, regroup = FALSE)
   {
      local iFaction;

      if IsClass(target,GetClass(self))
      {
         return TRUE;
      }

      // Ours: a liege's soldiers and mages stand together (a DukeMage beside a DukeTroop)
      if IsClass(target,&FactionTroop)
         AND Send(target,@GetFaction) = viFaction
      {
         return TRUE;
      }

      if IsClass(target,&Player)
      {
         if pbHuntsAll
         {
            return FALSE;
         }

         iFaction = Send(target,@GetFaction);
         if (NOT regroup) AND (iFaction = FACTION_NEUTRAL)
         {
            return TRUE;
         }

         if iFaction = viFaction
         {
            return TRUE;
         }
         else
         {
            return FALSE;
         }
      }

      propagate;
   }

   SpecialHatredBehavior(what=$)
   {
      local iFaction;

      // Ours: in a battle, only the other army and the other side's soldiers, the
      //  nearest most; nobody else at all (as ArenaFighter's).
      if poBattle <> $
      {
         if NOT Send(self,@IsBattleFoe,#what=what)
         {
            return -10000;
         }

         return 1000 - 4 * (Send(self,@SquaredFineDistanceTo,#what=what) / (FINENESS * FINENESS));
      }

      // Ours (guild revamp): the Order hunts players, the nearest most, and
      //  leaves the monsters beside it be.
      if pbHuntsAll
      {
         if IsClass(what,&Player)
         {
            return 1000 - 4 * (Send(self,@SquaredFineDistanceTo,#what=what) / (FINENESS * FINENESS));
         }

         return -10000;
      }

      if (IsClass(what,&User)
         AND (Send(SETTINGS_OBJECT,@TroopsAttackNonShielded)
            OR Send(what,@FindUsing,#class=&SoldierShield) <> $))
         OR IsClass(what,&FactionTroop)
      {
         iFaction = Send(what,@GetFaction);
         if iFaction = viFaction
         {
            return -30;
         }
         
         if (iFaction <> FACTION_NEUTRAL)
            AND (iFaction <> viFaction)
         {
            return 1000;
         }
      }

      return 0;
   }

   //// Ours (the faction revamp): battles (util/factionwar.kod)

   SetBattle(battle = $, role = BATTLE_ROLE_SOLDIER, school = 0)
   "We fight in battle, as role: twice a flag troop's strength (a captain more), fighting the "
   "other army as well as its soldiers. A mage takes up school's robe and spells."
   {
      poBattle = battle;
      piBattleRole = role;

      if role = BATTLE_ROLE_ARCHER
      {
         Send(self,@ReplaceGear,#old=&Weapon,#new=&LongBow);
      }
      else if role = BATTLE_ROLE_CAPTAIN
      {
         Send(self,@ReplaceGear,#old=&Weapon,#new=&Scimitar);
         Send(self,@ReplaceGear,#old=&Armor,#new=&PlateArmor);
         Send(self,@ReplaceGear,#old=&Helmet,#new=&KnightsHelm);
      }
      else if role = BATTLE_ROLE_MAGE
         AND IsClass(self,&FactionMage)
      {
         Send(self,@SetBattleSchool,#school=school);
      }

      if role = BATTLE_ROLE_CAPTAIN
      {
         viLevel = BATTLE_CAPTAIN_LEVEL;
         viDifficulty = 9;
      }
      else if role = BATTLE_ROLE_MAGE
         AND plSpellBook = $
      {
         // Kraanan's war priests and Jala's bards have no spells to cast: they make up for
         //  it with the blade (FactionMage.SetBattleSchool).
         viLevel = Bound(viLevel * 5 / 2,1,BATTLE_CAPTAIN_LEVEL - 30);
         viDifficulty = 9;
      }
      else
      {
         viLevel = Bound(viLevel * 2,1,BATTLE_LEVEL_MAX);
         viDifficulty = Bound(viDifficulty + 2,1,9);
      }

      piMax_hit_points = Send(self,@GetMaxHitPoints);
      if role = BATTLE_ROLE_CAPTAIN
      {
         piMax_hit_points = piMax_hit_points * 3 / 2;
      }

      piHit_points = piMax_hit_points * 100;
      piAttackRange = Send(self,@GetAttackRange);
      Send(self,@ResetBehaviorFlags);

      return;
   }

   ReplaceGear(old = $, new = $)
   "Trade what we wear of class old for a new one of class new (a weapon's arrows go with "
   "it; a bow brings its own)."
   {
      local i, lOld;

      lOld = $;
      foreach i in plUsing
      {
         if IsClass(i,old)
         {
            lOld = Cons(i,lOld);
         }
      }

      foreach i in lOld
      {
         Send(self,@UnuseItem,#what=i);
         Send(i,@Delete);
      }

      if old = &Weapon
      {
         if poArrow <> $
         {
            Send(poArrow,@Delete);
            poArrow = $;
         }

         if new = &LongBow
         {
            poArrow = Create(&NeruditeArrow);
         }
      }

      Send(self,@AddEquipmentObject,#what=Create(new));

      return;
   }

   GetBattle()
   {
      return poBattle;
   }

   GetBattleRole()
   {
      return piBattleRole;
   }

   IsBattleFoe(what = $)
   "In a battle: the other army's troops, and soldiers of a rival liege wearing their shields."
   {
      local oShield, iFaction;

      if poBattle = $
         OR what = $
         OR what = self
      {
         return FALSE;
      }

      // A captain is guarded while half their army stands: the troops fight the army first
      //  (a soldier may still go for them).
      if IsClass(what,&FactionTroop)
      {
         return Send(what,@GetBattle) = poBattle
                AND Send(what,@GetFaction) <> viFaction
                AND NOT Send(poBattle,@IsGuardedCaptain,#troop=what);
      }

      if IsClass(what,&Player)
      {
         oShield = Send(what,@FindUsing,#class=&SoldierShield);
         if oShield = $
         {
            return FALSE;
         }

         iFaction = Send(oShield,@GetFaction);

         // One just come to the field has a moment to find their army (FactionWar.InGrace)
         return iFaction <> viFaction
                AND Send(poBattle,@IsBattleSide,#faction=iFaction)
                AND NOT Send(poBattle,@InGrace,#who=what);
      }

      return FALSE;
   }

   SetDuty(duty = DUTY_NONE)
   "A town duty for one of the liege's troops (util/factionworld.kod): a reveller wanders "
   "and cheers, a sentry stands at the town's pole. Neither fights or can be fought."
   {
      piDuty = duty;
      Send(self,@ResetBehaviorFlags);

      return;
   }

   GetDuty()
   {
      return piDuty;
   }

   Dance()
   "A reveller's toast (FactionWorld.Cheer): one swing of the arm, as a monster's cast."
   {
      if poOwner = $
      {
         return;
      }

      piAnimation = ANIM_ATTACK;
      Send(poOwner,@SomethingChanged,#what=self);
      piAnimation = ANIM_NONE;

      return;
   }

   TweakBehavior()
   {
      if piDuty = DUTY_REVELLER
      {
         // Ours: they mill about the square (FactionWorld.Cheer makes them dance)
         piBehavior = AI_NPC | AI_NOFIGHT | AI_MOVE_RANDOM;

         return;
      }

      if piDuty = DUTY_SENTRY
      {
         piBehavior = AI_NPC | AI_NOFIGHT | AI_NOMOVE;

         return;
      }

      if pbHuntsAll
      {
         piBehavior |= AI_FIGHT_AGGRESSIVE | AI_FIGHT_SWITCHALOT;
      }

      if poBattle <> $
      {
         // The other army is monsters: we fight them too (SpecialHatredBehavior keeps it
         //  to them), and keep fighting whoever we're on.
         piBehavior |= AI_FIGHT_MONSTERS | AI_FIGHT_HYPERAGGRESSIVE;
         piBehavior = piBehavior & ~AI_FIGHT_NEWBIESAFE;

         if piBattleRole = BATTLE_ROLE_ARCHER
            OR piBattleRole = BATTLE_ROLE_MAGE
         {
            piBehavior |= AI_MOVE_OPTIMAL_RANGE;
         }

         // A guarded captain holds their ground (FactionWar.Tick frees them)
         if piBattleRole = BATTLE_ROLE_CAPTAIN
            AND Send(poBattle,@IsGuardedCaptain,#troop=self)
         {
            piBehavior |= AI_NOMOVE;
         }
      }

      propagate;
   }

   GetOptimalRange()
   {
      if poBattle <> $
      {
         if piBattleRole = BATTLE_ROLE_ARCHER
         {
            return BATTLE_ARCHER_RANGE;
         }

         if piBattleRole = BATTLE_ROLE_MAGE
         {
            return BATTLE_MAGE_RANGE;
         }
      }

      propagate;
   }

   PlayAwareSound(random_pitch = FALSE)
   "Ours (2026-10-30): in a battle, the army's horn sounds as the armies take the field and "
   "then at most now and then (FactionWar.MayHorn), not at every troop's every new target."
   {
      if poBattle <> $
         AND NOT Send(poBattle,@MayHorn)
      {
         return;
      }

      propagate;
   }

   TargetSwitch(what = $, iHatred = 0, force = FALSE)
   "In a battle: never a bystander, and (unless the battle picks for us, force) we keep our "
   "foe unless what is much nearer; else every step a foe takes makes us chase whichever is "
   "nearest, and we bounce between two archers backing off. Ours (2026-10-30): a mage keeps "
   "its foe until it falls or leaves, nearer or not, and whoever strikes it."
   {
      local iNow, iNew;

      if poBattle <> $
      {
         if NOT Send(self,@IsBattleFoe,#what=what)
         {
            return;
         }

         if NOT force
            AND poTarget <> $
            AND poTarget <> what
            AND IsObject(poTarget)
            AND Send(poTarget,@GetOwner) = poOwner
            AND Send(self,@IsBattleFoe,#what=poTarget)
         {
            if piBattleRole = BATTLE_ROLE_MAGE
            {
               return;
            }

            iNow = Send(self,@SquaredFineDistanceTo,#what=poTarget);
            iNew = Send(self,@SquaredFineDistanceTo,#what=what);
            if iNow <> $
               AND (iNew = $ OR iNew * BATTLE_SWITCH_NEARER_SQ_DIV > iNow)
            {
               return;
            }
         }
      }

      propagate;
   }

   CanMonsterFight(who = $)
   "In a battle, only the two lieges' soldiers may strike us; anyone else is a bystander."
   {
      local oShield;

      if poBattle <> $
         AND who <> $
         AND IsClass(who,&Player)
         AND NOT IsClass(who,&DM)
      {
         oShield = Send(who,@FindUsing,#class=&SoldierShield);
         if oShield = $
            OR NOT Send(poBattle,@IsBattleSide,#faction=Send(oShield,@GetFaction))
         {
            Send(who,@MsgSendUser,#message_rsc=FactionTroop_not_your_battle,
                 #parm1=Send(self,@GetCapDef),#parm2=Send(self,@GetName));

            return FALSE;
         }

         // Striking first ends one's grace
         Send(poBattle,@EndGrace,#who=who);
      }

      propagate;
   }

   GetName()
   {
      if piBattleRole = BATTLE_ROLE_CAPTAIN
      {
         if viFaction = FACTION_DUKE
         {
            return FactionTroop_captain_duke;
         }

         if viFaction = FACTION_PRINCESS
         {
            return FactionTroop_captain_princess;
         }

         return FactionTroop_captain_rebel;
      }

      propagate;
   }

   GetTrueName()
   {
      return Send(self,@GetName);
   }

   GetApparentName()
   {
      return Send(self,@GetName);
   }

   DestroyDisposable()
   "An empty room clears its monsters away now and then (Room.DisposeTimer); a battle's "
   "armies stay until their battle is done, watched or not."
   {
      if poBattle <> $
      {
         return;
      }

      propagate;
   }

   Delete()
   {
      // Fallen or cleared away: our battle counts us out.
      if poBattle <> $
      {
         Send(poBattle,@TroopGone,#troop=self);
         poBattle = $;
      }

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
