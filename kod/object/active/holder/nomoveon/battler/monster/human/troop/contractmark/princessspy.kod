PrincessSpy is ContractMark

// Ours: a mark of Roq's contracts (util/roqcontracts.kod) who serves FACTION_PRINCESS.

constants:

   include blakston.khd

resources:

   PrincessSpy_name_rsc = "spy of the Princess"
   PrincessSpy_desc_rsc = \
      "Plainly dressed, with a quick eye that takes in everything and gives back "
      "nothing.  The Princess's colours show only at the cuffs."
   PrincessSpy_dead_name_rsc = "dead spy"
   PrincessSpy_sound_aware = trps2awr.ogg

classvars:

   vrName = PrincessSpy_name_rsc
   vrDesc = PrincessSpy_desc_rsc
   vrDead_name = PrincessSpy_dead_name_rsc

   viSpeed = SPEED_AVERAGE
   viAttack_type = ATCK_WEAP_SLASH
   viAttributes = 0
   viDefault_behavior = AI_FIGHT_NEWBIESAFE | AI_MOVE_REGROUP
   viChanceFemale = 50
   viColorTranslate1 = XLAT_TO_ORANGE     // Shirt
   viColorTranslate2 = XLAT_TO_GREEN     // Pants
   vcShieldClass = &PrincessShield
   viFaction = FACTION_PRINCESS

properties:

   piBaseLevel = 60
   piBaseDifficulty = 3
   viLevel = 60
   viDifficulty = 3
   vrSound_aware = PrincessSpy_sound_aware

messages:

end
////////////////////////////////////////////////////////////////////////////////
