RebelAgitator is ContractMark

// Ours: a mark of Roq's contracts (util/roqcontracts.kod) who serves FACTION_REBEL.

constants:

   include blakston.khd

resources:

   RebelAgitator_name_rsc = "agitator of the rebels"
   RebelAgitator_desc_rsc = \
      "A sharp-tongued firebrand in Jasper's red, carrying pamphlets and a long "
      "knife, rousing the countryside for Jonas D'Accor."
   RebelAgitator_dead_name_rsc = "dead agitator"
   RebelAgitator_sound_aware = trps1awr.ogg

classvars:

   vrName = RebelAgitator_name_rsc
   vrDesc = RebelAgitator_desc_rsc
   vrDead_name = RebelAgitator_dead_name_rsc

   viSpeed = SPEED_AVERAGE
   viAttack_type = ATCK_WEAP_SLASH
   viAttributes = 0
   viDefault_behavior = AI_FIGHT_NEWBIESAFE | AI_MOVE_REGROUP
   viChanceFemale = 50
   viColorTranslate1 = XLAT_TO_RED     // Shirt
   viColorTranslate2 = XLAT_TO_BLACK     // Pants
   vcShieldClass = &RebelShield
   viFaction = FACTION_REBEL

properties:

   piBaseLevel = 60
   piBaseDifficulty = 3
   viLevel = 60
   viDifficulty = 3
   vrSound_aware = RebelAgitator_sound_aware

messages:

end
////////////////////////////////////////////////////////////////////////////////
