////////////////////////////////////////////////////////////////////////////////
FactionMage is FactionTroop

constants:

   include blakston.khd

   // A battle mage's chance to cast (Monster.piSpellChance; MonsterCastSpell tries one chase
   //  step in this * 6)
   BATTLE_SPELL_CHANCE = 4

resources:

classvars:

properties:

   piMana = 100
   piMax_Mana = 100

   // Ours: the school SetBattleSchool gave us (0 for none)
   piBattleSchool = 0

messages:

   SetEquipment()
   {
      local oEquipmentItem, iBonusModifier, oSpell;

      iBonusModifier = 3;

      viDifficulty = piBaseDifficulty + iBonusModifier;
      
      if plSpellBook = $
      {
         oEquipmentItem = Create(&Robe,#color=Random(XLAT_TO_RED,XLAT_TO_SKY));
         Send(self,@AddEquipmentObject,#what=oEquipmentItem);

         iBonusModifier = Random(20,40);
		 
	     oEquipmentItem = Create(&ApprenticeWand);
         Send(self,@AddEquipmentObject,#what=oEquipmentItem);
      }
      else
      {
         oSpell = Send(SYS,@FindSpellByNum,
                        #num=First(Nth(plSpellBook,Random(1,Length(plSpellBook)))));
         oEquipmentItem = Create(&DiscipleRobe,#school=Send(oSpell,@GetSchool));
         Send(self,@AddEquipmentObject,#what=oEquipmentItem);
		 
         iBonusModifier = Random(40,60);
		 
	     oEquipmentItem = Create(&ApprenticeWand,#school=Send(oSpell,@GetSchool));
         Send(self,@AddEquipmentObject,#what=oEquipmentItem);
      }

      if Random(1,100) < 20
      {
         iBonusModifier = iBonusModifier + 20;
         oEquipmentItem = Create(&Circlet);
         Send(self,@AddEquipmentObject,#what=oEquipmentItem);
      }
	  
      viLevel = piBaseLevel + iBonusModifier;

      return;
   }

   SetBattleSchool(school = 0)
   "Ours (the faction revamp's battles): a battle mage of school, in its robe. Qor, Riija, "
   "Faren and Shal'ille cast; Kraanan's war priests and Jala's bards have no spells a monster "
   "can turn on a foe, so they fight with a blade."
   {
      local i, lOld;

      lOld = $;
      foreach i in plUsing
      {
         if IsClass(i,&RobeBase)
            OR IsClass(i,&ApprenticeWand)
            OR IsClass(i,&Weapon)
         {
            lOld = Cons(i,lOld);
         }
      }

      foreach i in lOld
      {
         Send(self,@UnuseItem,#what=i);
         Send(i,@Delete);
      }

      Send(self,@AddEquipmentObject,#what=Create(&DiscipleRobe,#school=school));
      piBattleSchool = school;

      if school = SS_KRAANAN
         OR school = SS_JALA
      {
         plSpellBook = $;
         if school = SS_KRAANAN
         {
            Send(self,@AddEquipmentObject,#what=Create(&Scimitar));
         }
         else
         {
            Send(self,@AddEquipmentObject,#what=Create(&ShortSword));
         }

         return;
      }

      Send(self,@AddEquipmentObject,#what=Create(&ApprenticeWand,#school=school));

      if school = SS_QOR
      {
         // (No Vampiric Drain: it heals its caster, which a troop can't take)
         plSpellBook = [ [SID_HOLD,6,20], [SID_BLIND,6,40], [SID_SPLASH_OF_ACID,8,100] ];
      }
      else if school = SS_RIIJA
      {
         plSpellBook = [ [SID_VERTIGO,6,25], [SID_DAZZLE,6,45],
                         [SID_ILLUSIONARY_WOUNDS,7,100] ];
      }
      else if school = SS_FAREN
      {
         // Ours (27 October): bolts only, fire and lightning (Touch of Flame up close:
         //  GetSpellType, MonsterAttack, DidDamage)
         plSpellBook = [ [SID_LIGHTNING_BOLT,6,50], [SID_FIREBALL,7,100] ];
      }
      else
      {
         plSpellBook = [ [SID_DAZZLE,6,30], [SID_HOLY_BLAZE,7,100] ];
      }

      // A battle mage casts often: one chase step in BATTLE_SPELL_CHANCE * 6 (Monster's 10)
      piSpellChance = BATTLE_SPELL_CHANCE;

      return;
   }

   //// Ours (27 October): a Faren battle mage's blows up close are Touch of Flame's

   IsFlameHanded()
   {
      return piBattleSchool = SS_FAREN;
   }

   GetSpellType(what = $, use_weapon = $)
   {
      if Send(self,@IsFlameHanded)
      {
         return ATCK_SPELL_FIRE + ATCK_SPELL_ALL;
      }

      propagate;
   }

   MonsterAttack(what = $)
   {
      if Send(self,@IsFlameHanded)
      {
         Send(self,@DoCast);

         return;
      }

      propagate;
   }

   DidDamage(what = $, amount = 0)
   "Embers where a flame-handed blow lands (as Touch of Flame's, TouchAttackSpell)."
   {
      local oFlame;

      if Send(self,@IsFlameHanded)
         AND what <> $
      {
         oFlame = Send(SYS,@FindSpellByNum,#num=SID_TOUCH_OF_FLAME);
         if oFlame <> $
         {
            Send(oFlame,@SendSpellFx,#kind=SPELLFX_IMPACT,#source=self,#target=what,
                 #size=1,#color=Send(oFlame,@ElementFxColor,#iType=ATCK_SPELL_FIRE),
                 #fxlook=Send(oFlame,@ElementFxLook,#iType=ATCK_SPELL_FIRE));
         }
      }

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
