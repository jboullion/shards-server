////////////////////////////////////////////////////////////////////////////////
PrincessGuildMaster is GuildMaster

// Ours (guild revamp, ADR 0022 decision 28): the Princess's Guild Master, who
// stands beside Princess Kateriina in the Assembly Chamber (castle2c.kod). The
// looks are fixed (GuildMaster's Looks classvars).

constants:

   include blakston.khd

resources:

   PrincessGuildMaster_name_rsc = "Dame Seraphine Dawnmere"
   PrincessGuildMaster_desc_rsc = \
      "Dame Seraphine Dawnmere keeps the rolls of the guilds that serve "
      "Princess Kateriina.  She speaks softly, writes everything down, "
      "and remembers every guild that has fallen to the Order of "
      "Necromancers."

classvars:

   vrName = PrincessGuildMaster_name_rsc
   vrDesc = PrincessGuildMaster_desc_rsc
   viIndefinite = ARTICLE_NONE
   viDefinite = ARTICLE_NONE

   viLooks_gender = GENDER_FEMALE
   vrLooks_hair = human_hair_dr_icon
   vrLooks_eyes = human_eyes_lx_icon
   vrLooks_nose = human_nose_kx_icon
   vrLooks_mouth = human_mouth_lx_icon
   vrLooks_beard = $
   viLooks_hair_colour = PT_GRAY_TO_PLATBLOND
   viLooks_skin = 1
   viLooks_shirt = XLAT_TO_ORANGE
   viLooks_pants = XLAT_TO_GRAY

properties:

messages:

end
////////////////////////////////////////////////////////////////////////////////
