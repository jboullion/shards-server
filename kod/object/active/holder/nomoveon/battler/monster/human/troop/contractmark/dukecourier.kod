////////////////////////////////////////////////////////////////////////////////
DukeCourier is ContractMark

// Ours: a mark of Roq's contracts (util/roqcontracts.kod) who serves FACTION_DUKE.

constants:

   include blakston.khd

resources:

   DukeCourier_name_rsc = "courier of the Duke"
   DukeCourier_desc_rsc = \
      "A hooded rider in the Duke's purple, a sealed dispatch case strapped tight "
      "against the ribs.  This one has the look of someone who expects to be "
      "followed."
   DukeCourier_dead_name_rsc = "dead courier"
   DukeCourier_sound_aware = trps3awr.ogg

classvars:

   vrName = DukeCourier_name_rsc
   vrDesc = DukeCourier_desc_rsc
   vrDead_name = DukeCourier_dead_name_rsc

   viSpeed = SPEED_AVERAGE
   viAttack_type = ATCK_WEAP_SLASH
   viAttributes = 0
   viDefault_behavior = AI_FIGHT_NEWBIESAFE | AI_MOVE_REGROUP
   viChanceFemale = 50
   viColorTranslate1 = XLAT_TO_PURPLE     // Shirt
   viColorTranslate2 = XLAT_TO_BLUE     // Pants
   vcShieldClass = &DukeShield
   viFaction = FACTION_DUKE

properties:

   piBaseLevel = 60
   piBaseDifficulty = 3
   viLevel = 60
   viDifficulty = 3
   vrSound_aware = DukeCourier_sound_aware

messages:

end
////////////////////////////////////////////////////////////////////////////////
