////////////////////////////////////////////////////////////////////////////////
Revenant is Monster

// Ours (no random PvP, 2026-10-21): a revenant once haunted a player who
// murdered another. Nobody can murder another player any more, so nothing makes
// one. The class stays so a saved world that has one still loads; one left from
// an old world goes away as soon as it's touched. (Revenantb, the death realm
// monster, is a separate class.)

constants:

   include blakston.khd

resources:

   revenant_name_rsc = "revenant"
   revenant_icon_rsc = zombie.bgf
   revenant_desc_rsc = "A lost soul, fading from the world."

classvars:

   vrName = revenant_name_rsc
   vrIcon = revenant_icon_rsc
   vrDesc = revenant_desc_rsc

properties:

messages:

   Constructed()
   {
      Post(self,@Delete);

      propagate;
   }

   SomethingEntered(what=$,where=$)
   {
      Post(self,@Delete);

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
