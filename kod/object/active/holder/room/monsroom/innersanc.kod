//////////////////////////////////////////////////////////////////////////////////////
InnerSanctum is MonsterRoom

constants:

   ENTRANCE_SECTOR = 2
   ENTRANCE_H_DN = 10
   ENTRANCE_H_UP = 200
   
   LIFT_DELAY = 13000

   LEVER_REACTIVATE_DELAY = 2000    // 2 seconds

   // Ours: Queen Venya'cyr walks here always, like Far'Nohl's ghost in the throne room
   // (throne2.kod): while anyone is here, she comes back this long after she falls (seconds)
   QUEEN_CYCLE = 600

   // Ours (guild revamp, ADR 0022 decision 26): the capstone, in the sealed lever room
   // (rows 20-25, cols 11-16) behind sector 1 at (19,14). Sealed; open, with the Ascended
   // Queen risen; or cleared, until the next Meridian day (FallenHalls.NewGameDay).
   CAPSTONE_SEALED = 0
   CAPSTONE_OPEN = 1
   CAPSTONE_CLEARED = 2
   CAPSTONE_DOOR = 1
   CAPSTONE_DOOR_OPEN = 100
   CAPSTONE_DOOR_SHUT = 0
   // The Ascended Queen's strength (Monster.SetGarrisonStrength), above Lieutenant
   // Morvaine's (215), and her guards'
   CAPSTONE_LEVEL = 230
   CAPSTONE_HP_PERCENT = 600
   CAPSTONE_DAMAGE_PERCENT = 90
   CAPSTONE_GUARD_LEVEL = 200
   CAPSTONE_PRIZE_SEED = 10
       
   include blakston.khd

resources:

   include innersanc.lkod

   room_name_guildh15 = "Inner Sanctum of Queen Venya'cyr"
   room_guildh15 = guildh15.roo

   Guildh15_lever_desc = \
      "This lever is clearly of archaic design, yet it seems to be in "
      "pristine condition.  You can't help but wonder what it controls."
   Guildh15_lever_icon = neclever.bgf

   InnerSanctum_loop = necloop3.ogg
   InnerSanctum_music = nec03.ogg

   guildh15_guildwarning = \
      "Your amulet vibrates vigorously for a moment.  Something is amiss."

   innersanc_queen_spawn = \
      "~kA cold voice fills the sanctum, \"~r~IKneel before your Queen!~I~k\""

   // Ours (guild revamp): the capstone
   innersanc_open_word = "open"
   innersanc_seal_holds = \
      "The sealed door does not stir.  Only a guild that has driven the Order "
      "of Necromancers from all eight of the Fallen Halls may break this seal."
   innersanc_seal_breaks = \
      "~B~kThe seal breaks, and the door below the hall grinds open.  In the "
      "chamber of levers beyond, Queen Venya'cyr rises in her full and "
      "terrible power."
   innersanc_ascended_rises = \
      "~kQueen Venya'cyr says, \"~r~IYou have fed me well, little guild.  Every "
      "hall you took from my Order made me stronger.  Now kneel.~I~k\""
   innersanc_guard_1 = \
      "~kQueen Venya'cyr shrieks, \"~r~IMy Order!  To your Queen!~I~k\""
   innersanc_guard_2 = \
      "~kQueen Venya'cyr screams, \"~r~IRise, my dead!  Rise and feed me!~I~k\""
   innersanc_ascended_falls = \
      "~B~kQueen Venya'cyr's power breaks.  For this day at least, the Inner "
      "Sanctum is free of her."
   innersanc_announce_guild = \
      "~B~k[Halls]~n ~B%s%q has cast down Queen Venya'cyr in her Inner Sanctum!"
   innersanc_announce_player = \
      "~B~k[Halls]~n ~B%s has cast down Queen Venya'cyr in her Inner Sanctum!"

classvars:

   vrName = room_name_guildh15

   viTeleport_row = 13
   viTeleport_col = 14

   viTerrain_type = TERRAIN_NECROPOLIS | TERRAIN_LAIR

properties:

   prMusic = InnerSanctum_music

   prRoom = room_guildh15
   piRoom_num = RID_INNERSAN

   piBaseLight = LIGHT_NICE

   ptEntrance = $

   plLevers = $
   ptReactivateLevers = $
   plGuild_doors = $
   plEntrance = $

   piGen_time = 10000

   piInit_count_min = 4
   piInit_count_max = 20

   piMonster_count_max = 10

   // The timer that brings the Queen back (QUEEN_CYCLE)
   ptQueen = $

   // Ours (guild revamp): the capstone (CAPSTONE_*), the Ascended Queen and her guards,
   // and a reset waiting on the last player out
   piCapstone = CAPSTONE_SEALED
   poAscended = $
   plCapstoneGuard = $
   pbCapstoneResetDue = FALSE
   pbCapstoneResetting = FALSE

messages:

   Constructor()
   {
      Send(self,@OpenEntranceDoor);

      plGuild_doors = [[12,30],[13,30],[14,30]];
      plLooping_sounds = [[ InnerSanctum_loop, 0, 0, 200, 100 ]];
      
      plMonsters = [ [&DarkAngel, 100] ];

      plGenerators = [ [13, 14], [13, 33], [13, 42], [7, 43], [18, 44],
                       [10, 49], [16, 48], [13, 25], [16, 4], [4, 14] ];
      // This is a box containing the guild door, used
      // for removing players from it when it closes.
      plEntrance = [ 0, 3200, 3038, 3275 ];


      propagate;
   }

   CreateStandardExits()
   {
      plExits = $;

  /// TO TOWN
//      plExits = Cons([ 2, 3, RID_LICH_MAZE, 42, 27, ROTATE_NONE ],plExits);
      plExits = Cons([ 1, 3, RID_LICH_MAZE, 42, 27, ROTATE_NONE ],plExits);
      plExits = Cons([ 1, 4, RID_LICH_MAZE, 42, 27, ROTATE_NONE ],plExits);
      plExits = Cons([ 1, 5, RID_LICH_MAZE, 42, 27, ROTATE_NONE ],plExits);
      plExits = Cons([ 2, 3, RID_LICH_MAZE, 42, 27, ROTATE_NONE ],plExits);
      plExits = Cons([ 2, 4, RID_LICH_MAZE, 42, 27, ROTATE_NONE ],plExits);
      plExits = Cons([ 2, 5, RID_LICH_MAZE, 42, 27, ROTATE_NONE ],plExits);

      propagate;
   }

   Delete()
   {
      if ptQueen <> $
      {
         DeleteTimer(ptQueen);
         ptQueen = $;
      }

      if ptEntrance <> $ {
         DeleteTimer(ptEntrance);
         ptEntrance = $;
      }
      plLevers = $;
      if ptReactivateLevers <> $ {
         DeleteTimer(ptReactivateLevers);
         ptReactivateLevers = $;
      }

      propagate;
   }

   SomethingTryGo(what=$, row=$,  col = $)
   {
      if ((row = 12) OR (row = 13) OR (row = 14) )
         AND ((col = 31) OR (col = 32) OR (col = 33))
      {
         Send(self,@OpenEntranceDoor);

         return TRUE;
      }

      propagate;
   }

   OpenEntranceDoor()
   {
      //if ptEntrance = $
      //{
      //   Send(self,@TimeStampDoor);
         Send(self,@SetSector,#sector=ENTRANCE_SECTOR,
               #animation=ANIMATE_FLOOR_LIFT,
               #height=ENTRANCE_H_DN,#speed=50);
      //}

      return;
   }

   CloseEntranceDoor()
   {
      Send(self,@SetSector,#sector=ENTRANCE_SECTOR,
            #animation=ANIMATE_FLOOR_LIFT,
            #height=ENTRANCE_H_UP,#speed=120);
      Send(self,@CloseEntranceDoorSound);

      // We now propagate this to handle removing players from the door,
      // and so the door can still be entered while it is closing.
      propagate;
   }

   CreateStandardObjects()
   {
      local oLever;

      // Create ornamental items.
      Send(self,@NewHold,#what=Create(&OrnamentalObject,#type=OO_SACRIFICIALBOWL),
            #new_row=4,#new_col=14,
            #fine_row=0,#fine_col=0,
            #angle=ANGLE_EAST);
      Send(self,@NewHold,#what=Create(&OrnamentalObject,#type=OO_SKULL10),
            #new_row=4,#new_col=15,
            #fine_row=0,#fine_col=0,
            #angle=ANGLE_EAST);
      Send(self,@NewHold,#what=Create(&OrnamentalObject,#type=OO_SACRIFICIALBOWL),
            #new_row=4,#new_col=13,
            #fine_row=0,#fine_col=0,
            #angle=ANGLE_EAST);
      Send(self,@NewHold,#what=Create(&OrnamentalObject,#type=OO_GOATHEAD),
            #new_row=6,#new_col=42,
            #fine_row=8,#fine_col=8,
            #new_angle=ANGLE_SOUTH);
      Send(self,@NewHold,#what=Create(&OrnamentalObject,#type=OO_GOATHEAD),
            #new_row=20,#new_col=42,
            #fine_row=48,#fine_col=48,
            #new_angle=ANGLE_NORTH);
      Send(self,@NewHold,#what=Create(&OrnamentalObject,#type=OO_GOATHEAD),
            #new_row=3,#new_col=10,
            #fine_row=16,#fine_col=24,
            #new_angle=ANGLE_SOUTH_EAST);
      
      // Ours: no necromancer guild, and so no ghostly remains to raise her from: the Queen
      // herself comes when someone enters (SpawnQueen), as Far'Nohl's ghost does

      // Create the levers.
      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=22,#new_col=11,
            #fine_row=48,#fine_col=55,
            #new_angle=ANGLE_EAST);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=23,#new_col=11,
            #fine_row=32,#fine_col=55,
            #new_angle=ANGLE_EAST);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=24,#new_col=11,
            #fine_row=16,#fine_col=55,
            #new_angle=ANGLE_EAST);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=25,#new_col=13,
            #fine_row=55,#fine_col=16,
            #new_angle=ANGLE_NORTH);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=25,#new_col=14,
            #fine_row=55,#fine_col=00,
            #new_angle=ANGLE_NORTH);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=25,#new_col=14,
            #fine_row=55,#fine_col=48,
            #new_angle=ANGLE_NORTH);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=25,#new_col=15,
            #fine_row=55,#fine_col=32,
            #new_angle=ANGLE_NORTH);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=24,#new_col=16,
            #fine_row=16,#fine_col=55,
            #new_angle=ANGLE_WEST);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=23,#new_col=16,
            #fine_row=32,#fine_col=55,
            #new_angle=ANGLE_WEST);

      oLever = Create(&Lever,#description=Guildh15_lever_desc,
                     #icon=Guildh15_lever_icon,#range=2);
      plLevers = Cons(oLever,plLevers);
      Send(self,@NewHold,#what=oLever,
            #new_row=22,#new_col=16,
            #fine_row=48,#fine_col=55,
            #new_angle=ANGLE_WEST);

      propagate;
   }

////////////////////////////
// Maze control lever code //
////////////////////////////
//
   SomethingChanged(what=$)
   {
      local oLever, i;

      if IsClass(what,&Lever)
      {
         foreach oLever in plLevers
         {
            if what = oLever
            {
               Send(Send(SYS,@FindRoomByNum,#num=RID_LICH_MAZE),@LeverPulled,
                     #num=FindListElem(plLevers,oLever));
               foreach i in plLevers
               {
                  Send(i,@SetStuck,#newStuck=TRUE);
               }
               ptReactivateLevers =
                     CreateTimer(self,@ReactivateLevers,LEVER_REACTIVATE_DELAY);
            }
         }
      }

      propagate;
   }

   ReactivateLevers()
   {
      local i;
      ptReactivateLevers = $;

      foreach i in plLevers
      {
         Send(i,@SetStuck,#newStuck=FALSE);
      }

      return;
   }

   GetPurchaseValue(who=$)
   "This returns the value that the GuildCreator will sell the guild to."
   "When the guild has been conquered, he will only sell the guild hall to "
   "someone in the Conquering guild."
   "return -1 if this player cannot rent this guild hall."
   {
      return -1;   /// A player can never normally rent this guild hall.
   }

   FirstUserEntered()
   {
      Send(self,@SpawnQueen);

      propagate;
   }

   LastUserLeft()
   {
      if ptQueen <> $
      {
         DeleteTimer(ptQueen);
         ptQueen = $;
      }

      if pbCapstoneResetDue
      {
         Post(self,@ResetCapstone);
      }

      propagate;
   }

   QueenTimer()
   {
      ptQueen = $;
      Send(self,@SpawnQueen);

      return;
   }

   SpawnQueen()
   "Queen Venya'cyr, unless she's here already; and the timer to look again."
   {
      local i, iTime, oQueen;

      if ptQueen = $
      {
         // Ten percent either way, in milliseconds
         iTime = (QUEEN_CYCLE * Random(90,110)) / 100;
         ptQueen = CreateTimer(self,@QueenTimer,iTime * 1000);
      }

      // The Queen who walks the sanctum; the Ascended Queen in the lever room is another
      foreach i in plActive
      {
         if GetClass(Send(self,@HolderExtractObject,#data=i)) = &Lich
         {
            return FALSE;
         }
      }

      oQueen = Create(&Lich);
      Send(self,@NewHold,#what=oQueen,#new_row=13,#new_col=49,#fine_row=16,#fine_col=0,
           #new_angle=ANGLE_WEST);

      if pbUser_in_room
      {
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=innersanc_queen_spawn,#what=self);
      }

      return TRUE;
   }

   GetRegion()
   {
      return RID_BRAX;
   }

   //// Ours (guild revamp, ADR 0022 decision 26): the capstone

   SomeoneSaid(what = $,type = $,string = $,parm1 = $,parm2 = $,parm3 = $,
               parm4 = $,parm5 = $,parm6 = $,parm7 = $,parm8 = $)
   {
      if IsClass(what,&Player)
         AND type <> SAY_EMOTE
         AND string <> $
         AND StringEqual(string,innersanc_open_word)
      {
         Post(self,@CapstoneWord,#who=what);
      }

      propagate;
   }

   InLeverRoom(row = 0,col = 0)
   {
      return row >= 20 AND col >= 11 AND col <= 16;
   }

   BesideSeal(row = 0,col = 0)
   "Just north of the sealed door at (19,14)."
   {
      return row >= 17 AND row <= 18 AND col >= 12 AND col <= 16;
   }

   GuildHoldsAll(who = $)
   "Whether who's guild holds every Fallen Hall's trophy."
   {
      local oGuild;

      oGuild = Send(who,@GetGuild);
      if oGuild = $
      {
         return FALSE;
      }

      return Send(oGuild,@CountTrophies,#low=TROPHY_FALLEN_FIRST,#high=TROPHY_FALLEN_LAST)
         >= TROPHY_FALLEN_LAST - TROPHY_FALLEN_FIRST + 1;
   }

   CapstoneWord(who = $)
   "\"open\" beside the seal breaks it for a guild holding the eight trophies, and once "
   "it's broken takes anyone through, either way."
   {
      local iRow, iCol;

      if who = $ OR Send(who,@GetOwner) <> self
      {
         return;
      }

      iRow = Send(who,@GetRow);
      iCol = Send(who,@GetCol);

      if Send(self,@InLeverRoom,#row=iRow,#col=iCol)
      {
         Send(SYS,@UtilGoNearSquare,#what=who,#where=self,#new_row=18,#new_col=14);

         return;
      }

      if NOT Send(self,@BesideSeal,#row=iRow,#col=iCol)
      {
         return;
      }

      if piCapstone = CAPSTONE_SEALED
      {
         if NOT Send(self,@GuildHoldsAll,#who=who)
         {
            Send(who,@MsgSendUser,#message_rsc=innersanc_seal_holds);

            return;
         }

         Send(self,@OpenCapstone,#who=who);
      }

      Send(SYS,@UtilGoNearSquare,#what=who,#where=self,#new_row=22,#new_col=14);

      return;
   }

   OpenCapstone(who = $)
   "The seal breaks: the door lifts, and the Ascended Queen rises with her prize."
   {
      local iHP, oTreasure, oItem;

      piCapstone = CAPSTONE_OPEN;
      pbCapstoneResetDue = FALSE;
      Send(self,@SetSector,#sector=CAPSTONE_DOOR,#animation=ANIMATE_CEILING_LIFT,
            #height=CAPSTONE_DOOR_OPEN,#speed=50);

      poAscended = Create(&AscendedQueen);
      iHP = (120 * CAPSTONE_LEVEL / 100) * CAPSTONE_HP_PERCENT / 100;
      Send(poAscended,@SetGarrisonStrength,#level=CAPSTONE_LEVEL,#hp=iHP,
            #damage_percent=CAPSTONE_DAMAGE_PERCENT);

      // The prize, as a Fallen Hall's boss carries hers
      oTreasure = Send(SYS,@FindTreasureByNum,#num=TID_NECRO);
      if oTreasure <> $ AND who <> $
      {
         oItem = Send(oTreasure,@GenerateItemAtt,#diff_seed=CAPSTONE_PRIZE_SEED,
                      #raw=TRUE,#who=who);
         if oItem <> $
         {
            Send(poAscended,@NewHold,#what=oItem);
         }
      }

      Send(self,@NewHold,#what=poAscended,#new_row=24,#new_col=14,#fine_row=32,
            #fine_col=32,#new_angle=ANGLE_NORTH);

      SendListByClass(plActive,1,&User,@MsgSendUser,#message_rsc=innersanc_seal_breaks);
      Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=innersanc_ascended_rises,#what=self);
      Post(Send(SYS,@GetFallenHalls),@Broadcast);

      return;
   }

   QueenCallsGuard(ascended = $,wave = 1)
   "AscendedQueen.HitPointThresholdDamage: the Order comes to her, at three-fifths and "
   "two-fifths of her health."
   {
      local i, lGuard, oMonster;

      if ascended = $ OR ascended <> poAscended
      {
         return;
      }

      if wave = 1
      {
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=innersanc_guard_1,#what=self);
         lGuard = [ [ &OrderMage, 23, 13 ], [ &DarkAngel, 23, 15 ] ];
      }
      else
      {
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=innersanc_guard_2,#what=self);
         lGuard = [ [ &OrderSoldier, 25, 12 ], [ &OrderMage, 25, 16 ],
                    [ &DarkAngel, 23, 14 ] ];
      }

      foreach i in lGuard
      {
         oMonster = Create(First(i));
         Send(oMonster,@SetGarrisonStrength,#level=CAPSTONE_GUARD_LEVEL);
         plCapstoneGuard = Cons(oMonster,plCapstoneGuard);
         Send(self,@NewHold,#what=oMonster,#new_row=Nth(i,2),#new_col=Nth(i,3),
               #fine_row=32,#fine_col=32);
      }

      return;
   }

   LeaveHold(what = $)
   {
      if NOT pbCapstoneResetting
         AND what <> $
      {
         if FindListElem(plCapstoneGuard,what) > 0
         {
            plCapstoneGuard = DelListElem(plCapstoneGuard,what);
         }

         // She's gone as she dies, with her struck list still to hand
         if what = poAscended
         {
            poAscended = $;
            piCapstone = CAPSTONE_CLEARED;
            Send(self,@AscendedSlain,#ascended=what);
            Post(Send(SYS,@GetFallenHalls),@Broadcast);
         }
      }

      propagate;
   }

   AscendedSlain(ascended = $)
   "The capstone's fall: the room hears it, and everyone online hears who cast her down "
   "(a guild that earned the trophy, else a player who struck her). Monster.Killed has "
   "already given the trophy (util/guildtrophies.kod)."
   {
      local i, each_obj, oGuild, oStriker;

      SendListByClass(plActive,1,&User,@MsgSendUser,#message_rsc=innersanc_ascended_falls);

      oGuild = $;
      oStriker = $;
      foreach i in plActive
      {
         each_obj = Send(self,@HolderExtractObject,#data=i);
         if IsClass(each_obj,&Player)
            AND Send(ascended,@WasStruckBy,#who=each_obj)
         {
            oStriker = each_obj;
            if oGuild = $
               AND Send(each_obj,@GetGuild) <> $
               AND Send(Send(each_obj,@GetGuild),@HasTrophy,#id=TROPHY_CAPSTONE)
               AND Send(Send(each_obj,@GetGuild),@GetName) <> $
            {
               oGuild = Send(each_obj,@GetGuild);
            }
         }
      }

      if oGuild <> $
      {
         Send(Send(SYS,@GetFallenHalls),@Announce,#rsc=innersanc_announce_guild,
               #parm1=Send(oGuild,@GetCapDef),#parm2=Send(oGuild,@GetName));
      }
      else if oStriker <> $
      {
         Send(Send(SYS,@GetFallenHalls),@Announce,#rsc=innersanc_announce_player,
               #parm1=Send(oStriker,@GetTrueName));
      }

      return;
   }

   NewGameDay()
   "FallenHalls.NewGameDay: the capstone resets with the halls, once the sanctum is empty."
   {
      if piCapstone = CAPSTONE_SEALED
      {
         return;
      }

      if Send(self,@CountHoldingHowMany,#class=&User) > 0
      {
         pbCapstoneResetDue = TRUE;

         return;
      }

      Send(self,@ResetCapstone);

      return;
   }

   ResetCapstone()
   {
      local i, lMonsters;

      if Send(self,@CountHoldingHowMany,#class=&User) > 0
      {
         pbCapstoneResetDue = TRUE;

         return;
      }

      pbCapstoneResetting = TRUE;
      lMonsters = plCapstoneGuard;
      if poAscended <> $
      {
         lMonsters = Cons(poAscended,lMonsters);
      }

      plCapstoneGuard = $;
      poAscended = $;
      foreach i in lMonsters
      {
         Send(i,@Delete);
      }

      pbCapstoneResetting = FALSE;

      Send(self,@SetSector,#sector=CAPSTONE_DOOR,#animation=ANIMATE_CEILING_LIFT,
            #height=CAPSTONE_DOOR_SHUT,#speed=50);
      piCapstone = CAPSTONE_SEALED;
      pbCapstoneResetDue = FALSE;
      Post(Send(SYS,@GetFallenHalls),@Broadcast);

      return;
   }

   NewHold(what = $)
   {
      if IsClass(what,&User)
      {
         Post(self,@LeaveSealedRoom,#who=what);
      }

      propagate;
   }

   LeaveSealedRoom(who = $)
   "Back from logging off in the lever room after its seal closed: out to the hall."
   {
      if who <> $
         AND Send(who,@GetOwner) = self
         AND piCapstone = CAPSTONE_SEALED
         AND Send(self,@InLeverRoom,#row=Send(who,@GetRow),#col=Send(who,@GetCol))
      {
         Send(SYS,@UtilGoNearSquare,#what=who,#where=self,#new_row=18,#new_col=14);
      }

      return;
   }

   GetCapstoneState()
   {
      return piCapstone;
   }

end
