////////////////////////////////////////////////////////////////////////////////
FeyForest is MonsterRoom

constants:

   include blakston.khd

   // Base light value for the room.
   BASE_LIGHT = LIGHT_NICE

   // What we adjust the Karma in the room by to get the light modifier.
   LIGHT_KARMA_ADJUST = -70

   // Ours: how long a detect spell locks a room good or evil (CastLock): a Meridian day
   FEY_LOCK_TIME = 7200000

resources:

   feyforest_music_neutral = neutfor.ogg
   feyforest_music_evil = badfor.ogg
   feyforest_music_good = goodfor.ogg

   feyforest_locked_good = \
      "~B%s's Detect Evil floods this part of the vale with Shal'ille's light.  "
      "Only good fey will gather here for the next day."
   feyforest_locked_evil = \
      "~B%s's Detect Good drowns this part of the vale in Qor's shadow.  "
      "Only evil fey will gather here for the next day."
   feyforest_lock_renewed = "~BThe lock on this part of the vale holds for another day."
   feyforest_lock_broken = "~B%s's spell breaks the lock on this part of the vale."
   feyforest_lock_faded = "~BThe lock on this part of the vale fades."

classvars:

   // This is where this section of the faerie forest will
   // 'aim' for on the karmic scale.
   viEquilibrium = 50

   viTerrain_type = TERRAIN_FOREST | TERRAIN_MYSTICAL

   viWeatherZone = WEATHER_ZONE_VALE

properties:

   piBaseLight = BASE_LIGHT
   piOutside_factor = 8

   piDirectional_percent = DIRECTIONAL_PERCENT_OUTDOORS

   piGen_time = 20000
   piGen_percent = 80

   // Room Karma is the karma of the Faerie Forest
   // and determines the state of the forest.
   piRoom_Karma = 50
   ptFaerie = $

   // Ours: the lock a detect spell sets (CastLock): $, or the FeyLock room enchantment that
   // holds the room good or evil, and the two FeyLock objects this room uses
   poLock = $
   poLockGood = $
   poLockEvil = $

   pbSnowGroundTexture = TRUE

messages:

   Constructor()
   {
      piRoom_Karma = viEquilibrium;
      ptFaerie = CreateTimer(self,@FaerieTimer,piGen_time/2);

      propagate;
   }

   FaerieTimer()
   {
      // Ours: a locked room doesn't drift back toward its equilibrium
      if NOT pbUser_in_room
         AND poLock = $
      {
         if piRoom_Karma < viEquilibrium
         {
            piRoom_Karma = piRoom_Karma + Random(1,5);
         }
         else
         {
            piRoom_Karma = piRoom_Karma - Random(1,5);
         }

         if piInit_count_max < Length(plGenerators)
         {
            ++piInit_count_min;
            ++piInit_count_max;
         }
      }

      ptFaerie = CreateTimer(self,@FaerieTimer,piGen_time/2);

      return;
   }

   Delete()
   {
      if ptFaerie <> $
      {
         DeleteTimer(ptFaerie);
         ptFaerie = $;
      }

      poLock = $;
      if poLockGood <> $
      {
         Send(poLockGood,@Delete);
         poLockGood = $;
      }

      if poLockEvil <> $
      {
         Send(poLockEvil,@Delete);
         poLockEvil = $;
      }

      propagate;
   }

   ////////////////////////////////////////////////////////////////// Ours: locks

   SpellCast(who = $,oSpell = $,lItems = $,bItemCast = FALSE)
   "Shal'ille's Detect Evil locks the room good, Qor's Detect Good evil (CastLock); a potion "
   "doesn't."
   {
      if NOT bItemCast AND oSpell <> $
      {
         if Send(oSpell,@GetSpellNum) = SID_DETECT_EVIL
         {
            Send(self,@CastLock,#who=who,#karma=KVERY_GOOD);
         }
         else if Send(oSpell,@GetSpellNum) = SID_DETECT_GOOD
         {
            Send(self,@CastLock,#who=who,#karma=KVERY_EVIL);
         }
      }

      propagate;
   }

   CastLock(who = $,karma = KVERY_GOOD)
   "Someone cast a detect spell here: the same lock again holds another day, the opposing one "
   "only breaks it, and an unlocked room locks."
   {
      if poLock <> $ AND Send(poLock,@GetLockKarma) = karma
      {
         // Take it off quietly (FeyLockEnded leaves an unknown lock alone), then put it back
         poLock = $;
         Send(self,@RemoveEnchantment,#what=Send(self,@LockIcon,#karma=karma),#report=FALSE);
         Send(self,@LockRoom,#karma=karma);
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=feyforest_lock_renewed,#what=self);

         return;
      }

      if poLock <> $
      {
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=feyforest_lock_broken,#what=self,
              #parm1=Send(who,@GetName));
         // Its ending (FeyLockEnded) lets the room go back to its fairies
         Send(self,@RemoveEnchantment,#what=poLock,#report=FALSE);

         return;
      }

      Send(self,@LockRoom,#karma=karma);
      if karma = KVERY_GOOD
      {
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=feyforest_locked_good,#what=self,
              #parm1=Send(who,@GetName));
      }
      else
      {
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=feyforest_locked_evil,#what=self,
              #parm1=Send(who,@GetName));
      }

      return;
   }

   LockIcon(karma = KVERY_GOOD)
   "This room's FeyLock for good or evil, made the first time it's needed."
   {
      if karma = KVERY_GOOD
      {
         if poLockGood = $
         {
            poLockGood = Create(&FeyLockGood);
         }

         return poLockGood;
      }

      if poLockEvil = $
      {
         poLockEvil = Create(&FeyLockEvil);
      }

      return poLockEvil;
   }

   LockRoom(karma = KVERY_GOOD)
   "Holds the room very good or very evil for a day: its karma, its spawns and its look."
   {
      poLock = Send(self,@LockIcon,#karma=karma);
      Send(self,@RoomStartEnchantment,#what=poLock,#time=FEY_LOCK_TIME,#state=$);

      if karma = KVERY_GOOD
      {
         piRoom_Karma = 100;
      }
      else
      {
         piRoom_Karma = 0;
      }

      Send(self,@SetRoomKarma,#karma=karma);

      return;
   }

   FeyLockEnded(what = $,report = TRUE)
   "FeyLock.EndSpell: the lock's time ran out (report), or it was broken. The room goes back to "
   "counting its fairies."
   {
      if poLock = $ OR what <> poLock
      {
         return;
      }

      poLock = $;
      if report
      {
         Send(self,@SomeoneSaid,#type=SAY_MESSAGE,#string=feyforest_lock_faded,#what=self);
      }

      Send(self,@FigureRoomKarma,#bForceChange=TRUE);

      return;
   }

   IsLocked()
   {
      return poLock <> $;
   }

   SomethingKilled(victim = $)
   {
      if victim = $
      {
         Debug("SomethingKilled() reached with no victim!");
      }

      if IsClass(victim,&Fairy)
         OR IsClass(victim,&EvilFairy)
      {
         Post(self,@FigureRoomKarma);
      }

      propagate;
   }

   LastUserLeft()
   {
      piInit_count_min = piMonster_count - 2;
      piInit_count_max = piMonster_count + 2;

      propagate;
   }

   TryCreateMonster(initroom = FALSE,goodguy=FALSE,darkguy=FALSE,nofigure=FALSE)
   {
      local oMonster, iRoll, iTotal, lMonster_info, iRow, iCol, lPos;

      if piMonster_count >= piMonster_count_max
      {
         return FALSE;
      }

      iRoll = Random(1,100);
      if (iRoll > piGen_percent) AND (initroom = FALSE)
      {
         return FALSE;
      }

      iRoll = Random(1,100);
      iRoll += (Bound((piRoom_Karma - viEquilibrium)/5,-10,10));

      // Ours: a locked room only gathers its own kind
      if poLock <> $ AND NOT goodguy AND NOT darkguy
      {
         goodguy = (Send(poLock,@GetLockKarma) = KVERY_GOOD);
         darkguy = NOT goodguy;
      }

      if (iRoll >= piRoom_Karma AND NOT darkguy) OR goodguy
      {
         // Forest is evil.  Make it good.
         oMonster = Create(&Fairy);
      }
      else
      {
         // Forest is good.  Make it evil.
         oMonster = Create(&EvilFairy);
      }

      if plGenerators = $
      {
         iRow = Random(1,piRows);
         iCol = Random(1,piCols);
      }
      else
      {
         iRoll = Random(1,Length(plGenerators));
         lPos = Nth(plGenerators,iRoll);
         iRow = First(lPos);
         iCol = Nth(lPos,2);
      }

      if Send(self,@ReqNewHold,#what=oMonster,#new_row=iRow,#new_col=iCol)
         AND Send(self,@ReqSomethingMoved,#what=oMonster,#new_row=iRow,#new_col=iCol)
      {
         Send(self,@NewHold,#what=oMonster,#new_row=iRow,#new_col=iCol,
              #fine_row=FINENESS/2,#fine_col=FINENESS/2);
      }
      else
      {
         Send(oMonster,@Delete);

         return FALSE;
      }

      if NOT noFigure
      {
         Send(self,@FigureRoomKarma);
      }

      return TRUE;
   }

   FigureRoomKarma(bForceChange=FALSE)
   {
      local i, gCount, eCount, oldKarma, iIndex, oObj;

      // Ours: a locked room holds its karma whatever its fairies (LockRoom)
      if poLock <> $
      {
         if bForceChange
         {
            Send(self,@SetRoomKarma,#karma=Send(self,@GetKarma));
         }

         return;
      }

      gCount = 0;
      eCount = 0;
      oldKarma = Send(self,@GetKarma);

      foreach i in plActive
      {
         oObj = First(i);
         if IsClass(oObj,&Fairy)
            OR IsClass(oObj,&EvilFairy)
         {
            if Send(oObj,@GetKarma) > 0
            {
               ++gCount;
            }
            else
            {
               ++eCount;
            }
         }
      }

      if gCount = 0 AND eCount = 0
      {
         gCount = 1;
         eCount = 1;
      }

      piRoom_Karma = (100 * gCount) / (gCount+eCount);

      // enough have died for a change in the forest.
      if Send(self,@GetKarma) <> oldKarma
         OR bForceChange
      {
         Send(self,@SetRoomKarma,#karma=Send(self,@GetKarma));
      }

      return;
   }

   GetKarma()
   {
      if piRoom_Karma < 20 { return KVERY_EVIL; }
      if piRoom_Karma < 40 { return KEVIL; }
      if piRoom_Karma > 80 { return KVERY_GOOD; }
      if piRoom_Karma > 60 { return KGOOD; }

      return KNEUTRAL;
   }

   SetRoomKarma(karma = $)
   {
      local karma1, karma2, karma3, oCenter,rMusic,i,each_obj;

      rMusic = feyforest_music_neutral;

      if karma = KVERY_EVIL
      {
         rMusic = feyforest_music_evil;
      }
      else if karma = KVERY_GOOD
      {
         rMusic = feyforest_music_good;
      }

      prMusic = rMusic;

      foreach i in plActive
      {
         each_obj = First(i);
         if IsClass(each_obj,&User)
         {
            Send(each_obj,@SendRoomMusic,#music_rsc=rMusic);
         }
      }

      foreach i in plPassive
      {
         each_obj = First(i);
         if IsClass(each_obj,&FeyTree)
         {
            Send(each_obj,@SetKarma,#karma=karma);
         }
      }

      karma1 = 8871;
      karma2 = 8860 + ((karma - 1) * 2) + 1;
      karma3 = 8860 + (karma * 2);

      Send(self,@ChangeTexture,#id=2,#new_texture=karma2,#flags=CTF_NORMALWALL);
      Send(self,@ChangeTexture,#id=3,#new_texture=karma3,#flags=CTF_NORMALWALL);

      if (karma = KVERY_EVIL)
      {
         Send(self,@ChangeTexture,#id=1,#new_texture=karma1,#flags=CTF_NORMALWALL);
      }
      else
      {
         Send(self,@ChangeTexture,#id=1,#new_texture=karma2,#flags=CTF_NORMALWALL);
      }

      // See if we need to load the node.
      oCenter = Send(SYS,@FindRoomByNum,#num=RID_C2);
      Send(oCenter,@KarmaChanged,#karma=karma);

      // Lighten/darken the room as appropriate.
      Send(self,@SetBaseLight,#amount=BASE_LIGHT+piRoom_Karma+LIGHT_KARMA_ADJUST);

      return;
   }

   SomeoneSaid(what=$,string=$,type=$)
   {
      local i, iValue, oRoom,oCenter;

      iValue = -1;

      if type <> SAY_DM
         OR NOT IsClass(what,&DM)
      {
         propagate;
      }

      // Codes to change the room karma, spawn mobs or change the forest karma.
      if StringEqual(string,"room very good")
      {
         Send(self,@AdjustRoomKarma,#value=100);
      }
      else if StringEqual(string,"room good")
      {
         Send(self,@AdjustRoomKarma,#value=75);
      }
      else if StringEqual(string,"room neutral")
      {
         Send(self,@AdjustRoomKarma,#value=50);
      }
      else if StringEqual(string,"room evil")
      {
         Send(self,@AdjustRoomKarma,#value=25);
      }
      else if StringEqual(string,"room very evil")
      {
         Send(self,@AdjustRoomKarma,#value=0);
      }
      else if StringEqual(string,"good fey")
      {
         Send(self,@TryCreateMonster,#goodguy=TRUE);
      }
      else if StringEqual(string,"evil fey")
      {
         Send(self,@TryCreateMonster,#darkguy=TRUE);
      }
      else if StringEqual(string,"forest very good")
      {
         iValue = 100;
      }
      else if StringEqual(string,"forest good")
      {
         iValue = 75;
      }
      else if StringEqual(string,"forest neutral")
      {
         iValue = 50;
      }
      else if StringEqual(string,"forest evil")
      {
         iValue = 25;
      }
      else if StringEqual(string,"forest very evil")
      {
         iValue = 0;
      }

      if iValue <> -1
      {
         oCenter = Send(SYS,@FindRoomByNum,#num=RID_C2);
         foreach i in Send(oCenter,@GetFeyForest)
         {
            oRoom = Send(SYS,@FindRoomByNum,#num=i);
            if oRoom = $
            {
               continue;
            }

            Send(oRoom,@AdjustRoomKarma,#value=iValue);
         }
      }

      propagate;
   }

   AdjustRoomKarma(value = 50)
   {
      local i, iGood, iBad;

      // Ours: a DM's setting breaks any lock
      if poLock <> $
      {
         Send(self,@RemoveEnchantment,#what=poLock,#report=FALSE);
      }

      piRoom_karma = value;

      foreach i in plActive
      {
         if IsClass(First(i),&Monster)
         {
            Send(First(i),@Delete);
         }
      }

      if pbUser_in_room
      {
         iGood = value / 10;
         iBad = 10 - iGood;

         while iGood > 0
         {
            if Send(self,@TryCreateMonster,#goodguy=TRUE,#nofigure=TRUE)
            {
               --iGood;
            }
         }

         while iBad > 0
         {
            if Send(self,@TryCreateMonster,#darkguy=TRUE,#nofigure=TRUE)
            {
               --iBad;
            }
         }
      }

      // Force a change, because we've pre-set the Karma value.
      Send(self,@FigureRoomKarma,#bForceChange=TRUE);

      return;
   }

   CreateYellZoneList()
   {
      plYell_zone = [RID_A1, RID_B1, RID_B2, RID_C1,
                     RID_C2, RID_C3, RID_D2, RID_D1];

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
