//////////////////////////////////////////////////////////////////////////////////
GuildHall9 is FallenHall

// Ours (guild revamp, ADR 0022 decision 16): the Order of Necromancers holds
// the Abandoned Warehouse, the ladder's fifth rung, where its soldiers and
// mages guard the relics Captain Vesk's bandits smuggle through the Ports.
// Vesk waits in the sanctum, the old vault, behind the floor that drops at
// column 12 (sector 2) for good once the main hall's guard has fallen.

constants:

   MAINDOOR = 1
   SECRETDOOR = 2
   
   DOOR_DELAY = 5000
       
   include blakston.khd

resources:

   include guildh9.lkod

   room_name_guildh9 = "The Abandoned Warehouse"
   room_guildh9 = guildh9.roo
   guildh9_door = "the Ports of Barloque"

classvars:

   vrName = room_name_guildh9

   viTeleport_row = 9
   viTeleport_col = 19

   viTerrain_type = TERRAIN_CITY

   // The guild window (ADR 0022 decisions 30 and 32): rank 5 of VIII, its daily quest
   viRank = 5
   viMin_health = 100
   viDaily_quest = 324
   vrDoor = guildh9_door

   viGarrison_level = 150
   viBoss_level = 165
   viBoss_hp_percent = 500
   viBoss_damage_percent = 90
   viPrize_seed = 7

properties:

   prRoom = room_guildh9
   piRoom_num = RID_GUILDH9

   piBaseLight = LIGHT_NICE
   piOutside_factor = OUTDOORS_5


messages:

   Constructor()
   {
      plGuild_doors = [ [11,19] ];

      // This is a box containing the guild door, used
      // for removing players from it when it closes.
      plEntrance = [ 1175, 1225, 1900, 2000 ];

      propagate;
   }

   CreateStandardExits()
   {
      plExits = $;

      /// TO TOWN
      plExits = Cons([ 9, 24, RID_BAR_PORT, 38, 6, ROTATE_NONE ],plExits);
      plExits = Cons([ 10, 24, RID_BAR_PORT, 38, 6, ROTATE_NONE ],plExits);

      propagate;
   }

   GetGarrison()
   {
      return [ [ &OrderSoldier, 14, 7, FALLEN_ROLE_HALL ],
               [ &OrderSoldier, 18, 11, FALLEN_ROLE_HALL ],
               [ &OrderSoldier, 15, 22, FALLEN_ROLE_HALL ],
               [ &OrderSoldier, 23, 20, FALLEN_ROLE_HALL ],
               [ &BanditSniper, 14, 11, FALLEN_ROLE_HALL ],
               [ &BanditSniper, 19, 17, FALLEN_ROLE_HALL ],
               [ &BanditSniper, 23, 8, FALLEN_ROLE_HALL ],
               [ &OrderMage, 18, 6, FALLEN_ROLE_HALL ],
               [ &OrderMage, 15, 18, FALLEN_ROLE_HALL ],
               [ &OrderMage, 19, 22, FALLEN_ROLE_HALL ],
               [ &OrderSoldier, 9, 7, FALLEN_ROLE_SANCTUM ],
               [ &OrderSoldier, 9, 11, FALLEN_ROLE_SANCTUM ],
               [ &SmugglerCaptain, 7, 9, FALLEN_ROLE_BOSS ]
             ];
   }

   InSanctum(row=$,col=$)
   "The old vault."
   {
      return row >= 6 AND row <= 11 AND col >= 5 AND col <= 13;
   }

   SomethingTryGo(what=$, row=$, col = $)
   {
      if row = 12 AND col = 19
      {
         Send(self,@OpenEntrancedoor);

         return TRUE;
      }

      propagate;
   }

   OpenEntranceDoor()
   {
      if ptEntrance = $
      {
         Send(self,@TimeStampDoor);
         Send(self,@SetSector,#sector=MAINDOOR,#animation=ANIMATE_FLOOR_LIFT,
               #height=128,#speed=100);
         Send(self,@OpenEntranceDoorSound);
         ptEntrance = CreateTimer(self,@CloseEntranceDoor,DOOR_DELAY);
      }

      return;
   }

   CloseEntranceDoor()
   {
      Send(self,@SetSector,#sector=MAINDOOR,#animation=ANIMATE_FLOOR_LIFT,
            #height=224,#speed=50);
      Send(self,@CloseEntranceDoorSound);

      // We now propagate this to handle removing players from the door,
      // and so the door can still be entered while it is closing.
      propagate;
   }

   OpenSanctum()
   "The floor at column 12 drops, and stays down until the reset."
   {
      Send(self,@SetSector,#sector=SECRETDOOR,#animation=ANIMATE_FLOOR_LIFT,
            #height=128,#speed=100);
      Send(self,@OpenSecretDoorSound);

      return;
   }

   CloseSanctum()
   {
      Send(self,@SetSector,#sector=SECRETDOOR,#animation=ANIMATE_FLOOR_LIFT,
            #height=224,#speed=100);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
