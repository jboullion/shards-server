//////////////////////////////////////////////////////////////////////////////////
GuildHall3 is FallenHall

// Ours (guild revamp, ADR 0022 decision 16): the Order of Necromancers holds
// the Den of Shadows, the ladder's first rung: its soldiers, its
// illusionists (Riija's casters) and shadowbeasts. Mistress Ysolde waits in
// the sanctum, the south hall and chest room beyond the bridge (sector 2),
// which sinks for good once the main hall's guard has fallen. F8's balcony
// door into the sanctum opens only then too (IsSanctumOpen).

constants:

   BRIDGE = 2
   ENTRANCE = 1

   BRIDGE_HIGH = 654
   BRIDGE_LOW = 500

   DOOR_CLOSED = 500
   DOOR_OPEN = 580

   LIFT_DELAY = 10000              // ten seconds

   include blakston.khd

resources:

   include guildh3.lkod

   room_name_guildhall3 = "The Den of Shadows"
   room_guildhall3 = guildh3.roo
   guildh3_door = "the Lake of Jala's Song"

classvars:

   vrName = room_name_guildhall3

   viTeleport_row = 5
   viTeleport_col = 4

   viTerrain_type = TERRAIN_CAVES | TERRAIN_RIVER

   // The guild window (ADR 0022 decisions 30 and 32): rank 1 of VIII, its daily quest
   viRank = 1
   viMin_health = 80
   viDaily_quest = 320
   vrDoor = guildh3_door

   viGarrison_level = 90
   viBoss_level = 105
   viBoss_hp_percent = 500
   viBoss_damage_percent = 90
   viPrize_seed = 5

properties:

   prRoom = room_guildhall3
   piRoom_num = RID_GUILDH3

   piBaseLight = LIGHT_NICE


messages:

   Constructor()
   {
      plGuild_doors = [ [ 5,7] ];

      // This is a box containing the guild door, used
      // for removing players from it when it closes.
      plEntrance = [ 506, 593, 787, 812 ];

      propagate;
   }

   GetGarrison()
   {
      return [ [ &OrderSoldier, 4, 14, FALLEN_ROLE_HALL ],
               [ &OrderSoldier, 10, 16, FALLEN_ROLE_HALL ],
               [ &OrderSoldier, 13, 12, FALLEN_ROLE_HALL ],
               [ &OrderSoldier, 17, 8, FALLEN_ROLE_HALL ],
               [ &OrderIllusionist, 5, 16, FALLEN_ROLE_HALL ],
               [ &OrderIllusionist, 12, 8, FALLEN_ROLE_HALL ],
               [ &OrderIllusionist, 18, 10, FALLEN_ROLE_HALL ],
               [ &Shadowbeast, 10, 11, FALLEN_ROLE_HALL ],
               [ &Shadowbeast, 15, 10, FALLEN_ROLE_HALL ],
               [ &Shadowbeast, 16, 12, FALLEN_ROLE_HALL ],
               [ &OrderIllusionist, 27, 10, FALLEN_ROLE_SANCTUM ],
               [ &OrderIllusionist, 27, 15, FALLEN_ROLE_SANCTUM ],
               [ &FallenIllusionist, 28, 12, FALLEN_ROLE_BOSS ]
             ];
   }

   InSanctum(row=$,col=$)
   "The south hall and chest room, and the east corridor beside the hall."
   {
      return (row >= 21 AND col <= 19)
         OR (col >= 20 AND row >= 5 AND row <= 22);
   }

   CreateStandardExits()
   {
      plExits = $;

      /// TO JALA'S SONG
      plExits = Cons([ 5, 1, RID_F8, 6, 47, ROTATE_NONE ],plExits);
      plExits = Cons([ 25, 1, RID_F8, 26, 49, ROTATE_NONE ],plExits);

      propagate;
   }

   SomethingTryGo(what=$,row=$,col=$)
   {
      if row = 5 and col = 8
      {
         Send(self,@OpenEntranceDoor);

         return TRUE;
      }

      propagate;
   }

   OpenEntranceDoor()
   {
      if ptEntrance = $
      {
         Send(self,@TimeStampDoor);
         Send(self,@SetSector,#sector=ENTRANCE,#animation=ANIMATE_CEILING_LIFT,
               #height=DOOR_OPEN,#speed=50);
         ptEntrance = CreateTimer(self,@CloseEntranceDoor,LIFT_DELAY);
      }

      Send(self,@OpenEntranceDoorSound);

      return;
   }

   CloseEntranceDoor()
   {
      ptEntrance = $;
      Send(self,@SetSector,#sector=ENTRANCE,#animation=ANIMATE_CEILING_LIFT,
            #height=DOOR_CLOSED,#speed=50);
      Send(self,@CloseEntranceDoorSound);

      // We now propagate this to handle removing players from the door,
      // and so the door can still be entered while it is closing.
      propagate;
   }

   OpenSanctum()
   "The bridge sinks, and stays down until the reset."
   {
      Send(self,@SetSector,#sector=BRIDGE,#animation=ANIMATE_FLOOR_LIFT,
            #height=BRIDGE_LOW,#speed=16);
      Send(self,@OpenSecretDoorSound);

      return;
   }

   CloseSanctum()
   {
      Send(self,@SetSector,#sector=BRIDGE,#animation=ANIMATE_FLOOR_LIFT,
            #height=BRIDGE_HIGH,#speed=16);

      return;
   }

   CreateStandardObjects()
   {
      Send(self,@NewHold,#what=Create(&Table),
            #new_row=13,#new_col=14,#fine_row=0,#fine_col=0);
      Send(self,@NewHold,#what=Create(&Table),
            #new_row=14,#new_col=14,#fine_row=32,#fine_col=0);

      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=7,#new_col=4,#fine_row=32,#fine_col=24);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=3,#new_col=4,#fine_row=32,#fine_col=24);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=4,#new_col=7,#fine_row=16,#fine_col=56);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=6,#new_col=7,#fine_row=48,#fine_col=56);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=3,#new_col=12,#fine_row=32,#fine_col=32);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=9,#new_col=9,#fine_row=32,#fine_col=32);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=9,#new_col=12,#fine_row=32,#fine_col=0);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=15,#new_col=19,#fine_row=32,#fine_col=0);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=22,#new_col=8,#fine_row=0,#fine_col=32);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=23,#new_col=18,#fine_row=0,#fine_col=32);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=17,#new_col=6,#fine_row=40,#fine_col=8);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=14,#new_col=6,#fine_row=24,#fine_col=8);
      Send(self,@NewHold,#what=Create(&Brazier),
            #new_row=29,#new_col=17,#fine_row=32,#fine_col=0);

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
