NecromancerAmulet is ActiveItem

// Ours (the faction revamp): Duke Akardius's Champion's Gift (util/championgifts.kod), no
// longer the necromancers' half of the Necromancer/Hunter scenario nor sold by the Goad. Its
// hunger is softened: kills feed it, a fed amulet is strongest (intellect, mysticism, spell
// power), a starving one weakens and lets its bearer's ghastly face show through, but it
// never hurts them and comes off when they like; one left unfed too long goes back to the
// Duke. Its wearer still counts as undead (Player.IsUndead), may join the Order of
// Necromancers (questtemplate/necroguildqt.kod), and can't wield the spiritual weapons.

constants:

   include blakston.khd

resources:

   include necroam.lkod

   necamulet_name_rsc = "Amulet of the Three"
   necamulet_icon_rsc = necamlet.bgf
   necamulet_desc_rsc = \
      "There is something deeply disturbing about this amulet.  When you "
      "look at it in the corner of your eye, you can almost see the evil "
      "pouring forth from it.\n\n"
      "Duke Akardius gives it to his champions.  It feeds on the life of his "
      "enemies; a fed amulet is at its strongest."

   necamulet_used_rsc = \
      "As you put the amulet on, a wave of power flows through your body, "
      "setting every nerve on fire with pleasure.  Somewhere far inside your "
      "mind, underneath the feeling of power, you can also feel something else: "
      "a kind of hunger gnawing at you."
   necamulet_bound = \
      "The Amulet of the Three was given to you alone.  It will not leave you."

   necamulet_hunger_1 = "You're starting to feel a little hungry."
   necamulet_hunger_2 = "You're definitely hungry now."
   necamulet_hunger_3 = \
      "You are very hungry now.  The hunger is a burning knot somewhere "
      "inside your skull.  It is time to feed."
   necamulet_hunger_4 = \
      "Your amulet's power is ebbing away for want of life to feed on.  Feed "
      "soon."
   necamulet_hunger_5 = \
      "Your amulet is starving.  Unless it feeds soon, it will leave you and "
      "return to the Duke."

   necamulet_illusion_slipped = \
      "The illusion masking your true features slips, revealing your ghastly "
      "appearance in all its obscene glory!"
   necamulet_illusion_restored = \
      "Your horrific appearance has once again been cloaked in illusion."

   necamulet_hunger_assuaged = \
      "You feel your amulet absorbing %s%s's life energy.  It washes through "
      "you in waves, slaking your hunger and leaving you feeling strengthened."

   necamulet_cant_eat = \
      "You attempt to gag down %s%s, to no avail.  Mortal food will no "
      "longer assuage the dark hunger that burns within your unholy body."

   ao3_no_spiritw = "The amulet forces your weapon out of your grip!"

classvars:

   viIndefinite = ARTICLE_AN

   vrName = necamulet_name_rsc
   vrIcon = necamulet_icon_rsc
   vrDesc = necamulet_desc_rsc

   viValue_average = 40000

   viBulk = 25
   viWeight = 25
   viUse_type = ITEM_USE_NECK
   viItem_type = ITEMTYPE_NECKLACE | ITEMTYPE_SPECIAL

   viUse_Amount = 1

   viLight_change = 50

properties:

   // What we've added to our wearer's stats: might, intellect, agility, aim, stamina,
   // mysticism
   plStatmods = $

   piHunger = 0
   piFineHunger = 0
   ptHungerTimer = $

   pbIllusioned = TRUE
   piSavedSkinColor = $

   piIndestructible = TRUE

   poLastEnemyToAttack = $

messages:

   NewOwner(what = $)
   {
      // Remember, poOwner is still our old owner until we propagate all the way to object.
      if ptHungerTimer <> $
      {
         DeleteTimer(ptHungerTimer);
         ptHungerTimer = $;
      }

      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(self,@ReplaceIllusions,#notify=FALSE);
         Send(self,@RestoreStats,#who=poOwner);
      }

      if what <> $
         AND IsClass(what,&User)
      {
         ptHungerTimer = CreateTimer(self,@HungerTrigger,
                                     Send(Send(SYS,@GetChampionGifts),@GetHungerTick));
      }

      propagate;
   }

   ReqNewOwner(what = $)
   "Bound to the champion it was given to: it won't be dropped, given or stored."
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=necamulet_bound);

         return FALSE;
      }

      propagate;
   }

   NewUsed(what = $, iSpecial = $)
   {
      local oSpiritS, oSpiritH;

      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         // The undead can't wield the spiritual weapons.
         oSpiritH = Send(poOwner,@FindUsing,#class=&SpiritualHammer);
         oSpiritS = Send(poOwner,@FindUsing,#class=&SpiritualSword);
         if oSpiritH <> $
         {
            Send(poOwner,@TryUnuseItem,#what=oSpiritH);
         }

         if oSpiritS <> $
         {
            Send(poOwner,@TryUnuseItem,#what=oSpiritS);
         }

         if oSpiritH <> $ OR oSpiritS <> $
         {
            Send(poOwner,@MsgSendUser,#message_rsc=ao3_no_spiritw);
         }

         Send(poOwner,@MsgSendUser,#message_rsc=necamulet_used_rsc);

         // Let any passive quest know the amulet is now being worn.
         Post(poOwner,@EquippedAnItem,#oItem=self);
         Post(self,@AdjustStats);
         Post(self,@AdjustColor);
      }

      propagate;
   }

   NewUnused(what = $, iSpecial = $)
   {
      Send(self,@ReplaceIllusions,#notify=FALSE);
      Send(self,@RestoreStats);

      propagate;
   }

   AdjustStats()
   "While worn: up to +11 intellect and mysticism, +4 stamina and agility, and -5 might "
   "and aim when fed; a third of that when starving, when the illusion over its wearer's "
   "face slips more often."
   {
      local iModifier, iStatMod;

      if poOwner = $
         OR NOT IsClass(poOwner,&User)
         OR NOT pbIn_use
      {
         return;
      }

      // 100 well fed (piHunger -HUNGER_5), 66 at 0, 33 at HUNGER_5 and beyond.
      iModifier = Bound(66 - (34 * piHunger) / HUNGER_5,33,100);

      if plStatmods = $
      {
         plStatmods = [0,0,0,0,0,0];
      }

      iStatMod = 110 * iModifier / 1000;
      if (iStatMod - Nth(plStatmods,2)) <> 0
      {
         iStatMod = Send(poOwner,@AddIntellect,#points=(iStatMod - Nth(plStatmods,2)))
                    + Nth(plStatmods,2);
         SetNth(plStatmods,2,iStatMod);
      }

      iStatMod = 110 * iModifier / 1000;
      if (iStatMod - Nth(plStatmods,6)) <> 0
      {
         iStatMod = Send(poOwner,@AddMysticism,#points=(iStatMod - Nth(plStatmods,6)))
                    + Nth(plStatmods,6);
         SetNth(plStatmods,6,iStatMod);
      }

      iStatMod = (-35 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,1)) <> 0
      {
         iStatMod = Send(poOwner,@AddMight,#points=(iStatMod - Nth(plStatmods,1)))
                    + Nth(plStatmods,1);
         SetNth(plStatmods,1,iStatMod);
      }

      iStatMod = (-35 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,4)) <> 0
      {
         iStatMod = Send(poOwner,@AddAim,#points=(iStatMod - Nth(plStatmods,4)))
                    + Nth(plStatmods,4);
         SetNth(plStatmods,4,iStatMod);
      }

      iStatMod = (59 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,5)) <> 0
      {
         iStatMod = Send(poOwner,@AddStamina,#points=(iStatMod - Nth(plStatmods,5)))
                    + Nth(plStatmods,5);
         SetNth(plStatmods,5,iStatMod);
      }

      iStatMod = (59 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,3)) <> 0
      {
         iStatMod = Send(poOwner,@AddAgility,#points=(iStatMod - Nth(plStatmods,3)))
                    + Nth(plStatmods,3);
         SetNth(plStatmods,3,iStatMod);
      }

      if NOT pbIllusioned
      {
         if Random(0,HUNGER_5) > piHunger
         {
            Send(self,@ReplaceIllusions);
         }
      }
      else
      {
         if Random(0,HUNGER_5) < piHunger
         {
            Send(self,@DispelIllusions);
         }
      }

      return;
   }

   RestoreStats(who = $)
   {
      if who = $
      {
         who = poOwner;
      }

      if plStatmods = $
         OR who = $
      {
         plStatmods = $;

         return;
      }

      Send(who,@AddIntellect,#points=(-Nth(plStatmods,2)));
      Send(who,@AddMysticism,#points=(-Nth(plStatmods,6)));
      Send(who,@AddMight,#points=(-Nth(plStatmods,1)));
      Send(who,@AddAim,#points=(-Nth(plStatmods,4)));
      Send(who,@AddStamina,#points=(-Nth(plStatmods,5)));
      Send(who,@AddAgility,#points=(-Nth(plStatmods,3)));
      plStatmods = $;

      return;
   }

   GetBaseSpellModifier(oSpell=$)
   {
      return 20;
   }

   AdjustColor()
   {
      local Xlat;

      if piHunger > HUNGER_5
      {
         Xlat = PT_GRAY_TO_RED;
      }
      else if piHunger > (HUNGER_5*3/5)
      {
         Xlat = PT_GRAY_TO_KRED;
      }
      else if piHunger > (HUNGER_5*1/5)
      {
         Xlat = 0;
      }
      else if piHunger > (-HUNGER_5*1/5)
      {
         Xlat = PT_GRAY_TO_KGRAY;
      }
      else if piHunger > (-HUNGER_5*3/5)
      {
         Xlat = PT_GRAY_TO_BLACK;
      }
      else
      {
         Xlat = PT_GRAY_TO_KPURPLE;
      }

      Send(self,@SetPaletteTranslation,#translation=Xlat);
      if poOwner <> $
      {
         Send(poOwner,@SomethingChanged,#what=self);
      }

      return;
   }

   DispelIllusions()
   {
      if NOT pbIn_Use
         OR NOT pbIllusioned
         OR poOwner = $
      {
         return;
      }

      Send(poOwner,@MsgSendUser,#message_rsc=necamulet_illusion_slipped);
      if piSavedSkinColor = $
      {
         // Save skin color, then turn skin white, eyes red.
         piSavedSkinColor = Send(poOwner,@GetSkinColor);
         Send(poOwner,@SetSkinColor,#color=PT_BLUE_TO_ASHEN);
      }
      pbIllusioned = FALSE;

      return;
   }

   ReplaceIllusions(notify=TRUE)
   {
      if pbIllusioned
         OR poOwner = $
      {
         return;
      }

      if notify
      {
         Send(poOwner,@MsgSendUser,#message_rsc=necamulet_illusion_restored);
      }

      if piSavedSkinColor <> $
      {
         Send(poOwner,@SetSkinColor,#color=piSavedSkinColor);
         piSavedSkinColor = $;
      }
      pbIllusioned = TRUE;

      return;
   }

   HungerTrigger()
   "Every minute its bearer plays: an hour adds a point of hunger. Starved, or in the "
   "wrong faction, the amulet goes back to the Duke."
   {
      local oGifts;

      ptHungerTimer = $;

      if poOwner = $
         OR NOT IsClass(poOwner,&User)
      {
         return;
      }

      oGifts = Send(SYS,@GetChampionGifts);
      ptHungerTimer = CreateTimer(self,@HungerTrigger,Send(oGifts,@GetHungerTick));

      if NOT Send(poOwner,@IsLoggedOn)
      {
         return;
      }

      if NOT Send(oGifts,@KeepsGift,#oItem=self,#bearer=poOwner)
      {
         return;
      }

      piFineHunger = piFineHunger + 1;
      if piFineHunger >= 60
      {
         piFineHunger = 0;
         piHunger = piHunger + 1;
      }

      if Send(oGifts,@IsStarved,#hunger=piHunger)
      {
         Send(oGifts,@GiftStarved,#oItem=self,#bearer=poOwner);

         return;
      }

      Send(self,@AdjustStats);
      if pbIn_use
      {
         Send(self,@AdjustColor);
      }

      if piHunger > HUNGER_5
      {
         if (piFineHunger % 5) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=necamulet_hunger_5);
         }
      }
      else if piHunger > HUNGER_4
      {
         if (piFineHunger % 10) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=necamulet_hunger_4);
         }
      }
      else if piHunger > HUNGER_3
      {
         if (piFineHunger % 15) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=necamulet_hunger_3);
         }
      }
      else if piHunger > HUNGER_2
      {
         if (piFineHunger % 30) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=necamulet_hunger_2);
         }
      }
      else if piHunger > HUNGER_1
      {
         if piFineHunger = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=necamulet_hunger_1);
         }
      }

      return;
   }

   SomethingKilled(what = $,victim = $,use_weapon = $)
   "A death in our bearer's room may feed us (ChampionGifts.FeedFor)."
   {
      local iGain, oRoom;

      if poOwner = $
         OR NOT IsClass(poOwner,&User)
         OR victim = $
         OR victim = poOwner
      {
         return;
      }

      // No feeding on an arena's mock fights.
      oRoom = Send(poOwner,@GetOwner);
      if oRoom <> $
         AND Send(oRoom,@SafePlayerAttack)
         AND Send(oRoom,@InPlay,#what=poOwner)
      {
         return;
      }

      iGain = Send(Send(SYS,@GetChampionGifts),@FeedFor,#oItem=self,#killer=what,
                   #victim=victim,#bearer=poOwner);
      if iGain > 0
      {
         Send(poOwner,@MsgSendUser,#message_rsc=necamulet_hunger_assuaged,
              #parm1=Send(victim,@GetDef),#parm2=Send(victim,@GetName));
         Send(self,@SatisfyHunger,#amount=iGain);
      }

      return;
   }

   SatisfyHunger(amount = 0)
   {
      piFineHunger = piFineHunger - amount;
      while piFineHunger < 0
      {
         piHunger = piHunger - 1;
         piFineHunger = piFineHunger + 60;
      }

      // Can 'save up', but only to a point.
      piHunger = Bound(piHunger,-HUNGER_5,$);
      Send(self,@AdjustStats);
      if pbIn_use
      {
         Send(self,@AdjustColor);
      }

      return;
   }

   OrderOfNecromancersDisbanded()
   "The Order of Necromancers (guild/necguild.kod) tells every amulet when it disbands. "
   "Its members once died of it; now they just carry on."
   {
      return;
   }

   Delete()
   {
      if ptHungerTimer <> $
      {
         DeleteTimer(ptHungerTimer);
         ptHungerTimer = $;
      }

      Send(self,@ReplaceIllusions,#notify=FALSE);
      Send(self,@RestoreStats);

      propagate;
   }

   SendAnimation()
   {
      AddPacket(1, ANIMATE_NONE, 2, 2);

      return;
   }

   SendInventoryAnimation()
   {
      if pbIn_Use
         AND (piItem_flags & ITEM_PALETTE_MASK) <> 0
      {
         AddPacket(1,ANIMATE_TRANSLATION,1,piItem_flags & ITEM_PALETTE_MASK);
      }

      AddPacket(1,ANIMATE_NONE,2,2);

      return;
   }

   SendLookAnimation()
   {
      if pbIn_Use
         AND (piItem_flags & ITEM_PALETTE_MASK) <> 0
      {
         AddPacket(1,ANIMATE_TRANSLATION,1,piItem_flags & ITEM_PALETTE_MASK);
      }

      AddPacket(1,ANIMATE_NONE,2,1);

      return;
   }

   ReqUseSomething(what = $)
   {
      if IsClass(what,&Food)
         AND IsClass(what,&Spideye)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=necamulet_cant_eat,
               #parm1=Send(what,@GetDef),#parm2=Send(what,@GetName));

         return FALSE;
      }

      propagate;
   }

   DestroyDisposable()
   {
      return;
   }

   CanWeaken()
   "Brittle will not work."
   {
      return FALSE;
   }

   CanSwap()
   "Swap will never yank this."
   {
      return FALSE;
   }

   CanShatter()
   "this will not shatter."
   {
      return FALSE;
   }

   CanEnchant()
   {
      return FALSE;
   }

   CanBeGivenToNPC()
   "NPCs will refuse to take this item if offered to them."
   {
      return FALSE;
   }

   CanBeStoredInVault()
   {
      return FALSE;
   }

   ReqDMDelete()
   "Item will not be deleted by DM Clear Inventory command."
   {
      return FALSE;
   }

   DropOnDeath()
   {
      return FALSE;
   }

end
////////////////////////////////////////////////////////////////////////////////
