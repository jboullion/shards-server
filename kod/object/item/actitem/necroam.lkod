necamulet_name_rsc = de "Das Amulett der Drei"
necamulet_hunger_1 = de "Du fängst an, ein wenig hungrig zu werden."
necamulet_hunger_2 = de "Du fühlst Dich definitiv hungrig."
necamulet_hunger_3 = de \
   "Mittlerweile bist Du sehr hungrig. Der Hunger ist ein brennender Knoten "
   "irgendwo tief in Deinem Schädel. Es ist Zeit zu essen."
necamulet_illusion_slipped = de \
   "Die Illusion, die Deine wahren Fähigkeiten verdeckte, verschwindet und "
   "zeigt Deine bösartige Erscheinung in all ihrem obszönen Glanz!"
necamulet_illusion_restored = de \
   "Deine fürchterliche Erscheinung wurde erneut durch eine Illusion verhüllt."
necamulet_hunger_assuaged = de \
   "%s%s vergeht. Du fühlst, wie Dein Amulett Lebensenergie absorbiert. Eine "
   "Energiewelle wäscht Deinen Hunger hinfort und läßt Dich gestärkt zurück."
necamulet_cant_eat = de \
   "Du versuchst %s%s zurückzugewinnen, vergeblich. Lebensspendende Nahrung "
   "wird nicht mehr nötig sein. Ein bohrendes Hungergefühl quält Deinen unreinen "
   "Körper."

necamulet_name_rsc = pt "Amuleto dos Três"
necamulet_hunger_1 = pt "Você está começando a sentir um pouco de fome."
necamulet_hunger_2 = pt "Você definitivamente está com fome agora."
necamulet_hunger_3 = pt "Você está muito faminto agora. A fome é um nó ardente em algum lugar dentro de seu crânio. É hora de se alimentar."
necamulet_illusion_slipped = pt "A ilusão que mascara seus verdadeiros traços desaparece, revelando sua aparência horrenda em toda sua glória obscena!"
necamulet_illusion_restored = pt "Sua aparência horrível foi mais uma vez envolta em ilusão."
necamulet_hunger_assuaged = pt "Você sente seu amuleto absorvendo a energia vital de %s%s. Ela passa por você em ondas, saciando sua fome e deixando-o se sentindo fortalecido."
necamulet_cant_eat = pt "Você tenta engolir %s%s, em vão. Comida mortal não vai mais saciar a fome negra que queima dentro de seu corpo profano."
