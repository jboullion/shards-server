GuildCloak is PassiveItem

// Ours (guild revamp, ADR 0022 decision 22): a cloak in a guild's two colours, for looks
// alone. A member takes one free from the cloak rack in the
// guild's hall (CloakRack). It's worn over everything else (ITEM_USE_CLOAK, no armour slot),
// and like the recall stone it's bound to its bearer and crumbles when they leave the guild
// (Player.ResetGuildStuff).
//
// The cape hangs from the head's hotspot. Its art is drawn in the red and dark-blue ramps that a
// guild's colour translation changes, so it takes the guild's colours as its shield does: the
// cloth the first, the collar, edges and hem the second. The art and its depth markers come
// from tools/iconforge/cloak.ts.

constants:

   include blakston.khd

resources:

   GuildCloak_name_rsc = "guild cloak"
   GuildCloak_icon_rsc = cloakic.bgf
   GuildCloak_desc_rsc = \
      "A long cloak in the colours of %s%q.  It is worn over whatever else "
      "you wear, for looks alone.  It "
      "is bound to you and to your guild: it cannot be dropped, given or "
      "stored, and it crumbles if you leave the guild."
   GuildCloak_desc_lost_rsc = \
      "A long cloak in the colours of a guild that is no more."

   GuildCloak_male = cloakm.bgf
   GuildCloak_female = cloakf.bgf

   GuildCloak_bound = \
      "Your guild cloak is bound to you.  It will not leave your hands."
   GuildCloak_not_member = "This cloak is for its own guild's members alone."

classvars:

   vrName = GuildCloak_name_rsc
   vrIcon = GuildCloak_icon_rsc
   vrDesc = GuildCloak_desc_rsc

   viUse_type = ITEM_USE_CLOAK
   viUse_amount = 1
   viBulk = 0
   viWeight = 0
   viValue_average = 0

properties:

   // The guild whose colours it bears
   poGuild = $

messages:

   Constructor(oGuild = $)
   {
      poGuild = oGuild;
      if oGuild <> $
      {
         piItem_flags = Send(SYS,@EncodeTwoColorXLAT,
                             #color1=Send(oGuild,@GetPrimaryGuildColor),
                             #color2=Send(oGuild,@GetSecondaryGuildColor));
      }

      propagate;
   }

   GetGuild()
   {
      return poGuild;
   }

   DoBaseDesc()
   {
      if poGuild = $
         OR Send(poGuild,@GetName) = $
      {
         AddPacket(4,GuildCloak_desc_lost_rsc);

         return;
      }

      AddPacket(4,vrDesc,4,Send(poGuild,@GetDef),4,Send(poGuild,@GetName));

      return;
   }

   //// Bound to its bearer, as the recall stone is

   ReqNewOwner(what = $)
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=GuildCloak_bound);

         return FALSE;
      }

      propagate;
   }

   CanBeStoredInVault()
   {
      return FALSE;
   }

   CanBeGivenToNPC()
   {
      return FALSE;
   }

   CanSwap()
   {
      return FALSE;
   }

   CanShatter()
   {
      return FALSE;
   }

   DropOnDeath()
   {
      return FALSE;
   }

   //// Worn

   ReqUse()
   {
      if poGuild = $
         OR Send(poOwner,@GetGuild) <> poGuild
      {
         Send(poOwner,@MsgSendUser,#message_rsc=GuildCloak_not_member);

         return FALSE;
      }

      propagate;
   }

   NewUsed()
   {
      Send(poOwner,@SetOverlay,#what=self);

      propagate;
   }

   NewUnused()
   {
      Send(poOwner,@RemoveOverlay,#what=self);

      propagate;
   }

   GetNumberOverlays(iAnimation = $)
   {
      return 1;
   }

   GetOverlay()
   {
      if poOwner <> $
         AND Send(poOwner,@GetGender) = GENDER_FEMALE
      {
         return GuildCloak_female;
      }

      return GuildCloak_male;
   }

   GetOverlayHotspot()
   {
      return HS_HEAD;
   }

   SendOverlayInformation(iAnimation = $)
   "The cape hangs from the neck and shows the body's view, whatever its pose."
   {
      AddPacket(4,Send(self,@GetOverlay),1,HS_HEAD,
                1,ANIMATE_TRANSLATION,1,Send(self,@GetPaletteTranslation),
                1,ANIMATE_NONE,2,1);

      return;
   }

   Crumble()
   "Its bearer left the guild (Player.ResetGuildStuff)."
   {
      if poOwner <> $
         AND IsClass(poOwner,&Player)
         AND Send(poOwner,@FindUsing,#class=&GuildCloak) = self
      {
         Send(poOwner,@UnuseItem,#what=self);
      }

      Send(self,@Delete);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
