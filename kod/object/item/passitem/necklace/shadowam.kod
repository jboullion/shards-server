////////////////////////////////////////////////////////////////////////////////
// The Amulet of Shadows. Originally code by Justin Houk, 98jsh@williams.edu,
// tweaked by Chris Kirmse: a cursed amulet that clung to its wearer's neck,
// cost defense and light, and hurt to take off.
//
// Ours (the magic item revamp, no more curses): it wraps its wearer in Shadow
// Form while worn (Item's poSpell, cast at full power when it's put on and
// taken away when it comes off), and comes off like any other amulet. Shadow
// Form breaks as the spell's does; put the amulet on again to call it back.

ShadowAmulet is Necklace

constants:

   include blakston.khd

resources:

   include shadowam.lkod

   shadowAmulet_name_rsc = "Amulet of Shadows"
   shadowamulet_icon_rsc = amulet.bgf
   shadowAmulet_desc_rsc = \
      "You cannot get a good look at the amulet.  "
      "Shadows seem to cling to it even in direct sunlight."

classvars:

   viIndefinite = ARTICLE_AN

   vrName = shadowAmulet_name_rsc
   vrIcon = shadowamulet_icon_rsc
   vrDesc = shadowAmulet_desc_rsc

   viValue_average = 100

   viBulk = 25
   viWeight = 25

properties:

   poSpell = SID_SHADOW_FORM

messages:

   SendInventoryAnimation()
   {
      AddPacket(1,ANIMATE_NONE,2,2);

      return;
   }

   SendLookAnimation()
   {
      AddPacket(1,ANIMATE_NONE,2,2);

      return;
   }

   GetLightEffect()
   {
      return 0;
   }

end
////////////////////////////////////////////////////////////////////////////////
