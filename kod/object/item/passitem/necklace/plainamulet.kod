////////////////////////////////////////////////////////////////////////////////
// Ours (the magic item revamp, phase 3): a plain amulet, the base random jewellery magic is
// put on (its armor attributes: warding, resistance, focus, vitality). It has no magic of its
// own. Worn at the neck, one at a time, as other necklaces are.

PlainAmulet is Necklace

constants:

   include blakston.khd

resources:

   plainamulet_name_rsc = "plain amulet"
   plainamulet_icon_rsc = plainamulet.bgf
   plainamulet_desc_rsc = "A plain gold pendant on a short chain, framing a smooth, pale stone."

classvars:

   vrName = plainamulet_name_rsc
   vrIcon = plainamulet_icon_rsc
   vrDesc = plainamulet_desc_rsc

   viBulk = 5
   viWeight = 5

   viValue_average = 150

properties:

messages:

end
////////////////////////////////////////////////////////////////////////////////
