////////////////////////////////////////////////////////////////////////////////
UBScroll is Ticket

constants:

   include blakston.khd

resources:

   include UBScroll.lkod

   UBScroll_name_rsc = "unbound energy scroll"
   UBScroll_icon_rsc = scr06.bgf
   UBScroll_desc_rsc = "This scroll once held unbound energy, which the world knows no more."

   // Ours: unbound energy is gone (docs/adr/0016-abilities.md); a scroll still about crumbles
   UBScroll_crumbles = "The scroll's magic is long spent, and it crumbles to dust."

classvars:

   vrName = UBScroll_name_rsc
   vrIcon = UBScroll_icon_rsc
   vrDesc = UBScroll_desc_rsc

   viUse_type = ITEM_SINGLE_USE

   viBulk = 1
   viWeight = 1
   viValue_average = 10
   
properties:

   pbIn_use = FALSE
   
messages:
   
   ReqNewApply(what = $,use_item = $)
   {
      Send(what,@MsgSendUser,#message_rsc=UBScroll_crumbles);
      Send(self,@Delete);

      return FALSE;
   }

   CanBeStoredInVault()
   {
      return TRUE;
   }
   
end
////////////////////////////////////////////////////////////////////////////////
