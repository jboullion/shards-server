////////////////////////////////////////////////////////////////////////////////
HunterSword is Weapon

// Ours (the faction revamp): Princess Kateriina's Champion's Gift (util/championgifts.kod),
// no longer the hunters' half of the Necromancer/Hunter scenario nor sold by the Goad. Its
// hunger is softened: kills feed it, a fed sword is strongest (might, aim), a starving one
// weakens but never bites its bearer, and one left unfed too long goes back to the Princess.
// Like the Amulet of the Three it's an active item (GetObjectType), so it hears the kills
// in its bearer's room (Holder.SomethingKilled).

constants:

   include blakston.khd

resources:

   include huntsw.lkod

   HunterSword_name_rsc = "Sword of the Hunt"
   HunterSword_icon_rsc = huntswrd.bgf
   HunterSword_desc_rsc = \
      "This weapon is truly a fine piece of workmanship.  Intricate organic "
      "carvings intertwine along the hilt, enclosing an exquisitely beautiful "
      "gem, almost as if it were an eye gazing calmly back at you.  Indeed, "
      "every now and then out of the corner of your eye you almost catch "
      "it blinking.\n\n"
      "Princess Kateriina gives it to her champions.  It drinks the blood of "
      "her enemies; a fed sword is at its strongest."

   HunterSword_window_overlay_rsc = povhunts.bgf
   HunterSword_player_overlay = huntswov.bgf

   HunterSword_used_rsc = \
      "The hilt of the Sword of the Hunt comes alive, writhing against the palm "
      "of your hand, and a greatly pleasurable feeling of power runs up your arm, "
      "with a nagging sense of hunger."
   HunterSword_bound = \
      "The Sword of the Hunt was given to you alone.  It will not leave you."

   HunterSword_hunger_1 = "Your sword thirsts for the hunt."
   HunterSword_hunger_2 = "Your sword is growing impatient for a hunt."
   HunterSword_hunger_3 = \
      "Your sword hungers for the blood of the Princess's enemies.  It is time to hunt."
   HunterSword_hunger_4 = \
      "Your sword hungers, and its strength is ebbing away.  Hunt soon."
   HunterSword_hunger_5 = \
      "Your sword is starving.  Unless it feeds soon, it will leave you and "
      "return to the Princess."

   HunterSword_hunger_assuaged = \
      "Your sword drinks in %s%s's blood.  You can feel it course along its "
      "roots into your body, filling you with energy."

classvars:

   viIndefinite = ARTICLE_A

   vrName = HunterSword_name_rsc
   vrIcon = HunterSword_icon_rsc
   vrDesc = HunterSword_desc_rsc

   vrWeapon_window_overlay = HunterSword_window_overlay_rsc
   vrWeapon_overlay = HunterSword_player_overlay

   // Hunter swords are high quality thrusting weapons.
   viWeaponType = WEAPON_TYPE_THRUST
   viWeaponQuality = WEAPON_QUALITY_HIGH

   viProficiency_needed = SKID_PROFICIENCY_SWORD

   viGround_group = 1
   viInventory_group = 4
   viBroken_group = 2

   viValue_average = 40000
   viBulk = 50
   viWeight = 70

   viHits_init_min = 500
   viHits_init_max = 500

   viItem_type = ITEMTYPE_WEAPON | ITEMTYPE_SPECIAL

   viRange = 3 * FINENESS

properties:

   // What we've added to our bearer's stats: might, intellect, agility, aim, stamina,
   // mysticism
   plStatmods = $

   piHunger = 0
   piFineHunger = 0
   ptHungerTimer = $

   piAttack_type = ATCK_WEAP_SLASH
   piAttack_Spell = ATCK_SPELL_HUNTERSWORD

   piIndestructible = TRUE

   poLastEnemyToAttack = $

messages:

   NewOwner(what = $)
   {
      // Remember, poOwner is still our old owner until we propagate all the way to object.
      if ptHungerTimer <> $
      {
         DeleteTimer(ptHungerTimer);
         ptHungerTimer = $;
      }

      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(self,@RestoreStats,#who=poOwner);
      }

      if what <> $
         AND IsClass(what,&User)
      {
         ptHungerTimer = CreateTimer(self,@HungerTrigger,
                                     Send(Send(SYS,@GetChampionGifts),@GetHungerTick));
      }

      propagate;
   }

   ReqNewOwner(what = $)
   "Bound to the champion it was given to: it won't be dropped, given or stored."
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_bound);

         return FALSE;
      }

      propagate;
   }

   NewUsed(what = $, iSpecial = $)
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_used_rsc);
         Post(poOwner,@EquippedAnItem,#oItem=self);
         Post(self,@AdjustStats);
      }

      propagate;
   }

   NewUnused(what = $, iSpecial = $)
   {
      Send(self,@RestoreStats);

      propagate;
   }

   AdjustStats()
   "While wielded: up to +10 might and aim, +2 stamina and agility, and -5 intellect and "
   "mysticism when fed; a third of that, and a weaker blade, when starving."
   {
      local iModifier, iStatMod;

      if poOwner = $
         OR NOT IsClass(poOwner,&User)
         OR NOT pbIn_use
      {
         return;
      }

      // 100 well fed (piHunger -HUNGER_5), 66 at 0, 33 at HUNGER_5 and beyond.
      iModifier = Bound(66 - (34 * piHunger) / HUNGER_5,33,100);

      if plStatmods = $
      {
         plStatmods = [0,0,0,0,0,0];
      }

      iStatMod = 105 * iModifier / 1000;
      if (iStatMod - Nth(plStatmods,1)) <> 0
      {
         iStatMod = Send(poOwner,@AddMight,#points=(iStatMod - Nth(plStatmods,1)))
                    + Nth(plStatmods,1);
         SetNth(plStatmods,1,iStatMod);
      }

      iStatMod = 105 * iModifier / 1000;
      if (iStatMod - Nth(plStatmods,4)) <> 0
      {
         iStatMod = Send(poOwner,@AddAim,#points=(iStatMod - Nth(plStatmods,4)))
                    + Nth(plStatmods,4);
         SetNth(plStatmods,4,iStatMod);
      }

      iStatMod = (-35 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,2)) <> 0
      {
         iStatMod = Send(poOwner,@AddIntellect,#points=(iStatMod - Nth(plStatmods,2)))
                    + Nth(plStatmods,2);
         SetNth(plStatmods,2,iStatMod);
      }

      iStatMod = (-35 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,6)) <> 0
      {
         iStatMod = Send(poOwner,@AddMysticism,#points=(iStatMod - Nth(plStatmods,6)))
                    + Nth(plStatmods,6);
         SetNth(plStatmods,6,iStatMod);
      }

      iStatMod = (39 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,5)) <> 0
      {
         iStatMod = Send(poOwner,@AddStamina,#points=(iStatMod - Nth(plStatmods,5)))
                    + Nth(plStatmods,5);
         SetNth(plStatmods,5,iStatMod);
      }

      iStatMod = (39 * iModifier / 1000) - 2;
      if (iStatMod - Nth(plStatmods,3)) <> 0
      {
         iStatMod = Send(poOwner,@AddAgility,#points=(iStatMod - Nth(plStatmods,3)))
                    + Nth(plStatmods,3);
         SetNth(plStatmods,3,iStatMod);
      }

      // The blade's condition follows its hunger, from a quarter to all of piHits_init.
      piHits = Bound((100 - (piHunger + HUNGER_5) * 70 / (2 * HUNGER_5)),25,100)
               * piHits_init / 100;

      return;
   }

   RestoreStats(who = $)
   {
      if who = $
      {
         who = poOwner;
      }

      if plStatmods = $
         OR who = $
      {
         plStatmods = $;

         return;
      }

      Send(who,@AddIntellect,#points=(-Nth(plStatmods,2)));
      Send(who,@AddMysticism,#points=(-Nth(plStatmods,6)));
      Send(who,@AddMight,#points=(-Nth(plStatmods,1)));
      Send(who,@AddAim,#points=(-Nth(plStatmods,4)));
      Send(who,@AddStamina,#points=(-Nth(plStatmods,5)));
      Send(who,@AddAgility,#points=(-Nth(plStatmods,3)));
      plStatmods = $;

      return;
   }

   HungerTrigger()
   "Every minute its bearer plays: an hour adds a point of hunger. Starved, or in the "
   "wrong faction, the sword goes back to the Princess."
   {
      local oGifts;

      ptHungerTimer = $;

      if poOwner = $
         OR NOT IsClass(poOwner,&User)
      {
         return;
      }

      oGifts = Send(SYS,@GetChampionGifts);
      ptHungerTimer = CreateTimer(self,@HungerTrigger,Send(oGifts,@GetHungerTick));

      if NOT Send(poOwner,@IsLoggedOn)
      {
         return;
      }

      if NOT Send(oGifts,@KeepsGift,#oItem=self,#bearer=poOwner)
      {
         return;
      }

      piFineHunger = piFineHunger + 1;
      if piFineHunger >= 60
      {
         piFineHunger = 0;
         piHunger = piHunger + 1;
      }

      if Send(oGifts,@IsStarved,#hunger=piHunger)
      {
         Send(oGifts,@GiftStarved,#oItem=self,#bearer=poOwner);

         return;
      }

      Send(self,@AdjustStats);

      if piHunger > HUNGER_5
      {
         if (piFineHunger % 5) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_hunger_5);
         }
      }
      else if piHunger > HUNGER_4
      {
         if (piFineHunger % 10) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_hunger_4);
         }
      }
      else if piHunger > HUNGER_3
      {
         if (piFineHunger % 15) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_hunger_3);
         }
      }
      else if piHunger > HUNGER_2
      {
         if (piFineHunger % 30) = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_hunger_2);
         }
      }
      else if piHunger > HUNGER_1
      {
         if piFineHunger = 0
         {
            Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_hunger_1);
         }
      }

      return;
   }

   SomethingKilled(what = $,victim = $,use_weapon = $)
   "A death in our bearer's room may feed us (ChampionGifts.FeedFor)."
   {
      local iGain, oRoom;

      if poOwner = $
         OR NOT IsClass(poOwner,&User)
         OR victim = $
         OR victim = poOwner
      {
         return;
      }

      // No feeding on an arena's mock fights.
      oRoom = Send(poOwner,@GetOwner);
      if oRoom <> $
         AND Send(oRoom,@SafePlayerAttack)
         AND Send(oRoom,@InPlay,#what=poOwner)
      {
         return;
      }

      iGain = Send(Send(SYS,@GetChampionGifts),@FeedFor,#oItem=self,#killer=what,
                   #victim=victim,#bearer=poOwner);
      if iGain > 0
      {
         Send(poOwner,@MsgSendUser,#message_rsc=HunterSword_hunger_assuaged,
              #parm1=Send(victim,@GetDef),#parm2=Send(victim,@GetName));
         Send(self,@SatisfyHunger,#amount=iGain);
      }

      return;
   }

   SatisfyHunger(amount = 0)
   {
      piFineHunger = piFineHunger - amount;
      while piFineHunger < 0
      {
         piHunger = piHunger - 1;
         piFineHunger = piFineHunger + 60;
      }

      // Can 'save up', but only to a point.
      piHunger = Bound(piHunger,-HUNGER_5,$);
      Send(self,@AdjustStats);

      return;
   }

   Delete()
   {
      if ptHungerTimer <> $
      {
         DeleteTimer(ptHungerTimer);
         ptHungerTimer = $;
      }

      Send(self,@RestoreStats);

      propagate;
   }

   SendAnimation()
   {
      local iXLAT;

      if (piItem_flags & ITEM_PALETTE_MASK) <> 0
      {
         // The artists made the gem red in the inv/dropped views
         // (blue in the look view), so we have to juggle this a little (ugh).
         iXLAT = Send(SYS,@DecodeSecondaryColor,#xlat=(piItem_flags & ITEM_PALETTE_MASK));
         iXLAT = Send(SYS,@EncodeTwoColorXLAT,#color1=iXLAT);
         AddPacket(1,ANIMATE_TRANSLATION,1,iXLAT);
      }

      AddPacket(1,ANIMATE_NONE,2,viGround_group);

      return;
   }

   SendLookAnimation()
   {
      if (piItem_flags & ITEM_PALETTE_MASK) <> 0
      {
         AddPacket(1,ANIMATE_TRANSLATION,1,piItem_flags & ITEM_PALETTE_MASK);
      }

      AddPacket(1,ANIMATE_NONE,2,3);

      return;
   }

   GetObjectType()
   {
      return ACTIVE;
   }

   CanBeStoredInVault()
   {
      return FALSE;
   }

   DestroyDisposable()
   {
      return;
   }

   WeaponHitTarget()
   {
      // The hunter sword never takes damage normally.
      return;
   }

   SetMaxHits(number = $)
   {
      // This cannot be modified externally.
      return;
   }

   SetHits(number = $)
   {
      // This cannot be modified externally.
      return;
   }

   CanMend()
   {
      return FALSE;
   }

   CanWeaken()
   "Brittle will not work."
   {
      return FALSE;
   }

   CanSwap()
   "Swap will never yank this."
   {
      return FALSE;
   }

   CanShatter()
   "this will not shatter."
   {
      return FALSE;
   }

   CanEnchant()
   {
      return FALSE;
   }

   CanBeGivenToNPC()
   "NPCs will refuse to take this item if offered to them."
   {
      return FALSE;
   }

   ReqDMDelete()
   "Item will not be deleted by DM Clear Inventory command"
   {
      return FALSE;
   }

   DropOnDeath()
   {
      return FALSE;
   }

end
////////////////////////////////////////////////////////////////////////////////
