////////////////////////////////////////////////////////////////////////////////
// Ours (spell revamp, ADR 0023): Qor's answer to the spiritual sword, summoned by Qor's Blade
// (spell/bldinher.kod). The sword's art, its blade turned blood red. Its blows deal
// unholy damage, and now and then it drinks the victim's blood and heals its wielder by as
// much; the undead have none to give. Bound to its summoner, as the sword is.
QorsBlade is Weapon

constants:

   include blakston.khd

   // The chance a blow drinks blood, percent, and what it drinks (and heals)
   DRINK_PERCENT = 15
   DRINK_MIN = 6
   DRINK_MAX = 12
   // Qor's spells it strengthens
   QOR_SPELL_MODIFIER = 15
   // Its wielder must know a Qor spell of this level
   QOR_LEVEL_NEEDED = 6

resources:

   QorsBlade_name_rsc = "Qor's blade"
   QorsBlade_icon_rsc = spirsword.bgf
   QorsBlade_desc_rsc = \
      "A blade of Qor, dark and blood red.  Its blows deal unholy damage, and now and then "
      "it drinks its victim's blood and heals you by as much, though the undead have none "
      "to give.  It strengthens its wielder's Qor spells, and only a servant of Qor who "
      "knows the deepest of Qor's spells may wield it.  It is bound to you and will not leave you."
   QorsBlade_drink = "~rYour blade drinks the blood of %s%s for %i, and you feel it heal you."
   QorsBlade_window_overlay_rsc = povspirsword.bgf
   QorsBlade_player_overlay = spirswordov.bgf

   QorsBlade_not_qor = \
      "Only a servant of Qor who knows the deepest of Qor's spells may wield this blade."
   QorsBlade_shalille = "Shal'ille will not allow you to wield an unholy weapon."
   QorsBlade_bound = "Qor's blade is bound to you.  It will not leave you."

classvars:

   vrName = QorsBlade_name_rsc
   vrIcon = QorsBlade_icon_rsc
   vrDesc = QorsBlade_desc_rsc
   // "Qor's blade", not "a Qor's blade"
   viIndefinite = ARTICLE_NONE
   viDefinite = ARTICLE_NONE

   viWeaponType = WEAPON_TYPE_THRUST
   viWeaponQuality = WEAPON_QUALITY_HIGH

   viProficiency_Needed = SKID_PROFICIENCY_SWORD

   viValue_average = 0
   viWeight = 10
   viBulk = 40

   vrWeapon_window_overlay = QorsBlade_window_overlay_rsc
   vrWeapon_overlay = QorsBlade_player_overlay

   viGround_group = 1
   viInventory_group = 3
   viBroken_group = 2

   viHits_init_min = 500
   viHits_init_max = 1000

   viDamage_min = 10
   viDamage_max = 30

properties:

   piAttack_type = ATCK_WEAP_MAGIC+ATCK_WEAP_THRUST
   piHitBonus = 0

messages:

   GetMagicShowFlags()
   "Qor's blade glows crimson, as a magic weapon of that might would, in the hand and in the "
   "world (our client's ring)."
   {
      return (MAGIC_SHOW_SLIGHT + MAGIC_TIER_ENORMOUS) * OF_MAGIC_SHOW_MUL
             + MAGIC_COLOUR_CRIMSON * OF_MAGIC_COLOUR_MUL;
   }

   Constructor(iToHitBonus=$)
   {
      if iToHitBonus <> $
      {
         piHitBonus = iToHitBonus;
      }

      Send(self,@SetSpellFlag,#flag=ATCK_SPELL_UNHOLY,#value=TRUE);
      // The spiritual sword's art, the steel of its blade blood red
      Send(self,@SetPaletteTranslation,#translation=PT_GRAY_TO_RED);

      propagate;
   }

   ReqUse()
   "Only for a servant of Qor who knows a level 6 Qor spell, and no Shal'ille spell."
   {
      local i, oSpell, bQor;

      if poOwner = $
         OR Send(poOwner,@PlayerIsImmortal)
      {
         propagate;
      }

      bQor = FALSE;
      foreach i in Send(poOwner,@GetSpellList)
      {
         oSpell = Send(SYS,@FindSpellByNum,
                       #num=Send(poOwner,@DecodeSpellNum,#compound=i));
         if oSpell = $
         {
            continue;
         }

         if Send(oSpell,@GetSchool) = SS_SHALILLE
         {
            Send(poOwner,@MsgSendUser,#message_rsc=QorsBlade_shalille);

            return FALSE;
         }

         if Send(oSpell,@GetSchool) = SS_QOR
            AND Send(oSpell,@GetLevel) >= QOR_LEVEL_NEEDED
         {
            bQor = TRUE;
         }
      }

      if NOT bQor
      {
         Send(poOwner,@MsgSendUser,#message_rsc=QorsBlade_not_qor);

         return FALSE;
      }

      propagate;
   }

   WeaponHitTarget(who=$,victim=$,damage=$)
   "One blow in seven drinks blood: 6 to 12 unholy damage, and the wielder healed by as much. "
   "Not from the undead. Returning here keeps the blade from wearing down."
   {
      local iDamage;

      if who = $
         OR victim = $
         OR NOT IsObject(victim)
         OR NOT IsClass(victim,&Battler)
         OR Send(victim,@GetOwner) = $
         OR Send(victim,@GetHealth) <= 0
         OR Send(victim,@IsUndead)
         OR Random(1,100) > DRINK_PERCENT
      {
         return;
      }

      iDamage = Random(DRINK_MIN,DRINK_MAX);
      Send(who,@MsgSendUser,#message_rsc=QorsBlade_drink,
           #parm1=Send(victim,@GetDef),#parm2=Send(victim,@GetName),
           #parm3=iDamage);
      Send(who,@GainHealth,#amount=iDamage);
      if Send(victim,@AssessDamage,#what=who,#damage=iDamage,
              #aspell=ATCK_SPELL_ALL+ATCK_SPELL_UNHOLY,#report=FALSE,
              #report_resistance=FALSE) = $
      {
         Send(who,@KilledSomething,#what=victim,#use_weapon=self);
      }

      return;
   }

   //// Bound to its summoner: it won't be dropped, given, sold or stored

   ReqNewOwner(what = $)
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=QorsBlade_bound);

         return FALSE;
      }

      propagate;
   }

   CanBeStoredInVault()
   {
      return FALSE;
   }

   CanBeGivenToNPC()
   {
      return FALSE;
   }

   DropOnDeath()
   {
      return FALSE;
   }

   CanEnchant()
   {
      return FALSE;
   }

   CanShatter()
   {
      return FALSE;
   }

   CanSwap()
   {
      return FALSE;
   }

   CanWeaken()
   {
      return FALSE;
   }

   GetBaseSpellModifier(oSpell=$)
   {
      if oSpell <> $ AND Send(oSpell,@GetSchool) = SS_QOR
      {
         return QOR_SPELL_MODIFIER;
      }

      return 0;
   }

end
////////////////////////////////////////////////////////////////////////////////
