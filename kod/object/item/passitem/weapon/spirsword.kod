////////////////////////////////////////////////////////////////////////////////
SpiritualSword is Weapon

constants:

   include blakston.khd

resources:

   SpiritSword_name_rsc = "spiritual sword"
   SpiritSword_icon_rsc = spirsword.bgf
   SpiritSword_desc_rsc = \
      "Inherently having holy blessings, this sword is even more powerful "
      "than the standard variation.  Its blows deal holy damage, and now and "
      "then it flares with a holy touch that sears its victim, the undead "
      "twice as badly.  It also strengthens its wielder's Shal'ille spells.  It is bound "
      "to you and will not leave you."
   SpiritSword_flare = "~gYour spiritual sword flares with holy light, searing %s%s for %i!"
SpiritSword_window_overlay_rsc = povspirsword.bgf
   SpiritSword_player_overlay = spirswordov.bgf

   SS_not_qor = "Qor will not allow you to wield a holy weapon."
   SS_no_ao3 = "You amulet will not allow you to wield a holy weapon."
   SS_bound = "The spiritual sword is bound to you.  It will not leave you."

classvars:
   vrName = SpiritSword_name_rsc
   vrIcon = SpiritSword_icon_rsc
   vrDesc = SpiritSword_desc_rsc

   viWeaponType = WEAPON_TYPE_THRUST
   viWeaponQuality = WEAPON_QUALITY_HIGH

   viProficiency_Needed = SKID_PROFICIENCY_SWORD

   viValue_average = 0
   viWeight = 10
   viBulk = 40

   vrWeapon_window_overlay = SpiritSword_window_overlay_rsc
   vrWeapon_overlay = SpiritSword_player_overlay

   viGround_group = 1
   viInventory_group = 3
   viBroken_group = 2

   viHits_init_min = 500
   viHits_init_max = 1000

   viDamage_min = 10
   viDamage_max = 30

properties:

   piAttack_type = ATCK_WEAP_MAGIC+ATCK_WEAP_THRUST
   piHitBonus = 0

messages:

   GetMagicShowFlags()
   "Ours (spell revamp phase 9): Shal'ille's sword glows gold, as a magic weapon of "
   "that might would, in the hand and in the world (our client's ring)."
   {
      return (MAGIC_SHOW_SLIGHT + MAGIC_TIER_ENORMOUS) * OF_MAGIC_SHOW_MUL
             + MAGIC_COLOUR_GOLD * OF_MAGIC_COLOUR_MUL;
   }

   Constructor(iToHitBonus=$)
   {
      local oWeapAtt;

      if iToHitBonus <> $
      {
         piHitBonus = iToHitBonus;
      }

      Send(self,@SetSpellFlag,#flag=ATCK_SPELL_HOLY,#value=TRUE);

      propagate;
   }

   ReqUse()
   {
      local i, oSpell, oFound;

      if Send(poOwner,@PlayerIsImmortal)
         OR IsClass(poOwner,&EscapedConvict)
      {
         return TRUE;
      }

      oFound = FALSE;

      if poOwner <> $
      {
         if Send(poOwner,@FindHoldingActive,#class=&NecromancerAmulet) <> $
         {
            Send(poOwner, @MsgSendUser, #message_rsc = SS_no_ao3);
            return FALSE;
         }

         foreach i in Send(poOwner,@GetSpellList)
         {
            oSpell = Send(SYS,@FindSpellByNum,
                           #num=Send(poOwner,@DecodeSpellNum,#compound=i));
            if Send(oSpell,@GetSchool) = SS_QOR
            {
               oFound = TRUE;

               break;
            }
         }

         if oFound = TRUE
         {
            Send(poOwner, @MsgSendUser, #message_rsc = SS_not_qor);
            return FALSE;
         }
		}

      propagate;
   }

   WeaponHitTarget(who=$,victim=$,damage=$)
   "Ours (spell revamp balance): one blow in seven flares with a holy touch "
   "(6 to 12 holy damage, twice that to the undead). Returning here keeps "
   "the sword from wearing down."
   {
      local iDamage;

      if who = $
         OR victim = $
         OR NOT IsObject(victim)
         OR NOT IsClass(victim,&Battler)
         OR Send(victim,@GetOwner) = $
         OR Send(victim,@GetHealth) <= 0
         OR Random(1,100) > 15
      {
         return;
      }

      iDamage = Random(6,12);
      if Send(victim,@IsUndead)
      {
         iDamage = iDamage * 2;
      }

      Send(who,@MsgSendUser,#message_rsc=SpiritSword_flare,
           #parm1=Send(victim,@GetDef),#parm2=Send(victim,@GetName),
           #parm3=iDamage);
      if Send(victim,@AssessDamage,#what=who,#damage=iDamage,
              #aspell=ATCK_SPELL_ALL+ATCK_SPELL_HOLY,#report=FALSE,
              #report_resistance=FALSE) = $
      {
         Send(who,@KilledSomething,#what=victim,#use_weapon=self);
      }

      return;
   }

   //// Ours: bound to its summoner, as Qor's blade is (qorblade.kod): it won't be dropped,
   //// given, sold or stored. Casting again replaces it (creaspsw.kod).

   ReqNewOwner(what = $)
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=SS_bound);

         return FALSE;
      }

      propagate;
   }

   CanBeStoredInVault()
   {
      return FALSE;
   }

   CanBeGivenToNPC()
   {
      return FALSE;
   }

   DropOnDeath()
   {
      return FALSE;
   }

   CanEnchant()
   {
      return FALSE;
   }

   CanShatter()
   {
      return FALSE;
   }

   CanSwap()
   {
      return FALSE;
   }

   CanWeaken()
   {
      return FALSE;
   }

   GetBaseSpellModifier(oSpell=$)
   {
      if oSpell <> $ AND Send(oSpell,@GetSchool) = SS_SHALILLE
      {
         return 15;
      }

      return 0;
   }

end
////////////////////////////////////////////////////////////////////////////////
