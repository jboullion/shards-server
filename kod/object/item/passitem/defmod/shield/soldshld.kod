////////////////////////////////////////////////////////////////////////////////
SoldierShield is Shield

constants:

   include blakston.khd

   // "Magic" constants used in shield superclasses
   USED = 1
   UNUSED = 2
   DEFENDING = 3

   // Ours (2026-10-30): the most health worn shield gives, a rank (NamedRank: Recruit 5 to
   //  Champion 30)
   HEALTH_PER_RANK = 5

resources:

   include soldshld.lkod

   SoldierShield_name_rsc = "soldier's shield"
   SoldierShield_desc_rsc = \
      "Shields of this style show allegiance to a particular faction"
   SoldierShield_icon_rsc = gshE.bgf
   SoldierShield_icon_back_rsc = gsheback.bgf
   SoldierShield_window_overlay_rsc = povgshE.bgf

   // Ours (2026-10-30): the guild shield's insignias, for looks only (ChangeGuildInsignia): its
   //  emblem, held and on the ground; slung on the back, the liege's own unless the sign has
   //  one (the lieges' and Shal'ille's)
   soldshield_insig_riija = gshri.bgf
   soldshield_insig_riija_over = gshriov.bgf
   soldshield_insig_qor = gshqo.bgf
   soldshield_insig_qor_over = gshqoov.bgf
   soldshield_insig_kraanan = gshkr.bgf
   soldshield_insig_kraanan_over = gshkrov.bgf
   soldshield_insig_faren = gshfa.bgf
   soldshield_insig_faren_over = gshfaov.bgf
   soldshield_insig_jala = gshja.bgf
   soldshield_insig_jala_over = gshjaov.bgf
   soldshield_insig_shalille = gshsh.bgf
   soldshield_insig_shalille_over = gshshov.bgf
   soldshield_insig_shalille_back = gshshbk.bgf
   soldshield_insig_duke = gshda.bgf
   soldshield_insig_duke_over = gshdaov.bgf
   soldshield_insig_duke_back = gshdabk.bgf
   soldshield_insig_princess = gshpr.bgf
   soldshield_insig_princess_over = gshprov.bgf
   soldshield_insig_princess_back = gshprbk.bgf
   soldshield_insig_rebel = gshre.bgf
   soldshield_insig_rebel_over = gshreov.bgf
   soldshield_insig_rebel_back = gshrebk.bgf
   soldshield_insig_desc_riija = "\n\nThe unblinking eye of Riija stares from its center."
   soldshield_insig_desc_qor = "\n\nThe skull insignia of Qor is upon it."
   soldshield_insig_desc_kraanan = "\n\nThe weapons of Kraanan are crossed acenter."
   soldshield_insig_desc_faren = "\n\nThe power of Faren arcs across it."
   soldshield_insig_desc_jala = "\n\nThe lute of Jala is depicted upon it."
   soldshield_insig_desc_shalille = "\n\nThe ankh of Shal'ille's blessing is upon it."
   SoldierShield_rank_desc = "\n\nYour rank within %s is: %s."
   SoldierShield_renown_desc = \
      "\n\nYou are %s of %s, with %i renown of 100.\n"
      "In the Faction War: %i kills, %i deaths; %i battles fought, %i won."
   SoldierShield_in_battle = "You can't put your shield away in the middle of a fight."
   SoldierShield_put_away = \
      "You put your soldier's shield away. Enemy soldiers will pass you by while it stays "
      "off; take it up again to rejoin the Faction War."
   SoldierShield_ArmyName = "the forces of neutrality"
   SoldierShield_rank_name1 = "a lowly peon"
   SoldierShield_rank_name2 = "an average soldier"
   SoldierShield_rank_name3 = "a notable fighter"
   SoldierShield_rank_name4 = "a great warrior"
   SoldierShield_rank_name5 = "a supreme hero"
   SoldierShield_welcome_mail = "Subject: Welcome.\n"
      "You are a soldier now."
   SoldierShield_lost_status = "Your liege revokes your status as a soldier!"
   SoldierShield_lost_status_nonfaction = \
      "You are not worthy to hold a soldier shield!"
   SoldierShield_booted_mail = "Subject: Your soldier status is revoked.\n"
      "I have removed you from my army of soldiers.  I have no use for one so "
      "cowardly as yourself."
   SoldierShield_sling_on_back = "You sling your shield on your back."
   SoldierShield_remove_from_back = "You remove your shield from your back."

classvars:

   // Ours (docs/adr/0012-cosmetics.md): a dye recolours nothing (not dyeable)
   viDyeRamp = DYE_RAMP_NONE

   vrName = SoldierShield_name_rsc
   vrDesc = SoldierShield_desc_rsc
   vrIcon = SoldierShield_icon_rsc
   viWeight = 0
   viBulk = 0
   viDefense_base = 20
   viDamage_base = 2
   viFaction = FACTION_NEUTRAL
   viColor = XLAT_TO_GRAY
   prShield_emblem_held = $
   prShield_emblem_drop = $
   prShield_emblem_back = $
   viGround_group = 3
   viInventory_group = 1

   // Don't show damage condition since we don't take damage.
   vbShow_Condition = FALSE

   vrWelcomeMessage = SoldierShield_welcome_mail

   // Stuff for rank
   vrArmyName = SoldierShield_ArmyName
   vrRank1 = SoldierShield_rank_name1
   vrRank2 = SoldierShield_rank_name2
   vrRank3 = SoldierShield_rank_name3
   vrRank4 = SoldierShield_rank_name4
   vrRank5 = SoldierShield_rank_name5

   // Layer 0 soldier shields will be slung on use
   viLayer = 0

properties:

   // Ours (2026-10-30): an insignia it bears, for looks only (INSIG_NONE: its liege's own
   //  emblem, the classvars prShield_emblem_*), and its art ($: the liege's own)
   piInsigniaType = INSIG_NONE
   prInsig_held = $
   prInsig_drop = $
   prInsig_back = $

   // 1 to 10: the owner's renown / 10 (RenownChanged); the subclasses' powers read it
   piFactionRank = 1
   // Ours: the most health this shield has given its owner, to take back off (as a circlet's)
   piHealthChange = 0

   poLastEnemyToAttack = $

   // These can change if we put the shield on our back.
   piOverlayHotspot = HS_LEFT_WEAPON
   vrShield_window_overlay = SoldierShield_window_overlay_rsc
   viUse_amount = 1
   vrShield_overlay = SoldierShield_icon_rsc

messages:

   Constructor()
   {
      // Doesn't matter what the second color is, this shield only has
      //  a single translation.
      Send(self,@SetPaletteTranslation,
           #translation=Send(SYS,@EncodeTwoColorXLAT,#color1=viColor,
                             #color2=viColor));

      propagate;
   }

   Delete()
   {
      if poOwner <> $ AND IsClass(poOwner,&Player)
      {
         if NOT IsClass(poOwner,&DM)
         {
            if Send(poOwner,@GetFaction) = viFaction
            {
               if Send(poOwner,@IsLoggedOn)
               {
                  Post(poOwner,@MsgSendUser,
                       #message_rsc=SoldierShield_lost_status);
               }
               else
               {
                  Send(poOwner,@ReceiveNestedMail,
                       #from=Send(Send(SYS,@GetParliament),
                                  @GetFactionLiegeName,#faction=viFaction),
                       #dest_list=[poOwner],
                       #nest_list=[4,SoldierShield_booted_mail]);
               }
            }
            else
            {
               if Send(poOwner,@IsLoggedOn)
               {
                  Post(poOwner,@MsgSendUser,
                       #message_rsc=SoldierShield_lost_status_nonfaction);
               }

               // No message if you're logged out.  You were the wrong
               //  faction, anyway!
            }
         }

         // Remove the shield from the player
         // - This removes stats!
         Send(self,@NewUnused,#what=poOwner,#Recalibrate=TRUE);
      }

      propagate;
   }

   //// Faction rank stuff.

   GetFactionRank()
   {
      return piFactionRank;
   }

   GetFaction()
   {
      return viFaction;
   }

   NamedRank()
   "Ours (2026-10-30): the owner's rank (Player.GetRenownRank), 1 Recruit to 6 Champion: the "
   "shield gives HEALTH_PER_RANK health for each, and Jonas's absorbs that much damage."
   {
      if poOwner <> $
         AND IsClass(poOwner,&Player)
      {
         return Send(poOwner,@GetRenownRank);
      }

      return RENOWN_RANK_RECRUIT;
   }

   RenownChanged()
   "Ours (the faction revamp): the rank, 1 to 10, is the owner's renown / 10, and the "
   "powers follow it."
   {
      if poOwner <> $
         AND IsClass(poOwner,&Player)
      {
         piFactionRank = Bound(Send(poOwner,@GetFactionRenown) / 10,1,10);
      }

      Send(self,@UpdateRankPowers);

      return piFactionRank;
   }

   UpdateRankPowers()
   "Ours (2026-10-30): worn, the shield gives HEALTH_PER_RANK health for each of its owner's "
   "ranks (GainMaxHealth, as a circlet does); put away, none. Its old stat bonuses come off."
   {
      local iWant;

      Send(self,@RemoveOldStats);
      if poOwner = $
         OR NOT IsClass(poOwner,&User)
      {
         return;
      }

      iWant = 0;
      if Send(poOwner,@FindUsing,#class=&SoldierShield) = self
      {
         iWant = HEALTH_PER_RANK * Send(self,@NamedRank);
      }

      if iWant <> piHealthChange
      {
         piHealthChange = piHealthChange
                          + Send(poOwner,@GainMaxHealth,#amount=iWant - piHealthChange);
      }

      return;
   }

   RemoveStats()
   "The shield comes off: the health it gave goes."
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
         AND piHealthChange <> 0
      {
         Send(poOwner,@GainMaxHealth,#amount=-piHealthChange);
         piHealthChange = 0;
      }

      Send(self,@RemoveOldStats);

      return;
   }

   RemoveOldStats()
   "Ours (2026-10-30): until then each liege's shield raised three stats; a shield worn since "
   "takes them back off (the subclasses). Nothing here."
   {
      return;
   }

   KilledSomething(what=$)
   "Called when our owner killed something. Ours (the faction revamp): an enemy soldier "
   "is a war kill (Player.WarKill), and enemy troops count toward renown. Attacking our own "
   "faction is charged by Player.CheckFactionAttack."
   {
      local oOwnerOwner;

      // No bonus for killing neutrals or for killing in the Arena.
      oOwnerOwner = Send(poOwner,@GetOwner);
      if Send(what,@GetFaction) = FACTION_NEUTRAL
         OR oOwnerOwner = $
         OR Send(oOwnerOwner,@CheckRoomFlag,#flag=ROOM_SAFE_DEATH)
      {
         return;
      }

      if IsClass(what,&Player)
      {
         // No bonus if it wasn't an enemy or if for some reason we didn't
         //  attack any one "recently" (IE, our owner can be helped by mules).
         if NOT Send(self,@IsEnemyAttack,#what=what)
            OR Send(poOwner,@CanHelpPlayer)
         {
            return;
         }

         Send(poOwner,@WarKill,#victim=what);

         return;
      }

      // (The Order of Necromancers isn't in the Faction War.)
      if IsClass(what,&FactionTroop)
         AND Send(what,@GetFaction) <> viFaction
         AND Send(what,@GetFaction) <> FACTION_NECROMANCER
      {
         Send(poOwner,@EnemyTroopKilled);
      }

      return;
   }

   LostFaction()
   "Does cleanup when the player loses faction."
   {
      Post(self,@Delete);

      return;
   }

   OwnerDied(what=$,logoff=FALSE)
   "Called when our owner dies due to 'what', or with 'logoff' to apply a "
   "penalty reguardless."
   {
      local oSoldierShield;

      // logoff is used for logoff ghosts to thump us a good one for being
      //  cowardly. Ours (the faction revamp): a war death is Player.WarDeath, so
      //  this is only the logoff: it costs renown as a war death would, and the last
      //  enemy to attack us scores the kill.
      if logoff
      {
         Send(poOwner,@AddFactionRenown,#amount=RENOWN_WAR_DEATH,#report=FALSE);

         if poLastEnemyToAttack <> $
         {
            oSoldierShield = Send(poLastEnemyToAttack,@FindUsing,
                                  #class=&SoldierShield);
            if oSoldierShield <> $
            {
               Send(oSoldierShield,@KilledSomething,#what=poOwner);
            }
         }
      }

      return;
   }

   IsEnemyAttack(what=$,damage=FALSE)
   "Returns TRUE if what is an enemy (opposing faction soldier)."
   {
      local oSoldierShield;

      if what <> $
         AND IsClass(what,&Player)
         AND what <> poOwner
      {
         oSoldierShield = Send(what,@FindUsing,#class=&SoldierShield);

         // Gotta have a shield, and it can't be the same faction as us.
         if oSoldierShield <> $
            AND Send(oSoldierShield,@GetFaction) <> viFaction
         {
            // Ours: the enemy they remember is our owner (this said what, themselves)
            Send(oSoldierShield,@AttackedByEnemy,#who=poOwner);

            return TRUE;
         }
      }

      return FALSE;
   }

   AttackedByEnemy(who=$)
   {
      poLastEnemyToAttack = who;

      return;
   }

   //// Making sure the item is not unused and not dropped

   ReqUse()
   {
      if Send(poOwner,@GetFaction) = viFaction
         OR IsClass(poOwner,&DM)
      {
         Post(self,@RenownChanged);

         return TRUE;
      }
      else
      {
         // Otherwise, the owner shouldn't have the shield.
         Post(self,@Delete);
      }

      return FALSE;
   }

   ReqUnuse()
   {
      // Ours (the faction revamp): wearing the shield is joining the Faction War, and
      //  putting it away leaves it; but not in the middle of a fight.
      // A troop's shield (troop.kod) comes and goes as the troop pleases
      if IsClass(poOwner,&DM)
         OR NOT IsClass(poOwner,&Player)
      {
         return TRUE;
      }

      if Send(poOwner,@IsInPvP)
      {
         Send(poOwner,@MsgSendUser,#message_rsc=SoldierShield_in_battle);

         return FALSE;
      }

      return TRUE;
   }

   NewUnused(what=$, Recalibrate=FALSE)
   {
      if NOT (Recalibrate OR IsClass(what,&DM))
         AND IsClass(what,&Player)
      {
         if Send(what,@IsInPvP)
         {
            return FALSE;
         }

         Send(what,@MsgSendUser,#message_rsc=SoldierShield_put_away);
      }

      // Remove it from our back and remove our stats.
      Send(self,@RemoveFromBack);
      Send(self,@RemoveStats);

      propagate;
   }

   ReqNewOwner(what=$)
   {
      if (NOT IsClass(what,&Battler))
         OR (Send(what,@GetFaction) <> viFaction
             AND NOT IsClass(what,&DM))
      {
         return FALSE;
      }

      propagate;
   }

   NewOwner(what=$)
   {
      if what <> $
         AND IsClass(what,&Player)
      {
         if Send(what,@GetFaction) = viFaction
            OR IsClass(what,&DM)
         {
            Send(what,@FreeHands);
            Post(what,@TryUseItem,#what=self);
            if NOT IsClass(what,&DM)
            {
               Send(what,@ReceiveNestedMail,
                    #from=Send(Send(SYS,@GetParliament),@GetFactionLiegeName,
                               #faction=viFaction),
                    #dest_list=[what],
                    #nest_list=[4,vrWelcomeMessage]);
               Post(what,@EquippedAnItem,#oItem=self);
            }
         }
         else
         {
            // Otherwise, the owner shouldn't have the shield.
            Post(self,@Delete);

            return;
         }
      }

      propagate;
   }

   ReqLeaveOwner()
   {
      return FALSE;
   }

   ReqUseSomething(what = $)
   {
      if (IsClass(what,&Shield)
         AND Send(what,@GetLayer) > Send(self,@GetLayer))
         OR IsClass(what,&Bow)
         OR IsClass(what,&Lute)
         OR IsClass(what,&Totem)
         OR IsClass(what,&BrawlGloves)
         OR (IsClass(what,&JewelofFroz)
            AND Send(poOwner,@IsUsingA,#class=&JewelofFroz))
      {
         Send(self,@SlingOnBack,#report=FALSE);

         return TRUE;
      }

      propagate;
   }

   //// For putting the shield on our back

   // This is used for Bows and Lutes, currently.

   SlingOnBack(report=TRUE)
   {
      if piOverlayHotspot <> HS_SHIELD_BACK
      {
         piOverlayHotspot = HS_SHIELD_BACK;

         // Do text message
         if report
         {
            Send(poOwner,@MsgSendUser,#message_rsc=SoldierShield_sling_on_back);
         }

         // Remove the shield window overlay
         //  NOTE: This doesn't actually remove the overlay, just make it appear
         //        "nowhere".
         Send(poOwner,@RemoveWindowOverlay,#what=self);

         // This makes it not take a hand.
         viUse_amount = 0;

         vrShield_overlay = SoldierShield_icon_back_rsc;
         Send(poOwner,@SetOverlay,#what=self);
      }

      return;
   }

   RemoveFromBack(report=TRUE)
   {
      if piOverlayHotspot <> HS_LEFT_WEAPON
      {
         piOverlayHotspot = HS_LEFT_WEAPON;

         // Do text message
         if report
         {
            Send(poOwner,@MsgSendUser,
                 #message_rsc=SoldierShield_remove_from_back);
         }

         // Restore the shield window overlay
         vrShield_window_overlay = SoldierShield_window_overlay_rsc;
         Send(poOwner,@SetWindowOverlay,#what=self);

         // This makes it take a hand slot again.
         viUse_amount = 1;

         vrShield_overlay = SoldierShield_icon_rsc;
         Send(poOwner,@SetOverlay,#what=self);
      }

      return;
   }

   IsOnBack()
   "Is this shield being worn on the back?"
   {
      return piOverlayHotspot = HS_SHIELD_BACK;
   }

   GetWindowOverlayHotspot()
   {
      // turns off the window overlay if unused or on our back
      if piUsed = UNUSED
         OR piOverlayHotspot = HS_SHIELD_BACK
      {
         return 0;
      }

      return HS_SW;
   }

   //// Misc. Infrastructure

   EmblemHeld()
   "The emblem drawn on the shield held: an insignia's (ChangeGuildInsignia), else the liege's."
   {
      if prInsig_held <> $
      {
         return prInsig_held;
      }

      return prShield_emblem_held;
   }

   EmblemDrop()
   {
      if prInsig_drop <> $
      {
         return prInsig_drop;
      }

      return prShield_emblem_drop;
   }

   EmblemBack()
   "Slung on the back: an insignia's back art if it has one (the lieges' and Shal'ille's), else "
   "the liege's."
   {
      if prInsig_back <> $
      {
         return prInsig_back;
      }

      return prShield_emblem_back;
   }

   HasInsignia()
   {
      return piInsigniaType <> INSIG_NONE;
   }

   ChangeGuildInsignia(insignia = INSIG_NONE)
   "Ours (2026-10-30): a temple's sign or a liege's seal on the shield, as on a guild shield "
   "(QuestBook QRW_INSIGNIA), but for looks only: it gives no spellpower. Its liege's own seal, "
   "or INSIG_NONE, shows its own emblem again."
   {
      local lArt;

      // [ held, on the ground, slung on the back ($: the liege's own) ]
      lArt = $;
      if insignia = INSIG_RIIJA
      {
         lArt = [ soldshield_insig_riija_over, soldshield_insig_riija, $ ];
      }
      else if insignia = INSIG_QOR
      {
         lArt = [ soldshield_insig_qor_over, soldshield_insig_qor, $ ];
      }
      else if insignia = INSIG_KRAANAN
      {
         lArt = [ soldshield_insig_kraanan_over, soldshield_insig_kraanan, $ ];
      }
      else if insignia = INSIG_FAREN
      {
         lArt = [ soldshield_insig_faren_over, soldshield_insig_faren, $ ];
      }
      else if insignia = INSIG_JALA
      {
         lArt = [ soldshield_insig_jala_over, soldshield_insig_jala, $ ];
      }
      else if insignia = INSIG_SHALILLE
      {
         lArt = [ soldshield_insig_shalille_over, soldshield_insig_shalille,
                  soldshield_insig_shalille_back ];
      }
      else if insignia = INSIG_DUKE AND viFaction <> FACTION_DUKE
      {
         lArt = [ soldshield_insig_duke_over, soldshield_insig_duke,
                  soldshield_insig_duke_back ];
      }
      else if insignia = INSIG_PRINCESS AND viFaction <> FACTION_PRINCESS
      {
         lArt = [ soldshield_insig_princess_over, soldshield_insig_princess,
                  soldshield_insig_princess_back ];
      }
      else if insignia = INSIG_REBEL AND viFaction <> FACTION_REBEL
      {
         lArt = [ soldshield_insig_rebel_over, soldshield_insig_rebel,
                  soldshield_insig_rebel_back ];
      }

      piInsigniaType = INSIG_NONE;
      prInsig_held = $;
      prInsig_drop = $;
      prInsig_back = $;
      if lArt <> $
      {
         piInsigniaType = insignia;
         prInsig_held = First(lArt);
         prInsig_drop = Nth(lArt,2);
         prInsig_back = Nth(lArt,3);
      }

      if poOwner <> $
      {
         Post(poOwner,@SomethingChanged,#what=self);
      }

      // Ours (2026-10-30): worn, everyone in the room sees the new sign at once (as
      //  Player.SetOverlay tells them), not only once the shield is worn again
      if poOwner <> $
         AND IsClass(poOwner,&Battler)
         AND Send(poOwner,@GetOwner) <> $
      {
         Send(Send(poOwner,@GetOwner),@SomethingChanged,#what=poOwner);
      }

      return;
   }

   AppendDesc()
   "Ours (the faction revamp): the owner's renown rank, renown and war record; and a god's sign "
   "it bears."
   {
      local lRecord;

      if piInsigniaType = INSIG_RIIJA { AddPacket(4,soldshield_insig_desc_riija); }
      else if piInsigniaType = INSIG_QOR { AddPacket(4,soldshield_insig_desc_qor); }
      else if piInsigniaType = INSIG_KRAANAN { AddPacket(4,soldshield_insig_desc_kraanan); }
      else if piInsigniaType = INSIG_FAREN { AddPacket(4,soldshield_insig_desc_faren); }
      else if piInsigniaType = INSIG_JALA { AddPacket(4,soldshield_insig_desc_jala); }
      else if piInsigniaType = INSIG_SHALILLE { AddPacket(4,soldshield_insig_desc_shalille); }

      if poOwner = $
         OR NOT IsClass(poOwner,&Player)
      {
         return;
      }

      lRecord = Send(poOwner,@GetWarRecord);
      AddPacket(4,SoldierShield_renown_desc,
                4,Send(poOwner,@GetRenownRankName),4,vrArmyName,
                4,Send(poOwner,@GetFactionRenown),
                4,Nth(lRecord,1),4,Nth(lRecord,2),4,Nth(lRecord,3),4,Nth(lRecord,4));

      return;
   }

   // Copied from Shield superclass so we don't take damage.
   DefendingHit()
   "Called when the item provides defense."
   {
      piUsed = DEFENDING;
      if vrShield_window_overlay <> $
         AND piOverlayHotspot <> HS_SHIELD_BACK
      {
         Send(poOwner,@ChangeWindowOverlay,#what=self);
      }

      if vrShield_overlay <> $
      {
         piUsed = USED;
      }

      // Return here so that the item doesn't take damage.
      return;
   }

   GetBlockAbility(who = $)
   {
      // No blocking if it's slung on our back.
      if piOverlayHotspot = HS_SHIELD_BACK
      {
         return 0;
      }

      propagate;
   }

   // Copied from DefenseModifier superclass, ignores shield's Block
   //  requirement.
   ModifyDefenseDamage(who = $,what = $,damage = $,atype = 0,aspell = 0)
   "Affects damage done to owner."
   {
      local iDamageReduce;

      iDamageReduce = 0;
      if piDamage_reduce <> 0
      {
         iDamageReduce = random(piDamage_reduce*33,piDamage_reduce*100);
         iDamageReduce = bound(iDamageReduce,0,(damage-100));
      }

      if aspell <> 0
      {
         // Reduce damage if part of the damage is spell
         if atype <> 0
         {
            // Lose 1/3 of the damage reduction if we're doing both weapon
            //  and spell damage types.
            iDamageReduce = iDamageReduce * 2 / 3;
         }
         else
         {
            // If we're doing pure spell damage, we get no reduction.
            iDamageReduce = 0;
         }
      }

      return damage - iDamageReduce;
   }

   GetHeatDamage()
   {
      return 2;
   }

   GetBaseSpellModifier(oSpell=$)
   {
      return 0;
   }

   // No mending, since it never gets damaged, really.
   CanMend()
   {
      return FALSE;
   }

   // No shattering or swapping the item.
   CanShatter()
   {
      return FALSE;
   }

   CanSwap()
   {
      return FALSE;
   }

   // Should be handled by ReqNewOwner, but this is just for sanity.
   DropOnDeath()
   {
      return FALSE;
   }

   //// Overlay and Animation stuff.

   GetOverlay()
   {
      return vrShield_overlay;
   }

   GetOverlayHotspot()
   {
      return piOverlayHotspot;
   }

   GetNumberOverlays()
   {
      if (piOverlayHotspot = HS_LEFT_WEAPON
          AND Send(self,@EmblemHeld) <> $)
         OR (piOverlayHotspot = HS_SHIELD_BACK
             AND Send(self,@EmblemBack) <> $)
      {
         return 2;
      }

      return 1;
   }

   SendOverlayInformation(iAnimation = $)
   {
      AddPacket(4,vrShield_Overlay);
      AddPacket(1,piOverlayHotspot);
      Send(self,@SendHeldAnimation,#iAnimation=iAnimation);

      if piOverlayHotspot = HS_LEFT_WEAPON
      {
         if Send(self,@EmblemHeld) <> $
         {
            AddPacket(4,Send(self,@EmblemHeld));
            AddPacket(1,piOverlayHotspot);
            AddPacket(1,ANIMATE_NONE, 2,1);
         }
      }
      else
      {
         // Therefore, piOverlayHotspot = HS_SHIELD_BACK
         if Send(self,@EmblemBack) <> $
         {
            // Shields slung on the back use a different hotspot for the emblem
            //  due to overlay priorities.
            AddPacket(4,Send(self,@EmblemBack));
            AddPacket(1,piOverlayHotspot);
            if iAnimation = PANM_BOW_FIRE
            {
               // Uses group 2 for animation
               AddPacket(1,ANIMATE_ONCE, 4,1200, 2,2, 2,2, 2,1);
            }
            else
            {
               // Default: Group 1
               AddPacket(1,ANIMATE_NONE, 2,1);
            }
         }
      }

      return;
   }

   SendHeldAnimation(iAnimation=$)
   {
      local XLAT;

      XLAT = Send(self,@GetPaletteTranslation);
      AddPacket(1,ANIMATE_TRANSLATION,1,XLAT);

      if piOverlayHotspot = HS_LEFT_WEAPON
      {
         AddPacket(1,ANIMATE_NONE,2,2);
      }
      else
      {
         // Therefore, piOverlayHotspot = HS_SHIELD_BACK
         if iAnimation = PANM_BOW_FIRE
         {
            // Uses group 5 for animation
            AddPacket(1,ANIMATE_ONCE,4,1200,2,5,2,5,2,1);
         }
         else
         {
            // Default: group 1
            AddPacket(1,ANIMATE_NONE,2,1);
         }
      }

      return;
   }

   SendAnimation()
   {
      local XLAT;

      XLAT = Send(self,@GetPaletteTranslation);
      AddPacket(1,ANIMATE_TRANSLATION,1,XLAT);
      AddPacket(1,ANIMATE_NONE,2,viGround_group);

      return;
   }

   SendWindowOverlayAnimation()
   {
      local XLAT;

      XLAT = Send(self,@GetPaletteTranslation);
      AddPacket(1,ANIMATE_TRANSLATION,1,XLAT);

      if piUsed = DEFENDING
      {
         AddPacket(1,ANIMATE_ONCE, 4,1000, 2,2, 2,2, 2,1);

         return;
      }

      AddPacket(1,ANIMATE_NONE, 2,1);

      return;
   }

   SendOverlays()
   {
      if Send(self,@EmblemDrop) <> $
      {
         AddPacket(1,1);
         AddPacket(4,Send(self,@EmblemDrop), 1,1, 1,ANIMATE_NONE, 2,2);
      }
      else
      {
         AddPacket(1,0);
      }

      return;
   }

   SendLookAnimation()
   {
      local XLAT;

      XLAT = Send(self,@GetPaletteTranslation);
      AddPacket(1,ANIMATE_TRANSLATION,1,XLAT);

      AddPacket(1,ANIMATE_NONE, 2,viInventory_group);

      return;
   }

   SendLookOverlays()
   {
      if Send(self,@EmblemDrop) <> $
      {
         AddPacket(1,1);
         AddPacket(4,Send(self,@EmblemDrop), 1,1, 1,ANIMATE_NONE, 2,1);
      }
      else
      {
         AddPacket(1,0);
      }

      return;
   }

   SendInventoryAnimation()
   {
      Send(self,@SendLookAnimation);

      return;
   }

   SendInventoryOverlays()
   {
      Send(self,@SendLookOverlays);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
