PrincessShield is SoldierShield

// Health: as every soldier's shield, 5 a rank (SoldierShield.UpdateRankPowers). Until 2026-10-30
// it raised Intellect, Mysticism and Aim instead (RemoveOldStats takes that off).
// Special bonus: spellpower to all spells, as the Duke's (2026-10-30; it was a mana cut and
// defence): 1.5 a shield rank (renown / 10), 1 to 15.

constants:

   include blakston.khd

resources:

   include prinshld.lkod

   PrincessShield_name_rsc = "shield of the Princess' army"

   PrincessShield_desc_rsc = \
      "This shield identifies you as a proud member of the Princess' army."

   PrincessShield_ArmyName = "the Royal army"

   PrincessShield_emblem_over = gshprov.bgf
   PrincessShield_emblem_drop = gshpr.bgf
   PrincessShield_emblem_back = gshprbk.bgf

   PrincessShield_welcome_mail = "Subject: Welcome to the Royal army.\nGreetings. I welcome you as a new ally in "
      "our fight to keep the throne from the forces that would see us come to harm.\n\n"
      "SOLDIER SHIELD: Your shield is the sign that you are an official part of the "
      "Royal army. While you wear it, the Duke's soldiers and the rebels may attack you "
      "anywhere but a guild hall, and you may attack them, without fear of penalty. You "
      "may put it away when you are not fighting, though not in the midst of a fight.\n\n"
      "DEATH IN BATTLE: A soldier who falls loses nothing but a little renown, though "
      "their weapon and armour break: any smith can mend them. You will have ten "
      "minutes to regroup before the enemy may strike you again. Attacking a fellow "
      "soldier of the Crown will vex me greatly: it costs you renown, and with none "
      "left, your place in my service.\n\n"
      "RANKS: Your rank is the renown you have earned. Win battles, claim flagpoles for "
      "the Crown and defeat enemy soldiers, and you will be promoted. Your renown will "
      "not fade while you serve me.\n\n"
      "ABILITIES: As a soldier of the Crown, you will be hardier, and Shal'ille's light "
      "will strengthen all your spells. These gifts grow with your rank.\n\n"
      "THE WAR: Our army takes the field every two hours. Stand with it, shield on, and "
      "you will be rewarded whether we win or lose. Only soldiers may carry the flags "
      "in my chambers and claim territory for the Crown.\n\n"
      "May Shal'ille guide your actions to ensure our victory!\n\n"
      "Signed, The Princess Kateriina, regent to Meridian."

classvars:

   vrName = PrincessShield_name_rsc
   vrDesc = PrincessShield_desc_rsc

   prShield_emblem_held = PrincessShield_emblem_over
   prShield_emblem_drop = PrincessShield_emblem_drop
   prShield_emblem_back = PrincessShield_emblem_back

   viFaction = FACTION_PRINCESS
   viColor = XLAT_TO_ORANGE

   // Stuff for rank
   vrArmyName = PrincessShield_ArmyName

   vrWelcomeMessage = PrincessShield_welcome_mail

properties:

   piIntellectChange = 0
   piMysticismChange = 0
   piAimChange = 0

messages:

   RemoveOldStats()
   "Ours (2026-10-30): the stats this shield used to raise, taken back off a shield worn from "
   "before. Their properties can go once no saved shield gives any."
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         // Reset owner's stats
         Send(poOwner,@AddIntellect,#points=-piIntellectChange);
         Send(poOwner,@AddMysticism,#points=-piMysticismChange);
	     Send(poOwner,@AddAim,#points=-piAimChange);
         piIntellectChange = 0;
         piMysticismChange = 0;
	     piAimChange = 0;
      }

      return;
   }

   GetBaseSpellModifier(oSpell=$)
   "Ours (2026-10-30): as the Duke's shield."
   {
      return (15 * piFactionRank) / 10;
   }

end
////////////////////////////////////////////////////////////////////////////////