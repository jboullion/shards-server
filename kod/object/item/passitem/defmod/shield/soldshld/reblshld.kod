RebelShield is SoldierShield

// Health: as every soldier's shield, 5 a rank (SoldierShield.UpdateRankPowers). Until 2026-10-30
// it raised Might, Aim and Agility instead (RemoveOldStats takes that off).
// Special bonus: absorbs damage, its piDamage_reduce one more than the rank (2 to 7; SoldierShield's
// ModifyDefenseDamage takes a third to all of it off a hit).

constants:

   include blakston.khd

resources:

   include reblshld.lkod

   RebelShield_name_rsc = "shield of the rebel militia"

   RebelShield_desc_rsc = \
      "This shield identifies you as a soldier of the rebel militia under Jonas."

   RebelShield_ArmyName = "the rebel militia"

   RebelShield_emblem_over = gshreov.bgf
   RebelShield_emblem_drop = gshre.bgf
   RebelShield_emblem_back = gshrebk.bgf

   RebelShield_welcome_mail = "Subject: Welcome fellow freedom fighter.\nI am glad to see that you are willing "
      "to become more active in our fight for the future of these lands against the "
      "forces of tyranny. Read these rules and follow them.\n\n"
      "SOLDIER SHIELD: Your shield is the sign that you are an official part of the "
      "rebel militia. While you wear it, those bearing the colours of the Duke and the "
      "Princess may attack you anywhere but a guild hall, and you them, with no penalty "
      "either way. Put it away when you need rest, though not in the middle of a fight.\n\n"
      "DEATH IN BATTLE: Fall to the enemy and you lose a little renown, and your weapon "
      "and armour break: a smith can mend them. You will have ten minutes to regroup "
      "before their soldiers may strike you again. Attacking one of our own costs you "
      "renown, and with none left, you are expelled from the militia.\n\n"
      "RANKS: Your position within our forces is your renown. Win battles, claim "
      "flagpoles for the cause and defeat enemy soldiers, and you will rise. Renown "
      "does not fade. Simple enough?\n\n"
      "ABILITIES: You will receive a soldier's training. Rigorous exercise will make "
      "you tougher, and I will teach you to turn aside the enemy's blows. The higher "
      "your rank, the more time I will spend on you.\n\n"
      "THE WAR: We fight for the flagpoles every two hours. Be there, shield on, and "
      "you will be paid, win or lose. Only soldiers may carry the flags in Pietro's and "
      "claim territory.\n\n"
      "Your brother in arms,\n\n"
      "Jonas D'Accor"

classvars:

   vrName = RebelShield_name_rsc
   vrDesc = RebelShield_desc_rsc

   prShield_emblem_held = RebelShield_emblem_over
   prShield_emblem_drop = RebelShield_emblem_drop
   prShield_emblem_back = RebelShield_emblem_back

   viDamage_base = 2                // This is the default value for piDamage_reduce

   viFaction = FACTION_REBEL
   viColor = XLAT_TO_RED

   // Stuff for rank
   vrArmyName = RebelShield_ArmyName

   vrWelcomeMessage = RebelShield_welcome_mail

properties:

   piMightChange = 0
   piAimChange = 0
   piAgilityChange = 0

messages:

   RemoveOldStats()
   "Ours (2026-10-30): the stats this shield used to raise, taken back off a shield worn from "
   "before. Their properties can go once no saved shield gives any."
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         // Reset owner's stats
         Send(poOwner,@AddMight,#points=-piMightChange);
         Send(poOwner,@AddAim,#points=-piAimChange);
	     Send(poOwner,@AddAgility,#points=-piAgilityChange);
         piMightChange = 0;
         piAimChange = 0;
	     piAgilityChange = 0;
      }

      return;
   }

   ModifyDefenseDamage(who = $,what = $,damage = $,atype = 0,aspell = 0)
   "Sets piDamage_reduce for damage reduction in the superclass."
   {
      // Ours (2026-10-30): one more than the rank, 2 Recruit (as the other lieges' shields) to
      //  7 Champion
      piDamage_reduce = Send(self,@NamedRank) + 1;

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////