DukeShield is SoldierShield

// Health: as every soldier's shield, 5 a rank (SoldierShield.UpdateRankPowers). Until 2026-10-30
// it raised Intellect, Stamina and Agility instead (RemoveOldStats takes that off).
// Special bonus: spellpower to all spells, 1.5 a shield rank (renown / 10): 1 to 15.

constants:

   include blakston.khd

resources:

   include dukeshld.lkod

   DukeShield_name_rsc = "shield of the Duke's army"

   DukeShield_desc_rsc = \
      "This shield identifies you as an elite soldier of Duke Akardius' army."

   DukeShield_ArmyName = "the ducal army"

   DukeShield_emblem_over = gshdaov.bgf
   DukeShield_emblem_drop = gshda.bgf
   DukeShield_emblem_back = gshdabk.bgf

   DukeShield_welcome_mail = "Subject: You are now an elite soldier.\nWelcome to the army of the true leader "
      "of these lands. Your ambition suits you very well.\n\n"
      "SOLDIER SHIELD: Wear my shield and you are at war. The Princess's soldiers and "
      "Jonas's rabble may attack you wherever they find you outside a guild hall, as you may "
      "attack them, and neither of you answers for it. Put it away when you would rather be left "
      "alone, though not in the heat of a fight. Lose my favour and you lose the shield "
      "with it.\n\n"
      "DEATH IN BATTLE: Fall to the enemy and you lose nothing but your pride and a "
      "little renown, though your weapon and armour break in the fall: a smith will "
      "mend them. You will have ten minutes to regroup before their soldiers may strike "
      "you again. Do not turn on those loyal to me: it costs you renown, and with none "
      "left, your place in my service.\n\n"
      "RANKS: Your rank is your renown with me. Win my battles, claim flagpoles in my "
      "name and cut down the enemy's soldiers, and you will rise. Renown does not fade: "
      "what you earn, you keep.\n\n"
      "ABILITIES: In return for your loyal service, I will give you power. While you "
      "wear my shield, you will be harder to kill, and the darker aspects of magic will "
      "strengthen all your spells. These powers grow with your rank.\n\n"
      "THE WAR: My armies march on the flagpoles every two hours. Be there, shield on, "
      "and you will be paid, win or lose. Only soldiers may carry my flags and claim "
      "territory in my name.\n\n"
      "We will take the throne of this kingdom. You have given your support wisely.\n\n"
      "Akardius, Duke of Blackstone Keep"

classvars:

   vrName = DukeShield_name_rsc
   vrDesc = DukeShield_desc_rsc

   prShield_emblem_held = DukeShield_emblem_over
   prShield_emblem_drop = DukeShield_emblem_drop
   prShield_emblem_back = DukeShield_emblem_back

   viFaction = FACTION_DUKE
   viColor = XLAT_TO_PURPLE

   // Stuff for rank
   vrArmyName = DukeShield_ArmyName

   vrWelcomeMessage = DukeShield_welcome_mail

properties:

   piStaminaChange = 0
   piAgilityChange = 0
   piIntellectChange = 0

messages:

   RemoveOldStats()
   "Ours (2026-10-30): the stats this shield used to raise, taken back off a shield worn from "
   "before. Their properties can go once no saved shield gives any."
   {
      if poOwner <> $
         AND IsClass(poOwner,&User)
      {
         // Reset owner's stats
         Send(poOwner,@AddStamina,#points=-piStaminaChange);
         Send(poOwner,@AddAgility,#points=-piAgilityChange);
	     Send(poOwner,@AddIntellect,#points=-piIntellectChange);
         piStaminaChange = 0;
         piAgilityChange = 0;
	     piIntellectChange = 0;
      }

      return;
   }

   GetBaseSpellModifier(oSpell=$)
   {
      local iModifier;

      iModifier = ((15 * piFactionRank) / 10);

      return iModifier;
   }

end
////////////////////////////////////////////////////////////////////////////////