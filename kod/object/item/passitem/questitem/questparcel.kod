// Ours (Meridian Shards, docs/adr/0009-quests.md): what a deliver step gives you to carry, named
// by the quest (QuestBook.BeginStep), and taken back when you hand it in. A sabotage step's kit
// is one too (docs/adr/0021 Behind the Lines), used up on its target.

////////////////////////////////////////////////////////////////////////////////
QuestParcel is QuestItem

constants:

   include blakston.khd

resources:

   questparcel_name_rsc = "parcel"
   questparcel_icon_rsc = scr04.bgf
   questparcel_desc_rsc = "Something you've agreed to deliver.  It isn't yours to open."
   questparcel_kit_desc_rsc =       "What your liege gave you for the job.  Use whatever you were sent to wreck, and this will "
      "do the rest."

classvars:

   vrName = questparcel_name_rsc
   vrIcon = questparcel_icon_rsc
   vrDesc = questparcel_desc_rsc

   viDefinite = ARTICLE_NONE
   viIndefinite = ARTICLE_NONE

   viValue_average = 0
   // Weightless, so it always fits in the pack, overburdened or not (Holder.CanHoldWeightAndBulk
   // passes nothing at all): one left at your feet could decay and leave the quest stuck
   viWeight = 0
   viBulk = 0

properties:

   // The quest it's for, and what it's called
   piQuest = 0
   prParcelName = $
   // A sabotage step's kit, not something to deliver
   pbKit = FALSE

messages:

   Constructor(quest = 0, parcel_name = $, kit = FALSE)
   {
      piQuest = quest;
      prParcelName = parcel_name;
      pbKit = kit;

      propagate;
   }

   GetQuestId()
   {
      return piQuest;
   }

   DoBaseDesc()
   {
      if pbKit
      {
         AddPacket(4,questparcel_kit_desc_rsc);

         return;
      }

      propagate;
   }

   GetName()
   {
      if prParcelName <> $
      {
         return prParcelName;
      }

      return vrName;
   }

   GetTrueName()
   {
      return Send(self,@GetName);
   }

   GetApparentName()
   {
      return Send(self,@GetName);
   }

end
////////////////////////////////////////////////////////////////////////////////
