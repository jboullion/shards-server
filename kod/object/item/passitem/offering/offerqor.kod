////////////////////////////////////////////////////////////////////////////////
OfferingQor is Offering

constants:

   include blakston.khd

resources:

   include offerqor.lkod

   OfferingQor_name_rsc = "blood of the innocent"
   OfferingQor_icon_rsc = bloodinn.bgf
   OfferingQor_desc_rsc = \
      "A dark vial that never quite stops trembling, sacred to Qor.  Left at one of the "
      "realm's shrines, it would give the shrine to the Dark Mistress for a day.  It is "
      "said that six such offerings, one for each god, can open stranger doors than a "
      "shrine's."

classvars:         

   vrName = OfferingQor_name_rsc
   vrIcon = OfferingQor_icon_rsc
   vrDesc = OfferingQor_desc_rsc

   vrAllegiance = SS_QOR
   viIndefinite = ARTICLE_THE

   viGround_group = 1
   
   viValue_average = 10000

properties:  

messages:   

end
