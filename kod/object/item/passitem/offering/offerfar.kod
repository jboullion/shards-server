////////////////////////////////////////////////////////////////////////////////
OfferingFaren is Offering

constants:

   include blakston.khd

resources:

   include offerfar.lkod

   OfferingFaren_name_rsc = "burning water"
   OfferingFaren_icon_rsc = burnwate.bgf
   OfferingFaren_desc_rsc = \
      "A vial of water that burns without heat, sacred to Faren.  Left at one of the "
      "realm's shrines, it would turn the shrine, and the elements' favour, to Faren for a "
      "day."

classvars:         

   vrName = OfferingFaren_name_rsc
   vrIcon = OfferingFaren_icon_rsc
   vrDesc = OfferingFaren_desc_rsc
   viIndefinite = ARTICLE_NONE

   vrAllegiance = SS_FAREN  

   viValue_average = 10000

properties:  

messages:   

end
////////////////////////////////////////////////////////////////////////////////

