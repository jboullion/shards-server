////////////////////////////////////////////////////////////////////////////////
OfferingJala is Offering

constants:

   include blakston.khd

resources:

   include offerjal.lkod

   OfferingJala_name_rsc = "mystic perfume"
   OfferingJala_icon_rsc = solagh.bgf
   OfferingJala_desc_rsc = \
      "A little bottle of perfume that hums faintly, sacred to Jala.  Left at one of the "
      "realm's shrines, it would give the shrine to the Lady of Song for a day, and every "
      "bard's music would carry further."

classvars:

   vrName = OfferingJala_name_rsc
   vrIcon = OfferingJala_icon_rsc
   vrDesc = OfferingJala_desc_rsc

   vrAllegiance = SS_JALA
   
   viValue_average = 10000

properties:

messages:

end
////////////////////////////////////////////////////////////////////////////////

