////////////////////////////////////////////////////////////////////////////////
OfferingKraanan is Offering

constants:

   include blakston.khd

resources:

   include offerkra.lkod

   OfferingKraanan_name_rsc = "sweat of the warrior king"
   OfferingKraanan_icon_rsc = sweat.bgf
   OfferingKraanan_desc_rsc = \
      "A stoppered flask of a champion's sweat, sacred to Kraanan.  Left at one of the "
      "realm's shrines, it would claim the shrine for the Warrior King for a day, and the "
      "arts of war would come easier to all."

classvars:         

   vrName = OfferingKraanan_name_rsc
   vrIcon = OfferingKraanan_icon_rsc
   vrDesc = OfferingKraanan_desc_rsc

   vrAllegiance = SS_KRAANAN
   viIndefinite = ARTICLE_THE

   viValue_average = 10000

properties:  

   viGround_group = 2

messages:   

end
////////////////////////////////////////////////////////////////////////////////

