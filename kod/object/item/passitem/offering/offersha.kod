////////////////////////////////////////////////////////////////////////////////
OfferingShalille is Offering

constants:

   include blakston.khd

resources:

   include offersha.lkod

   OfferingShalille_name_rsc = "tears of a newborn"
   OfferingShalille_icon_rsc = tear.bgf
   OfferingShalille_desc_rsc = \
      "A tiny vial of tears, warm to the touch, sacred to Shal'ille.  Left at one of the "
      "realm's shrines, it would turn the shrine to the Lady of Light for a day, and her "
      "magic would run stronger in every hand."

classvars:         

   vrName = OfferingShalille_name_rsc
   vrIcon = OfferingShalille_icon_rsc
   vrDesc = OfferingShalille_desc_rsc

   vrAllegiance = SS_SHALILLE
   viIndefinite = ARTICLE_THE

   viGround_group = 2

   viValue_average = 10000

properties:  

messages:   

end
////////////////////////////////////////////////////////////////////////////////

