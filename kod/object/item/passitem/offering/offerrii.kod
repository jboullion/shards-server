////////////////////////////////////////////////////////////////////////////////
OfferingRiija is Offering

constants:

   include blakston.khd

resources:

   include offerrii.lkod

   offeringRiija_name_rsc = "bottle of lies"
   offeringRiija_icon_rsc = lies.bgf
   offeringRiija_desc_rsc = \
      "A bottle that looks full or empty depending on who is asking, sacred to Riija.  "
      "Left at one of the realm's shrines, it would hand the shrine to the Lord Fool for a "
      "day, for the benefit of every trickster in the land."

classvars:         

   vrName = offeringRiija_name_rsc
   vrIcon = offeringRiija_icon_rsc
   vrDesc = offeringRiija_desc_rsc

   vrAllegiance = SS_RIIJA
   viGround_group = 2

   viValue_average = 10000

properties:  

messages:   

end
////////////////////////////////////////////////////////////////////////////////

