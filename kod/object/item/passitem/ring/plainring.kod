////////////////////////////////////////////////////////////////////////////////
// Ours (the magic item revamp, phase 3): a plain ring, the base random jewellery magic is put
// on (its armor attributes: warding, resistance, focus, vitality). It has no magic of its own,
// so unlike other rings it isn't a "magical ring" until revealed: its attributes are what's
// hidden. Two can be worn at once, one on each hand.

PlainRing is Ring

constants:

   include blakston.khd

resources:

   plainring_name_rsc = "plain ring"
   plainring_icon_rsc = plainring.bgf
   plainring_desc_rsc = "A plain, wide band of polished silver."

classvars:

   vrRealName = plainring_name_rsc
   vrRealDesc = plainring_desc_rsc
   vrIcon = plainring_icon_rsc

   viBulk = 2
   viWeight = 3

   viValue_average = 100

properties:

   vrName = plainring_name_rsc
   vrDesc = plainring_desc_rsc

messages:

   // Worn, it counts with the wearer's armor, so its attributes' defense (Warding) counts
   // (Player.GetDefense asks every defense modifier)

   NewUsed(what = $)
   {
      if what <> $ AND IsClass(what,&Player)
      {
         Send(what,@AddDefenseModifier,#what=self);
      }

      propagate;
   }

   NewUnused(what = $)
   {
      if what <> $ AND IsClass(what,&Player)
      {
         Send(what,@RemoveDefenseModifier,#what=self);
      }

      propagate;
   }

   ModifyDefensePower(who = $,what = $,defense_power = 0)
   {
      return defense_power + Send(self,@GetAttributeDefense);
   }

   ModifyDefenseDamage(who = $,what = $,damage = $,atype = 0,aspell = 0)
   {
      return damage;
   }

   DefendingHit(who = $,what = $)
   "Jewellery doesn't wear."
   {
      return;
   }

   ReqUseSomething(what = $)
   "Ring won't have two of a kind on; a plain ring's magic is its own, so two may be."
   {
      if IsClass(what,&PlainRing)
      {
         return TRUE;
      }

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
