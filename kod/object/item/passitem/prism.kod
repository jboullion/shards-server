////////////////////////////////////////////////////////////////////////////////
// Ours (ADR 0022 decision 34, 2026-10-26): a guild artifact. It focused the group spells, which
// are gone; now a guild's Lord sets it on the pedestal in their hall ("prism place",
// GuildHall.HallCommandSaid), and as many members as it has sides attune to it and get its
// colour's bonus (spell/prismatt.kod). The sides are rolled rarest at 7; the colour evenly.
Prism is PassiveItem

constants:

   include blakston.khd

resources:

   prism_name_emerald = "emerald prism"
   prism_name_ruby = "ruby prism"
   prism_name_sapphire = "sapphire prism"
   prism_name_amber = "amber prism"
   prism_name_amethyst = "amethyst prism"
   prism_name_pearl = "pearl prism"

   prism_1_icon_rsc = prism1.bgf
   prism_3_icon_rsc = prism3.bgf
   prism_5_icon_rsc = prism5.bgf
   prism_7_icon_rsc = prism7.bgf

   prism_desc_rsc = \
      "When held up to the light, this prism refracts a pretty rainbow of colours.  Set upon "
      "the pedestal in a guild's hall, it binds the guild's members to one another: as many "
      "of them as it has sides may attune themselves to it, and gain its gift for as long as "
      "it stands there.  This prism has %i %s, and its colour %s"
   prism_side = "side"
   prism_sides = "sides"

   prism_bonus_emerald = "quickens learning: those attuned gain 5 percent more experience."
   prism_bonus_ruby = "hardens the body: those attuned have 5 more health."
   prism_bonus_sapphire = "deepens the mind: those attuned have 5 more mana."
   prism_bonus_amber = "steadies the arm: those attuned deal 3 percent more damage with weapons."
   prism_bonus_amethyst = "sharpens the will: those attuned cast with 3 more spellpower."
   prism_bonus_pearl = "soothes the body: those attuned recover health and mana 15 percent faster."

classvars:

   vrDesc = prism_desc_rsc

   viBulk = 10
   viWeight = 10
   viValue_average = 200

properties:

   vrName = prism_name_emerald
   vrIcon = prism_3_icon_rsc
   piNumSides = 3
   piColour = PRISM_COLOUR_EMERALD

messages:

   Constructor(numSides = 0, colour = 0)
   {
      Send(self,@SetNumSides,#numSides=numSides);
      Send(self,@SetColour,#colour=colour);

      propagate;
   }

   SetNumSides(numSides = 0)
   "1, 3, 5 or 7; 0 rolls them, the most sides the rarest: 45, 30, 18 and 7 in 100."
   {
      local iRoll;

      if numSides = 0
      {
         iRoll = Random(1,100);
         numSides = 7;
         if iRoll <= 45
         {
            numSides = 1;
         }
         else if iRoll <= 75
         {
            numSides = 3;
         }
         else if iRoll <= 93
         {
            numSides = 5;
         }
      }

      if numSides <= 2
      {
         piNumSides = 1;
         vrIcon = prism_1_icon_rsc;
      }
      else if numSides <= 4
      {
         piNumSides = 3;
         vrIcon = prism_3_icon_rsc;
      }
      else if numSides <= 6
      {
         piNumSides = 5;
         vrIcon = prism_5_icon_rsc;
      }
      else
      {
         piNumSides = 7;
         vrIcon = prism_7_icon_rsc;
      }

      return;
   }

   SetColour(colour = 0)
   "PRISM_COLOUR_*; 0 rolls one. The gem is drawn in it (its red or blue, translated)."
   {
      if colour < 1 OR colour > PRISM_COLOURS
      {
         colour = Random(1,PRISM_COLOURS);
      }

      piColour = colour;
      vrName = Nth([ prism_name_emerald, prism_name_ruby, prism_name_sapphire,
                     prism_name_amber, prism_name_amethyst, prism_name_pearl ],colour);
      Send(self,@SetPaletteTranslation,
           #translation=Send(SYS,@EncodeTwoColorXLAT,
                             #color1=Send(self,@GetColourXlat),
                             #color2=Send(self,@GetColourXlat)));

      return;
   }

   GetColourXlat()
   {
      return Nth([ XLAT_TO_GREEN, XLAT_TO_RED, XLAT_TO_BLUE, XLAT_TO_ORANGE, XLAT_TO_PURPLE,
                   XLAT_TO_GRAY ],piColour);
   }

   GetNumSides()
   {
      return piNumSides;
   }

   GetColour()
   {
      return piColour;
   }

   GetBonusText()
   {
      return Nth([ prism_bonus_emerald, prism_bonus_ruby, prism_bonus_sapphire,
                   prism_bonus_amber, prism_bonus_amethyst, prism_bonus_pearl ],piColour);
   }

   DoBaseDesc()
   {
      local rSides;

      rSides = prism_sides;
      if piNumSides = 1
      {
         rSides = prism_side;
      }

      AddPacket(4,vrDesc, 4,piNumSides, 4,rSides, 4,Send(self,@GetBonusText));

      return;
   }

   DestroyDisposable()
   {
      // Don't destroy prisms.
      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
