////////////////////////////////////////////////////////////////////////////////
WeaponAttribute is ItemAttribute

////////////////////////////////////////////////////////////////////////////////
//  Weapon Attributes, added 5 March 97 by Damion Schubert
//
//   The difference between a weapon attribute and an item attribute is simply
//   that these are affects that only affect weapons, and attempting to bind
//   them to a non-weapon will fail.  Examples include:
//      * Changing the attack type
//      * Poisoned weapons
//      * Splintering Weapons
//   Note also that many Weapon Attributes affect hit percentages and damage
//   amounts.  This, in fact, is a common usage of Weapon Attributes.  However,
//   this is more rare for item attributes.  If an item modifies damage or
//   hit percentage, that item needs to be added to the player's AttMod list.
//   Weapons do not.
//
//   Ours (the magic item revamp): every permanent weapon attribute carries a
//   tier in its power digit, slight to enormous (MAGIC_TIER_*), rolled from
//   the difficulty of whatever dropped it (RollTier). The weapon takes the
//   best tier's hit and damage bonus once (Weapon.GetMagicTier), on top of
//   whatever the attribute itself does. Attributes put on by spells (they
//   have a timer) carry no tier.
//
//   See item.kod for notes on implementation and structure used for ItemAtts
//   on a per item basis.
////////////////////////////////////////////////////////////////////////////////

constants:

   include blakston.khd

resources:

   include weapatt.lkod

   // Inside descriptions: "this weapon looks to provide %s advantage"
   weapatt_slight = "a slight"
   weapatt_moderate = "a moderate"
   weapatt_potent = "a potent"
   weapatt_enormous = "an enormous"

   // In a revealed weapon's full name
   weapatt_name_slight = "slight %s"
   weapatt_name_moderate = "moderate %s"
   weapatt_name_potent = "potent %s"
   weapatt_name_enormous = "enormous %s"

   // In the stats block
   weapatt_tier_slight = "Slight"
   weapatt_tier_moderate = "Moderate"
   weapatt_tier_potent = "Potent"
   weapatt_tier_enormous = "Enormous"
   weapatt_tier_info = "%s magic: +%i to hit, +%i damage\n"

classvars:

   // If TRUE, add the weaponatt power to description.
   vbPowerDesc = FALSE
   viDamage_bonus = 0

properties:

messages:

   SetItemsToAttribute()
   {
      // This is used by the weapon attribute when trestype decides
      //  to apply this weapatt to a weapon.  The number given is a
      //  very approximate percentage of the chance that that particular
      //  weapon will be the one created.  This will be modified by
      //  other factors, so that higher level characters are more likely
      //  to get better stuff.

      plItems_to_attribute = [ [ &Mace, 25 ],
                               [ &ShortSword, 25 ],
                               [ &Hammer, 15 ],
                               [ &Axe, 15 ],
                               [ &Longsword, 13 ],
                               [ &Scimitar, 4 ],
                               [ &MysticSword, 3 ]
                             ];
      return;
   }

////////////////////////////////////////////////
///
///  Weapon Tier
///
////////////////////////////////////////////////

   InitialPower(oItem=$,diff_seed=1)
   {
      return Send(self,@RollTier,#diff_seed=diff_seed);
   }

   RollTier(diff_seed=1)
   "A tier for a weapon found at this treasure difficulty (1-10). Odds in percent, "
   "slight / moderate / potent / enormous:\n"
   "   1-3: 70 / 30 /  0 /  0\n"
   "   4-6: 40 / 40 / 18 /  2\n"
   "   7-8: 15 / 40 / 35 / 10\n"
   "  9-10:  5 / 30 / 45 / 20"
   {
      local iRoll, lOdds, iTier, iOdds;

      diff_seed = Bound(diff_seed,1,10);

      if diff_seed <= 3
      {
         lOdds = [70, 30, 0, 0];
      }
      else if diff_seed <= 6
      {
         lOdds = [40, 40, 18, 2];
      }
      else if diff_seed <= 8
      {
         lOdds = [15, 40, 35, 10];
      }
      else
      {
         lOdds = [5, 30, 45, 20];
      }

      iRoll = Random(1,100);
      iTier = MAGIC_TIER_SLIGHT;
      foreach iOdds in lOdds
      {
         iRoll = iRoll - iOdds;
         if iRoll <= 0
         {
            return iTier;
         }

         iTier = iTier + 1;
      }

      return MAGIC_TIER_SLIGHT;
   }

   GetTier(lData=$)
   "This attribute's tier on a weapon (its node, lData), or MAGIC_TIER_NONE if it has "
   "none: it was put on by a spell and will wear off."
   {
      if lData = $
         OR Send(self,@HasTimer,#lData=lData)
      {
         return MAGIC_TIER_NONE;
      }

      return Bound(Send(self,@TranslatePowerFromCompound,#iCompound=First(lData)),
                   MAGIC_TIER_SLIGHT,MAGIC_TIER_ENORMOUS);
   }

   DecipherDamageFromPower(iPower=0)
   "A tier's damage bonus."
   {
      if iPower <= MAGIC_TIER_MODERATE
      {
         return 1;
      }

      if iPower = MAGIC_TIER_POTENT
      {
         return 2;
      }

      return 3;
   }

   DecipherHitRollFromPower(iPower=0)
   "A tier's to-hit bonus."
   {
      if iPower <= MAGIC_TIER_SLIGHT
      {
         return 25;
      }

      return 50;
   }

   GetPowerDesc(iPower=0)
   {
      if iPower <= MAGIC_TIER_SLIGHT { return weapatt_slight; }
      if iPower = MAGIC_TIER_MODERATE { return weapatt_moderate; }
      if iPower = MAGIC_TIER_POTENT { return weapatt_potent; }

      return weapatt_enormous;
   }

   GetTierNamePart(iPower=0)
   {
      if iPower <= MAGIC_TIER_SLIGHT { return weapatt_name_slight; }
      if iPower = MAGIC_TIER_MODERATE { return weapatt_name_moderate; }
      if iPower = MAGIC_TIER_POTENT { return weapatt_name_potent; }

      return weapatt_name_enormous;
   }

   GetTierWord(iPower=0)
   {
      if iPower <= MAGIC_TIER_SLIGHT { return weapatt_tier_slight; }
      if iPower = MAGIC_TIER_MODERATE { return weapatt_tier_moderate; }
      if iPower = MAGIC_TIER_POTENT { return weapatt_tier_potent; }

      return weapatt_tier_enormous;
   }

   //// Effect Functions

   ModifyDamage(damage=0,target=$,wielder=$)
   "Item Attributes, in general, should only + or - damage."
   {
      return damage;
   }

   ModifyHitRoll(hitroll=0,target=$,wielder=$)
   "Item Attributes, in general, should only + or - damage."
   {
      return hitroll;
   }

   //// Infrastructure (Adding and removing a ItemAtt from an item.)

   AppendDesc(oItem=$,lData=$)
   {
      local iPower;

      if vbPowerDesc
      {
         iPower = MAGIC_TIER_SLIGHT;
         if lData <> $
         {
            iPower = Send(self,@TranslatePowerFromCompound,
                           #iCompound=First(lData));
         }

         AddPacket(4,vrDesc, 4,Send(self,@GetPowerDesc,#iPower=iPower));

         return;
      }

      propagate;
   }

   GetInfoDesc()
   "Every weapon attribute can show the weapon's tier in the stats block."
   {
      return weapatt_tier_info;
   }

   AppendDescInfo(oItem = $,compound = $)
   "Once revealed: the weapon's tier line, if this attribute is the one that sets it "
   "(Weapon.GetMagicTierAttribute), then what this attribute does (AppendOwnInfo)."
   {
      local iTier;

      if NOT Send(oItem,@GetIDStatusFromCompound,#compound=compound)
      {
         AddPacket(4,system_blank_resource);

         return;
      }

      if Send(oItem,@GetMagicTierAttribute) = self
      {
         iTier = Send(oItem,@GetMagicTier);
         AddPacket(4,system_rsc_template_2,
                   4,weapatt_tier_info, 4,Send(self,@GetTierWord,#iPower=iTier),
                   4,Send(self,@DecipherHitRollFromPower,#iPower=iTier),
                   4,Send(self,@DecipherDamageFromPower,#iPower=iTier));
      }

      Send(self,@AppendOwnInfo,#oItem=oItem);

      return;
   }

   AppendOwnInfo(oItem=$)
   "What this attribute does, for the stats block; one resource and its parameters."
   {
      AddPacket(4,vrInfoDesc);

      return;
   }

   ReqAddToItem(oItem=$)
   {
      if IsClass(oItem,&Weapon)
      {
         return TRUE;
      }

      return FALSE;
   }

end
////////////////////////////////////////////////////////////////////////////////
