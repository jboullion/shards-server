////////////////////////////////////////////////////////////////////////////////
WeapAttPoison is WeaponAttribute

///////////////////////////////////////////////////////////////////////
//
//  This weapon has a chance to blind the opponent every time it does
//     damage.
//
//  Form is:
//
//      [ WA_POISON]
//
///////////////////////////////////////////////////////////////////////

constants:

   include blakston.khd

resources:

   weapattPoison_desc = \
      "\n\nA pungent toxin seeps down the metal of the weapon."
   Poison_fail_use = "You are not yet ready to use %s%s."
   Poison_worked = "%s%s grasp the wound, screaming as the venom enters!"
   Poison_burned = "Your venom burns into %s%s!"
   Poison_dm = "Poison"
   Poison_info_desc = "15%% chance on hit to poison a player, or to burn a monster for 10 to 30 more damage\n"
   weapattpoison_name = "%s of venom"

classvars:

   viMagicColour = MAGIC_COLOUR_GREEN

   vrDesc = weapattPoison_desc
   vrInfoDesc = Poison_info_desc
   vrName = weapattpoison_name
   viNameKind = ITEMATT_NAME_SUFFIX
   viItem_Att_Num = WA_POISON

   viDifficulty = 9
   vrDM_trigger = Poison_dm

properties:

   piValue_modifier = 200   /// modify the object's price by 100//
   piValue_power_modifier = 10
   piEffect_percent = 15

messages:

////////////////////////////////////////////////
///
///  Effect Functions
///
////////////////////////////////////////////////

   ModifyDamage(damage=0,target=$,wielder=$,lData=$)
   "Wielder has a piEffect_percent chance with any hit of poisoning a player. Ours: poison is "
   "players' alone (Poison.MakePoisoned), so a monster takes the venom as more damage at once."
   {
      local oSpell, iduration, iamount;

      if target = $
         OR wielder = $
      {
         return damage;
      }

      if Random(1,100) <= piEffect_percent
      {
         if NOT IsClass(target,&Player)
         {
            Send(wielder,@MsgSendUser,#message_rsc=Poison_burned,
                 #parm1=Send(target,@GetDef),#parm2=Send(target,@GetName));

            return damage + Random(10,30);
         }

         iamount     = Random(2500,6500);
         iduration   = Random(80000,180000);

         oSpell = Send(SYS,@FindSpellByNum,#num=SID_POISON);
            
         send(oSpell,@MakePoisoned,#who=target,
               #lossrate=iamount,#duration=iduration);

            Send(wielder,@MsgSendUser,#message_rsc=Poison_worked,
                 #parm1=Send(target,@GetCapDef),#parm2=Send(target,@GetName),
                 #parm3=Send(target,@GetHisher));
      }

      return Damage;
   }

   IsMagicalEffect()
   {
      return TRUE;
   }

end
////////////////////////////////////////////////////////////////////////////////
