////////////////////////////////////////////////////////////////////////////////
WeapAttCeremonial is WeaponAttribute

///////////////////////////////////////////////////////////////////////
//
//   This Weapon Attribute offers a +Power bonus in the arena (ours: and no
//   longer a penalty anywhere else).  Power is the weapon's tier, from the
//   WeapAtt tier table.
//
//  Form is:
//
//       [ WA_CEREMONIAL ]
//
///////////////////////////////////////////////////////////////////////

constants:

   include blakston.khd

resources:

   include wacerem.lkod

   weapattcerem_desc = \
      "\n\nBeautiful and ornate, this weapon is obviously unsuitable for blood "
      "combat, though it might provide %s edge in games and tourneys."
   weapatt_ceremonial_name = "ceremonial %s"
   weapatt_ceremonial_info = "In the arena: +%i to hit and +%i damage more\n"
   ceremonial_dm = "ceremonial"

classvars:

   vrDesc = weapattcerem_desc
   vbPowerDesc = TRUE
   viItem_Att_Num = WA_CEREMONIAL
   viDamage_bonus = 2
   viDifficulty = 5
   vrDM_Trigger = ceremonial_dm
   vrName = weapatt_ceremonial_name
   viNameKind = ITEMATT_NAME_PREFIX
   vrInfoDesc = weapatt_ceremonial_info

properties:

   piValue_modifier = 150   /// modify the object's price by 100//
   piValue_power_modifier = 5

messages:

////////////////////////////////////////////////
///
///  Effect Functions
///
////////////////////////////////////////////////

   // Ours (the magic item revamp): the tier's bonus again in the arena, and no penalty
   // anywhere else.

   ModifyHitRoll(hitroll=0,target=$,wielder=$,lData=$)
   {
      local oRoom, iPower;

      if wielder = $
      {
         return hitroll;
      }

      oRoom = Send(wielder,@GetOwner);
      if oRoom = $
         OR NOT Send(oRoom,@CheckRoomFlag,#flag=ROOM_SAFE_DEATH)
      {
         return hitroll;
      }

      iPower = Send(self,@TranslatePowerFromCompound,#iCompound=First(lData));

      return hitroll + Send(self,@DecipherHitRollFromPower,#iPower=iPower);
   }

   ModifyDamage(damage=0,target=$,wielder=$,lData=$)
   {
      local oRoom, iPower;

      if wielder = $
      {
         return damage;
      }

      oRoom = Send(wielder,@GetOwner);
      if oRoom = $
         OR NOT Send(oRoom,@CheckRoomFlag,#flag=ROOM_SAFE_DEATH)
      {
         return damage;
      }

      iPower = Send(self,@TranslatePowerFromCompound,#iCompound=First(lData));

      return damage + Send(self,@DecipherDamageFromPower,#iPower=iPower);
   }

   AppendOwnInfo(oItem=$)
   {
      local iPower;

      iPower = Send(self,@TranslatePowerFromCompound,
                    #iCompound=First(Send(oItem,@GetAttributeData,#ItemAtt=viItem_Att_Num)));
      AddPacket(4,vrInfoDesc, 4,Send(self,@DecipherHitRollFromPower,#iPower=iPower),
                4,Send(self,@DecipherDamageFromPower,#iPower=iPower));

      return;
   }

   IsMagicalEffect()
   {
      return TRUE;
   }

end
////////////////////////////////////////////////////////////////////////////////
