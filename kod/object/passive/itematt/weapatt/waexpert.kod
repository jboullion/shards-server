////////////////////////////////////////////////////////////////////////////////
WeapAttExpert is WeaponAttribute

//   This weapon is more potent in the hands of an expert than in the
//   hands of a novice.  It determines 'expert' by the proficiency 
//   of the weapon
//
//   Form is:
//      [ WA_EXPERT ]
//
////////////////////////////////////////////////////////////////////////////////
constants:

   include blakston.khd

resources:

   include waexpert.lkod

   weapattexpert_desc = \
      "\n\nColhorr's signature is engraved on the handle of this weapon. This "
      "weapon looks to provide %s advantage - in the right hands."
   weapattexpert_name = "%s of the master"
   weapattexpert_info = \
      "In skilled hands: up to +%i to hit and +%i damage more, at full skill with it\n"
   expert_dm = "expert"

classvars:

   vrDesc = weapattexpert_desc
   vbPowerDesc = TRUE
   viItem_Att_Num = WA_EXPERT
   viDifficulty = 9
   vrName = weapattexpert_name
   viNameKind = ITEMATT_NAME_SUFFIX
   vrInfoDesc = weapattexpert_info
   vrDM_trigger = expert_dm

properties:

   // Increase the object's price by 100//
   piValue_modifier = 200
   piValue_power_modifier = 10

messages:

   ///  Effect Functions

   // Ours (the magic item revamp): on top of the weapon's tier, the tier's bonus again,
   // scaled by the wielder's skill with the weapon. Never a penalty.

   ModifyDamage(damage=0,target=$,wielder=$,lData=$)
   {
      local oWeapon, iProf, iPower;

      if wielder = $
      {
         return damage;
      }

      oWeapon = Send(wielder,@LookUpPlayerWeapon);
      iProf = Send(oWeapon,@GetProf,#who=wielder);

      iPower = Send(self,@TranslatePowerFromCompound,#iCompound=First(lData));
      iPower = Send(self,@DecipherDamageFromPower,#iPower=iPower);

      return damage + (iPower * Bound(iProf,0,100) / 100);
   }

   ModifyHitRoll(hitroll=0,target=$,wielder=$,lData=$)
   {
      local oWeapon, iProf, iPower;

      if wielder = $
      {
         return hitroll;
      }

      oWeapon = Send(wielder,@LookUpPlayerWeapon);
      iProf = Send(oWeapon,@GetProf,#who=wielder);

      iPower = Send(self,@TranslatePowerFromCompound,#iCompound=First(lData));
      iPower = Send(self,@DecipherHitRollFromPower,#iPower=iPower);

      return hitroll + (iPower * Bound(iProf,0,100) / 100);
   }

   AppendOwnInfo(oItem=$)
   {
      local iPower;

      iPower = Send(self,@TranslatePowerFromCompound,
                    #iCompound=First(Send(oItem,@GetAttributeData,#ItemAtt=viItem_Att_Num)));
      AddPacket(4,vrInfoDesc, 4,Send(self,@DecipherHitRollFromPower,#iPower=iPower),
                4,Send(self,@DecipherDamageFromPower,#iPower=iPower));

      return;
   }

   IsMagicalEffect()
   {
      return TRUE;
   }

end
////////////////////////////////////////////////////////////////////////////////
