////////////////////////////////////////////////////////////////////////////////
ItemAttPKPointer is ItemAttribute

// Ours (no random PvP, 2026-10-21): this attribute (item attribute 17) kept the
// loot of a player kill from anyone who couldn't be attacked. A player death no
// longer drops anything outside the Arena of Death, so nothing gets it and the
// system no longer creates one. The class stays, empty, so a saved world that
// has one still loads.

constants:

   include blakston.khd

resources:

classvars:

   viItem_Att_Num = 17
   vrDesc = resource_blank

properties:

messages:

end
////////////////////////////////////////////////////////////////////////////////
