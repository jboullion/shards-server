////////////////////////////////////////////////////////////////////////////////
ItemAttIndestructible is ItemAttribute

///////////////////////////////////////////////////////////////////////
//
//   This item was crafted by a player.
//
///////////////////////////////////////////////////////////////////////

constants:

   include blakston.khd
   include protocol.khd

resources:

   itematt_Indestructible_desc = "\n\nThis item is indestructible."
   itematt_Indestructible_name = "indestructible %s"
   itematt_Indestructible_info = "Never wears down\n"

classvars:

   viMagicColour = MAGIC_COLOUR_AMBER

   viItem_Att_Num = IA_INDESTRUCTIBLE
   vrDesc = itematt_Indestructible_desc
   vrName = itematt_Indestructible_name
   viNameKind = ITEMATT_NAME_PREFIX
   vrInfoDesc = itematt_Indestructible_info

   viDifficulty = 5

properties:

messages:

   AddEffects(oItem=$)
   {
      Send(oItem,@SetIndestructible);

      return;
   }

   AppendDesc()
   {
      AddPacket(4,vrDesc);

      return;
   }

   InitiallyIdentified()
   {
      return TRUE;
   }

   AddToTreasureTable()
   {
      return;
   }

   CanBeSpoofed()
   {
      return FALSE;
   }

   IsMagicalEffect()
   {
      return TRUE;
   }
   
end
////////////////////////////////////////////////////////////////////////////////