   guild_name_rsc = "guild"
   guild_icon_rsc = light.bgf
   guild_desc_rsc = "An organization of individuals with similar purposes."

   // Ours (guild revamp): the default names of the five ranks, RANK_MASTER
   // down to RANK_APPRENTICE; the leader is now a Commander. A guild can
   // still name its own at creation.
