////////////////////////////////////////////////////////////////////////////////
Proficiency is Skill

constants:

   include blakston.khd

resources:

   include profic.lkod

   proficiency_effect_rsc = \
      "+%i to your offense, and +%i.%i damage, then %i%% more from your stats."
   proficiency_name_rsc = "Weapon proficiency"
   proficiency_icon_rsc = light.bgf
   proficiency_desc_rsc = "This is a weapon proficiency"

classvars:

   vrName = proficiency_name_rsc
   vrIcon = proficiency_icon_rsc
   vrDesc = proficiency_desc_rsc

   viIndefinite = ARTICLE_NONE
   viDefinite = ARTICLE_NONE

   viSchool = SKS_FENCING
   viSkill_num = 0
   
   viMeditate_ratio = 30
   // Ours: weapon skills learn at half the others' pace since 2026-10-28 (skill.kod
   //  viPractice_slowness, 2): every gain takes twice the uses; they rose too fast in play
   viPractice_slowness = 4

   vbAutomatic = TRUE    // does not show up in pull-down menu

properties:

   // Format of reagents:  Each element of plReagents is a list, describing a single reagent.
   // First elem of this list is class of reagent; second is # of reagent required for skill.
   plPrerequisites = $
   piSchool = 0

   piChanceToIncrease = 100

messages:


   HasEffectSummary()
   {
      return TRUE;
   }

   SendEffectSummary(who=$,iAbility=0)
   "Ours: Player's offense (twice the proficiency) and Stroke.DamageFactors: (ability+1) x 5 "
   "hundredths of damage, then a percentage from the stat and Might."
   {
      local iHundredths, iStat, iMight, iPercent;

      iHundredths = (iAbility + 1) * 5;
      iStat = Send(self,@GetRequisiteStat,#who=who) - 25;
      iMight = Send(who,@GetMight) - 25;
      iStat = (iStat + iMight) / 2;
      iPercent = Bound(iStat * (iAbility + 1) / 100, 0, 40);

      AddPacket(4,proficiency_effect_rsc, 4,2 * iAbility, 4,iHundredths / 100,
                4,(iHundredths % 100) / 10, 4,iPercent);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
