////////////////////////////////////////////////////////////////////////////////
Block is Skill

constants:

   include blakston.khd

resources:

   include block.lkod
   block_effect_rsc = \
      "Your shield gives +%i to your defense, and a %i%% chance to soften each hit with its armour."
   block_effect_none_rsc = "With a shield: +%i to your defense, and more from the shield itself."
   Block_name_rsc = "block"
   Block_icon_rsc = iblock.bgf
   Block_desc_rsc = "Block is a basic skill, allowing people in combat to block blows with a shield.  "
         "A successfully blocked blow will be more damaging to the attacking weapon and to the "
         "defending shield."

   Block_skill_intro = "Weaponcraft Lv. 1: The ability to block blows in combat, and thus stay alive longer."

classvars:

   vrName = Block_name_rsc
   vrIcon = Block_icon_rsc
   vrDesc = Block_desc_rsc

   vrSkill_intro = Block_skill_intro

   viIndefinite = ARTICLE_NONE
   viDefinite = ARTICLE_NONE

   viSkill_num = SKID_BLOCK
   viSchool = SKS_FENCING
   viSkill_Level = 1
   viChance_to_Increase = 60
   // Ours: block keeps the full practice pace (skill.kod viPractice_slowness)
   viPractice_slowness = 1
   viMeditate_ratio = 10

   viSkillExertion = 0
   vbCheck_exertion = FALSE

   vbAutomatic = TRUE

properties:

messages:

   HasEffectSummary()
   {
      return TRUE;
   }

   SendEffectSummary(who=$,iAbility=0)
   "Ours: Shield.GetBlockAbility (the shield's bonus and the ability, at most 120, to the "
   "defense) and ModifyDefenseDamage's check (SuccessChance with the shield's bonus)."
   {
      local oShield, iStat, iChance;

      oShield = Send(who,@LookupPlayerShield);
      if oShield = $
      {
         AddPacket(4,block_effect_none_rsc, 4,iAbility);

         return;
      }

      iStat = Send(self,@GetRequisiteStat,#who=who);
      iChance = ((100 - iStat) * iAbility / 100) + iStat + Send(oShield,@GetBlockAbility);
      AddPacket(4,block_effect_rsc, 4,Send(oShield,@GetBlockAbility,#who=who),
                4,Bound(iChance,0,100));

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
