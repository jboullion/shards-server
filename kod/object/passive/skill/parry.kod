////////////////////////////////////////////////////////////////////////////////
Parry is Skill

constants:

   include blakston.khd

resources:

   include parry.lkod

   parry_effect_rsc = "+%i to your defense while you wield a weapon you can parry with (not a bow)."
   parry_name_rsc = "parry"
   parry_icon_rsc = parryico.bgf
   parry_desc_rsc = "Parrying allows people with a weapon to turn aside a blow, thus avoiding being hit."

classvars:

   vrName = parry_name_rsc
   vrIcon = parry_icon_rsc
   vrDesc = parry_desc_rsc

   viIndefinite = ARTICLE_NONE
   viDefinite = ARTICLE_NONE

   viSkill_num = SKID_PARRY
   viSchool = SKS_FENCING
   viSkill_level = 4
   viChance_to_Increase = 20
   viMeditate_ratio = 40

   viSkillExertion = 0
   vbCheck_exertion = FALSE

   vbAutomatic = TRUE        /// not available on pulldown menus

properties:

   plPrerequisites = $

messages:

   CanPayCosts(who=$,oTarget=$)
   {
      // No parrying if you aren't moving.
      if Send(who,@CheckPlayerFlag,#flag=PFLAG_NO_FIGHT)
      {
         return 0;
      }

      propagate;
   }


   HasEffectSummary()
   {
      return TRUE;
   }

   SendEffectSummary(who=$,iAbility=0)
   "Ours: Player.GetParryAbility: the ability, to the defense, with a melee weapon."
   {
      AddPacket(4,parry_effect_rsc, 4,iAbility);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
