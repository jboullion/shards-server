////////////////////////////////////////////////////////////////////////////////
Vertigo is Debuff

constants:

   include blakston.khd

resources:

   include vertigo.lkod

   Vertigo_name_rsc = "vertigo"
   Vertigo_icon_rsc = ivertigo.bgf
   Vertigo_desc_rsc = \
      "This spell causes the victim to become so ill that they can hardly "
      "stand, much less fight, and leaves them bewildered.  "
      "Requires two dragonfly eyes and a vial of solagh to cast."
   Vertigo_effect_rsc = \
      "A player loses %i agility, might and aim, a monster %i%% of its "
      "offense and defense, for %i to %i seconds.%r"

   Vertigo_caster = "%s%s looks strangely dazed... and confused."
   Vertigo_already_enchanted = "%s%s already appears to be freaking."

   Vertigo_on = \
      "Your stomach leaps into your throat and feel as though "
      "someone hit you on the head with a very large hammer."
   Vertigo_off = "You recover from that terrible feeling."

   Vertigo_sound = rvertigo.ogg

classvars:

   vrName = Vertigo_name_rsc
   vrIcon = Vertigo_icon_rsc
   vrDesc = Vertigo_desc_rsc

   vrAlreadyEnchanted = Vertigo_already_enchanted
   vrEnchantment_On = Vertigo_on
   vrEnchantment_Off = Vertigo_off
   vrSuccess = Vertigo_caster

   viSpell_num = SID_VERTIGO
   viSchool = SS_RIIJA
   viSpell_level = 3
   viMana = 12
   viSpellExertion = 2

   viChance_to_increase = 15
   viMeditate_ratio = 30

   vrSucceed_wav = Vertigo_sound

properties:

   piBaseDuration = 4000
   piSpellPowerModifier = 101
   piDeviation = 10

messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&DragonflyEye,2],plReagents);
      plReagents = Cons([&Solagh,1],plReagents);

      return;
   }

   CastSpell(who=$,lTargets=$,iSpellPower=0)
   {
      local oTarget;

      oTarget = First(lTargets);

      Send(self,@DoSpell,#what=who,#oTarget=oTarget,#iSpellPower=iSpellPower,
           #iDuration=Send(self,@GetDuration,#iSpellPower=iSpellPower));

      propagate;
   }

   DoSpell(what=$,oTarget=$,iDuration=0,iSpellPower=$)
   {
      local iAmount,iAgil,iStr,iAim;

      iAmount = Send(self,@GetAmount,#iSpellPower=iSpellPower);

      Send(what,@MsgSendUser,#message_rsc=vrSuccess,
           #parm1=Send(oTarget,@GetCapDef),#parm2=Send(oTarget,@GetName));

      // Spell effects
      if IsClass(oTarget,&User)
      {
         Send(oTarget,@MsgSendUser,#message_rsc=vrEnchantment_On);
         Send(oTarget,@EffectSendUserDuration,#effect=EFFECT_WAVER,
               #duration=iDuration);

         iAgil = Send(oTarget,@AddAgility,#points=-iAmount);
         iStr = Send(oTarget,@AddMight,#points=-iAmount);
         iAim = Send(oTarget,@AddAim,#points=-iAmount);

         Send(oTarget,@StartEnchantment,#what=self,#time=iDuration,
               #state=[-iAgil,-iStr,-iAim]);
      }
      else
      {
         // Ours (spell revamp D37): a share of its offense and defense
         //  (ModifyMonsterOffense, ModifyMonsterDefense), so it reaches
         //  monsters whose offense is set outright, not from aim and agility.
         Send(oTarget,@StartEnchantment,#what=self,#time=iDuration,
               #state=iAmount);
      }

      // Ours (spell revamp D36).
      Send(Send(SYS,@FindSpellByNum,#num=SID_BEWILDERED),@DoBewilder,
           #oTarget=oTarget);

      propagate;
   }

   ModifyMonsterOffense(mob=$,iOffense=0,state=$)
   {
      if state = $
         OR IsList(state)
      {
         return iOffense;
      }

      return iOffense * (100 - state) / 100;
   }

   ModifyMonsterDefense(mob=$,iDefense=0,state=$)
   {
      if state = $
         OR IsList(state)
      {
         return iDefense;
      }

      return iDefense * (100 - state) / 100;
   }

   HasEffectSummary()
   {
      return TRUE;
   }

   SendEffectSummary(who=$,iSpellPower=0)
   {
      local iAmount, iTime;

      iAmount = Send(self,@GetAmount,#iSpellPower=iSpellPower);
      iTime = Send(self,@GetFullDuration,#iSpellPower=iSpellPower);
      AddPacket(4,Vertigo_effect_rsc,4,iAmount,4,iAmount,
                4,iTime * (100 - piDeviation) / 100000,4,iTime / 1000);
      Send(Send(SYS,@FindSpellByNum,#num=SID_BEWILDERED),
           @SendBewilderSummary);

      return;
   }

   GetAmount(iSpellPower=0)
   {
      local iAmount;

      // Stats are reduced between 15-24
      iAmount = 15+(iSpellPower/10);

      return iAmount;
   }

   GetDuration(iSpellPower=0)
   {
      local iDuration;

      // Ours (spell revamp D37): 10 to 30 seconds, then 90-100% of that.
      iDuration = Send(self,@GetFullDuration,#iSpellPower=iSpellPower);
      iDuration = random(iDuration*(100-piDeviation)/100,iDuration);

      return iDuration;
   }

   GetFullDuration(iSpellPower=0)
   {
      return 10000 + Bound(iSpellPower,0,SPELLPOWER_MAXIMUM) * 200;
   }

   EndEnchantment(who=$,state=$,report=TRUE)
   {
      if report
      {
         Send(who,@MsgSendUser,#message_rsc=vrEnchantment_Off);
      }

      if IsClass(who,&User)
      {
         Send(who,@AddAgility,#points=Nth(state,1));
         Send(who,@AddMight,#points=Nth(state,2));
         Send(who,@AddAim,#points=Nth(state,3));
      }
      else if IsList(state)
      {
         // One cast before the revamp.
         Send(who,@AddMonsterAgility,#points=Nth(state,1));
         Send(who,@AddMonsterAim,#points=Nth(state,2));
      }

      return;
   }

   RestartEnchantmentEffect(who=$,state=$)
   {
      local i, iDuration, oList;

      oList = Send(who,@GetEnchantmentList);

      foreach i in oList
      {
         if Nth(i,2) = self
         {
            iDuration = GetTimeRemaining(First(i));
         }
      }

      Send(who,@MsgSendUser,#message_rsc=vrEnchantment_On);
      Send(who,@EffectSendUserDuration,#effect=EFFECT_WAVER,#duration=iDuration);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
