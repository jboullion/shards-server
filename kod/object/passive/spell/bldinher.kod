// Ours (spell revamp, ADR 0023): Qor's Blade, Qor's answer to Shal'ille's spiritual sword
// (creaspsw.kod). Was Blood Inheritance, a multicast at a prism that gave a weapon a random
// power; now cast alone, at once, it summons Qor's blade (weapon/qorblade.kod). The class
// keeps its name and spell number, for the spell objects in saved worlds and the spellbooks
// that know it.
BloodInheritance is Spell

constants:

   include blakston.khd

resources:

   include bldinher.lkod

   BloodInheritance_name_rsc = "Qor's blade"
   BloodInheritance_icon_rsc = ibloodin.bgf
   BloodInheritance_desc_rsc = \
      "Summons a blade of Qor, which deals unholy damage and now and then drinks its "
      "victim's blood to heal you.  It is bound to you; casting again replaces it.  "
      "Requires 20 shaman blood and 30 orc teeth to cast."

   BloodInheritance_sound = qunbond.ogg

   BloodInheritance_cast = "Qor's blade appears in your hand, dark and blood red."
   BloodInheritance_replaced = "Your old blade crumbles to dust as the new one appears."
   BloodInheritance_inv_full = \
      "Qor's blade appears in the air before you, but before you can drop something and "
      "grab it, it vanishes."

classvars:

   vrName = BloodInheritance_name_rsc
   vrIcon = BloodInheritance_icon_rsc
   vrDesc = BloodInheritance_desc_rsc

   vrSucceed_wav = BloodInheritance_sound

   viSpell_num = SID_BLOOD_INHERITANCE
   viSchool = SS_QOR
   viSpell_level = 6
   viMana = 15
   viSpellExertion = 2
   viCast_time = 0
   viMeditate_ratio = 60

properties:

messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&ShamanBlood,20],plReagents);
      plReagents = Cons([&OrcTooth,30],plReagents);

      return;
   }

   GetNumSpellTargets()
   {
      return 0;
   }

   CastSpell(who = $, lTargets = $, iSpellPower = $)
   {
      local oBlade, oOld;

      oBlade = Create(&QorsBlade,#iToHitBonus=(iSpellPower * 3) / 2);

      // Bound, so it can't be dropped: a new one replaces the old
      oOld = Send(who,@FindHolding,#class=&QorsBlade);

      if Send(who,@ReqNewHold,#what=oBlade)
      {
         if oOld <> $
         {
            Send(oOld,@Delete);
            Send(who,@MsgSendUser,#message_rsc=BloodInheritance_replaced);
         }

         Send(who,@NewHold,#what=oBlade);
         Send(who,@MsgSendUser,#message_rsc=BloodInheritance_cast);
      }
      else
      {
         Send(oBlade,@Delete);
         Send(who,@MsgSendUser,#message_rsc=BloodInheritance_inv_full);
      }

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
