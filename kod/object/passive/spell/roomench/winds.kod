////////////////////////////////////////////////////////////////////////////////
Winds is RoomEnchantment

/// April 20, 1997 - DSchubert
/// Reduces aim by Spellpower/2
/// lasts 60 to 60+spellpower minutes

constants:

   include blakston.khd

   // Ours (spell revamp D14): a gust every so often, as Sandstorm has.
   WINDS_PERIOD = 10000

resources:

   include winds.lkod

   winds_name_rsc = "winds"
   winds_icon_rsc = iwinds.bgf
   winds_desc_rsc = \
      "Summons powerful winds which render ranged attacks more difficult "
      "for a minute or more.  Each gust buffets your foes, monsters too, for "
      "a little damage and spoils their aim.  Requires three elderberries "
      "and a purple mushroom to cast."
   winds_already_enchanted = "Magical winds are already present."
   winds_on = "Violent winds suddenly sweep the area and buffet your limbs."
   winds_off = "The winds slow and then cease."
   winds_new_entrant = "Violent winds sweep the area and buffet your limbs."
   winds_miss_rsc = "The powerful winds snatch your shot away."
   winds_spell_intro = \
      "Faren Level 3: Summons violent winds, which make ranged "
      "combat less effective."
   winds_sound = fwinds.ogg

classvars:

   vrName = winds_name_rsc
   vrIcon = winds_icon_rsc
   vrDesc = winds_desc_rsc
   vrSpell_intro = winds_spell_intro
   vrAlreadyEnchanted = winds_already_enchanted
   vrSucceed_wav = winds_sound
   viShow_enchantment_icon = ENCHANTMENT_SHOW_ROOM
   viHarmful = TRUE
   viNoNewbieOffense = TRUE
   viSpell_num = SID_WINDS
   viMana = 10
   viSpell_level = 3
   viSchool = SS_FAREN
   // Ours (spell revamp D13, D14): only foes, not the caster.
   vbRoomEnchHitCaster = FALSE
   viChance_To_Increase = 35
   viMeditate_ratio = 30

properties:

messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Elderberry,3],plReagents);
      plReagents = Cons([&PurpleMushroom,1],plReagents);

      return;
   }

   GetSpellPowerFromState(state=$)
   {
      return First(state) % 100;
   }

   CastSpell(who = $, iSpellPower = 0)
   "Initiation point for the spell."
   {
      local oRoom;

      oRoom = Send(who,@GetOwner);

      // Global effects of the enchantment. Ours (spell revamp D14): a gust
      //  every WINDS_PERIOD, Sandstorm's way: the state's first number is the
      //  time gone by plus the spellpower in its last two digits.
      iSpellPower = Bound(iSpellPower,0,99);
      Send(oRoom,@SomeoneSaid,#type=SAY_MESSAGE,#string=winds_on,#what=self);
      Send(oRoom,@RoomStartEnchantment,#what=self,#time=WINDS_PERIOD,
            #state=[WINDS_PERIOD + iSpellPower, who],#addicon=TRUE,
            #lastcall=FALSE);
      Send(oRoom,@EnchantAllOccupants,#what=self,#iSpellPower=iSpellPower,
            #state=[WINDS_PERIOD + iSpellPower, who]);

      propagate;
   }

   StartPeriodicEnchantment(who = $, where = $, state = 0)
   "A gust: the next one, or the last stretch to the end."
   {
      local iCombined, iNext_time, iSpellPower, iEnd;

      iCombined = First(state);
      iSpellPower = iCombined % 100;
      iCombined = iCombined - iSpellPower;
      iEnd = Send(self,@GetDuration,#iSpellPower=iSpellPower);

      iNext_time = iCombined + WINDS_PERIOD;
      if iNext_time >= iEnd
      {
         Send(where,@RoomStartEnchantment,#what=self,
               #time=Bound(iEnd - iCombined,1000,$),
               #state=[iEnd + iSpellPower, Nth(state,2)],
               #addicon=FALSE,#lastcall=TRUE);

         return;
      }

      Send(where,@RoomStartEnchantment,#what=self,#time=WINDS_PERIOD,
            #state=[iNext_time + iSpellPower, Nth(state,2)],
            #addicon=FALSE,#lastcall=FALSE);
      Send(where,@EnchantAllOccupants,#what=self,#iSpellPower=iSpellPower,
            #state=state);

      return;
   }

   AffectsMonsters()
   {
      return TRUE;
   }

   StartEnchantmentNewOccupant(who = $, state=$)
   "Called on new occupants of the enchanted room."
   {
      Send(who,@MsgSendUser,#message_rsc=winds_new_entrant);
      Send(self,@StartEnchantment,#who=who,#state=state);

      return;
   }

   StartEnchantment(who = $, state = $)
   "Starts enchantment effect on one player"
   {
      // Ours (spell revamp D14): a monster's aim is spoiled until the next
      //  gust.
      if IsClass(who,&Monster)
      {
         if Send(self,@IsHostileTo,#oTarget=who,#state=state)
         {
            if Send(who,@IsEnchanted,#what=self)
            {
               Send(who,@RemoveEnchantment,#what=self);
            }

            Send(who,@StartEnchantment,#what=self,#time=WINDS_PERIOD,
                  #state=First(state) % 100);
         }

         Send(self,@RoomEnchantmentDamage,#oTarget=who,#state=state);

         return;
      }

      if (NOT Send(who,@IsEnchanted,#what=self)
         AND Send(self,@CanEnchantUser,#who=who,#state=state))
      {
         Send(who,@AddAim,#points=-((First(state) % 100) / 3));
         Send(who,@StartEnchantment,#what=self,#state=state);
      }

      Send(self,@RoomEnchantmentDamage,#oTarget=who,#state=state);

      return;
   }

   ComputeDamage(who=$,oTarget=$,iDamage=$,iSpellPower=0)
   "Ours (spell revamp D14): a buffeting, 1 to 3. It never kills."
   {
      iDamage = 1 + (iSpellPower / 40);

      return Bound(iDamage,0,Send(oTarget,@GetHealth) - 1);
   }

   ModifyMonsterOffense(mob=$,iOffense=0,state=$)
   "Ours: spellpower/3 percent less (20% at 60), as a player loses spellpower/3 aim."
   {
      if state = $
      {
         return iOffense;
      }

      return iOffense * (100 - (state / 3)) / 100;
   }

   EndRoomEnchantment(who = $, state = $)
   "Ends enchantment effect on one player"
   {
      Send(who,@RemoveEnchantment,#what=self);

      return;
   }

   EndEnchantment(who = $, state = $)
   "Ends enchantment effect on one player"
   {
      if IsClass(who,&Monster)
      {
         return;
      }

      Send(who,@AddAim,#points=(First(state) % 100) / 3);

      return;
   }

   EndSpell(where = $, state = $)
   "Called when spell expires."
   {
      Send(where,@SomeoneSaid,#type=SAY_MESSAGE,#string=winds_off,#what=self);
      Send(where,@UnenchantAllOccupants,#what=self,#state=state);

      return;
   }

   RemoveEnchantment(who = $)
   "Remove enchantment effects on this occupant"
   {
      Send(who,@RemoveEnchantment,#what=self);

      return;
   }

   GetDuration(iSpellPower=0)
   "60 to 159 seconds (it was a random time up to this)."
   {
      return 60000 + (iSpellPower * 1000);
   }

   CanEnchantUser(who=$,state=$)
   {
      local oCaster;

      if (who = $ OR state = $)
      {
         propagate;
      }

      oCaster = Nth(state,2);

      if ((who = oCaster AND NOT vbRoomEnchHitCaster)
         OR NOT Send(oCaster,@AllowBattlerAttack,#victim=who,#stroke_obj=self))
      {
         return FALSE;
      }

      propagate;
   }

   TryRuinShot(who=$,state=$)
   "Returns TRUE if it manages to knock down a shot."
   {
      local iMissChance, iSpellPower, oCaster;

      oCaster = Nth(state,2);

      if ((who = oCaster AND NOT vbRoomEnchHitCaster)
         OR NOT Send(oCaster,@AllowBattlerAttack,#victim=who,#stroke_obj=self))
      {
         return FALSE;
      }

      iSpellPower = First(state) % 100;

      iMissChance = iSpellpower / 2 + 10;
      iMissChance = Bound(iMissChance,25,60);
      if Random(1,100) < iMissChance
      {
         Send(who,@MsgSendUser,#message_rsc=winds_miss_rsc);

         return TRUE;
      }

      return FALSE;
   }

   HasConditionalEffect()
   {
      return TRUE;
   }

end
////////////////////////////////////////////////////////////////////////////////
