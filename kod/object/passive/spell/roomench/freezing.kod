////////////////////////////////////////////////////////////////////////////////
Freezing is RoomEnchantment

constants:

   include blakston.khd

   // Total duration: 10 realtime minutes
   FREEZING_TIME = 300000

resources:

   include freezing.lkod

   freezing_name_rsc = "freezing"
   freezing_icon_rsc = iicenova.bgf
   freezing_desc_rsc = \
      "Fills the room with the earth magic of Faren, freezing "
      "all armor causing frostbite.  The lighter the armor, the deeper the "
      "cold bites, and everyone it bites is chilled, slowing them.  "
      "Monsters freeze too.  "
      "Requires blue mushroom and firesand to cast."
   
   freezing_effect_rsc = \
      "Every 5 seconds for %i seconds it strikes each foe in the room: a "
      "monster for %i, a player the harder the lighter their armor."

   freezing_already_enchanted = "This place already has a freezing enchantment."

   freezing_on = \
      "Fills the room with the earth magic of Faren, freezing "
      "all armor causing frostbite. "
   freezing_off = "The armor-freezing field dissipates."
   freezing_new_entrant = \
      "Faren earth magic fills the room freezing all armor causing frostbite."
   freezing_kills_you = "Your body freezes into solid ice."
   freezing_kills_him = "%s%s freezes solid."

   freezing_hurts_you = \
      "You offer a yelp of pain as your armor freezes to your skin."

   freezing_sound = fheat.ogg

classvars:

   vrName = freezing_name_rsc
   vrIcon = freezing_icon_rsc
   vrDesc = freezing_desc_rsc

   vrAlreadyEnchanted = freezing_already_enchanted
   vrRoomEnchKilled = freezing_kills_you
   vrRoomEnchKiller = freezing_kills_him
   vrRoomEnchHit = freezing_hurts_you

   viAttack_spell = ATCK_SPELL_COLD
   viSpell_num = SID_FREEZING
   viSchool = SS_FAREN
   // Ours (spell revamp D13, D14): only foes, not the caster.
   vbRoomEnchHitCaster = FALSE
   viFarenElement = FAREN_ELEMENT_FROST
   viSpell_level = 4   // Ours (spell revamp grids): was 3
   viMana = 8

   viHarmful = TRUE
   viNoNewbieOffense = TRUE

   vrSucceed_wav = freezing_sound
   viChance_To_Increase = 35
   viMeditate_ratio = 30

properties:

messages:

   HasEffectSummary()
   {
      return TRUE;
   }

   SendEffectSummary(who=$,iSpellPower=0)
   "Ours (spell revamp balance): the pulse, the length and a monster's hurt."
   {
      AddPacket(4,freezing_effect_rsc, 4,60 + Bound(iSpellPower,0,99),
                4,2 + (Bound(iSpellPower,0,99) / 25));

      return;
   }

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&BlueMushroom,1],plReagents);
      plReagents = Cons([&FireSand,1],plReagents);

      return;
   }

   CanPayCosts(who = $)
   {
      if IsClass(Send(who,@GetOwner),&GuildHall)
      {
         Send(who,@MsgSendUser,#message_rsc=spell_bad_location,#parm1=vrName);

         return FALSE;
      }

      propagate;
   }

   CastSpell( who = $, iSpellPower = 0 )
   "Initiation point for the spell."
   {
      local i, oSpell, oRoom, lEnchantments, iPeriod;

      if isClass(who,&Room)
      {
         oRoom = who;
      }
      else
      {
         oRoom = Send(who,@GetOwner);
      }

      lEnchantments = Send(oRoom,@GetEnchantmentList);

      foreach i in lEnchantments
      {
         oSpell = Nth(i,2);
         if isClass(oSpell,&Heat)
         {
            Send(oRoom,@RemoveEnchantment,#what=oSpell);
         }
      }

      Send(oRoom,@SomeoneSaid,#type=SAY_MESSAGE,#string=freezing_on,#what=self);

      // Ours: every 5 seconds
      iPeriod = 5;   // Ours (spell revamp balance): every 5 seconds (was 7 to 17)
      // can't store in greater fineness - value stores state too!
      iPeriod = iPeriod * 1000;

      Send(oRoom,@RoomStartEnchantment,#what=self,#time=iPeriod,
            #state=[iPeriod + iSpellPower, who],#addicon=TRUE,#lastcall=FALSE);

      propagate;
   }

   StartPeriodicEnchantment(who = $, where = $, state = $)
   "Sends enchantment message to room like CastSpell for most room enchantments, "
   "but silent, and done as often as necessary"
   {
      local iNext_time, iCombined, iPower, iPeriod, iTotal;

      // First, extract the spellpower from the state
      iCombined = First(state);
      iPower = iCombined % 100;
      iCombined = iCombined - iPower;

      // Ours: every 5 seconds
      iPeriod = 5;   // Ours (spell revamp balance): every 5 seconds (was 7 to 17)
      // Can't store in greater fineness - value stores state too!
      iPeriod = iPeriod * 1000;
      
      // Global effects of the enchantment
      // State is elapsed time in ms
      // Ours (spell revamp balance): 60 + spellpower seconds in all (it was
      //  five minutes).  The state packs the spellpower under 100.
      iTotal = (60 + iPower) * 1000;
      iNext_time = iCombined + iPeriod;
      if iNext_time >= iTotal
      {
         Send(where,@RoomStartEnchantment,#what=self,#time=iTotal-iCombined,
               #state=[iTotal + iPower, Nth(state,2)],#addicon=False,
               #lastcall=TRUE);

         return;
      }

      Send(where,@RoomStartEnchantment,#what=self,#time=iPeriod,
            #state=[iNext_time+iPower, Nth(state,2)],#addicon=FALSE,
            #lastcall=FALSE);

      Send(where,@EnchantAllOccupants,#what=self,#iSpellPower=iPower,
            #state=state);

      return;
   }

   GetSpellPowerFromState(state=$)
   "Ours: the state packs the time gone by with the spellpower in its last two digits."
   {
      return First(state) % 100;
   }

   AffectsMonsters()
   {
      return TRUE;
   }

   StartEnchantmentNewOccupant(who = $,state = $)
   "Called on new occupants of the enchanted room."
   {
      Send(who,@MsgSendUser,#message_rsc=freezing_new_entrant);
      Send(self,@StartEnchantment,#who=who,#state=state);

      return;
   }

   StartEnchantment(who = $, state = $)
   "Does enchantment effect on one player"
   {
      if (who = $)
      {
         return;
      }

      // Ours (spell revamp D13): the cold chills whoever it bites.
      if Send(self,@IsHostileTo,#oTarget=who,#state=state)
      {
         Send(Send(SYS,@FindSpellByNum,#num=SID_CHILL),@DoChill,#oTarget=who,
              #iSpellPower=First(state) % 100);
      }

      Send(self,@RoomEnchantmentDamage,#oTarget=who,#state=state);

      return;
   }

   ComputeDamage(who=$,oTarget=$,iDamage=$,iSpellPower=0)
   "Ours (spell revamp D13): Heat's opposite. The lighter a player's armor, "
   "the more it hurts (8 unarmored, 1 in the heaviest); a monster takes 2 to 5."
   {
      local i;

      if IsClass(oTarget,&Player)
      {
         iDamage = 0;
         foreach i in Send(oTarget,@GetPlayerUsing)
         {
            iDamage = iDamage + Send(i,@GetHeatDamage);
         }

         iDamage = Bound(8 - iDamage,1,8);
      }
      else
      {
         iDamage = 2 + (iSpellPower / 25);
      }

      return Send(self,@ApplyAttunementDamage,#who=who,#iDamage=iDamage);
   }

   EndSpell(where = $, state = $)
   "Called when spell expires."
   {
      Send(where,@SomeoneSaid,#type=SAY_MESSAGE,#string=freezing_off,#what=self);

      return;
   }

   EndRoomEnchantment(who = $, state = $)
   "Ends enchantment effect on one player"
   {
      Send(who,@RemoveEnchantment,#what=self);

      return;
   }

   RemoveEnchantment(who = $)
   "Remove enchantment effects on this occupant"
   {
      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
