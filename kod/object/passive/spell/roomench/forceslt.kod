//////////////////////////S///////////////////////////////////////////////////////
ForcesOfLight is RoomEnchantment

constants:

   include blakston.khd

resources:

   include forceslt.lkod

   forcesoflight_name_rsc = "forces of light"
   forcesoflight_icon_rsc = ifrclite.bgf
   forcesoflight_desc_rsc = \
      "Summons Shal'ille to infuse her power into the caster's allies in the "
      "room, companions among them, making their attacks far more accurate "
      "and her spells more potent.  Those who follow Qor get nothing from "
      "it.  "
      "Requires elderberries and emeralds to cast."

   forcesoflight_already_enchanted = \
      "This place is already infused with the spirit of Shal'ille."
   forcesoflight_enchantment_rsc = \
      "\n\nThe %s enchantment currently adds %i offense to the attacks of the "
      "caster's allies and %i spellpower to all Shal'ille spells cast in the "
      "area."
   forcesoflight_on = "This place is infused with the spirit of Shal'ille."
   forcesoflight_off = "The spirit of Shal'ille departs from this place."
   forcesoflight_player_on = "You are filled with the spirit of Shal'ille."
   forcesoflight_player_off = "The spirit of Shal'ille has left you."

   forcesoflight_sound = sforcelt.ogg

classvars:

   vrName = forcesoflight_name_rsc
   vrIcon = forcesoflight_icon_rsc
   vrDesc = forcesoflight_desc_rsc

   vrAlreadyEnchanted = forcesoflight_already_enchanted

   viSpell_num = SID_FORCES_OF_LIGHT
   viSchool = SS_SHALILLE
   viSpell_level = 4
   viMana = 12

   vrSucceed_wav = forcesoflight_sound

   viChance_To_Increase = 40
   viMeditate_ratio = 40

properties:

messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Elderberry,2],plReagents);
      plReagents = Cons([&Emerald,1],plReagents);

      return;
   }

   CastSpell(who = $, iSpellpower = $)
   {
      local oRoom;

      oRoom = Send(who,@GetOwner);

      // Global effects of the enchantment.
      Send(oRoom,@SomeoneSaid,#type=SAY_MESSAGE,#string=forcesoflight_on,
            #what=self);

      Send(oRoom,@RoomStartEnchantment,#what=self,#state=[iSpellpower,who],
            #time=Send(self,@GetDuration,#iSpellpower=iSpellpower));
      Send(oRoom,@EnchantAllOccupants,#what=self,#state=[iSpellpower,who]);

      propagate;
   }

   StartEnchantmentNewOccupant(who = $, state = $)
   "Called on new occupants of the enchanted room."
   {
      Send(self,@StartEnchantment,#who=who,#state=state);

      return;
   }

   AffectsMonsters()
   "Ours (spell revamp playtest): allied monsters (companions) too."
   {
      return TRUE;
   }

   StartEnchantmentNewMonster(who = $, state = $)
   {
      Send(self,@StartEnchantment,#who=who,#state=state);

      return;
   }

   StartEnchantment(who = $, state = $)
   "Starts enchantment effect on one player"
   {
      local oCaster;

      // Ours (spell revamp D32): the caster's allies, not "good players"
      //  (anyone who knew no Qor spell, foes included).
      oCaster = $;
      if state <> $
      {
         oCaster = Nth(state,2);
      }

      if IsClass(who,&Monster)
      {
         if state <> $
            AND oCaster <> $
            AND Send(self,@IsCasterAlly,#oCaster=oCaster,#who=who)
            AND NOT Send(who,@IsEnchanted,#what=self)
         {
            Send(who,@StartEnchantment,#what=self,#state=First(state));
         }

         return;
      }

      if Send(self,@KarmaCheck,#who=who)
         AND (oCaster = $
              OR Send(self,@IsCasterAlly,#oCaster=oCaster,#who=who))
      {
         Send(who,@AddAttackModifier,#what=self);
         Send(who,@MsgSendUser,#message_rsc=forcesoflight_player_on);
      }
      
      return;
   }

   EndSpell(where = $, state = $)
   "Called when spell expires."
   {
      Send(where,@SomeoneSaid,#type=SAY_MESSAGE,#string=forcesoflight_off,#what=self);
      Send(where,@UnenchantAllOccupants,#what=self,#state=state,
           #monsters=TRUE);

      return;
   }

   EndRoomEnchantment(who = $, state = $)
   "Remove enchantment effects on this occupant"
   {
      if IsClass(who,&Monster)
      {
         Send(who,@RemoveEnchantment,#what=self);

         return;
      }

      // Ours (spell revamp playtest): only those it blessed hear it go.
      if Send(who,@IsAttackModifier,#what=self)
      {
         Send(who,@RemoveAttackModifier,#what=self);
         Send(who,@MsgSendUser,#message_rsc=forcesoflight_player_off);
      }

      return;
   }

   EndEnchantment(who = $, state = $)
   "A monster's blessing: nothing to undo."
   {
      return;
   }

   ModifyMonsterOffense(mob=$,iOffense=0,state=$)
   "Ours (spell revamp playtest): an allied monster hits more often, by a "
   "share like Martyr's Battleground's."
   {
      if state = $
      {
         return iOffense;
      }

      return iOffense * (110 + Bound(state,0,99) / 5) / 100;
   }

   // stuff we handle to be an attack modifier

   ModifyHitRoll(who = $, what = $, hit_roll = $)
   "Ours (spell revamp playtest): what the description says, 50 plus the "
   "spellpower (it was a flat 150)."
   {
      local oRoom, lState;

      oRoom = Send(who,@GetOwner);
      lState = $;
      if oRoom <> $
      {
         lState = Send(oRoom,@GetEnchantedState,#what=self);
      }

      if lState = $
      {
         return hit_roll + 50;
      }

      return hit_roll + 50 + Bound(First(lState),0,99);
   }
   
   ModifyDamage(who = $, what = $, damage = $)
   {
      return damage;
   }

   GetDuration(iSpellpower = $)
   {
      local iDuration;

      // Up to ~3 minutes.
      iDuration = 6 * (iSpellpower/3 + 1); /// 1 - 33
      // Convert to milliseconds
      iDuration *= 1000;

      return iDuration;
   }

   EffectDesc(who=$)
   {
      local iState;

      iState = First(Send(Send(who,@GetOwner),@GetEnchantedState,#what=self));

      AddPacket(4, forcesoflight_enchantment_rsc, 4, Send(self,@GetName),
                4, iState + 50, 4, iState / 10);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
