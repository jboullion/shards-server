////////////////////////////////////////////////////////////////////////////////
ItemEnchantment is Spell

// Spells that take items as targets fall under this category, unless they
// require the infrastructure from another class such as RadiusEnchantment.

constants:

   include blakston.khd

resources:

   // Ours (2026-11-02): SendDurationRange's, for an effect summary's %r.
   itemench_hours_rsc = "%i to %i hours"

classvars:

   viMeditate_ratio = 20

properties:

messages:

   GetNumSpellTargets()
   {
      // Tell client how many targets this spell needs
      return 1;
   }

   IsTargetInRange(who=$,target=$)
   {
      return who = Send(target,@GetOwner)
         OR Send(who,@GetOwner) = Send(target,@GetOwner);
   }

   GetDuration(iSpellPower=0)
   {
      local iDuration;

      // 1 - 37 hours.
      iDuration = Random(1,4) + (iSpellPower/3);
      iDuration = iDuration * 1000 * 60 * 60;

      return iDuration;
   }

   SendDurationRange(iSpellPower=0)
   "Ours (2026-11-02): adds one resource (and its parameters) for "
   "GetDuration's range, for an effect summary's %r."
   {
      AddPacket(4,itemench_hours_rsc, 4,1 + (iSpellPower / 3),
                4,4 + (iSpellPower / 3));

      return;
   }

   SpellBannedInArena()
   {
      return TRUE;
   }

end
////////////////////////////////////////////////////////////////////////////////
