////////////////////////////////////////////////////////////////////////////////
Flash is Spell

constants:

   include blakston.khd

resources:

   include flash.lkod

   Flash_name_rsc = "flash"
   Flash_icon_rsc = iflash.bgf
   Flash_desc_rsc = \
      "Causes a bright flash, likely to interrupt the concentration of any "
      "foe casting a spell nearby, or to hold monsters for a moment.  It "
      "reaches six squares, and further the stronger the caster.  "
      "The caster and their allies are spared, and those it catches are left "
      "bewildered.  "
      "Requires a set of eyes from a dragonfly to cast."

   flash_sound = rflash.ogg

classvars:

   vrSucceed_wav = flash_sound

   vrName = Flash_name_rsc
   vrIcon = Flash_icon_rsc
   vrDesc = Flash_desc_rsc

   viSpell_num = SID_FLASH
   viSchool = SS_RIIJA
   viSpell_level = 1
   viMana = 15
   viSpellExertion = 1
   viChance_To_Increase = 15
   viMeditate_ratio = 10

   viOutlaw = TRUE
   viHarmful = TRUE
   viNoNewbieOffense = TRUE

   vbIsAreaEffect = TRUE

properties:

messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&DragonflyEye,2],plReagents);

      return;
   }

   GetNumSpellTargets()
   {
      return 0;
   }

   GetTargets(who=$,lTargets=$)
   "This returns a list of valid targets in the room."
   {
      local oRoom, i, each_obj, lFinalTargets;

      lFinalTargets = $;

      oRoom = Send(who,@GetOwner);
      foreach i in Send(oRoom,@GetHolderActive)
      {
         each_obj = Send(oRoom,@HolderExtractObject,#data=i);
         if IsClass(each_obj,&Battler)
         {
            lFinalTargets = Cons(each_obj,lFinalTargets);
         }
      }

      return lFinalTargets;
   }

   GetHoldTime(iSpellPower=0)
   {
      return 1000 + Bound(iSpellPower,0,SPELLPOWER_MAXIMUM) * 20;
   }

   GetFlashRange(iSpellPower=0)
   "Fine units: 6 squares, and up to 4 more with spellpower."
   {
      return (6 + Bound(iSpellPower,0,SPELLPOWER_MAXIMUM) / 20) * FINENESS;
   }

   CastSpell(who=$, lTargets = $, iSpellPower=0)
   {
      local oRoom, i, iChance, oHold, iRow, iCol, iFineRow, iFineCol, iRange;
      
      oRoom = Send(who,@GetOwner);

      // What's our chance to affect the target?
      iChance = 33 + ((2 * iSpellPower) / 3);

      // Find the hold spell to temporarily hold monsters
      oHold = Send(SYS,@FindSpellByNum,#num=SID_HOLD);

      // Ours (spell revamp playtest): those near the caster, not the whole
      //  room.
      iRow = Send(who,@GetRow);
      iCol = Send(who,@GetCol);
      iFineRow = Send(who,@GetFineRow);
      iFineCol = Send(who,@GetFineCol);
      iRange = Send(self,@GetFlashRange,#iSpellPower=iSpellPower);
      iRange = iRange * iRange;

      foreach i in lTargets
      {
         if Send(i,@SquaredFineDistanceToLocation3D,#row=iRow,#col=iCol,
                 #fine_row=iFineRow,#fine_col=iFineCol) > iRange
         {
            continue;
         }

         // Ours (spell revamp D37): the caster and their allies are spared.
         if i = who
            OR (IsClass(who,&Player)
                AND Send(self,@IsCasterAlly,#oCaster=who,#who=i))
         {
            continue;
         }

         if Random(1,100) > iChance
         {
            continue;
         }

         if IsClass(i,&Player) 
         {
            if Send(i,@CheckPlayerFlag,#flag=PFLAG_TRANCE)
            {
               Send(i,@BreakTrance,#event=EVENT_DISRUPT); 
            }

            Send(i,@EffectSendUserDuration,#effect=EFFECT_WHITEOUT,#duration=750);
         }
         else
         {
            // Is a monster, stun it.
            // Ours (spell revamp D37): one to three seconds.
            Send(oHold,@DoSpell,#what=who,#oTarget=i,
                  #iDuration=Send(self,@GetHoldTime,#iSpellPower=iSpellPower),
                  #report=FALSE,#bAllowFreeAction=FALSE);
         }

         // Ours (spell revamp D36).
         Send(Send(SYS,@FindSpellByNum,#num=SID_BEWILDERED),@DoBewilder,
              #oTarget=i);
      }

      propagate;
   }

end
////////////////////////////////////////////////////////////////////////////////
