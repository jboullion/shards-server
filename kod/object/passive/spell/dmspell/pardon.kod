////////////////////////////////////////////////////////////////////////////////
Pardon is DMSpell

// Ours (no random PvP, 2026-10-21): this DM spell took the murderer and outlaw
// flags off a player. Nobody is a murderer or an outlaw any more, so the spell is
// retired: the system no longer creates it and no DM is given it. The class
// stays, doing nothing, so a saved world that has one still loads.

constants:

   include blakston.khd

resources:

   pardon_name_rsc = "pardon"
   pardon_icon_rsc = light.bgf
   pardon_desc_rsc = "Retired: there are no murderers or outlaws any more."

classvars:

   vrName = pardon_name_rsc
   vrIcon = pardon_icon_rsc
   vrDesc = pardon_desc_rsc

   viSpell_num = SID_PARDON
   viSchool = SS_DM_COMMAND

properties:

messages:

   CanPayCosts(who = $, lTargets = $)
   {
      return FALSE;
   }

end
////////////////////////////////////////////////////////////////////////////////
