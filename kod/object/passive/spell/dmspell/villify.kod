////////////////////////////////////////////////////////////////////////////////
Villify is DMSpell

// Ours (no random PvP, 2026-10-21): this DM spell made a player an outlaw, or an
// outlaw a murderer. Nobody is a murderer or an outlaw any more, so the spell is
// retired: the system no longer creates it and no DM is given it. The class
// stays, doing nothing, so a saved world that has one still loads.

constants:

   include blakston.khd

resources:

   villify_name_rsc = "vilify"
   villify_icon_rsc = light.bgf
   villify_desc_rsc = "Retired: there are no murderers or outlaws any more."

classvars:

   vrName = villify_name_rsc
   vrIcon = villify_icon_rsc
   vrDesc = villify_desc_rsc

   viSpell_num = SID_VILLIFY
   viSchool = SS_DM_COMMAND

properties:

messages:

   CanPayCosts(who = $, lTargets = $)
   {
      return FALSE;
   }

end
////////////////////////////////////////////////////////////////////////////////
