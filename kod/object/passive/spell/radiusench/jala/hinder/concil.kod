/////////////////////////////////////////////////////////////////////////////////
Conciliation is HinderSpell

constants:

   include blakston.khd

resources:

   include concil.lkod

   Conciliation_name_rsc = "conciliation"
   Conciliation_icon_rsc = iconcil.bgf
   Conciliation_desc_rsc = \
      "A soothing melody.  Every five seconds, each monster within hearing "
      "that would fight you may lose interest for a few moments, the more "
      "likely the stronger you sing.  A ruby and some elderberries are "
      "required to begin performing this song."

   Conciliation_song = neutfor.ogg

   // Ours (spell revamp playtest): its own lines (every foe song used
   //  hinder.kod's).
   Conciliation_cast = "You begin a gentle song of peace against your foes."
   Conciliation_starts = "%s%s begins a gentle song of peace!"
   Conciliation_ends = "The song of peace played by %s%s fades."
   Conciliation_caster_ends = "Your song of peace fades."
   Conciliation_caster_enter = "You feel your song of peace reaching for your foes."
   Conciliation_enter = "A song of peace played by %s%s fills your mind."
   Conciliation_leave = "You can no longer hear the song of peace played by %s%s."

classvars:

   vrEnchantmentOn = Conciliation_cast
   vrEnchantmentOnOther = Conciliation_starts
   vrEnchantmentOff = Conciliation_caster_ends
   vrEnchantmentOffOther = Conciliation_ends
   vrEnterRadiusCaster = Conciliation_caster_enter
   vrEnterRadius = Conciliation_enter
   vrLeaveRadius = Conciliation_leave

   vrMusic = Conciliation_song

   vrName = Conciliation_name_rsc
   vrIcon = Conciliation_icon_rsc
   vrDesc = Conciliation_desc_rsc

   viMana = 5          // Mana is amount used upon inititiation
   viManaDrain = 3     // Drain is amount used every viDrainTime milliseconds
   viDrainTime = 5000    // Drain some mana every viDrainTime milliseconds
   viSpell_num = SID_CONCILIATION

   viSchool = SS_JALA
   viSpell_level = 2


properties:


messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Ruby,1],plReagents);
      plReagents = Cons([&Elderberry,1],plReagents);

      return;
   }

   PeriodicEffect(who=$,state=$)
   "Ours (spell revamp D16): a foe monster may stop fighting for 4 seconds "
   "(20 to 53 percent each pulse)."
   {
      if NOT IsClass(who,&Monster)
         OR NOT Send(self,@IsSongFoe,#who=who,#state=state)
      {
         return;
      }

      // Ours (spell revamp playtest): CalmFor, so it fights again after.
      if Random(1,100) <= 20 + (Send(self,@GetSongPower,#state=state) / 3)
      {
         Send(who,@CalmFor,#delay=4000);
      }

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
