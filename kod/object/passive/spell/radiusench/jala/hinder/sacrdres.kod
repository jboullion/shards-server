/////////////////////////////////////////////////////////////////////////////////
SacredResonance is HinderSpell

constants:

   include blakston.khd

resources:

   include sacrdres.lkod

   SacredResonance_name_rsc = "sacred resonance"
   SacredResonance_icon_rsc = isacrres.bgf
   SacredResonance_desc_rsc = \
      "A hymn of holy fire.  Every five seconds it sears your foes within "
      "hearing, monsters and enemy players alike, and burns the undead twice "
      "as fiercely.  "
      "A ruby and an entroot berry are required to begin performing this song."

   SacredResonance_song = goodfor.ogg

   // Ours (spell revamp playtest): its own lines (every foe song used
   //  hinder.kod's).
   SacredResonance_cast = "You begin a sacred hymn against your foes."
   SacredResonance_starts = "%s%s rings out a sacred hymn!"
   SacredResonance_ends = "The hymn played by %s%s fades."
   SacredResonance_caster_ends = "Your hymn fades."
   SacredResonance_caster_enter = "You feel your hymn reaching for your foes."
   SacredResonance_enter = "A hymn played by %s%s fills your mind."
   SacredResonance_leave = "You can no longer hear the hymn played by %s%s."

classvars:

   vrEnchantmentOn = SacredResonance_cast
   vrEnchantmentOnOther = SacredResonance_starts
   vrEnchantmentOff = SacredResonance_caster_ends
   vrEnchantmentOffOther = SacredResonance_ends
   vrEnterRadiusCaster = SacredResonance_caster_enter
   vrEnterRadius = SacredResonance_enter
   vrLeaveRadius = SacredResonance_leave

   vrMusic = SacredResonance_song

   vrName = SacredResonance_name_rsc
   vrIcon = SacredResonance_icon_rsc
   vrDesc = SacredResonance_desc_rsc

   viMana = 5          // Mana is amount used upon inititiation
   viManaDrain = 3     // Drain is amount used every viDrainTime milliseconds
   viDrainTime = 5000    // Drain some mana every viDrainTime milliseconds
   viSpell_num = SID_SACRED_RESONANCE

   viSchool = SS_JALA
   viSpell_level = 3
   viMeditate_ratio = 30


properties:


messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Ruby,1],plReagents);
      plReagents = Cons([&EntrootBerry,1],plReagents);

      return;
   }

   PeriodicEffect(who=$,state=$)
   "Ours (spell revamp D16): holy damage, double to the undead."
   {
      local iDamage;

      if NOT Send(self,@IsSongFoe,#who=who,#state=state)
      {
         return;
      }

      iDamage = Send(self,@GetPulseDamage,#state=state);
      if IsClass(who,&Monster)
         AND Send(who,@IsUndead)
      {
         iDamage = iDamage * 2;
      }

      Send(self,@SongDamage,#who=who,#state=state,#iDamage=iDamage,
           #iSpell=ATCK_SPELL_HOLY);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
