/////////////////////////////////////////////////////////////////////////////////
ProfaneResonance is HinderSpell

constants:

   include blakston.khd

resources:

   include profnres.lkod

   ProfaneResonance_name_rsc = "profane resonance"
   ProfaneResonance_icon_rsc = iprofres.bgf
   ProfaneResonance_desc_rsc = \
      "A dirge that rots the flesh.  Every five seconds it eats at your foes "
      "within hearing with unholy power, and a little of what it takes flows "
      "back to you as health.  A ruby and some herbs are required to begin "
      "performing this song."

   ProfaneResonance_song = nec02.ogg

classvars:

   vrMusic = ProfaneResonance_song

   vrName = ProfaneResonance_name_rsc
   vrIcon = ProfaneResonance_icon_rsc
   vrDesc = ProfaneResonance_desc_rsc

   viMana = 5          // Mana is amount used upon inititiation
   viManaDrain = 3     // Drain is amount used every viDrainTime milliseconds
   viDrainTime = 5000    // Drain some mana every viDrainTime milliseconds
   viSpell_num = SID_PROFANE_RESONANCE

   viSchool = SS_JALA
   viSpell_level = 3
   viMeditate_ratio = 30


properties:


messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Ruby,1],plReagents);
      plReagents = Cons([&Herbs,1],plReagents);

      return;
   }

   PeriodicEffect(who=$,state=$)
   "Ours (spell revamp D16): unholy damage; the singer gains a point of "
   "health from each foe it reaches."
   {
      local oCaster;

      if NOT Send(self,@IsSongFoe,#who=who,#state=state)
      {
         return;
      }

      oCaster = Send(self,@GetCaster,#state=state);
      if Send(self,@SongDamage,#who=who,#state=state,
              #iDamage=Send(self,@GetPulseDamage,#state=state),
              #iSpell=ATCK_SPELL_UNHOLY) <> 0
         AND IsClass(oCaster,&Player)
      {
         Send(oCaster,@GainHealth,#amount=1);
      }

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
