/////////////////////////////////////////////////////////////////////////////////
Truth is HinderSpell

constants:

   include blakston.khd

resources:

   include truth.lkod

   truth_name_rsc = "truth"
   truth_icon_rsc = itruth.bgf
   truth_desc_rsc = \
      "A song no lie can stand.  Invisible, faded and shadowed foes within "
      "hearing are revealed and their disguises fall away, illusions "
      "shatter, and every foe's defense falters by a tenth to almost a "
      "third.  A ruby and some rainbow ferns are required to begin performing "
      "this song."

   truth_song = song.ogg

classvars:

   vrMusic = truth_song

   vrName = truth_name_rsc
   vrIcon = truth_icon_rsc
   vrDesc = truth_desc_rsc

   viMana = 5          // Mana is amount used upon inititiation
   viManaDrain = 3     // Drain is amount used every viDrainTime milliseconds
   viDrainTime = 5000    // Drain some mana every viDrainTime milliseconds
   viSpell_num = SID_TRUTH

   viSchool = SS_JALA
   viSpell_level = 4
   viMeditate_ratio = 40


properties:


messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Ruby,1],plReagents);
      plReagents = Cons([&RainbowFern,2],plReagents);

      return;
   }

   AddEnchantmentEffects(who=$,state=$)
   {
      Send(self,@RevealFoe,#who=who,#state=state);

      propagate;
   }

   PeriodicEffect(who=$,state=$)
   {
      Send(self,@RevealFoe,#who=who,#state=state);

      return;
   }

   RevealFoe(who=$,state=$)
   "Ours (spell revamp D16): an illusion shatters; a foe player loses "
   "invisibility, fade, shadow form and illusionary form."
   {
      local i;

      if NOT Send(self,@IsSongFoe,#who=who,#state=state)
      {
         return;
      }

      if IsClass(who,&Monster)
      {
         if Send(who,@IsIllusion)
            AND NOT Send(who,@IsCompanion)
         {
            Send(who,@Delete);
         }

         return;
      }

      foreach i in [SID_INVISIBILITY, SID_FADE, SID_SHADOW_FORM,
                    SID_ILLUSIONARY_FORM]
      {
         Send(who,@RemoveEnchantment,#what=Send(SYS,@FindSpellByNum,#num=i));
      }

      return;
   }

   ModifyMonsterDefense(mob=$,iDefense=0,state=$)
   {
      if NOT Send(self,@IsSongFoe,#who=mob,#state=state)
      {
         return iDefense;
      }

      return iDefense * (100 - Send(self,@SongPercent,#state=state)) / 100;
   }

   ModifyDefensePower(who=$,what=$,defense_power=0,state=$)
   "A foe player's defense falters."
   {
      if NOT Send(self,@IsSongFoe,#who=who,#state=state)
      {
         return defense_power;
      }

      return defense_power * (100 - Send(self,@SongPercent,#state=state)) / 100;
   }

end
////////////////////////////////////////////////////////////////////////////////
