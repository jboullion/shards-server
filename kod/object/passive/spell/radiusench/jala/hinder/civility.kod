Civility is HinderSpell

constants:

   include blakston.khd

resources:

   include civility.lkod

   Civility_name_rsc = "civility"
   Civility_icon_rsc = icivilty.bgf
   Civility_desc_rsc = \
      "A courtly air that takes the fight out of your foes.  Monsters within "
      "hearing strike a tenth to almost a third more weakly, and enemy "
      "players lose a point or more from each blow.  A ruby and a mushroom "
      "are required to begin performing this song."

   Civility_song = jala3.ogg

   // Ours (spell revamp playtest): its own lines (every foe song used
   //  hinder.kod's).
   Civility_cast = "You begin a soothing, courtly air against your foes."
   Civility_starts = "%s%s begins a soothing, courtly air!"
   Civility_ends = "The courtly air played by %s%s fades."
   Civility_caster_ends = "Your courtly air fades."
   Civility_caster_enter = "You feel your courtly air reaching for your foes."
   Civility_enter = "A courtly air played by %s%s fills your mind."
   Civility_leave = "You can no longer hear the courtly air played by %s%s."

classvars:

   vrEnchantmentOn = Civility_cast
   vrEnchantmentOnOther = Civility_starts
   vrEnchantmentOff = Civility_caster_ends
   vrEnchantmentOffOther = Civility_ends
   vrEnterRadiusCaster = Civility_caster_enter
   vrEnterRadius = Civility_enter
   vrLeaveRadius = Civility_leave

   vrMusic = civility_song

   vrName = Civility_name_rsc
   vrIcon = Civility_icon_rsc
   vrDesc = Civility_desc_rsc

   viMana = 5          // Mana is amount used upon inititiation
   viManaDrain = 3     // Drain is amount used every viDrainTime milliseconds
   viDrainTime = 5000    // Drain some mana every viDrainTime milliseconds
   viSpell_num = SID_CIVILITY

   viSchool = SS_JALA
   viSpell_level = 2


properties:


messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Ruby,1],plReagents);
      plReagents = Cons([&Mushroom,1],plReagents);

      return;
   }

   ModifyMonsterDamage(mob=$,iDamage=0,state=$)
   "Ours (spell revamp D16): a foe monster's blows are weaker."
   {
      if NOT Send(self,@IsSongFoe,#who=mob,#state=state)
      {
         return iDamage;
      }

      return iDamage * (100 - Send(self,@SongPercent,#state=state)) / 100;
   }

   ModifyDamage(who=$,what=$,damage=$,state=$)
   "A foe player's damage bonus (whole points) loses 1 to 4."
   {
      if damage = $
         OR NOT Send(self,@IsSongFoe,#who=who,#state=state)
      {
         return damage;
      }

      return damage - 1 - (Send(self,@GetSongPower,#state=state) / 33);
   }

end
////////////////////////////////////////////////////////////////////////////////
