/////////////////////////////////////////////////////////////////////////////////
Disharmony is HinderSpell

constants:

   include blakston.khd

resources:

   include disharm.lkod

   Disharmony_name_rsc = "disharmony"
   Disharmony_icon_rsc = idisharm.bgf
   Disharmony_desc_rsc = \
      "A clash of notes that shakes the ground.  Every five seconds it "
      "batters your foes within hearing, and while they hear it monsters "
      "can't cast spells and players' casting is broken.  "
      "A single ruby is required to begin performing this song."

   Disharmony_song = bridge.ogg

   // Ours (spell revamp playtest): its own lines (every foe song used
   //  hinder.kod's).
   Disharmony_cast = "You begin a jarring, broken melody against your foes."
   Disharmony_starts = "%s%s begins a jarring, broken melody!"
   Disharmony_ends = "The jarring melody played by %s%s fades."
   Disharmony_caster_ends = "Your jarring melody fades."
   Disharmony_caster_enter = "You feel your jarring melody reaching for your foes."
   Disharmony_enter = "A jarring melody played by %s%s fills your mind."
   Disharmony_leave = "You can no longer hear the jarring melody played by %s%s."

classvars:

   vrEnchantmentOn = Disharmony_cast
   vrEnchantmentOnOther = Disharmony_starts
   vrEnchantmentOff = Disharmony_caster_ends
   vrEnchantmentOffOther = Disharmony_ends
   vrEnterRadiusCaster = Disharmony_caster_enter
   vrEnterRadius = Disharmony_enter
   vrLeaveRadius = Disharmony_leave

   vrMusic = Disharmony_song

   vrName = Disharmony_name_rsc
   vrIcon = Disharmony_icon_rsc
   vrDesc = Disharmony_desc_rsc

   viMana = 5
   viManaDrain = 3
   viDrainTime = 5000
   viSpell_num = SID_DISHARMONY

   viSchool = SS_JALA
   viSpell_level = 4
   viMeditate_ratio = 40


properties:


messages:

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&Ruby,1],plReagents);

      return;
   }

   PeriodicEffect(who=$,state=$)
   "Ours (spell revamp D16): earth damage, which breaks a player's casting."
   {
      if NOT Send(self,@IsSongFoe,#who=who,#state=state)
      {
         return;
      }

      Send(self,@SongDamage,#who=who,#state=state,
           #iDamage=Send(self,@GetPulseDamage,#state=state),
           #iSpell=ATCK_SPELL_QUAKE);

      return;
   }

   MonsterCanCast(mob=$,state=$)
   {
      return NOT Send(self,@IsSongFoe,#who=mob,#state=state);
   }

end
////////////////////////////////////////////////////////////////////////////////
