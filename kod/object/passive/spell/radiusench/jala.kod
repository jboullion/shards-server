////////////////////////////////////////////////////////////////////////////////
Jala is RadiusEnchantment

constants:

   include blakston.khd

resources:

   Jala_sound = lute_equip.ogg

   // Ours (2026-11-02): a song's quick pulse, for an effect summary
   //  (SendTenthsPhrase).
   jala_tenths_seconds = "%i.%i seconds"

classvars:

   viSchool = SS_JALA
   viNeedInstrument = FALSE

   vrSucceed_wav = Jala_sound

   // Ours (spell revamp D20): the song's music, played to its listeners
   //  while they hear it (it was a property nothing read).
   vrMusic = $

   // Ours (25 October play test): how many songs one singer may keep up; a
   //  new one past it ends the one they started first
   viMaxSongs = 2

   // Ours: keeps growing past full power, up to SPELLPOWER_EMPOWERED_MAXIMUM.
   viMax_spellpower = SPELLPOWER_EMPOWERED_MAXIMUM

properties:

   // Ours: when each singer last started this song, [who, GetTickCount()]
   plStarted = $

messages:

   CastSpell(who=$,iSpellPower=0,lTargets=$,bItemCast=FALSE)
   "Ours (25 October play test): a singer keeps up at most viMaxSongs songs; "
   "starting another ends the one they started first (it fades as a song "
   "does). Singing one you already sing is RadiusEnchantment's (it starts over)."
   {
      local i, j, iSongs, oOldest, lOldest, iOldest, iStarted, bThis;

      if who <> $
         AND IsClass(who,&Player)
      {
         iSongs = 0;
         bThis = FALSE;
         oOldest = $;
         foreach i in Send(who,@GetRadiusEnchantments)
         {
            if IsClass(Nth(i,2),&Jala)
               AND First(Nth(i,3)) = who
            {
               if Nth(i,2) = self
               {
                  bThis = TRUE;
               }
               else
               {
                  ++iSongs;
                  iStarted = Send(Nth(i,2),@GetStartedBy,#who=who);
                  if oOldest = $
                     OR iStarted < iOldest
                  {
                     oOldest = Nth(i,2);
                     lOldest = Nth(i,3);
                     iOldest = iStarted;
                  }
               }
            }
         }

         if NOT bThis
            AND iSongs >= viMaxSongs
            AND oOldest <> $
         {
            Send(who,@RemoveRadiusEnchantment,#what=oOldest,#state=lOldest);
         }

         foreach j in plStarted
         {
            if First(j) = who
            {
               plStarted = DelListElem(plStarted,j);
            }
         }
         plStarted = Cons([who,GetTickCount()],plStarted);
      }

      propagate;
   }

   GetStartedBy(who=$)
   "Ours: when who last started this song (GetTickCount), or 0 if not known."
   {
      local i;

      foreach i in plStarted
      {
         if First(i) = who
         {
            return Nth(i,2);
         }
      }

      return 0;
   }

   CalculateRange(who=$, iSpellPower=25)
   "Ours (spell revamp balance): a song reaches 8 squares, and up to 10 more "
   "with spellpower (Jala's 40 to 80 covered whole rooms). The foe songs "
   "first; every song since the range rings (25 October)."
   {
      return (8 + Bound(iSpellPower,0,SPELLPOWER_MAXIMUM) / 10) * FINENESS;
   }

   AddEnchantmentEffects(who=$,state=$)
   "Ours: a listener hears the song."
{
      if vrMusic <> $
         AND IsClass(who,&User)
      {
         Send(who,@SendRoomMusic,#music_rsc=vrMusic);
      }

      propagate;
   }

   EndEnchantment(who=$,report=TRUE,state=$,recheck=FALSE)
   "Ours: the room's own music again."
   {
      local oRoom;

      if vrMusic <> $
         AND IsClass(who,&User)
      {
         oRoom = Send(who,@GetOwner);
         if oRoom <> $
         {
            Send(who,@SendRoomMusic,#music_rsc=Send(oRoom,@GetMusic));
         }
      }

      propagate;
   }

   HasEffectSummary()
   "Ours (2026-11-02): every song says what it does (SendEffectSummary)."
   {
      return TRUE;
   }

   GetSummaryState(who=$,iSpellPower=0)
   "Ours (2026-11-02): the state a cast at iSpellPower would make, as "
   "RadiusEnchantment's CastSpell makes it (caster, centre, range, pulse, "
   "power), with who at its centre, for an effect summary."
   {
      return [ who, who,
               Send(self,@CalculateRange,#who=who,#iSpellPower=iSpellPower),
               Send(self,@GetDuration,#iSpellPower=iSpellPower),
               Send(self,@GetStateValue,#iSpellpower=iSpellPower,#who=who,
                    #target=who) ];
   }

   GetSummaryReach(state=$)
   "Ours (2026-11-02): how far the song reaches, in squares."
   {
      return Send(self,@GetRange,#state=state) / FINENESS;
   }

   SendTenthsPhrase(iTime=0)
   "Ours (2026-11-02): adds one resource for a time in milliseconds, to the "
   "nearest tenth of a second ('2.0 seconds'), for a pulse too quick for "
   "SendDurationPhrase."
   {
      local iTenths;

      iTenths = (iTime + 50) / 100;
      AddPacket(4,jala_tenths_seconds, 4,iTenths / 10, 4,iTenths % 10);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
