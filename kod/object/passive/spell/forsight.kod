////////////////////////////////////////////////////////////////////////////////
Foresight is Spell

constants:

   include blakston.khd
   include protocol.khd

   MAX_PERCENT_KNOWS = 16
   MAX_PERCENT_ADEQUATE = 32
   MAX_PERCENT_MEDIOCRE = 48
   MAX_PERCENT_GOOD = 64
   MAX_PERCENT_PRACTITIONER = 80
   MAX_PERCENT_GREAT = 90

   // Ours (25 October play test): how long a reading shows in the target's description
   FORESIGHT_LOOK_SECONDS = 600

resources:

   // Ours (spell revamp phase 9, V7): its own cast sound, from the game's
   //  (it played only its school's).
   foresight_cast_sound = rforsig.ogg

   include forsight.lkod

   Foresight_name_rsc = "foresight"
   Foresight_icon_rsc = iforesig.bgf
   Foresight_desc_rsc = \
      "Reveals knowledge of the victim, informing you of their abilities.  "
      "On a monster, it reveals its level, its health, its resistances and "
      "weaknesses, and the spells it casts.  "
      "Requires two uncut seraphym to cast."
   Foresight_monster_sizeup = \
      "You read %s%s: level %i, with %i%% of its health left."
   Foresight_monster_resist = "   %s %i%%"
   Foresight_monster_weak = "   %s %i%% (a weakness)"
   Foresight_monster_noresist = "   It has no resistances or weaknesses."
   Foresight_monster_nospells = "%s%s casts no spells."

   Foresight_caster = "You glare at %s%s read their thoughts."
   Foresight_info = "%s%s %s"
   Foresight_abil_name = "%s %s, %s"
   Foresight_last_abil_name = "and %s %s."
   Foresight_nothing = \
      "%s%s's head seems to be so empty you could probably hear the sea if "
      "you held it to your ear."
   Foresight_one = "%s %s."
   Foresight_notplayer = \
      "Hmmm...you aren't sure WHAT to make of what %s%s is thinking."

   Foresight_KnowsOf = "knows of"
   Foresight_AdequateAt  = "is adequate at"
   Foresight_MediocreAt  = "is mediocre at"
   Foresight_GoodAt  = "is good at"
   Foresight_PractitionerOf = "is a practitioner of"
   Foresight_GreatAt = "is great at" 
   Foresight_MasterOf = "is a master of"

   // Ours (25 October play test): the reading in the target's description
   Foresight_look_title = "\n\nYour Foresight: "
   Foresight_look_level = "level "
   Foresight_look_health = ", with "
   Foresight_look_health_end = "% of its health left."
   Foresight_look_line = "\n   "
   Foresight_look_space = " "
   Foresight_look_percent = "%"
   Foresight_look_weak = "% (a weakness)"
   Foresight_look_noresist = "\n   No resistances or weaknesses."
   Foresight_look_casts = "\n   Casts "
   Foresight_look_comma = ", "
   Foresight_look_nospells = "\n   Casts no spells."
   Foresight_look_empty = "nothing worth knowing."


classvars:

   vrSucceed_wav = foresight_cast_sound

   vrName = Foresight_name_rsc
   vrIcon = Foresight_icon_rsc
   vrDesc = Foresight_desc_rsc

   viSpell_num = SID_Foresight
   viSpell_level = 1   // Ours (spell revamp grids): was 2
   viSchool = SS_RIIJA
   viMana = 5
   viSpellExertion = 0
   viCast_time = 0
   viChance_to_increase = 10
   viMeditate_ratio = 20

   viFlash = FLASH_BAD

properties:

   viOutlaw = TRUE
   viHarmful = TRUE

   // Ours (25 October play test): readings shown in the target's description,
   //  [caster, target, until (GetTime), abilities read ([ability, compound])]
   plReadings = $

messages:

   Constructed()
   {
      // Allow the spell on Sacred Haven.
      if NOT Send(SYS,@IsPKAllowed)
      {
         viOutlaw = FALSE;
         viHarmful = FALSE;
      }

      propagate;
   }

   GetNumSpellTargets()
   {
      return 1;
   }

   ResetReagents()
   {
      plReagents = $;
      plReagents = Cons([&UncutSeraphym,2],plReagents);

      return;
   }

   CastSpell(who = $, lTargets=$, iSpellPower = 0)
   {
      local iToList, iListed, i, oTarget, lAbilities, iCompound, iAbilityNum,
            oAbility, iAbilityLength, iMaxHopSize, iFrog, iCounter, iTemp,
            iSkill, lRead;

      oTarget = First(lTargets);
      iToList = iSpellPower / 4;
      iToList = Bound(iToList,1,10);
      iListed = 0;
      iFrog = 0;

      if IsClass(oTarget,&Monster)
      {
         Send(self,@ForesightMonster,#who=who,#oTarget=oTarget,
               #iSpellPower=iSpellPower);
         Send(self,@RecordReading,#who=who,#oTarget=oTarget);

         propagate;
      }

      foreach i in Send(oTarget,@GetSpellList)
      {
         iAbilityNum = Send(oTarget,@DecodeSpellNum,#compound=i);
         oAbility = Send(SYS,@FindSpellByNum,#num=iAbilityNum);
         lAbilities = Cons([oAbility,i],lAbilities);
      }

      foreach i in Send(oTarget,@GetSkillList)
      {
         iAbilityNum = Send(oTarget,@DecodeSkillNum,#compound=i);
         oAbility = Send(SYS,@FindSkillByNum,#num=iAbilityNum);
         lAbilities = Cons([oAbility,i],lAbilities);
      }

      iCounter = 1;
      iAbilityLength = Length(lAbilities) - 1;

      while iCounter < (iAbilityLength / 2)
      {
         iTemp = Nth(lAbilities,iAbilityLength-iCounter);
         SetNth(lAbilities,iAbilityLength-iCounter,Nth(lAbilities,iCounter));
         SetNth(lAbilities,iCounter,iTemp);
         iCounter = iCounter + 2;
      }

      iAbilityLength = Length(lAbilities);

      if iAbilityLength < iToList
      {
         iToList = iAbilityLength;
      }

      if iToList = 0
      {
         AddPacket(1,BP_MESSAGE,4,Foresight_nothing);
         AddPacket(4,Send(oTarget,@GetDef));
         AddPacket(4,Send(oTarget,@GetName));
         SendPacket(Send(who,@GetSession));
         Send(self,@RecordReading,#who=who,#oTarget=oTarget);

         propagate;
      }

      iMaxHopSize = iAbilityLength / iToList;
      iMaxHopSize = Bound(iMaxHopsize,1,$);

      while iListed < iToList
      {
         oAbility = $;
         iFrog = iFrog + Random(1,iMaxHopSize);
         oAbility = First(Nth(lAbilities,iFrog));
         iCompound = Nth(Nth(lAbilities,iFrog),2);

         if iListed = 0
         {
            AddPacket(1,BP_MESSAGE,4,Foresight_info);
            AddPacket(4,Send(oTarget,@GetDef));
            AddPacket(4,Send(oTarget,@GetName));
         }

         ++iListed;

         if oAbility <> $
         {
            if iToList = 1
            {
               AddPacket(4,Foresight_one);
            }
            else if iListed = iToList
            {
               AddPacket(4,Foresight_last_abil_name);
            }
            else
            {
               AddPacket(4,Foresight_abil_name);
            }

            if IsClass(oAbility,&Spell)
            {
               iSkill = Send(oTarget,@DecodeSpellAbility,#compound=iCompound);
            }
            else
            {
               iSkill = Send(oTarget,@DecodeSkillAbility,#compound=iCompound);
            }

            AddPacket(4,Send(self,@GetAbilityResource,#iAbility=iSkill));
            AddPacket(4,Send(oAbility,@GetName));
            lRead = Cons([oAbility,iCompound],lRead);
         }
      }

      SendPacket(Send(who,@GetSession));
      Send(self,@RecordReading,#who=who,#oTarget=oTarget,#lAbilities=lRead);

      propagate;
   }

   RecordReading(who=$,oTarget=$,lAbilities=$)
   "Ours (25 October play test): what who read of oTarget shows in its "
   "description for FORESIGHT_LOOK_SECONDS (a new reading replaces it)."
   {
      local i;

      if who = $
         OR oTarget = $
      {
         return;
      }

      foreach i in plReadings
      {
         if First(i) = who
            AND Nth(i,2) = oTarget
         {
            plReadings = DelListElem(plReadings,i);
         }
      }
      plReadings = Cons([who,oTarget,GetTime() + FORESIGHT_LOOK_SECONDS,
                         lAbilities],plReadings);

      return;
   }

   GetReading(who=$,oTarget=$)
   "Ours: who's reading of oTarget while it lasts, else $ (and old ones go)."
   {
      local i, iNow, lFound;

      iNow = GetTime();
      lFound = $;
      foreach i in plReadings
      {
         if Nth(i,3) < iNow
         {
            plReadings = DelListElem(plReadings,i);
         }
         else if First(i) = who
            AND Nth(i,2) = oTarget
         {
            lFound = i;
         }
      }

      return lFound;
   }

   AppendLookText(who=$,oTarget=$)
   "Ours (25 October play test): the reading who has of oTarget, if any, put "
   "in the temp string (cleared first) for its description; FALSE if none. A "
   "monster's is read again now (its health changes); a player's is the "
   "abilities the cast revealed."
   {
      local lReading, i, iMax, bAny, lSpellBook, iLength, oSpell, oAbility,
            iSkill;

      lReading = Send(self,@GetReading,#who=who,#oTarget=oTarget);
      if lReading = $
      {
         return FALSE;
      }

      ClearTempString();
      AppendTempString(Foresight_look_title);

      if IsClass(oTarget,&Monster)
      {
         iMax = Bound(Send(oTarget,@GetMaxHealth),1,$);
         AppendTempString(Foresight_look_level);
         AppendTempString(Send(oTarget,@GetLevel));
         AppendTempString(Foresight_look_health);
         AppendTempString((Send(oTarget,@GetHealth) * 100) / iMax);
         AppendTempString(Foresight_look_health_end);

         bAny = FALSE;
         foreach i in Send(oTarget,@GetResistances)
         {
            if Nth(i,2) <> 0
            {
               AppendTempString(Foresight_look_line);
               AppendTempString(Send(SYS,@GetResistanceName,#type=First(i)));
               AppendTempString(Foresight_look_space);
               AppendTempString(Nth(i,2));
               if Nth(i,2) < 0
               {
                  AppendTempString(Foresight_look_weak);
               }
               else
               {
                  AppendTempString(Foresight_look_percent);
               }
               bAny = TRUE;
            }
         }
         if NOT bAny
         {
            AppendTempString(Foresight_look_noresist);
         }

         lSpellBook = Send(oTarget,@GetSpellBook);
         if lSpellBook = $
         {
            AppendTempString(Foresight_look_nospells);
         }
         else
         {
            AppendTempString(Foresight_look_casts);
            iLength = Length(lSpellBook);
            for (i = 1; i <= iLength; ++i)
            {
               if i > 1
               {
                  AppendTempString(Foresight_look_comma);
               }
               oSpell = Send(SYS,@FindSpellByNum,#num=First(Nth(lSpellBook,i)));
               if oSpell <> $
               {
                  AppendTempString(Send(oSpell,@GetName));
               }
            }
         }

         return TRUE;
      }

      // A player: the abilities the cast revealed, one a line
      if Nth(lReading,4) = $
      {
         AppendTempString(Foresight_look_empty);

         return TRUE;
      }

      foreach i in Nth(lReading,4)
      {
         oAbility = First(i);
         if IsClass(oAbility,&Spell)
         {
            iSkill = Send(oTarget,@DecodeSpellAbility,#compound=Nth(i,2));
         }
         else
         {
            iSkill = Send(oTarget,@DecodeSkillAbility,#compound=Nth(i,2));
         }
         AppendTempString(Foresight_look_line);
         AppendTempString(Send(self,@GetAbilityResource,#iAbility=iSkill));
         AppendTempString(Foresight_look_space);
         AppendTempString(Send(oAbility,@GetName));
      }

      return TRUE;
   }

   ForesightMonsterStats(who=$,oTarget=$)
   "Ours: level, health, then each resistance and weakness on its own line."
   {
      local i, iMax, bAny;

      iMax = Bound(Send(oTarget,@GetMaxHealth),1,$);
      Send(who,@MsgSendUser,#message_rsc=Foresight_monster_sizeup,
            #parm1=Send(oTarget,@GetDef),#parm2=Send(oTarget,@GetName),
            #parm3=Send(oTarget,@GetLevel),
            #parm4=(Send(oTarget,@GetHealth) * 100) / iMax);

      bAny = FALSE;
      foreach i in Send(oTarget,@GetResistances)
      {
         if Nth(i,2) > 0
         {
            Send(who,@MsgSendUser,#message_rsc=Foresight_monster_resist,
                  #parm1=Send(SYS,@GetResistanceName,#type=First(i)),
                  #parm2=Nth(i,2));
            bAny = TRUE;
         }
         else if Nth(i,2) < 0
         {
            Send(who,@MsgSendUser,#message_rsc=Foresight_monster_weak,
                  #parm1=Send(SYS,@GetResistanceName,#type=First(i)),
                  #parm2=Nth(i,2));
            bAny = TRUE;
         }
      }

      if NOT bAny
      {
         Send(who,@MsgSendUser,#message_rsc=Foresight_monster_noresist);
      }

      return;
   }

   ForesightMonster(who = $, oTarget = $, iSpellPower = 0)
   {
      local i, iLength, oSpell, lSpellBook, rAbility;

      if (who = $ OR oTarget = $)
      {
         return;
      }

      // Ours (spell revamp phase 2): its level, health and resistances first.
      Send(self,@ForesightMonsterStats,#who=who,#oTarget=oTarget);

      lSpellBook = Send(oTarget,@GetSpellBook);

      if (lSpellBook = $)
      {
         Send(who,@MsgSendUser,#message_rsc=Foresight_monster_nospells,
               #parm1=Send(oTarget,@GetCapDef),#parm2=Send(oTarget,@GetName));

         return;
      }

      AddPacket(1,BP_MESSAGE,4,Foresight_info);
      AddPacket(4,Send(oTarget,@GetCapDef));
      AddPacket(4,Send(oTarget,@GetName));

      // Mobs have the same spellpower/// for all spells they cast from spellbook.
      rAbility = Send(self,@GetAbilityResource,
                        #iAbility=Send(oTarget,@GetBaseSpellPower));

      iLength = Length(lSpellBook);
      for (i = 1; i <= iLength; ++i)
      {
         if iLength = 1
         {
            AddPacket(4,Foresight_one);
         }
         else if iLength = i
         {
            AddPacket(4,Foresight_last_abil_name);
         }
         else
         {
            AddPacket(4,Foresight_abil_name);
         }
         AddPacket(4,rAbility);

         oSpell = Send(SYS,@FindSpellByNum,#num=First(Nth(lSpellBook, i)));
         AddPacket(4,Send(oSpell,@GetName));
      }

      SendPacket(Send(who,@GetSession));

      return;
   }

   GetAbilityResource(iAbility = 0)
   "Returns the resource matching the ability percent."
   {
      if iAbility < MAX_PERCENT_KNOWS
      {
        return Foresight_KnowsOf;
      }
      if iAbility < MAX_PERCENT_ADEQUATE
      {
         return Foresight_AdequateAt;
      }
      if iAbility < MAX_PERCENT_MEDIOCRE
      {
         return Foresight_MediocreAt;
      }
      if iAbility < MAX_PERCENT_GOOD
      {
         return Foresight_GoodAt;
      }
      if iAbility < MAX_PERCENT_PRACTITIONER
      {
         return Foresight_PractitionerOf;
      }
      if iAbility < MAX_PERCENT_GREAT
      {
         return Foresight_GreatAt;
      }

        return Foresight_MasterOf;
   }

   // This spell is not an illusion, unlike most other Riija spells.
   IsIllusion()
   {
      return FALSE;
   }

end
////////////////////////////////////////////////////////////////////////////////
