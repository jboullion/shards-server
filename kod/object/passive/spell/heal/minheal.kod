////////////////////////////////////////////////////////////////////////////////
MinorHeal is Heal

constants:
   include blakston.khd

resources:

   include minheal.lkod

   heal_name_rsc = "minor heal"
   heal_icon_rsc = iheal.bgf
   heal_desc_rsc = \
      "The compassionate power of Shal'ille heals the wounds of the caster, "
      "another player or a companion.  Requires nothing but a "
      "compassionate soul.  Shal'ille's gift to all: anyone may learn it, "
      "and it doesn't count against the other spells you can learn."
   heal_spell_intro = \
      "Shal'ille Lv. 1: Bestows the healing touch of Shal'ille, restoring "
      "points of health."

classvars:

   vrName = heal_name_rsc
   vrIcon = heal_icon_rsc
   vrDesc = heal_desc_rsc
   vrSpell_intro = heal_spell_intro

   viSpell_num = SID_MINOR_HEAL
   viSchool = SS_SHALILLE
   viSpell_level = 1
   viMana = 9

   viMeditate_ratio = 10

   viHealMin = 100
   viHealMax = 500
   viHealPerPower = 8

properties:

messages:

   ResetReagents()
   {
      plReagents = $;

      return;
   }

   GetPotionClass()
   {
      return &MinorHealPotion;
   }

   IsFreeToLearn()
   "Ours: Shal'ille's gift to all (Spell.IsFreeToLearn)."
   {
      return TRUE;
   }

end
////////////////////////////////////////////////////////////////////////////////
