////////////////////////////////////////////////////////////////////////////////
Heal is Spell
// Parent class for heal spells. The cast text here is for Minor Heal.

constants:

   include blakston.khd

resources:

   include heal.lkod

   heal_cast_rsc = \
      "%s%s's spell heals some minor injuries, restoring ~g~B%i~B~n hitpoints."
   heal_cast_self = \
      "Shal'ille's holy magic heals some minor injuries, restoring "
      "~g~B%i~B~n hitpoints."
   heal_cast_on_other = "You heal %s%s for ~g~B%i~B~n hitpoints."
   heal_unnecessary_rsc = "%s%s is perfectly healthy."

   heal_effect_rsc = "Heals %i to %i health."

classvars:

   vrUnnecessary = heal_unnecessary_rsc
   vrCastSelf = heal_cast_self
   vrCastOther = heal_cast_rsc
   vrSuccess = heal_cast_on_other

   viFlash = FLASH_GOOD

   // Ours (spell revamp D3): GetHealAmount heals Random(viHealMin,viHealMax)
   //  + (spellpower + 1) * viHealPerPower, in hundredths of a hitpoint.
   viHealMin = 0
   viHealMax = 0
   viHealPerPower = 0

   // Ours: keeps growing past full power, up to SPELLPOWER_EMPOWERED_MAXIMUM.
   viMax_spellpower = SPELLPOWER_EMPOWERED_MAXIMUM

properties:

messages:

   GetNumSpellTargets()
   {
      return 1;
   }

   CanPayCosts(who = $, lTargets = $, bItemCast = FALSE)
   {
      local oTarget;

      // Skip standard heal code if it's an area effect.
      if vbIsAreaEffect
      {
         propagate;
      }

      // Can cast spell if the 1 target item is a user
      if Length(lTargets) <> 1
      {
         return FALSE;
      }

      oTarget = First(lTargets);
      // Ours: and the caster's companion, or a groupmate's (util/companionbook.kod)
      if NOT IsClass(oTarget,&User)
         AND NOT Send(self,@IsHealableCompanion,#who=who,#target=oTarget)
      {
         if NOT bItemCast
         {
            Send(who,@MsgSendUser,#message_rsc=spell_bad_target,
                  #parm1=vrName,#parm2=Send(oTarget,@GetDef),
                  #parm3=Send(oTarget,@GetName));
         }

         return FALSE;
      }

      if Send(oTarget,@GetHealth) >= Send(oTarget,@GetMaxHealth)
      {
         if NOT bItemCast
         {
            Send(who,@MsgSendUser,#message_rsc=vrUnnecessary,
                  #parm1=Send(oTarget,@GetCapDef),
                  #parm2=Send(oTarget,@GetName));
         }

         return FALSE;
      }

      propagate;
   }

   IsHealableCompanion(who = $,target = $)
   {
      local oOwner, oRoom;

      if target = $ OR NOT IsClass(target,&Monster) OR NOT Send(target,@IsCompanion)
         OR Send(target,@GetCompanionState) <> COMP_ACTIVE
      {
         return FALSE;
      }

      // Its owner, or the companion itself
      oOwner = Send(target,@GetSworn);
      if oOwner = who OR target = who
      {
         return TRUE;
      }

      oRoom = Send(who,@GetOwner);

      return oRoom <> $ AND Send(oRoom,@AreGroupedHere,#who=who,#what=oOwner);
   }

   CastSpell(who = $, lTargets = $, iSpellPower = 0)
   {
      local iHeal, oTarget;

      // Skip standard heal code if it's an area effect.
      if vbIsAreaEffect
      {
         propagate;
      }

      oTarget = First(lTargets);

      if (oTarget = $)
      {
         Debug(who," trying to cast ",Send(self,@GetName)," on $ target!");

         return;
      }

      iHeal = Send(self,@GetHealAmount,#oTarget=oTarget,
                     #iSpellPower=iSpellPower);

      // Ours: no extra healing for new players (it was 2-5 more).
      iHeal = Send(oTarget,@GainHealthNormal,#amount=iHeal,#precision=TRUE);
      // Ours (spell revamp phase 9): healing light about the target, for our client.
      Send(self,@SendSpellFx,#kind=SPELLFX_HEAL,#source=who,#target=oTarget);

      if who <> oTarget
      {
         Send(who,@MsgSendUser,#message_rsc=vrSuccess,
               #parm1=Send(oTarget,@GetDef),#parm2=Send(oTarget,@GetName),
               #parm3=iHeal/100);

         Send(oTarget,@MsgSendUser,#message_rsc=vrCastOther,
               #parm1=Send(who,@GetCapDef),#parm2=Send(who,@GetName),
               #parm3=iHeal/100);

         // Give them a little boost if they help someone of higher Karma.
         //if Send(who,@GetKarma) < Send(oTarget,@GetKarma)
         //{
         //   Send(who,@AddKarma,#amount=Send(who,@CalculateKarmaChangeFromAct,
         //         #karma_doer=Send(who,@GetKarma),
         //         #karma_act=Send(oTarget,@GetKarma),#Swing_factor=1));
         //}
      }
      else
      {
         Send(who,@MsgSendUser,#message_rsc=vrCastSelf,#parm1=iHeal/100);
      }

      propagate;
   }

   GetHealAmount(oTarget=$,iSpellPower=1)
   "Heal spells set viHealMin, viHealMax and viHealPerPower, or override this."
   {
      if (oTarget = $)
      {
         Debug("Trying to get heal amount for $ target!");

         return 1;
      }

      if viHealMax = 0
      {
         return 1;
      }

      return Random(viHealMin,viHealMax) + ((iSpellPower + 1) * viHealPerPower);
   }

   HasEffectSummary()
   {
      return viHealMax > 0 AND NOT vbIsAreaEffect;
   }

   SendEffectSummary(who=$,iSpellPower=0)
   "Ours (spell revamp D3): the heal range at this spellpower."
   {
      AddPacket(4,heal_effect_rsc,
                4,(viHealMin + ((iSpellPower + 1) * viHealPerPower)) / 100,
                4,(viHealMax + ((iSpellPower + 1) * viHealPerPower)) / 100);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
