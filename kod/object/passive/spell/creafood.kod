////////////////////////////////////////////////////////////////////////////////
CreateFood is Spell

constants:
   include blakston.khd

resources:

   include creafood.lkod

   createfood_name_rsc = "create food"
   createfood_icon_rsc = icrefood.bgf
   createfood_desc_rsc = \
      "The power of Kraanan is summoned to materialize various nourishing foods.  "
      "Requires nothing but free will to cast."

   createfood_spell_intro = "Kraanan Lv. 1: Conjures food for you to eat."

   createfood_sound = kcreatef.ogg

   createfood_cast_rsc = "%s%s appears."
   createfood_inv_full_rsc = \
      "%s%s appears in the air before you, but before you can drop something and grab it, it vanishes."

   // Ours (2026-11-02): the effect summary (SendEffectSummary)
   createfood_effect_rsc = "Conjures %r."
   createfood_list_one_rsc = "%s"
   createfood_list_first_rsc = "%s%r"
   createfood_list_more_rsc = ", %s%r"
   createfood_list_last_rsc = " or %s"
   createfood_apple_rsc = "an apple"
   createfood_bread_rsc = "a loaf of bread"
   createfood_grapes_rsc = "a bunch of grapes (five on Ko'catan)"
   createfood_turkeyleg_rsc = "a turkey leg"
   createfood_meatpie_rsc = "a meat pie"
   createfood_cheese_rsc = "a wheel of cheese"
   createfood_inkycap_rsc = "an inky-cap mushroom"

classvars:

   vrName = createfood_name_rsc
   vrIcon = createfood_icon_rsc
   vrDesc = createfood_desc_rsc

   vrSpell_intro = createfood_spell_intro
   viSpell_num = SID_CREATE_FOOD
   viSchool = SS_KRAANAN
   viSpell_level = 1
   viMana = 10 
   viSpellExertion = 0
   viCast_time = 500
   viChance_To_Increase = 15
   viMeditate_ratio = 10

   vrSucceed_wav = createfood_sound

properties:

messages:

   ResetReagents()
   {
      // separate message so can change, then set from admin mode

      plReagents = $;

      return;
   }

   GetNumSpellTargets()
   {
      return 0;
   }

   CastSpell(who = $, lTargets = $,iSpellpower = $)
   {
      local oFood, iNum, iAmount;

      iNum = Random(iSpellPower/2,iSpellpower);

      if iNum < 30 
      {
         oFood = Create(&Apple,#number=1);
      }
      else
      {
         if iNum < 40
         {
            oFood = Create(&Bread,#number=1);
         }
         else
         {
            if iNum < 60
            {
               // If they're on the island, let them create 5 grapes instead
               //  of 1.  This allows people to accomplish part of the Riija
               //  sword quest easier.
               iAmount = 1;
               if send(send(who,@GetOwner),@GetRegion) = RID_KOCATAN
               {
                  iAmount = 5;
               }

               oFood = Create(&Grapes,#number=iAmount);
            }
            else
            {
               if iNum < 70
               {
                  oFood = Create(&TurkeyLeg,#number=1);
               }
               else
               {
                  if iNum < 80
                  {
                     oFood = Create(&Meatpie,#number=1);
                  }
                  else
                  {
                     // Create cheese if number is less than 95
                     //  Also create cheese (instead of an inky) 66// of the time over 95//
                     if iNum < 95 OR random(1,3) <> 1
                     {
                        oFood = Create(&Cheese,#number=1);
                     }
                     else
                     {
                        oFood = Create(&InkyCap,#number=1);
                     }
                  }
               }
            }
         }
      }
      
      if Send(who,@ReqNewHold,#what=oFood)
      {
	      Send(who,@NewHold,#what=oFood);
	      Send(who,@MsgSendUser,#message_rsc=createfood_cast_rsc,
	           #parm1=send(oFood,@GetCapIndef),#parm2=send(oFood,@GetName));
      }
      else
      {
	      Send(oFood,@Delete);
	      Send(who,@MsgSendUser,#message_rsc=createfood_inv_full_rsc,
	           #parm1=send(oFood,@GetCapIndef),#parm2=send(oFood,@GetName));
      }

      propagate;
   }

//  If we use the IA_MADE attribute again:
//  GetDuration(iSpellpower=$)
//     iDuration = iSpellpower;  ///In minutes

   HasEffectSummary()
   {
      return TRUE;
   }

   GetSummaryFoods()
   "Ours (2026-11-02): what CastSpell makes for each number it rolls, for the "
   "effect summary: [lowest roll, highest roll, name]. From 95 it makes an "
   "inky-cap one time in three, cheese otherwise."
   {
      return [ [0,29,createfood_apple_rsc],
               [30,39,createfood_bread_rsc],
               [40,59,createfood_grapes_rsc],
               [60,69,createfood_turkeyleg_rsc],
               [70,79,createfood_meatpie_rsc],
               [80,10000,createfood_cheese_rsc],
               [95,10000,createfood_inkycap_rsc] ];
   }

   SendEffectSummary(who=$,iSpellPower=0)
   "Ours (2026-11-02): the foods it can make at this spellpower (CastSpell "
   "rolls iSpellPower / 2 to iSpellPower)."
   {
      local i, iLow, iHigh, iCount, iLength;

      iLow = iSpellPower / 2;
      iHigh = iSpellPower;
      iLength = 0;
      foreach i in Send(self,@GetSummaryFoods)
      {
         if (First(i) <= iHigh) AND (Nth(i,2) >= iLow)
         {
            iLength = iLength + 1;
         }
      }

      AddPacket(4,createfood_effect_rsc);
      iCount = 0;
      foreach i in Send(self,@GetSummaryFoods)
      {
         if (First(i) <= iHigh) AND (Nth(i,2) >= iLow)
         {
            iCount = iCount + 1;
            if iLength = 1
            {
               AddPacket(4,createfood_list_one_rsc, 4,Nth(i,3));
            }
            else if iCount = 1
            {
               AddPacket(4,createfood_list_first_rsc, 4,Nth(i,3));
            }
            else if iCount = iLength
            {
               AddPacket(4,createfood_list_last_rsc, 4,Nth(i,3));
            }
            else
            {
               AddPacket(4,createfood_list_more_rsc, 4,Nth(i,3));
            }
         }
      }

      return;
   }

end

////////////////////////////////////////////////////////////////////////////////
