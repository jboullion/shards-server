ShatterLock_name_rsc = de "Schloß Knacken"
ShatterLock_desc_rsc = de \
   "Durchdringt die Schlösser einer Gildenhalle (aber er wird keine anderen Türen öffnen). "
   "Erfordert vier Kriipa Klauen und die magischen Energien der Zauberer müssen durch ein Prisma gebündelt werden. "
ShatterLock_cast_complete = de \
   "Als Du deine Beschwörung abgeschlossen hast, öffnet sich plötlich die "
   "Tür der Gildenhalle!"
ShatterLock_guildwarning = de \
   "Du hast ein seltsames Gefühl, dass die Abwehr deiner Gildenhalle manipuliert "
   "wird."

ShatterLock_name_rsc = pt "quebrar bloqueio"
ShatterLock_desc_rsc = pt "Penetra as fechaduras de uma sala de guilda (observe que não abrirá outros tipos de portas em outros lugares). Requer quatro garras de Kriipa para ser lançado, e as energias dos lançadores devem ser focalizadas através de um prisma."
ShatterLock_cast_complete = pt "Ao terminar sua incantação, a porta da sala da guilda se abre!"
ShatterLock_guildwarning = pt "Você tem uma sensação estranha de que as defesas de sua sala de guilda estão sendo manipuladas."
