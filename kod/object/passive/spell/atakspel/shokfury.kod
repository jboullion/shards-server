////////////////////////////////////////////////////////////////////////////////
ShockingFury is AttackSpell

constants:

   include blakston.khd

   // Ours (spell revamp D11): how long a monster it hits can't cast (ms).
   STORM_DISRUPT_TIME = 3000

resources:

   storm_disrupt_summary_rsc = \
      "  A monster it hits can't cast spells for %i seconds."

   include shokfury.lkod

   ShockingFury_name_rsc = "shocking fury"

   ShockingFury_icon_rsc = ishkfury.bgf

   ShockingFury_desc_rsc = \
      "Releases Faren's fury as a large amount of electricity directed at a target at short range.  "
      "Requires blue mushrooms and elderberries to cast."

   ShockingFury_sound = fzap.ogg

classvars:

   vrName = ShockingFury_name_rsc
   vrIcon = ShockingFury_icon_rsc
   vrDesc = ShockingFury_desc_rsc
   
   viSpell_num = SID_SHOCKING_FURY

   viAttack_spell = ATCK_SPELL_ALL + ATCK_SPELL_SHOCK

   viSchool = SS_FAREN
   viFarenElement = FAREN_ELEMENT_STORM
   viSpell_level = 3
   viMana = 8

   vrSucceed_wav = ShockingFury_sound

   // In seconds, since it works off GetTime().
   viPostCast_time = 2

   viChance_To_Increase = 20

properties:

   piDamageMin = 12
   piDamageMax = 20
   piRange = 5 * FINENESS

messages:

   ResetReagents()
   {
      // separate message so can change, then set from admin mode

      plReagents = $;
      plReagents = Cons([&BlueMushroom,2],plReagents);
      plReagents = Cons([&Elderberry,1],plReagents);

      return;
   }

   DoSideEffect(who=$,victim=$,damage=0,iSpellPower=0)
   "Ours (spell revamp D11): storm disrupts. A monster it hits can't cast "
   "spells for a moment (a player's casting breaks on any damage already)."
   {
      if damage <> $
         AND IsClass(victim,&Monster)
      {
         if Send(victim,@IsEnchanted,#what=self)
         {
            Send(victim,@RemoveEnchantment,#what=self);
         }

         Send(victim,@StartEnchantment,#what=self,#time=STORM_DISRUPT_TIME);
      }

      propagate;
   }

   MonsterCanCast(mob=$,state=$)
   {
      return FALSE;
   }

   EndEnchantment(who=$,state=$,report=TRUE)
   {
      return;
   }

   SendSideEffectSummary(who=$,iSpellPower=0)
   {
      AddPacket(4,storm_disrupt_summary_rsc, 4,STORM_DISRUPT_TIME / 1000);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
