////////////////////////////////////////////////////////////////////////////////
Iceshard is BoltSpell

constants:
   include blakston.khd

resources:

   Iceshard_name_rsc = "ice shard"
   // icebolt.bgf is the projectile; the spell's own icon is iiceshrd.bgf
   // (resource/graphics/shards, from tools/iconforge).
   Iceshard_icon_rsc = icebolt.bgf
   Iceshard_look_icon = iiceshrd.bgf
   Iceshard_desc_rsc = \
      "Sends an ice shard at the target.  "
      "Requires two blue mushrooms and an orc tooth to cast."

   Iceshard_hit_rsc = "A shard of ice strikes %s%s!"

   Iceshard_sound = ficefing.ogg

classvars:

   vrName = Iceshard_name_rsc
   vrIcon = Iceshard_look_icon
   vrDesc = Iceshard_desc_rsc
   vrProjectile_icon = Iceshard_icon_rsc

   viSpell_num = SID_ICESHARD

   viAttack_spell = ATCK_SPELL_ALL+ATCK_SPELL_COLD

   viMana = 7
   viSchool = SS_FAREN
   viFarenElement = FAREN_ELEMENT_FROST
   viSpell_level = 3   // Ours (spell revamp grids): was 4
   viMeditate_ratio = 40

   vrSucceed_wav = Iceshard_sound
   
   viPostCast_time = 2        // in seconds, since it works off gettime()

   // Projectile lighting information.
   viProjectileLightFlags = LIGHT_FLAG_ON | LIGHT_FLAG_DYNAMIC
   // Medium light range, out of 255.
   viProjectileLightIntensity = 100
   // Color is orange.
   viProjectileLightColor = LIGHT_BBLUE

properties:
   
   piDamageMin = 9
   piDamageMax = 15
   prSpellHit = Iceshard_hit_rsc

messages:

   ResetReagents()
   {
      // separate message so can change, then set from admin mode

      plReagents = $;
      plReagents = Cons([&BlueMushroom,2],plReagents);
      plReagents = Cons([&OrcTooth,1],plReagents);

      return;
   }

   GetProjectileSpeed()
   {
      return 10;
   }

   SendLookAnimation()
   {
      AddPacket(1,ANIMATE_NONE, 2,2);

      return;
   }

   SendProjectileAnimation()
   {
      // 40ms between animations, between frames 1-2
      AddPacket(1,ANIMATE_CYCLE, 4,40, 2,1, 2,2);   

      return;
   }

   DoSideEffect(who=$,victim=$,damage=0,iSpellPower=0)
   "Ours (spell revamp D11): frost chills what it hits."
   {
      if damage <> $
      {
         Send(Send(SYS,@FindSpellByNum,#num=SID_CHILL),@DoChill,
              #oTarget=victim,#iSpellPower=iSpellPower);
      }

      propagate;
   }

   SendSideEffectSummary(who=$,iSpellPower=0)
   {
      Send(Send(SYS,@FindSpellByNum,#num=SID_CHILL),@SendChillSummary,
           #iSpellPower=iSpellPower);

      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
