////////////////////////////////////////////////////////////////////////////////
NecroGuildQuest is QuestTemplate

// Ours (guild revamp, ADR 0022 decision 27, 2026-10-23): the quest that
// founded the Order of Necromancers (QST_ID_ESTABLISH_NECROGUILD = 44, quest
// nodes 139 to 141) is retired with the rest of the old Necromancer/Hunter
// scenario. The quest engine no longer creates it; the class stays, disabled
// and empty, so a saved world that has one still loads.

constants:

   include blakston.khd

resources:

classvars:

   // The QST_ID constant for this quest.
   viQuestID = QST_ID_ESTABLISH_NECROGUILD

properties:

   pbDisabled = TRUE
   piSchedulePct = 0

messages:

   SendQuestNodeTemplates()
   {
      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
