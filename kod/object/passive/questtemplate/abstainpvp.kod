////////////////////////////////////////////////////////////////////////////////
AbstainPvPQuest is QuestTemplate

// Ours (no random PvP, 2026-10-21): the quest that let a player opt out of PvP
// (QST_ID_ABSTAIN_PVP = 75, quest nodes 217 and 218) is retired, since nobody is
// a target of random PvP any more. The quest engine no longer creates it; the
// class stays, disabled and empty, so a saved world that has one still loads.

constants:

   include blakston.khd

resources:

classvars:

   // The QST_ID constant for this quest.
   viQuestID = QST_ID_ABSTAIN_PVP

properties:

   pbDisabled = TRUE
   piSchedulePct = 0

messages:

   SendQuestNodeTemplates()
   {
      return;
   }

end
////////////////////////////////////////////////////////////////////////////////
