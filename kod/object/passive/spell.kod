   GetSpellPower(who=$,bParts=FALSE)
   "Ours (spell revamp D2): with bParts, returns [total, parts] instead of "
   "the total. Each part is [label resource, value, label parameters or $], "
   "in the order they add up. The cast and the spell's description both come "
   "from this one calculation, so they can't disagree."
   {
      local iSpellPower, i, oRoom, oModifierSpell, iAbilityLoss,
            iAbilityGain, iItemModifier, iBase, iPrimaryBonus, iSecondaryBonus,
            iPowerBonus, iShrines, lParts, lItemParts, iMod, iBefore, iBound,
            iBonus, iAbility, iAttune;

      if who = $
      {
         if bParts
         {
            return [SPELLPOWER_MINIMUM, $];
         }

         return SPELLPOWER_MINIMUM;
      }

      oRoom = Send(who,@GetOwner);

      // Let immortals cast at full potency.
      if IsClass(who,&DM)
         AND Send(who,@PlayerIsImmortal)
      {
         if bParts
         {
            return [SPELLPOWER_MAXIMUM,
                    [ [spell_pp_immortal, SPELLPOWER_MAXIMUM, $] ]];
         }

         return SPELLPOWER_MAXIMUM;
      }

      // KLUDGE: This allows monsters to query spellpower.  Should be a function
      //         call to the monster itself.  Currently, this is called from
      //         GetTargets in ManaBomb, which can be called by monsters.
      if IsClass(who,&Monster)
      {
         if bParts
         {
            return [SPELLPOWER_MAXIMUM, $];
         }

         return SPELLPOWER_MAXIMUM;
      }

      lParts = $;
      lItemParts = $;

      // Spell power starts out as half the player's spell ability.
      iAbility = Send(who,@GetSpellAbility,#spell_num=viSpell_num);
      iBase = iAbility / 2;
      if bParts
      {
         lParts = AppendListElem([spell_pp_ability, iBase, [vrName, iAbility]],
                                 lParts);
      }

      // Check the player's in use items to see if they affect anything.
      // Note that this also checks itematts.
      iItemModifier = 0;
      foreach i in Send(who,@GetPlayerUsing)
      {
         iMod = Send(i,@GetSpellModifier,#oSpell=self);
         iItemModifier = iItemModifier + iMod;
         if bParts AND iMod <> 0
         {
            lItemParts = AppendListElem([spell_pp_gear, iMod,
                                         [Send(i,@GetName)]], lItemParts);
         }
      }

      // Each school has a bonus for different things.
      iPrimaryBonus = 0;
      iSecondaryBonus = 0;

      if viSchool = SS_SHALILLE
      {
         // Shal'ille gives bonuses depending on the room setting,
         //  prefers natural settings.
         iPrimaryBonus = Send(oRoom,@GetShalilleBonus);
         // Ours (spell revamp D31): the brighter the room, the stronger (it
         //  was karma, which players no longer have).
         iSecondaryBonus = Send(self,@GetLightBonus,#oRoom=oRoom);
         if bParts
         {
            lParts = AppendListElem([spell_pp_shal_place, iPrimaryBonus, $],
                                    lParts);
            lParts = AppendListElem([spell_pp_light, iSecondaryBonus, $],
                                    lParts);
         }

         // Forces of Light boosts Shal'ille
         if Send(oRoom,@IsEnchanted,#what=SID_FORCES_OF_LIGHT)
         {
            // Add a function of the spellpower.
            iAbilityGain = First(Send(oRoom,@GetEnchantmentState,
                                 #what=SID_FORCES_OF_LIGHT));
            iAbilityGain /= 10;
            iSecondaryBonus += iAbilityGain;
            if bParts
            {
               lParts = AppendListElem([spell_pp_room_ench, iAbilityGain,
                  [Send(Send(SYS,@FindSpellByNum,#num=SID_FORCES_OF_LIGHT),
                        @GetName)]], lParts);
            }
         }
      }
      else if viSchool = SS_QOR
      {
         // Qor strength determined by day or night.
         iPrimaryBonus =  (2 + Send(SYS,@GetHour));
         // Ours (spell revamp D31): the darker the room, the stronger (it was
         //  karma, plus a bonus for Darkness, which now simply darkens it).
         iSecondaryBonus = 10 - Send(self,@GetLightBonus,#oRoom=oRoom);
         if bParts
         {
            lParts = AppendListElem([spell_pp_hour, iPrimaryBonus, $], lParts);
            lParts = AppendListElem([spell_pp_dark, iSecondaryBonus, $],
                                    lParts);
         }
      }
      else if viSchool = SS_RIIJA
      {
         // Riija's bonuses are a bit random seeming.
         // Riija strength determined by moon position - range is -16 to 30
         foreach i in Send(SYS,@GetBackgroundObjects)
         {
            if IsClass(i,&Moon)
            {
               iPrimaryBonus = Send(i,@GetBackgroundOverlayHeight)/12;
            }
         }

         // Ours (spell revamp D40): Riija rewards staying in disguise: up to
         //  10 from the strongest Riija guise on the caster (Anonymity,
         //  Illusionary Form, Morph, Shadow Form), by its spellpower.
         iSecondaryBonus = Bound((Send(who,@GetRiijaGuisePower) + 9) / 10,
                                 0,10);
         if bParts
         {
            lParts = AppendListElem([spell_pp_moon, iPrimaryBonus, $], lParts);
            lParts = AppendListElem([spell_pp_guise, iSecondaryBonus, $],
                                    lParts);
         }
      }
      else if viSchool = SS_FAREN
      {
         // Faren prefers water and fire.  If he finds water and fire, he gets stronger.
         iPrimaryBonus = Send(oRoom,@GetFarenBonus);
         // Faren also rewards the vigorous warrior.
         iSecondaryBonus = Send(who,@GetVigor)/20;
         if bParts
         {
            lParts = AppendListElem([spell_pp_faren_place, iPrimaryBonus, $],
                                    lParts);
            lParts = AppendListElem([spell_pp_vigor, iSecondaryBonus, $],
                                    lParts);
         }
      }
      else if viSchool = SS_KRAANAN
      {
         // Kraanan favors adversity and armies.  More people in a room, the better.
         iPrimaryBonus = Length(Send(oRoom,@GetHolderActive));
         // Kraanan also favors the healthy warrior.  Full hps = more bonus.
         iSecondaryBonus = (Send(who,@GetHealth)*10)/Send(who,@GetMaxHealth);
         if bParts
         {
            lParts = AppendListElem([spell_pp_company, iPrimaryBonus,
                                     [iPrimaryBonus]], lParts);
            lParts = AppendListElem([spell_pp_health, iSecondaryBonus, $],
                                    lParts);
         }

         // Kraanan, being a combat school, doesn't take penalties from items as much.
         if iItemModifier < 0
         {
            if bParts
            {
               lItemParts = AppendListElem([spell_pp_gear_kraanan,
                  (iItemModifier / 2) - iItemModifier, $], lItemParts);
            }

            iItemModifier /= 2;
         }
      }
      else if viSchool = SS_JALA
      {
         // Jala's strength is based on the strength of the instrument
         //  that it's master is wielding.  The bonus is a bit different from
         //  other schools in that it can go up to 40.  This is because the
         //  instruments that give big bonuses are harder to find and interfere
         //  with normal combat, etc.
         // Secondary bonus is based off of HPs.  Non-mules get bigger bonuses.
         iPrimaryBonus = Send(who,@GetInstrumentLevel);
         iSecondaryBonus = Send(who,@GetBaseMaxHealth)/12;
         if bParts
         {
            lParts = AppendListElem([spell_pp_instrument, iPrimaryBonus, $],
                                    lParts);
            lParts = AppendListElem([spell_pp_base_health, iSecondaryBonus, $],
                                    lParts);
         }
      }

      iPowerBonus = Send(Send(SYS,@GetParliament),@GetFactionSpellPowerBonus,
                         #who=who,#theSpell=self);

      // Bind the bonuses to reasonable values.
      if viSchool <> SS_JALA
      {
         iBound = Bound(iPrimaryBonus,0,30);
         if bParts AND iBound <> iPrimaryBonus
         {
            lParts = AppendListElem([Send(self,@GetCapLabel,
                                          #iValue=iPrimaryBonus),
                                     iBound - iPrimaryBonus,
                                     Send(self,@GetCapParms,
                                          #iValue=iPrimaryBonus,#iCap=30)],
                                    lParts);
         }
         iPrimaryBonus = iBound;
      }
      iBound = Bound(iSecondaryBonus,0,10);
      if bParts AND iBound <> iSecondaryBonus
      {
         lParts = AppendListElem([Send(self,@GetCapLabel,
                                       #iValue=iSecondaryBonus),
                                  iBound - iSecondaryBonus,
                                  Send(self,@GetCapParms,
                                       #iValue=iSecondaryBonus,#iCap=10)],
                                 lParts);
      }
      iSecondaryBonus = iBound;

      if bParts AND iPowerBonus <> 0
      {
         lParts = AppendListElem([spell_pp_faction, iPowerBonus, $], lParts);
      }

      // Ours (spell revamp D10): a Faren mage's chosen element.
      iAttune = Send(self,@GetAttunementBonus,#who=who);
      if bParts AND iAttune <> 0
      {
         lParts = AppendListElem([spell_pp_attuned, iAttune,
                                  [Send(self,@GetFarenElementName)]], lParts);
      }

      iSpellPower = iPrimaryBonus + iSecondaryBonus + iPowerBonus + iBase
                    + iAttune;

      if Send(oRoom,@CheckRoomFlag,#flag=ROOM_ANTI_MAGIC)
      {
         oModifierSpell = Send(SYS,@FindSpellByNum,#num=SID_ANTIMAGIC_AURA);
         iBefore = iSpellPower;
         iSpellPower = Send(oModifierSpell,@ModifySpellPower,
                              #who=who,#oRoom=oRoom,#oSpell=self,
                              #iSpellPower=iSpellPower);
         if bParts AND iSpellPower <> iBefore
         {
            lParts = AppendListElem([spell_pp_inside, iSpellPower - iBefore,
                        [Send(oModifierSpell,@GetName)]], lParts);
         }
      }

      foreach i in Send(who,@GetRadiusEnchantments)
      {
         iBefore = iSpellPower;
         iSpellPower = Send(Nth(i,2),@ModifySpellPower,#who=who,#oRoom=oRoom,
                              #oSpell=self,#iSpellPower=iSpellPower,
                              #state=Nth(i,3));
         if bParts AND iSpellPower <> iBefore
         {
            lParts = AppendListElem([spell_pp_inside, iSpellPower - iBefore,
                        [Send(Nth(i,2),@GetName)]], lParts);
         }
      }

      // Bound the lower end so that the stuff that follows is truly a bonus.
      if bParts AND iSpellPower < 0
      {
         lParts = AppendListElem([spell_pp_floor, -iSpellPower, $], lParts);
      }
      iSpellPower = Bound(iSpellPower,0,$);

      // This number is based on the number of shrines this god controls.
      iShrines = Send(SYS,@GetShrineBonus,#school=viSchool);

      // These bonuses (shrine, items) can boost spell power after all other modifiers.
      iSpellPower += iShrines + iItemModifier;
      if bParts
      {
         if iShrines <> 0
         {
            lParts = AppendListElem([spell_pp_shrines, iShrines,
                                     [Send(self,@GetSchoolStr)]], lParts);
         }

         foreach i in lItemParts
         {
            lParts = AppendListElem(i, lParts);
         }
      }

      // Then, add bonus from the system object, set by admins
      iBonus = Send(SYS,@GetBonusSpellpower,#school=viSchool);
      iSpellPower += iBonus;
      if bParts AND iBonus <> 0
      {
         lParts = AppendListElem([spell_pp_server, iBonus, $], lParts);
      }

      // Affected by the Dement spell?
      oModifierSpell = Send(SYS,@FindSpellByNum,#num=SID_DEMENT);
      if Send(who,@IsEnchanted,#what=oModifierSpell)
      {
         iAbilityLoss = First(Send(who,@GetEnchantedState,#what=oModifierSpell));
         if bParts
         {
            // A cast loses a random amount up to twice this: show the least.
            lParts = AppendListElem([spell_pp_dement, -iAbilityLoss,
                                     [iAbilityLoss]], lParts);
         }
         else
         {
            iAbilityLoss = Random(iAbilityLoss, iAbilityLoss*2);
         }
         iSpellpower -= iAbilityLoss;
      }

      //kraanan spellpower is lacking for some reason, adding this as a bandaid fix -Diggie
      if viSchool = SS_KRAANAN
      {
         iSpellPower = iSpellPower + 20;
         if bParts
         {
            lParts = AppendListElem([spell_pp_kraanan, 20, $], lParts);
         }
      }

      // Bound the result.
      iBound = Bound(iSpellPower,SPELLPOWER_MINIMUM,SPELLPOWER_MAXIMUM);
      if bParts
      {
         if iBound < iSpellPower
         {
            lParts = AppendListElem([spell_pp_total_cap, iBound - iSpellPower,
                                     [SPELLPOWER_MAXIMUM]], lParts);
         }
         else if iBound > iSpellPower
         {
            lParts = AppendListElem([spell_pp_total_floor, iBound - iSpellPower,
                                     [SPELLPOWER_MINIMUM]], lParts);
         }

         return [iBound, lParts];
      }

      return iBound;
   }

   GetLightBonus(oRoom=$)
   "Ours (spell revamp D31): 0 in a dungeon's gloom (light 84 or less) to "
   "10 in bright daylight (220 or more); Qor's is 10 less this."
   {
      if oRoom = $
      {
         return 0;
      }

      return Bound((Send(oRoom,@GetRoomLight) - 84) * 10 / 136,0,10);
   }

   GetRivalSchool()
   "Ours (spell revamp D33): Shal'ille's rival is Qor, and Qor's Shal'ille."
   {
      if viSchool = SS_SHALILLE
      {
         return SS_QOR;
      }

      if viSchool = SS_QOR
      {
         return SS_SHALILLE;
      }

      return $;
   }

   IsRivalSchoolPlayer(victim=$)
   "Ours (spell revamp D33): TRUE if victim is a player who knows spells of "
   "our rival school."
   {
      local iRival;

      iRival = Send(self,@GetRivalSchool);
      if victim = $
         OR iRival = $
         OR NOT IsClass(victim,&Player)
      {
         return FALSE;
      }

      return Send(victim,@KnowsSpellSchool,#school=iRival);
   }

   IsCasterAlly(oCaster=$,who=$)
   "Ours (spell revamp D25, D32): TRUE if who fights on oCaster's side: the "
   "caster, anyone they may not attack, their companions and minions (and "
   "those of their allies), and their faction's soldiers.  With a room as "
   "caster (the Marion crypt casts Martyr's Battleground) every player is."
   {
      local oLeader, iFaction;

      if who = $
      {
         return FALSE;
      }

      if oCaster = $
         OR NOT IsClass(oCaster,&Battler)
      {
         return IsClass(who,&Player);
      }

      if who = oCaster
      {
         return TRUE;
      }

      if IsClass(who,&Monster)
      {
         if Send(who,@IsCompanion)
         {
            oLeader = Send(who,@GetSworn);
         }
         else
         {
            oLeader = Send(who,@GetMaster);
         }

         if oLeader <> $
         {
            return oLeader = oCaster
                   OR (IsClass(oLeader,&Player)
                       AND NOT Send(oCaster,@AllowBattlerAttack,
                                    #victim=oLeader,#report=FALSE));
         }

         if IsClass(who,&FactionTroop)
            AND IsClass(oCaster,&Player)
         {
            iFaction = Send(oCaster,@GetFaction);

            return iFaction <> FACTION_NEUTRAL
                   AND iFaction = Send(who,@GetFaction);
         }

         return FALSE;
      }

      return NOT Send(oCaster,@AllowBattlerAttack,#victim=who,#report=FALSE);
   }

   GetFarenElement()
   {
      return viFarenElement;
   }

   GetFarenElementName(element=$)
   "The name of a Faren element (this spell's if element is $)."
   {
      if element = $
      {
         element = viFarenElement;
      }

      if element = FAREN_ELEMENT_FLAME
      {
         return spell_element_flame;
      }

      if element = FAREN_ELEMENT_FROST
      {
         return spell_element_frost;
      }

      if element = FAREN_ELEMENT_STORM
      {
         return spell_element_storm;
      }

      return spell_blank;
   }

   IsAttuned(who=$)
   "Ours (spell revamp D10): TRUE if who, a player, is attuned to our element."
   {
      if viFarenElement = FAREN_ELEMENT_NONE
         OR who = $
      {
         return FALSE;
      }

      if NOT IsClass(who,&Player)
      {
         return FALSE;
      }

      return Send(who,@GetFarenAttunement) = viFarenElement;
   }

   GetAttunementBonus(who=$)
   {
      if Send(self,@IsAttuned,#who=who)
      {
         return 10;
      }

      return 0;
   }

   ApplyAttunementDamage(who=$,iDamage=0)
   "15% more damage for a mage attuned to our element, unless it's a flame "
   "spell that burns instead (AttunementBurns)."
   {
      if Send(self,@IsAttuned,#who=who)
         AND NOT Send(self,@AttunementBurns,#who=who)
      {
         return iDamage * 115 / 100;
      }

      return iDamage;
   }

   AttunementBurns(who=$)
   "TRUE if who's hits with this spell set their target burning."
   {
      if viFarenElement <> FAREN_ELEMENT_FLAME
         OR NOT vbAttunementBurns
      {
         return FALSE;
      }

      return Send(self,@IsAttuned,#who=who);
   }

   TryAttunementBurn(who=$,victim=$,iDamage=0)
   "A hit for iDamage (hundredths) sets victim burning, if who burns with "
   "this spell."
   {
      if iDamage <> $
         AND iDamage > 0
         AND Send(self,@AttunementBurns,#who=who)
      {
         Send(Send(SYS,@FindSpellByNum,#num=SID_BURN),@DoBurn,#who=who,
              #oTarget=victim,#iHitDamage=iDamage);
      }

      return;
   }

   SendSideEffectSummary(who=$,iSpellPower=0)
   "Ours: one resource after an attack spell's damage in its description."
   {
      if Send(self,@AttunementBurns,#who=who)
      {
         Send(Send(SYS,@FindSpellByNum,#num=SID_BURN),@SendBurnSummary);

         return;
      }

      AddPacket(4,spell_blank);

      return;
   }

   GetCapParms(iValue=0,iCap=0)
   "Ours: the cap line names the cap; the floor line takes nothing."
   {
      if iValue < 0
      {
         return $;
      }

      return [iCap];
   }

   GetCapLabel(iValue=0)
   "Ours: the breakdown line for a school bonus held to its range."
   {
      if iValue < 0
      {
         return spell_pp_floor;
      }

      return spell_pp_cap;
   }

   CanBeRemovedByPlayer()
   "Returns if a spell can be removed by normal Purge/Purify"
   {
      // Most spells can be purged or purified.
      return TRUE;
   }

   SpellBannedInArena()
   {
      return FALSE;
   }

   OfferToNewCharacters()
   {
      // Don't offer if not enabled or accessible
      if NOT (pbEnabled AND pbAccessible)
      {
         return FALSE;
      }

      if viSpell_Level > 2
      {
         return FALSE;
      }
      
      if viSchool = SS_SHALILLE
         OR viSchool = SS_QOR
         OR viSchool = SS_KRAANAN
         OR viSchool = SS_FAREN
      {
         return TRUE;
      }

      // A Riija or Jala spell.  Don't offer initially.
      return FALSE;
   }

