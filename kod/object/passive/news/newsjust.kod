////////////////////////////////////////////////////////////////////////////////
NewsJusticar is News

constants:

   include blakston.khd

resources:

   newsjust_icon_rsc = jbook.bgf

classvars:

   vrIcon = newsjust_icon_rsc

properties:

   // Ours (ADR 0026): the register of name changes keeps more than a globe's 75 posts.
   // (A saved world keeps the value an object was created with, so GetMaxMessages
   // answers for it, below.)
   piMax_messages = 200

messages:

   GetMaxMessages()
   {
      return 200;
   }

   GetNewsPermission(what = $)
   { 
      local oCaramo;

      oCaramo = Send(SYS,@GetCaramo);

      if what = oCaramo
         OR IsClass(what,&DM)
      {
         return NEWS_PERMISSION_READ_WRITE;
      }

      return NEWS_PERMISSION_READ;
   }

end
////////////////////////////////////////////////////////////////////////////////
